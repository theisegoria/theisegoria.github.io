 export const motionRatios=[1,-1/3,1/12] as const;
 export const clamp=(n:number,min=0,max=1)=>Math.max(min,Math.min(max,n));
 export const smooth=(n:number)=>{const x=clamp(n);return x*x*(3-2*x)};
-export function escapePhase(cycles:number){const half=Math.floor(cycles*2);const p=cycles*2-half;const release=smooth((p-.40)/.20);return {balance:Math.cos(cycles*TAU)*Math.PI*.72,fork:(half%2?1:-1)*(.19-.38*release),wheel:(half+release)*Math.PI/15,phase:p<.40?'Locked · free swing':p<.47?'Unlocking':p<.60?'Impulse':'Relocked · free swing',beats:half};}
+export function escapePhase(cycles:number){const half=Math.floor(cycles*2);const p=cycles*2-half;const release=smooth((p-.40)/.20);return {balance:Math.cos(cycles*TAU)*Math.PI*.72,fork:(half%2?1:-1)*(.19-.38*release),wheel:(half+release)*Math.PI/15,phase:p<.40?"ロック・自由振動":p<.47?"ロック解除":p<.60?"インパルス":"再ロック・自由振動",beats:half};}
 export function dateState(progress:number){const cycle=Math.floor(progress),p=progress-cycle;return {angle:-(cycle+smooth((p-.35)/.3))*TAU/31,lift:Math.sin(clamp((p-.35)/.3)*Math.PI),day:((cycle+(p>.5?1:0))%31+31)%31+1};}
 export function resetAngle(angle:number,stroke:number){const shortest=((angle+Math.PI)%TAU+TAU)%TAU-Math.PI;return shortest*(1-smooth((stroke-.15)/.75));}
