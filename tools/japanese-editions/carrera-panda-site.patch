 export type Chapter={id:string;name:string;verb:string;title:string;intro:string;connection:string;principle:string;limitation:string;parts:Part[];stages:{name:string;title:string;body:string;focus:string}[];sources:{label:string;url:string}[]};
 const fhh='https://www.hautehorlogerie.org/en/watches-and-culture/';
 export const chapters:Chapter[]=[
-{id:'winding',name:'Automatic winding',verb:'Collect',title:'Your wrist winds a spring.',intro:'An automatic watch is a mechanical watch with an extra winding mechanism. The heavy rotor moves relative to the case as your wrist changes direction. That motion is converted into useful rotation at the mainspring’s arbor.',connection:'The TH20-00 winds in both rotor directions. The shield-shaped rotor is visible in the Carrera’s rear inspection view.',principle:'Input may reverse. Winding output must keep the same direction.',limitation:'The two one-way paths illustrate rectification. Their layout is not a reconstruction of the TH20-00 reversers.',parts:[{id:'rotor',name:'Weighted rotor',detail:'An off-centre mass turns around a bearing. Inertia and gravity produce relative motion between the rotor and case.'},{id:'reversers',name:'One-way coupling paths',detail:'One path transmits while the other overruns. The active path changes when the input reverses.'},{id:'reduction',name:'Reduction train',detail:'Multiple rotor movements produce a smaller winding rotation with greater available torque, after losses.'},{id:'arbor',name:'Winding output',detail:'The output winds the mainspring through the barrel arbor. A holding mechanism prevents that input from simply reversing.'}],stages:[{name:'Input',title:'The case moves; the rotor responds.',body:'Look at the weighted rim. Its centre of mass lies away from the bearing. Turn the input clockwise, then anticlockwise: the rotor is an energy collector, not the part that sets the time.',focus:'rotor'},{name:'Rectify',title:'Two directions become one.',body:'Follow the highlighted coupling path. A one-way coupling locks in one relative direction and freewheels in the other. With paired paths, either input direction can produce the required output direction.',focus:'reversers'},{name:'Reduce',title:'Speed is exchanged for torque.',body:'The winding train reduces the rotor’s motion before it reaches the spring. A rotor revolution is not a revolution of a watch hand. Energy crosses several geared connections first.',focus:'reduction'},{name:'Store',title:'Winding changes stored energy.',body:'The crown can also supply winding motion. Once sufficient energy is stored, the watch can run while resting on a table; it does not require continuous wrist motion.',focus:'arbor'}],sources:[{label:'TAG Heuer: TH20-00 bidirectional winding',url:'https://magazine.tagheuer.com/en/2024/02/28/ryan-gosling-unique-timepiece/'},{label:'FHH: the mechanical energy chain',url:fhh+'library/how-does-a-mechanical-watch-work'}]},
-{id:'barrel',name:'Barrel & mainspring',verb:'Store',title:'A metal ribbon stores the energy.',intro:'Inside the toothed barrel sits a long, flat spring. Its inner end connects to an arbor; its outer end couples to the barrel wall. Winding changes their relative angle and bends the spring.',connection:'The Carrera’s specified reserve is up to 80 hours. The illustrated winding level is not a measurement of your watch or a calibrated reserve curve.',principle:'Stored energy is the accumulated winding work: E = ∫ torque × d(angle).',limitation:'The coil shape and winding scale are schematic. Real mainspring torque is not constant, and the spring does not behave as a simple ideal spiral.',parts:[{id:'lid',name:'Barrel lid',detail:'Closes the drum and constrains the spring axially. Explode the assembly to lift it clear.'},{id:'spring',name:'Mainspring',detail:'A preformed metal ribbon that stores energy through elastic bending.'},{id:'arbor',name:'Arbor',detail:'The central shaft. Winding turns it relative to the barrel and tensions the spring.'},{id:'drum',name:'Toothed drum',detail:'The barrel turns as energy is released. Its teeth drive the going train.'},{id:'bridle',name:'Slipping bridle',detail:'In a typical automatic barrel, friction at the outer attachment permits controlled slipping near full wind.'}],stages:[{name:'Open',title:'Two ends, two different jobs.',body:'Lift the lid with the separation slider. Find the central arbor and the outer attachment. The spring connects these two members; the toothed drum is the power output.',focus:'lid'},{name:'Wind',title:'The arbor winds the ribbon.',body:'Move Winding level from low to high. The illustration gathers the spring inward. The elastic energy comes from work done while winding, not from the barrel’s gold colour or the rotor’s weight alone.',focus:'spring'},{name:'Drive',title:'The drum drives the train.',body:'During running, the spring urges the barrel onward. The train and escapement limit how quickly it can move. Less load does not automatically mean the hands should run faster: their pace is regulated downstream.',focus:'drum'},{name:'Limit',title:'An automatic barrel can slip.',body:'Near full wind, a slipping outer attachment can yield against the barrel wall. This allows further automatic winding motion without endlessly increasing spring tension. The mechanism is a friction limit, not a second energy source.',focus:'bridle'}],sources:[{label:'AWCI: automatic mainspring bridles',url:'https://www.awci.com/wp-content/uploads/ht/1979/1979-11-web.pdf'},{label:'FHH: barrel and energy storage',url:fhh+'library/how-does-a-mechanical-watch-work'}]},
-{id:'train',name:'Wheel train',verb:'Transmit',title:'Large wheels drive small pinions.',intro:'A pinion is a small gear on a shaft. A larger wheel on that same shaft turns with it and drives the next pinion. This compound arrangement creates large speed changes without an enormous single gear.',connection:'The TH20-00 has a going train that powers its escapement. The visible example demonstrates the principle with deliberately chosen teaching ratios.',principle:'Speed ratio = driver teeth / driven teeth. Here: 60/12 × 40/10 × 30/10 = 60.',limitation:'The 5 × 4 × 3 example is not the Carrera’s tooth count. Teeth use simplified profiles; this is a kinematic model, not a contact-force simulation.',parts:[{id:'input',name:'Input wheel · 60 teeth',detail:'This wheel supplies the example’s input motion.'},{id:'compound1',name:'12-tooth pinion + 40-tooth wheel',detail:'Both gears share a shaft. They have identical angular speed even though their diameters differ.'},{id:'compound2',name:'10-tooth pinion + 30-tooth wheel',detail:'The second compound shaft multiplies speed by another factor of four.'},{id:'output',name:'Output pinion · 10 teeth',detail:'After the final factor of three, it turns sixty times per input revolution, in the opposite direction.'}],stages:[{name:'Mesh',title:'Count teeth, not visual size alone.',body:'The 60-tooth input drives a 12-tooth pinion. For every turn of the input, twelve pinion teeth must pass five times: the pinion makes five turns in the opposite direction.',focus:'input'},{name:'Compound',title:'One shaft carries two gears.',body:'Separate the layers to find each pinion beneath its wheel. The wheel is fixed to the pinion’s shaft, so their rotations are locked together. Different diameters do not imply different speeds on the same rigid shaft.',focus:'compound1'},{name:'Multiply',title:'Ratios multiply along the train.',body:'The next mesh multiplies speed by four; the last multiplies by three. Five times four times three gives sixty. Each external mesh reverses rotation, so three meshes leave the output reversed.',focus:'output'},{name:'Torque',title:'Faster output has less torque.',body:'For an ideal lossless transmission, torque multiplied by angular speed is conserved. A sixtyfold speed increase means one-sixtieth of the input torque. Real friction reduces the available output further.',focus:'compound2'}],sources:[{label:'FHH: going train and motion work',url:fhh+'watchmaking-knowledge/encyclopedia/train'}]},
-{id:'escapement',name:'Escapement & balance',verb:'Regulate',title:'A controlled release, eight times a second.',intro:'The escape wheel receives torque from the train. Two ruby pallets alternately hold and release it. The fork interacts with the balance’s impulse jewel; the balance and hairspring set the rhythm.',connection:'The TH20-00 oscillates at 4 Hz: four complete back-and-forth cycles, eight beats per second, or 28,800 beats per hour.',principle:'Ideal oscillator: f = (1 / 2π) × √(spring stiffness / rotational inertia).',limitation:'Contact surfaces and angles are schematic. One displayed cycle is slowed to eight seconds; this is not real-time Carrera motion.',parts:[{id:'escape',name:'Escape wheel',detail:'A driven wheel that advances in controlled steps instead of running freely.'},{id:'fork',name:'Pallet fork & ruby pallets',detail:'The entrance and exit stones alternate between holding a tooth and receiving its impulse.'},{id:'balance',name:'Balance wheel & impulse jewel',detail:'An oscillator with rotational inertia. Its impulse jewel interacts with the fork during a small part of the swing.'},{id:'hairspring',name:'Hairspring',detail:'A fine restoring spring, distinct from the mainspring. It returns the balance toward equilibrium.'}],stages:[{name:'Lock',title:'A pallet holds the escape wheel.',body:'The train is under torque, but a wheel tooth rests on a pallet’s locking face. The balance continues its free swing. Most of the oscillation occurs without the train continuously pushing the balance.',focus:'escape'},{name:'Unlock',title:'The returning balance moves the fork.',body:'Near the middle of its swing, the balance’s impulse jewel enters the fork. This moves the pallet just far enough to unlock the escape wheel. The balance controls when release occurs.',focus:'fork'},{name:'Impulse',title:'The train replaces lost energy.',body:'The released tooth slides across an impulse face and moves the fork, which impulses the balance. The mainspring supplies this energy; it compensates for friction and air resistance.',focus:'balance'},{name:'Relock',title:'The other pallet catches the wheel.',body:'The next locking event stops the wheel again while the balance swings away. On the return journey the roles reverse. Two releases occur in each complete balance oscillation.',focus:'hairspring'}],sources:[{label:'FHH: Swiss lever escapement',url:fhh+'library/regulating-organs-from-past-to-presentpartfive'},{label:'FHH: entrance and exit pallets',url:fhh+'watchmaking-knowledge/encyclopedia/pallet'},{label:'TAG Heuer: movement frequency',url:'https://magazine.tagheuer.com/en/2024/02/28/ryan-gosling-unique-timepiece/'}]},
-{id:'motion',name:'Hands & motion work',verb:'Display',title:'Two hands share a centre, not a speed.',intro:'Concentric tubes let the minute and hour hands rotate around the same axis independently. A small reduction train beneath the dial slows the hour wheel relative to the minute-hand carrier.',connection:'The Carrera’s small seconds at six o’clock belongs to ordinary timekeeping. Its central red-tipped hand belongs to the chronograph, which can remain stopped.',principle:'One minute-hand revolution per hour; one hour-hand revolution per twelve hours.',limitation:'The displayed 12:1 gear example is generic motion work. Shaft locations and tooth counts are not measured TH20-00 parts.',parts:[{id:'cannon',name:'Cannon pinion & minute hand',detail:'The minute hand is carried on a central tube associated with the motion work.'},{id:'minuteWheel',name:'Intermediate wheel & pinion',detail:'A compound gear transfers motion outward and back to the shared hand axis.'},{id:'hour',name:'Hour wheel & hour hand',detail:'A wider tube surrounds the minute-hand carrier and turns twelve times more slowly.'},{id:'friction',name:'Friction connection',detail:'A friction fit permits hand-setting motion while keeping the display coupled during normal running.'}],stages:[{name:'Separate',title:'The hand tubes nest together.',body:'Explode the stack and inspect the central tubes. The hands sit at different heights and on different carriers, allowing one to pass over the other without contact.',focus:'cannon'},{name:'Reduce',title:'Two meshes give a twelvefold reduction.',body:'In this example, 12 teeth drive 36, then 10 drive 40. The output speed is one-third times one-quarter: one-twelfth. Two external meshes leave both hands turning the same way.',focus:'minuteWheel'},{name:'Read',title:'The hour hand moves between marks.',body:'At half past ten, the hour hand is halfway toward eleven. It is continuously geared to the minute hand, not held at an hour mark until the next hour begins.',focus:'hour'},{name:'Set',title:'Setting requires a slipping connection.',body:'A typical cannon-pinion friction fit is tight enough for normal running but permits relative motion during hand setting. It avoids forcing the entire going train to follow every turn of the crown.',focus:'friction'}],sources:[{label:'FHH: motion work',url:fhh+'watchmaking-knowledge/encyclopedia/motion-work'},{label:'FHH: cannon pinion',url:fhh+'watchmaking-knowledge/encyclopedia/cannon-pinion'},{label:'FHH: train components',url:fhh+'watchmaking-knowledge/encyclopedia/train'}]},
-{id:'clutch',name:'Chronograph clutch',verb:'Couple',title:'A stopwatch takes power from the same movement.',intro:'The chronograph adds an elapsed-time branch to the movement. Its control system decides whether that branch is driven, held still or reset. The timekeeping train continues to run independently of the displayed stopwatch state.',connection:'TAG Heuer documents an integrated column-wheel chronograph with vertical coupling for the TH20-00. The right counter records minutes; the left records hours.',principle:'Column wheel = control. Clutch = connection. Brake = hold.',limitation:'The coaxial plates explain a vertical clutch. Lever geometry and control sequencing are generic, not a TH20-00 service drawing.',parts:[{id:'drive',name:'Continuously driven member',detail:'Receives motion from the running watch even while the stopwatch is stopped.'},{id:'clutch',name:'Axial coupling',detail:'Frictional contact couples coaxial members so torque reaches the chronograph runner.'},{id:'runner',name:'Chronograph runner',detail:'Carries the stopwatch seconds hand and participates in driving the elapsed-time counters.'},{id:'column',name:'Column wheel & control lever',detail:'An indexed column wheel provides raised columns and gaps that coordinate control levers.'},{id:'brake',name:'Brake',detail:'Holds the stopped runner so its reading remains steady after the drive is uncoupled.'}],stages:[{name:'Stopped',title:'The watch runs; the stopwatch waits.',body:'The lower driving member rotates while the upper runner is held. Separating the coupling interrupts this branch without stopping ordinary timekeeping.',focus:'drive'},{name:'Start',title:'Control levers change state together.',body:'Starting indexes the control system, releases the runner and engages the coupling. The joined members now transmit torque along a common axis. Use Start to see them turn together.',focus:'clutch'},{name:'Measure',title:'The runner counts elapsed time.',body:'The central hand makes a turn each minute. Further gearing accumulates minutes and hours on the black counters. The red hands indicate elapsed time, not the current time of day.',focus:'runner'},{name:'Stop',title:'Disconnect, then hold the reading.',body:'Stopping uncouples the drive and holds the runner. The elapsed reading stays fixed. Press Start again to resume accumulation; reset is a separate operation available after stopping.',focus:'brake'}],sources:[{label:'TAG Heuer: column wheel and vertical coupling',url:'https://magazine.tagheuer.com/en/2024/04/09/its-panda-time-tag-heuer-carrera-angus-davies/'}]},
-{id:'reset',name:'Return to zero',verb:'Reset',title:'A shaped cam remembers where zero is.',intro:'A hand needs a repeatable mechanical zero. A heart-shaped cam is fixed to its runner. A hammer presses against the cam and rotates it toward a stable orientation, carrying the hand back with it.',connection:'The Carrera has a separate reset pusher. In this explainer, reset is interlocked while the chronograph is running. It is not presented as a flyback chronograph.',principle:'The cam and hand share an arbor. Rotating the cam to its rest position returns the hand to zero.',limitation:'The heart profile and hammer travel illustrate the principle; they are not the exact Carrera parts or a contact simulation.',parts:[{id:'heart',name:'Heart cam',detail:'Its changing radius guides the runner toward one preferred reset orientation.'},{id:'hammer',name:'Reset hammer',detail:'Moves onto the cam when reset is commanded and supplies the resetting force.'},{id:'runner',name:'Runner & hand',detail:'Shares its angular position with the heart cam. They return together.'},{id:'spring',name:'Return spring',detail:'Provides restoring force to the simplified hammer mechanism.'}],stages:[{name:'Measure',title:'Cam and hand turn together.',body:'Move the recorded-angle slider to choose a stopped reading. The cam has not forgotten zero: its shape encodes the orientation the hammer will restore.',focus:'heart'},{name:'Approach',title:'The hammer approaches the cam.',body:'Resetting first requires the chronograph’s driven state to end. The hammer can then act on the cam without fighting an engaged drive. Use Press reset to begin the illustrated stroke.',focus:'hammer'},{name:'Turn',title:'A slope produces a turning moment.',body:'Contact away from the centre produces torque. The cam can turn either way toward its reset position, depending on the starting angle. The hand follows because it is fixed to the same runner.',focus:'runner'},{name:'Zero',title:'Every counter needs a repeatable reference.',body:'A multi-counter chronograph must return its elapsed-time indications together. This enlarged single-cam example isolates the reason a physical mechanism can repeatedly find zero without electronics.',focus:'heart'}],sources:[{label:'A. Lange & Söhne: zero-reset heart cam principle',url:'https://www.alange-soehne.com/us-en/manufacture/art-of-watchmaking/double-tripple-rattrapante-mechanism'}]},
-{id:'date',name:'Date change',verb:'Index',title:'A daily drive advances one of 31 positions.',intro:'A basic date display is a numbered ring controlled by a daily drive and a spring-loaded locating element. The ring must advance by one position and then remain aligned with the dial window.',connection:'Your Carrera places its date window at six o’clock. This is a date display, not an annual or perpetual calendar: the displayed date may need correction after a short month.',principle:'One date-ring step = 360° / 31 ≈ 11.61°.',limitation:'This generic driving-finger and jumper arrangement demonstrates indexing. It does not establish the TH20-00’s precise date-change timing or architecture.',parts:[{id:'ring',name:'31-position date ring',detail:'Carries the dates past a fixed window in the dial.'},{id:'driver',name:'Daily driving finger',detail:'A once-per-day drive engages and advances the ring in the simplified example.'},{id:'jumper',name:'Jumper & spring',detail:'Locates the ring between changes so the numeral sits neatly in the window.'},{id:'window',name:'Fixed dial window',detail:'Shows a single number while the ring beneath it moves.'}],stages:[{name:'Hold',title:'The ring rests in a located position.',body:'A sprung jumper holds the ring in a stable position. This prevents a small disturbance from leaving the date halfway across the aperture.',focus:'jumper'},{name:'Engage',title:'The daily drive reaches the next tooth.',body:'The example’s driving finger approaches the ring. Energy has to overcome the locating spring before the date can move. Use Advance date to see one complete indexing event.',focus:'driver'},{name:'Advance',title:'Exactly one position is selected.',body:'The ring advances by one thirty-first of a turn. The jumper lifts and then settles again. A fixed aperture makes that rotational motion appear as one numeral replacing another.',focus:'ring'},{name:'Repeat',title:'A simple date ring does not know the month.',body:'After 31 comes 1. The basic mechanism has no information about February or a thirty-day month. This explains why a correct time display and an incorrect date can coexist.',focus:'window'}],sources:[{label:'FHH: date and calendar mechanisms',url:fhh+'watchmaking-knowledge/encyclopedia/day-date'},{label:'TAG Heuer: the Carrera date display',url:'https://www.tagheuer.com/au/en/timepieces/collections/tag-heuer-carrera/39-mm-th20-00/CBS2216.BA0048.html'}]},
-{id:'jewels',name:'Jewels & bearings',verb:'Support',title:'Tiny pivots need hard, smooth bearings.',intro:'A wheel rotates on a slender steel shaft. Its reduced ends, called pivots, sit in bearings. Synthetic ruby provides hard, wear-resistant contact surfaces; lubrication manages friction where the design requires it.',connection:'The TH20-00 has 33 jewels. That number includes functional bearing and escapement uses; it is not 33 decorative gems scattered around the dial.',principle:'Jewels support motion. They do not supply energy or determine accuracy by count alone.',limitation:'The section exaggerates pivot diameter, clearance and oil volume. The shown bearing stack and shock spring are generic.',parts:[{id:'pivot',name:'Steel pivot',detail:'The small end of a shaft. Its radius and surface finish affect friction at the bearing.'},{id:'hole',name:'Hole jewel',detail:'Locates the shaft radially and provides a hard bearing surface.'},{id:'cap',name:'Cap jewel',detail:'Supports the shaft end axially in a capped bearing arrangement.'},{id:'oil',name:'Oil film',detail:'A small, controlled lubricant volume reduces friction. More oil is not automatically better.'},{id:'setting',name:'Setting & shock spring',detail:'Retains the bearing assembly; in a shock-protected design it can yield briefly under impact.'}],stages:[{name:'Locate',title:'A pivot must turn without wandering.',body:'Separate the bearing stack. The hole jewel constrains sideways motion, while the cap controls the end contact. These are different mechanical jobs.',focus:'pivot'},{name:'Lubricate',title:'The working interface is very small.',body:'The enlarged oil film marks a functional contact region. Correct lubricant, amount and placement matter; flooding a movement would not improve its running.',focus:'oil'},{name:'Protect',title:'An impact can overload a thin pivot.',body:'A spring-mounted bearing setting can move slightly during a shock and return afterward. This protects delicate parts by managing displacement rather than making every part perfectly rigid.',focus:'setting'},{name:'Interpret',title:'Count functions, not prestige.',body:'Some jewels support shafts; others form escapement contacts. Their usefulness depends on where and how they are used. Thirty-three alone does not tell you a watch’s measured daily rate.',focus:'hole'}],sources:[{label:'FHH: jewel functions',url:fhh+'watchmaking-knowledge/encyclopedia/jewel'},{label:'FHH: escapement pallets',url:fhh+'watchmaking-knowledge/encyclopedia/pallet'}]}
+{id:'winding',name:"自動巻き上げ",verb:"収集",title:"あなたの手首がスプリングを巻き上げます。",intro:"自動巻き時計とは、機械式時計に追加された巻き上げ機構を持つ時計です。重いローターは、手首の向きが変化するにつれてケースに対して相対的に動きます。その動きは、主ぜんまいのアーバーに有用な回転に変換されます。",connection:"TH20-00は、ローターの両方向に巻き上げが可能です。カレラの背面の検視ビューでは、シールド型ローターが確認できます。",principle:"入力が逆転することがあります。巻き上げ出力は、同じ方向を保つ必要があります。",limitation:"2つの単方向の経路は、整流を示しています。その配置は、TH20-00の逆転機構を再構築したものではありません。",parts:[{id:'rotor',name:"質量を調整したローター",detail:"中心から離れた質量が軸を回転させます。慣性と重力がローターとケースの間で相対的な動きを生み出します。"},{id:'reversers',name:"単方向結合経路",detail:"1つの経路が動作し、もう1つはオーバーランします。入力が逆転したときに、アクティブな経路が変化します。"},{id:'reduction',name:"減速トレイン",detail:"複数のローターの動きにより、トルクが大きくなる一方で、回転数は小さくなる。ただし、損失を考慮した上でそのような結果が得られる。"},{id:'arbor',name:"巻き上げ出力",detail:"出力側では、バーレルの軸を通じて主ぜんまいを巻き上げる。その入力が単に逆転するのを防ぐため、保持機構が設けられている。"}],stages:[{name:"入力",title:"ケースが動く。ローターはそれに応じて反応する。",body:"重り付きリムを見てみよ。その重心は回転軸から離れている。入力を時計回りに、次に反時計回りに動かしてみよ。このローターはエネルギーを収集する装置であり、時を示す部分ではない。",focus:'rotor'},{name:"整流",title:"二つの方向が一つにまとまる。",body:"強調されたカップリング経路を追う。一方向では一方向の相対運動がロックされ、もう一方ではフリーローリングする。対称な経路を持つことで、どちらの入力方向でも必要な出力方向が得られる。",focus:'reversers'},{name:"減速",title:"速度はトルクに換わり合う。",body:"巻き上げトレインは、スプリングに達する前にローターの動きを減速させる。ローターの1回転は、時計の針の1回転とは異なる。エネルギーは複数のギア結合を通じて移動する。",focus:'reduction'},{name:"蓄え",title:"巻き上げは蓄えられたエネルギーを変化させる。",body:"カーブ（冠）も巻き上げ運動を供給できる。十分なエネルギーが蓄えられた後は、時計はテーブルの上に置かれていても動くことができる。連続的な腕の動きが求められない。",focus:'arbor'}],sources:[{label:"TAG Heuer: TH20-00 双方向巻き上げ",url:'https://magazine.tagheuer.com/en/2024/02/28/ryan-gosling-unique-timepiece/'},{label:"FHH: 機械的エネルギー連鎖",url:fhh+'library/how-does-a-mechanical-watch-work'}]},
+{id:'barrel',name:"バーレルおよび主ぜんまい",verb:"蓄え",title:"金属のリボンがエネルギーを蓄えます。",intro:"歯のボルト内部には長い平坦なスプリングが収められています。その内側の端はアーバーに接続され、外側の端はボルトの壁に結合しています。巻き上げることで、その相対角度が変化し、スプリングが曲がります。",connection:"カーレラが指定した備蓄時間は最大80時間までです。図示された巻き上げレベルは、あなたの時計の測定値や、校正された備蓄曲線とはなりません。",principle:"蓄えられたエネルギーは、巻き上げ作業の累積値です：E = ∫トルク × d(角度)。",limitation:"コイルの形状および巻き上げスケールはスケッチ的なものであり、実際の主ぜんまいのトルクは一定ではなく、スプリングは単純な理想スパイラの挙動とは異なります。",parts:[{id:'lid',name:"ボルトの蓋",detail:"ドームを閉じ、スプリングの軸方向に制約を与えます。アセンブリを分解して蓋を離すようにします。"},{id:'spring',name:"主ぜんまい",detail:"事前に形成された金属のリボンで、弾性曲げによってエネルギーを蓄えます。"},{id:'arbor',name:"アーバー",detail:"中心軸です。巻き上げはこの軸をボルトに対して回転させ、スプリングを緊張させます。"},{id:'drum',name:"歯のあるドラム",detail:"エネルギーが放出されると、ドラムが回転します。その歯が駆動トレインを駆動します。"},{id:'bridle',name:"スリップブリッジ",detail:"典型的な自動ボルトでは、外側の結合部での摩擦により、フル巻き時の近くで制御されたスリップが可能になります。"}],stages:[{name:"開いた状態",title:"2つの端、それぞれ異なる役割を持ちます。",body:"蓋を分離スライダーを使って持ち上げ、中央のアーバーと外側の結合部を見つけます。スプリングはこの2つの構成部品をつなげており、歯のあるドラムが出力になります。",focus:'lid'},{name:"巻き上げる",title:"アーボルがリボンを巻き上げる。",body:"巻き上げレベルを低いところから高いところへ移動させます。図解では、スプリングが内側に収縮する様子が描かれています。弾性エネルギーは、巻き上げ動作によって行われた仕事から生じるもので、バーレルの黄金色またはローターの重さだけでは得られません。",focus:'spring'},{name:"駆動",title:"ドラムがトレインを駆動する。",body:"走行中にスプリングはバーレルを前に押し進める。トレインおよびエスカペメントが、その速度を制限しています。負荷が少ないからといって、時計の針が自動的に速く回るとは限りません。針の進み方は、下流で制御されています。",focus:'drum'},{name:"制限",title:"自動バーレルはすべる可能性があります。",body:"フル巻きの近くで、外側の付属部品がバーレルの壁に擦れることがあります。これにより、バーレルの進みをさらに進めることが可能になりますが、無限にスプリングの張力を増加させることなく、制限が働きます。この機構は摩擦による制限であり、第二のエネルギー源ではありません。",focus:'bridle'}],sources:[{label:"AWCI：自動主ぜんまいのブリッジ",url:'https://www.awci.com/wp-content/uploads/ht/1979/1979-11-web.pdf'},{label:"FHH：バーレルおよびエネルギー蓄積",url:fhh+'library/how-does-a-mechanical-watch-work'}]},
+{id:'train',name:"ホイールトレイン",verb:"伝達",title:"大きなホイールが小さなピニオンを駆動する。",intro:"ピニオンとは、軸に取り付けられた小さな歯車です。その同じ軸に設けられた大きなホイールは、そのピニオンと共に回転し、次のピニオンを駆動します。この複合構成により、非常に大きな速度変化を実現できますが、一つの巨大な歯車を必要としません。",connection:"TH20-00は、走行トレインがエスカペメントを駆動する構造を持っています。この見える例では、意図的に選ばれた教育的な速度比で原理を示しています。",principle:"速度比 = 駆動歯数 / 駆動される歯数。ここでは：60/12 × 40/10 × 30/10 = 60。",limitation:"5 × 4 × 3 の例は、Carreraの歯数ではありません。歯の数は簡略化されたプロファイルを使用しています。これは運動学モデルであり、接触力のシミュレーションではありません。",parts:[{id:'input',name:"入力ホイール · 60歯",detail:"このホイールが、例の入力運動を提供します。"},{id:'compound1',name:"12歯のピニオン＋40歯のホイール",detail:"両方のギアは同一の軸に取り付けられている。直径が異なるにもかかわらず、角速度は同じである。"},{id:'compound2',name:"10歯のピニオン＋30歯のホイール",detail:"2つ目の複合軸は速度をさらに4倍に増幅する。"},{id:'output',name:"出力ピニオン・10歯",detail:"最終的な3倍の因子の後、入力1回転につき60回転になるが、反対方向に回転する。"}],stages:[{name:"ギアの噛み合い",title:"歯の数を数えて、視覚的な大きさだけではなく。",body:"60歯の入力が12歯のピニオンを駆動する。入力1回転につれて、12歯のピニオンの歯が5回通過しなければならない。つまり、ピニオンは反対方向に5回転する。",focus:'input'},{name:"複合ギア",title:"1つの軸に2つのギアが取り付けられている。",body:"各層を分離して、各ホイールの下にあるピニオンを特定する。ホイールはピニオンの軸に固定されているため、その回転は互いにロックされている。直径が異なることによって、同一の剛体軸上の回転速度が異なるとは限らない。",focus:'compound1'},{name:"掛け算",title:"トレイン内の比率は掛け算される。",body:"次のギアの噛み合いは速度を4倍に、最後のギアは3倍にする。5×4×3で60になる。外部のギア噛み合いは回転方向を反転させるため、3つの噛み合いの結果、出力は反転している。",focus:'output'},{name:"トルク",title:"出力が速くなるとトルクは減少する。",body:"理想的な損失のない伝達では、トルクに角速度を掛けた値は保存される。速度が60倍になると、入力トルクの1/60になる。実際の摩耗は、出力トルクをさらに減少させる。",focus:'compound2'}],sources:[{label:"FHH：運行中の時計と運動の仕組み",url:fhh+'watchmaking-knowledge/encyclopedia/train'}]},
+{id:'escapement',name:"逃げ機構とバランス",verb:"調整",title:"制御された放出、秒針が1秒間に8回。",intro:"逃げ歯車はトレインからトルクを受け、二つのルビー製パレットが交互にその歯車を保持・放出する。フォークはバランスのインパルスジャイルと相互作用し、バランスとハアースプリングがリズムを決める。",connection:"TH20-00は4Hzで振動しており、4回の往復運動、1秒間に8回の拍動、または1時間に28,800拍動となる。",principle:"理想的な振動装置：f = (1 / 2π) × √(スプリングの剛性 / 回転慣性)",limitation:"接触面および角度は模式的。示された1サイクルは8秒に拡大されたもので、これは現実のCarrera運動ではない。",parts:[{id:'escape',name:"逃げ歯車",detail:"駆動される歯車で、自由に回転するのではなく、制御されたステップで進む。"},{id:'fork',name:"パレットフォークおよびルビーパレット",detail:"入口と出口の石は、歯の保持とインパルスの受容を交互に実行する。"},{id:'balance',name:"バランス歯車およびインパルスジャイル",detail:"慣性を持つ振動装置で、そのインパルスジャイルはスウィングの一部の期間中にフォークと相互作用する。"},{id:'hairspring',name:"ハアースプリング",detail:"細い復帰スプリングで、主ぜんまいとは異なる。バランスを均衡点へ戻す。"}],stages:[{name:"ロック",title:"パレットが逃げ歯車を保持する。",body:"トレインはトルクを受けているが、歯の一部がパレットのロック面に当たっている。バランスはその自由な振動を続けている。トレインがバランスを連続的に押す必要はほとんどない。",focus:'escape'},{name:"ロック解除",title:"戻りのバランスがフォークを動かす。",body:"そのスイングの中央付近で、バランスのインパルスジャイルがフォークに進入し、パレットをちょうど十分に動かして逃げ歯車を開放する。バランスが開放タイミングを制御する。",focus:'fork'},{name:"インパルス",title:"トレインは失われたエネルギーを補填する。",body:"開放された歯がインパルス面を滑らせてフォークを動かし、その結果バランスにインパルスを与える。主ぜんまいがこのエネルギーを供給し、摩擦や空気抵抗を補償する。",focus:'balance'},{name:"再ロック",title:"もう一方のパレットが歯車を捕らえる。",body:"次のロックイベントでは、バランスが振動している間に歯車が停止する。戻りの段階では役割が逆転する。1つの振動周期あたり2回の開放が起こる。",focus:'hairspring'}],sources:[{label:"FHH: スイス式レバー式エスケープ",url:fhh+'library/regulating-organs-from-past-to-presentpartfive'},{label:"FHH: 入り口・出口パレット",url:fhh+'watchmaking-knowledge/encyclopedia/pallet'},{label:"TAG Heuer: 運動周波数",url:'https://magazine.tagheuer.com/en/2024/02/28/ryan-gosling-unique-timepiece/'}]},
+{id:'motion',name:"時計の手と動き",verb:"表示",title:"2つの時計の手は中心を共有し、速度は共有しない。",intro:"同心円チューブにより、分針と時針は同じ軸を中心に独立して回転できる。時計盤の下部にある小さな減速機構により、時針の回転速度が分針のキャリアに対して遅くなる。",connection:"Carreraの6時位置にある小さな秒針は、通常の時間計測に属する。中央の赤い先の針はクロノグラフに属し、停止したまま保持できる。",principle:"1時間に1回分針が1周、12時間に1回時針が1周。",limitation:"表示されている12:1ギアの例は一般的な動き仕組みである。シャフトの位置や歯数はTH20-00部品の測定値ではない。",parts:[{id:'cannon',name:"キャノンピニオンおよび分針",detail:"分針は、動作機構と関連付けられた中央チューブ上に搭載されている。"},{id:'minuteWheel',name:"中間歯車およびピニオン",detail:"複合歯車は、外側へと動力を伝送し、共通の手の軸へ戻す。"},{id:'hour',name:"時針歯車および時針",detail:"分針のキャリアに広いチューブが取り囲み、十二倍も遅く回転する。"},{id:'friction',name:"摩擦結合",detail:"摩擦適合により、手で設定する動きを可能にしながら、通常の運転中に表示が結合されている。"}],stages:[{name:"分離",title:"手のチューブは互いに内側に収まっている。",body:"スタックを分解し、中央チューブを確認する。時計の手は異なる高さにあり、異なるキャリアに設置されており、互いに接触せずに一方が他方を通過できる。",focus:'cannon'},{name:"減速",title:"2つの歯車の重なりにより、12倍の減速が得られる。",body:"この例では、12歯が36歯に、次に10歯が40歯に駆動する。出力速度は1/3 × 1/4 = 1/12となる。2つの外部歯車の重なりにより、両方の手が同じ方向に回転する。",focus:'minuteWheel'},{name:"確認",title:"時針はマーキング間を移動する。",body:"10時30分のとき、時針は11時へ向かう半分の位置にある。時針は連続して分針とギア結合しており、次の時刻が開始されるまで、時刻のマーキングに固定されていない。",focus:'hour'},{name:"設定",title:"設定には、スリップ結合が必要である。",body:"典型的なキャノンピンionの摩擦適合は、通常の動作においてはしっかりと固定されているが、手動調整中に相対運動を許容する。完全な運転トレインが冠の1回の回転に合わせて動く必要がないようにしている。",focus:'friction'}],sources:[{label:"FHH: 運動仕事",url:fhh+'watchmaking-knowledge/encyclopedia/motion-work'},{label:"FHH: キャノンピンion",url:fhh+'watchmaking-knowledge/encyclopedia/cannon-pinion'},{label:"FHH: トレイン部品",url:fhh+'watchmaking-knowledge/encyclopedia/train'}]},
+{id:'clutch',name:"クロノグラフクラッチ",verb:" couples",title:"ストップウォッチは同じ運動から電力を得る。",intro:"クロノグラフは、運動に追加の経過時間ブランチを追加する。その制御システムは、そのブランチが駆動されるか、停止されるか、またはリセットされるかを決定する。時間計測トレインは、表示されているストップウォッチの状態とは関係なく独立して動作する。",connection:"TAG Heuerは、TH20-00用に統合されたカラム・ウェルのクロノグラフを垂直結合で実装している。右側のカウンターは分を、左側は時間を記録する。",principle:"カラム・ウェル = 制御。クラッチ = 接続。ブレーキ = 持ち上げ。",limitation:"共軸プレートは垂直クラッチを説明する。レバーの幾何学的構造および制御シーケンスは一般的であり、TH20-00のサービス図ではない。",parts:[{id:'drive',name:"連続的に駆動される部品",detail:"ストップウォッチが停止している間も、運転中の時計からの運動を受け取る。"},{id:'clutch',name:"軸方向結合",detail:"摩擦的接触により共軸部品が結合され、トルクがクロノグラフランナーに伝達される。"},{id:'runner',name:"クロノグラフランナー",detail:"ストップウォッチの秒針を運ぶとともに、経過時間カウンターの駆動にも参加する。"},{id:'column',name:"カラム・ウェルおよび制御レバー",detail:"インデックス付きカラムホイールは、隆起した柱と隙間を備え、コントロールレバーの動作を同期させる。"},{id:'brake',name:"ブレーキ",detail:"駆動が離された後、停止したランナーの読みを安定させることを目的とする。"}],stages:[{name:"停止",title:"時計は走り、ストップウォッチは待つ。",body:"下方の駆動部品が回転しながら、上方のランナーは保持される。結合を離すことにより、このブランチは中断され、通常の時間計測は停止しない。",focus:'drive'},{name:"開始",title:"コントロールレバーは状態を同時に変化させる。",body:"スタートによりコントロールシステムがインデックスされ、ランナーが解放され、結合が成立する。結合された部品は共通軸を通じてトルクを伝達する。スタートを押すことで、その共通回転を確認できる。",focus:'clutch'},{name:"測定",title:"ランナーは経過時間をカウントする。",body:"中央の手は分単位で1分ごとに回転し、さらに複数段のギアにより分と時間は黒いカウンターに累積される。赤色の手は経過時間を示すもので、現在の時刻を示すものではない。",focus:'runner'},{name:"停止",title:"離脱後、読みを保持する。",body:"停止は駆動を離し、ランナーを保持する。経過した読みは固定される。スタートを再度押すことで累積を再開できるが、リセットは停止後に実行可能な別操作である。",focus:'brake'}],sources:[{label:"TAG Heuer: カラムホイールと垂直結合",url:'https://magazine.tagheuer.com/en/2024/04/09/its-panda-time-tag-heuer-carrera-angus-davies/'}]},
+{id:'reset',name:"ゼロに戻す",verb:"リセット",title:"形状を持つカムはゼロの位置を記憶する。",intro:"手は再現可能な機械的ゼロを必要とする。心形のカムはランナーに固定され、ハンマーがカムに押しつけられ、そのカムを安定した向きへ回転させ、手と共にその位置を戻す。",connection:"Carreraは別途リセット用のプッシュボタンを持つ。本説明では、クロノグラフが走っている間、リセットはロックされている。飛行式クロノグラフとして提示されていない。",principle:"カムとハンドは共通の軸を共有している。カムを復帰位置に回転させることで、ハンドはゼロに戻る。",limitation:"心臓のプロファイルとハンマーの移動はこの原理を示しているが、正確なCarrera部品や接触シミュレーションとは限らない。",parts:[{id:'heart',name:"心臓カム",detail:"その変化する半径はランナーを一つの好むリセット方向へ導く。"},{id:'hammer',name:"リセットハンマー",detail:"リセットが命令されたときにカムに移動し、リセット力を供給する。"},{id:'runner',name:"ランナーおよびハンド",detail:"心臓カムと同様の角位置を共有している。両者は一緒に戻る。"},{id:'spring',name:"戻りばね",detail:"簡易化されたハンマー機構に復帰力を提供する。"}],stages:[{name:"測定",title:"カムとハンドは一緒に回転する。",body:"記録された角度スライダーを動かして、停止した読みを選びなさい。カムはゼロを忘れていません。その形状は、ハンマーが復帰する方向を暗黙に記憶している。",focus:'heart'},{name:"アプローチ",title:"ハンマーがカムに近づく。",body:"リセットを行うには、クロノグラフの駆動状態が終了しなければならない。その状態が終了した後、ハンマーは駆動が進行している状態と戦うことなくカムに作用できる。『リセットを押す』ボタンを押して、示されたストロークを開始する。",focus:'hammer'},{name:"回転",title:"傾きは回転モーメントを生じる。",body:"中心から離れた接触はトルクを生じる。カムは開始角度に応じて、復帰位置へ向かってどちらかの方向に回転できる。ハンドはそのランナーに固定されているため、同じように動く。",focus:'runner'},{name:"ゼロ",title:"すべてのカウンターには、繰り返し可能な参照が必要である。",body:"複数カウンターを備えたクロノグラフは、経過時間の表示を同時に返す必要がある。この拡大された単一キャムの例は、物理的な機構が電子機器なしにゼロを繰り返し見つけることができる理由を分離している。",focus:'heart'}],sources:[{label:"A. Lange & Söhne：ゼロリセット・ハートキャム原理",url:'https://www.alange-soehne.com/us-en/manufacture/art-of-watchmaking/double-tripple-rattrapante-mechanism'}]},
+{id:'date',name:"日付の変更",verb:"インデックス",title:"1日1回の駆動が31の位置のうち1つを進める。",intro:"基本的な日付表示は、1日1回の駆動とスプリングで位置を固定する要素によって制御される数字リングである。リングは1位置進み、その後ダイアルの窓に正確に並ぶようにしなければならない。",connection:"あなたのCarreraは、日付窓を6時位置に設けている。これは日付表示であり、年間または永続カレンダーではない。表示された日付は、短い月の後に修正が必要になる可能性がある。",principle:"1日付リングステップ = 360° / 31 ≈ 11.61°。",limitation:"この一般的なドライビングフィンガーとジャンパーの配置はインデックス化を示している。これはTH20-00の正確な日付変更タイミングまたは構造を確立しているわけではない。",parts:[{id:'ring',name:"31位置の日付リング",detail:"ダイアル内の固定された窓を越えて日付を進める。"},{id:'driver',name:"1日1回のドライビングフィンガー",detail:"1日1回の駆動が発生し、リングを進める（簡易例）。"},{id:'jumper',name:"ジャンパーおよびスプリング",detail:"変更の間、リングを位置づけ、数字が窓に丁寧に配置されるようにする。"},{id:'window',name:"固定ダイアル窓",detail:"一つの数字を表示しながら、その下のリングが移動する。"}],stages:[{name:"保持",title:"リングは特定された位置に落ち着く。",body:"スプリング付きのジャンパーがリングを安定した位置に保持している。これにより、小さな揺れが時計の目盛りを半分にまで動かすことは防がれる。",focus:'jumper'},{name:"操作",title:"日付の駆動部が次の歯に達する。",body:"例示された駆動指がリングに近づく。その際、位置決めスプリングのエネルギーを克服しなければ、日付は動かない。完全なインデックスイングイベントを確認するには「日付を進める」を選択する。",focus:'driver'},{name:"進める",title:"正確に一つの位置が選択される。",body:"リングは1/31の回転だけ進む。ジャンパーは上昇してから再び落ち着く。固定されたアペアランスにより、その回転運動は一つの数字が別の数字に置き換わる様子として見える。",focus:'ring'},{name:"繰り返す",title:"単純な日付リングは月を認識していない。",body:"31の次は1になる。基本的な機構には2月や30日を持つ月に関する情報は存在しない。このことから、正しい時刻表示と誤った日付が共存する理由が説明できる。",focus:'window'}],sources:[{label:"FHH: 日付およびカレンダー機構",url:fhh+'watchmaking-knowledge/encyclopedia/day-date'},{label:"TAG Heuer: Carrera 日付表示",url:'https://www.tagheuer.com/au/en/timepieces/collections/tag-heuer-carrera/39-mm-th20-00/CBS2216.BA0048.html'}]},
+{id:'jewels',name:"ジェルズ＆ベアリング",verb:"サポート",title:"非常に小さなピボットには硬く滑らかなベアリングが必要である。",intro:"回転部は細いステンレスシャフトに回転する。その端部はピボットと呼ばれるもので、ベアリングに座っている。合成ルビーは硬く摩耗に強い接触面を提供し、設計上必要な場所では潤滑が摩擦を管理する。",connection:"TH20-00は33個のジェルを備えています。この数は、機能的な支持部品およびエスカペメントの使用を含み、ダイアルの周囲に散らばった33個の装飾的な宝石とは異なります。",principle:"ジェルは動きを支えます。エネルギーを供給したり、単にカウントによって正確性を決定するものではありません。",limitation:"このセクションはピボットの直径、クリアランス、油の体積を過大評価しています。図示されているベアリングスタックおよびショックスプリングは一般的な構造です。",parts:[{id:'pivot',name:"ステンレス製ピボット",detail:"シャフトの小さな端部。その半径および表面粗さは、ベアリングにおける摩耗に影響を与えます。"},{id:'hole',name:"ホールジェル",detail:"シャフトを径方向に位置決めし、硬いベアリング面を提供します。"},{id:'cap',name:"キャップジェル",detail:"キャップベアリング構造において、シャフトの端部を軸方向に支持します。"},{id:'oil',name:"油膜",detail:"小さな、制御された潤滑量は摩耗を減少させます。油の量が多いほど必ずしも良いとは限りません。"},{id:'setting',name:"設定およびショックスプリング",detail:"ベアリングアセンブリを保持します。ショック保護設計では、衝撃時に一時的に変形することがあります。"}],stages:[{name:"位置決め",title:"ピボットはずれずに回転しなければなりません。",body:"ベアリングスタックを分離します。ホールジェルは側面の動きを制約し、キャップは端面接触を制御します。これらは異なる機械的機能です。",focus:'pivot'},{name:"潤滑",title:"作動インターフェースは非常に小さいです。",body:"拡大された油膜は機能的接触領域を示している。適切な潤滑材、量、配置が重要であり、運動中に油を過剰に供給することは走行を改善しない。",focus:'oil'},{name:"保護",title:"衝撃によって薄いピボットが過負荷を受ける可能性がある。",body:"スプリングを搭載したベアリングは衝撃時にわずかに移動し、その後元の位置に戻る。このように変位を管理することで、精密な部品を保護できるが、すべての部品が完全に剛性を持つ必要はない。",focus:'setting'},{name:"解釈",title:"関数の数を、地位や名誉よりも数えてほしい。",body:"一部のジェルは軸を支え、他のものは時計の振動機構との接触を形成する。その有用性は、どこで、どのように使用されているかに依存する。33個だけでは、時計の1日あたりの測定値を知ることができない。",focus:'hole'}],sources:[{label:"FHH：ジェルの機能",url:fhh+'watchmaking-knowledge/encyclopedia/jewel'},{label:"FHH：振動機構のパレット",url:fhh+'watchmaking-knowledge/encyclopedia/pallet'}]}
 ];
