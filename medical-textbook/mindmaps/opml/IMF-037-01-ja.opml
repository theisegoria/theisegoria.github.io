<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>037-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="抗微生物療法の基礎">
      <outline text="概説">
        <outline text="活性薬の部位到達と病原体の感受性">
          <outline text="感染源制御と宿主による排除"/>
        </outline>
        <outline text="症候群、予想微生物、耐性を統合">
          <outline text="アレルギー、臓器機能、妊娠、相互作用"/>
        </outline>
        <outline text="広範な経験的治療は救命も耐性選択も"/>
      </outline>
      <outline text="選択毒性と薬剤曝露">
        <outline text="細胞壁、リボソーム、ウイルス酵素、エルゴステロール"/>
        <outline text="選択性は相対的">
          <outline text="ミトコンドリア、真核の真菌、共有経路"/>
        </outline>
        <outline text="薬物動態は時間に伴う濃度"/>
        <outline text="薬力学は曝露量と殺菌の関係">
          <outline text="最小発育阻止濃度超過時間、最高濃度比、曲線下面積"/>
        </outline>
        <outline text="殺菌薬と静菌薬">
          <outline text="臨床効果の優劣は自動的に決まらない"/>
        </outline>
        <outline text="治療困難部位は移行性と感染源制御"/>
      </outline>
      <outline text="細胞壁に作用する抗菌薬">
        <outline text="ベータラクタム薬はペニシリン結合蛋白に結合">
          <outline text="ペプチドグリカン架橋破綻、時間依存性"/>
        </outline>
        <outline text="アレルギー表示は不正確なことが多い">
          <outline text="検査で安全な狭域薬を再使用"/>
        </outline>
        <outline text="耐性はベータラクタマーゼ、標的変化、排出">
          <outline text="阻害薬は全酵素を阻害しない"/>
          <outline text="基質特異性拡張型、AmpC、カルバペネマーゼ"/>
        </outline>
        <outline text="グリコペプチド系は前駆体結合、陽性菌">
          <outline text="バンコマイシンは有効性と腎毒性を監視"/>
          <outline text="経口薬は腸管内でのみ作用"/>
        </outline>
      </outline>
      <outline text="蛋白合成阻害薬">
        <outline text="アミノグリコシド系は30Sで誤翻訳">
          <outline text="好気性グラム陰性菌を濃度依存的に殺菌"/>
          <outline text="嫌気性菌は酸素依存性取り込みを欠く"/>
          <outline text="腎毒性、前庭・聴覚毒性"/>
        </outline>
        <outline text="テトラサイクリン系はアミノアシル転移リボ核酸遮断"/>
        <outline text="マクロライド系は50S上で転位阻害">
          <outline text="QT延長と相互作用"/>
        </outline>
        <outline text="クリンダマイシンは毒素産生を抑制">
          <outline text="ディフィシル感染症を強く誘発"/>
        </outline>
        <outline text="リネゾリドは翻訳開始を阻害">
          <outline text="長期で血球減少、神経障害、乳酸アシドーシス"/>
        </outline>
      </outline>
      <outline text="核酸および代謝阻害薬">
        <outline text="フルオロキノロン系はジャイレース等を阻害">
          <outline text="腱、神経、血糖、QT、ディフィシル"/>
          <outline text="耐性が生じやすく利便性で使わない"/>
        </outline>
        <outline text="リファマイシン系はリボ核酸ポリメラーゼを阻害">
          <outline text="結核単剤治療で急速に耐性化"/>
          <outline text="酵素誘導で多くの薬剤が変化"/>
        </outline>
        <outline text="スルホンアミドとトリメトプリムの葉酸遮断">
          <outline text="高カリウム血症、骨髄抑制、酵素欠損で溶血"/>
        </outline>
        <outline text="メトロニダゾールは低酸素で有毒中間体"/>
      </outline>
      <outline text="膜作用薬と特殊薬">
        <outline text="ダプトマイシンはサーファクタントで不活化">
          <outline text="肺炎には使用できない"/>
        </outline>
        <outline text="ニトロフラントインは尿中のみ濃縮"/>
        <outline text="結核は複数薬剤で治療">
          <outline text="大量で不均一な集団は耐性を選択"/>
        </outline>
      </outline>
      <outline text="耐性機序">
        <outline text="薬剤破壊、標的変化、流入低下、排出"/>
        <outline text="内因性、または変異と水平伝播で獲得"/>
        <outline text="バイオフィルムと持続生残細胞は耐容性"/>
        <outline text="併用は範囲拡大、相乗、耐性防止">
          <outline text="代償は毒性、拮抗、生態学的選択圧"/>
          <outline text="培養で必要性が明確なら狭域化"/>
        </outline>
      </outline>
      <outline text="抗ウイルス療法">
        <outline text="複製は早期ピーク、時期が重要"/>
        <outline text="抑制しても潜伏ゲノムは残る"/>
        <outline text="核酸類似体はゲノム合成を破綻">
          <outline text="高度免疫不全でヘルペス耐性増加"/>
        </outline>
        <outline text="ノイラミニダーゼ阻害薬は早期ほど有効"/>
        <outline text="HIV併用は耐性と伝播を防ぐ"/>
        <outline text="B型肝炎は抑制、C型肝炎は治癒可能"/>
      </outline>
      <outline text="抗真菌療法">
        <outline text="ポリエン系はエルゴステロールに結合">
          <outline text="アムホテリシンは注入反応、腎障害、カリウム喪失"/>
        </outline>
        <outline text="アゾール系はエルゴステロール合成阻害">
          <outline text="QT、肝毒性、チトクローム相互作用が異なる"/>
        </outline>
        <outline text="エキノキャンディン系はベータグルカン合成阻害"/>
        <outline text="フルシトシンは耐性が速く併用"/>
        <outline text="転帰は免疫回復と機器除去に依存"/>
        <outline text="定着は侵入ではない"/>
      </outline>
      <outline text="抗寄生虫療法と安全な処方">
        <outline text="マラリアは種、地域、重症度">
          <outline text="グルコース六リン酸脱水素酵素を確認"/>
        </outline>
        <outline text="蠕虫殺滅は炎症を誘発し得る"/>
        <outline text="免疫抑制前に糞線虫を治療">
          <outline text="過剰感染は致死的になり得る"/>
        </outline>
        <outline text="失敗は膿瘍、閉塞、機器、誤診">
          <outline text="長期治療が常によいわけではない"/>
        </outline>
        <outline text="条件が許せば静注から経口へ"/>
      </outline>
    </outline>
  </body>
</opml>
