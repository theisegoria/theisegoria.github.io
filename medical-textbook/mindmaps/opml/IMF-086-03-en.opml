<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>086-03 Nervous-system, craniofacial, sensory-organ development, and principles of teratology</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Neural, craniofacial, and sensory development and teratology">
      <outline text="Brain vesicles and forebrain">
        <outline text="Neural tube closes from cervical region"/>
        <outline text="Three primary brain vesicles">
          <outline text="Prosencephalon: telencephalon and diencephalon"/>
          <outline text="Rhombencephalon: metencephalon and myelencephalon"/>
        </outline>
        <outline text="Cavities become the ventricles"/>
        <outline text="Hemispheres smooth, later gyri and sulci"/>
        <outline text="Commissures cross lamina terminalis">
          <outline text="Anterior, hippocampal, then corpus callosum"/>
        </outline>
        <outline text="Optic vesicles: retina is central tissue"/>
        <outline text="Pituitary: diencephalon plus Rathke pouch">
          <outline text="Remnants form cysts or tumours"/>
        </outline>
      </outline>
      <outline text="Brainstem and cerebellum">
        <outline text="Midbrain: alar tectum, basal motor structures"/>
        <outline text="Pontine flexure opens fourth ventricle roof">
          <outline text="Alar plates displaced lateral to basal"/>
          <outline text="Sensory nuclei lateral to motor nuclei"/>
        </outline>
        <outline text="Cerebellar plates from rhombic lips"/>
        <outline text="Roof plate becomes choroid plexus"/>
        <outline text="Aqueduct or outlet obstruction: hydrocephalus"/>
      </outline>
      <outline text="Spinal cord and neurons">
        <outline text="Mantle layer grey, marginal layer white"/>
        <outline text="Alar dorsal sensory, basal ventral motor"/>
        <outline text="Neural crest: ganglia and Schwann cells"/>
        <outline text="Column outgrows cord, cauda equina forms">
          <outline text="Tethering causes traction with growth"/>
        </outline>
        <outline text="Radial glia guide inside-out migration"/>
        <outline text="Interneurons migrate tangentially"/>
        <outline text="Myelination, pruning, critical periods"/>
      </outline>
      <outline text="Face and palate">
        <outline text="Frontonasal, maxillary, mandibular prominences"/>
        <outline text="Nasal placodes invaginate into pits"/>
        <outline text="Maxillary plus medial nasal: lip, primary palate">
          <outline text="Fusion failure: cleft lip"/>
        </outline>
        <outline text="Palatal shelves grow, elevate, fuse">
          <outline text="Failure at any step: cleft palate"/>
        </outline>
      </outline>
      <outline text="Tongue, thyroid, and skull">
        <outline text="Tongue from several arch swellings">
          <outline text="Anterior: first arch, taste via chorda tympani"/>
          <outline text="Posterior: third arch, glossopharyngeal"/>
          <outline text="Muscles: occipital myoblasts, hypoglossal"/>
        </outline>
        <outline text="Thyroid descends via thyroglossal duct">
          <outline text="Midline cyst moves with swallowing"/>
          <outline text="Ectopic tissue along the route"/>
        </outline>
        <outline text="Parathyroids and thymus from pouches"/>
        <outline text="Membranous bones, sutures, fontanelles"/>
        <outline text="Premature suture fusion">
          <outline text="Restricts growth perpendicular to suture"/>
        </outline>
      </outline>
      <outline text="Eye">
        <outline text="Optic vesicle induces lens placode"/>
        <outline text="Optic cup: pigment epithelium, neural retina"/>
        <outline text="Choroidal fissure must close">
          <outline text="Failure causes coloboma"/>
        </outline>
        <outline text="Cornea: surface ectoderm and neural crest"/>
        <outline text="Lens fibres elongate and lose nuclei"/>
      </outline>
      <outline text="Ear">
        <outline text="Otic placode invaginates into otic vesicle">
          <outline text="Cochlear duct, utricle, saccule, canals"/>
        </outline>
        <outline text="First pouch: middle ear and auditory tube"/>
        <outline text="Ossicles from first and second arches"/>
        <outline text="Auricle from six hillocks"/>
        <outline text="Ear anomalies may signal linked conditions">
          <outline text="Isolated minor variants often benign"/>
        </outline>
      </outline>
      <outline text="Teratogen principles and timing">
        <outline text="Dose, timing, metabolism, placenta, genotype"/>
        <outline text="Untreated maternal disease may harm more"/>
        <outline text="Preimplantation: loss or compensation"/>
        <outline text="Weeks three to eight: major malformations"/>
        <outline text="Later: growth, maturation, brain function"/>
      </outline>
      <outline text="Specific exposures and causation">
        <outline text="Alcohol: no proven safe threshold"/>
        <outline text="Retinoids disrupt neural-crest structures"/>
        <outline text="Valproate risk versus seizure control"/>
        <outline text="Infection: destruction, inflammation, vessels"/>
        <outline text="Maternal antibodies cross late in gestation"/>
        <outline text="Folate modifies neural-tube risk"/>
        <outline text="Causation: phenotype, timing, dose response"/>
      </outline>
      <outline text="Counselling and prevention">
        <outline text="Absolute versus relative risk"/>
        <outline text="Abrupt stopping can be dangerous"/>
        <outline text="Preconception control, folate, vaccination"/>
        <outline text="Link lineage, event, and time window"/>
      </outline>
    </outline>
  </body>
</opml>
