<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>079-01 骨盤骨格、骨盤壁、骨盤底、筋膜、血管、神経</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="骨盤骨格、壁、底、筋膜、血管、神経">
      <outline text="骨盤輪">
        <outline text="寛骨は寛骨臼で腸骨・坐骨・恥骨が癒合"/>
        <outline text="前方で恥骨結合、後方で仙腸関節">
          <outline text="輪のため一か所の破綻で別部位も探す"/>
        </outline>
        <outline text="骨盤縁が大骨盤と小骨盤を分ける">
          <outline text="入口は骨盤縁の面"/>
          <outline text="出口は恥骨弓、坐骨結節、仙結節、尾骨"/>
        </outline>
        <outline text="仙棘・仙結節靱帯">
          <outline text="切痕を孔へ変える"/>
          <outline text="仙骨回旋へ抵抗する"/>
        </outline>
        <outline text="仙腸関節は前方滑膜と後方靱帯結合">
          <outline text="荷重が楔のように仙骨を押す"/>
        </outline>
        <outline text="骨盤輪損傷は外力と安定性で記述">
          <outline text="前後圧迫は結合・仙腸構造を開く"/>
          <outline text="側方圧迫は片側骨盤を座屈させる"/>
          <outline text="垂直剪断は後方支持を破壊する"/>
          <outline text="海綿骨、静脈叢、動脈枝から出血"/>
          <outline text="尿道、膀胱、直腸、神経叢、血管も評価"/>
        </outline>
        <outline text="恥骨結合は二次軟骨結合">
          <outline text="妊娠拡大は軽度、外傷は不安定化"/>
        </outline>
      </outline>
      <outline text="寸法と変異">
        <outline text="入口、中骨盤、出口は出産に影響">
          <outline text="一つの計測で分娩力学を予測できない"/>
          <outline text="胎児頭変形、位置、軟部組織、子宮力"/>
        </outline>
        <outline text="性発達関連の平均差は重なる">
          <outline text="年齢、祖先、身長、活動、栄養"/>
          <outline text="身分でなく臨床的問いに答える"/>
        </outline>
        <outline text="産科的真結合線は直接測れない">
          <outline text="対角結合線で推定する"/>
        </outline>
        <outline text="坐骨棘間径は中骨盤の主要横径"/>
      </outline>
      <outline text="側壁と後壁">
        <outline text="側壁は閉鎖膜、内閉鎖筋">
          <outline text="閉鎖管から大腿内側へ"/>
        </outline>
        <outline text="後壁は仙骨、尾骨、梨状筋、靱帯"/>
        <outline text="梨状筋が大坐骨孔を上下に分ける">
          <outline text="上方は上臀血管・神経"/>
          <outline text="下方は坐骨、下臀、陰部"/>
        </outline>
        <outline text="陰部神経は坐骨棘を回る">
          <outline text="神経ブロックを可能にする"/>
          <outline text="出産・骨盤手術で脆弱"/>
        </outline>
      </outline>
      <outline text="骨盤隔膜">
        <outline text="肛門挙筋、尾骨筋、筋膜"/>
        <outline text="恥骨直腸、恥骨尾骨、腸骨尾骨部"/>
        <outline text="恥骨直腸筋が移行部をU字に囲む">
          <outline text="安静時の直腸肛門角を保つ"/>
          <outline text="排便時に弛緩する"/>
        </outline>
        <outline text="肛門挙筋は内臓支持、腹圧に抵抗"/>
        <outline text="裂孔は尿道、腟、肛門直腸管を通す">
          <outline text="必要な弱点で荷重により変化"/>
        </outline>
        <outline text="仙骨神経叢直接枝、括約筋に陰部神経"/>
        <outline text="筋緊張過剰は疼痛・排泄困難"/>
        <outline text="筋力低下は脱出・失禁"/>
      </outline>
      <outline text="骨盤内筋膜と支持">
        <outline text="壁側筋膜は壁、臓側筋膜は臓器"/>
        <outline text="疎な結合組織面は充満と剝離を許す">
          <outline text="血管と疾患拡大も通す"/>
        </outline>
        <outline text="基靱帯・仙骨子宮靱帯は頸と上部腟"/>
        <outline text="恥骨前立腺・恥骨膀胱靱帯は膀胱頸"/>
        <outline text="会陰体は中心線維筋性結節">
          <outline text="損傷は後腟壁と禁制支持を損なう"/>
        </outline>
        <outline text="脱出は複数要素の支持破綻">
          <outline text="見える下降は症状と一致しない"/>
          <outline text="孤立欠損でなく統合支持を修復"/>
        </outline>
      </outline>
      <outline text="内腸骨血管">
        <outline text="後区は腸腰、外側仙骨、上臀動脈"/>
        <outline text="前区は骨盤内臓、会陰、臀部"/>
        <outline text="正中を越え広く吻合"/>
        <outline text="子宮動脈は尿管上方を横切る"/>
        <outline text="死冠は上恥骨枝を横切る"/>
        <outline text="弁のない静脈叢">
          <outline text="椎骨静脈叢と交通"/>
          <outline text="つぶれにくく出血はびまん性"/>
        </outline>
      </outline>
      <outline text="体性・自律神経">
        <outline text="梨状筋上の仙骨神経叢">
          <outline text="腫瘤、分娩、手術で複数神経障害"/>
        </outline>
        <outline text="交感線維は下腹神経叢を経る"/>
        <outline text="S2からS4の副交感性骨盤内臓神経"/>
        <outline text="S2からS4の体性陰部神経">
          <outline text="同じ根でも混同しない"/>
        </outline>
        <outline text="骨盤痛線">
          <outline text="上方は交感神経、胸腰髄へ"/>
          <outline text="下方は副交感神経、仙髄へ"/>
        </outline>
      </outline>
      <outline text="骨盤空間">
        <outline text="恥骨後隙は手術進入路"/>
        <outline text="膀胱傍・直腸傍隙は血管、神経、尿管"/>
        <outline text="仙骨前隙は自律神経叢、血管"/>
        <outline text="腹膜外出血は広範に広がる"/>
        <outline text="感染・腫瘍は筋膜面に沿う"/>
        <outline text="画像で側壁、床、腹膜、尿管を同定"/>
      </outline>
    </outline>
  </body>
</opml>
