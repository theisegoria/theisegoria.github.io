<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>056-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="耳鼻咽喉、聴覚、平衡感覚、発声、嚥下">
      <outline text="概説と危険徴候">
        <outline text="狭い領域に多機能が集中">
          <outline text="わずかな腫脹で気流閉塞"/>
          <outline text="感染は眼窩、頭蓋底、深頸部、脳へ"/>
        </outline>
        <outline text="喘鳴、流涎、呼吸努力を認識"/>
        <outline text="拡大する頸部腫脹、重度出血"/>
        <outline text="突発性感音難聴、中枢性めまい"/>
      </outline>
      <outline text="聴覚生理と病歴・診察">
        <outline text="耳小骨は振動を内耳液へ伝達・増幅"/>
        <outline text="基底膜が有毛細胞の不動毛を曲げる">
          <outline text="機械的エネルギーを聴神経信号へ"/>
        </outline>
        <outline text="高周波は基底部、低周波は頂部"/>
        <outline text="脳幹は両側入力で音源定位"/>
        <outline text="伝音難聴は外耳・中耳の伝達障害"/>
        <outline text="感音難聴は蝸牛、聴神経、中枢経路"/>
        <outline text="突発性感音難聴は耳科的緊急疾患">
          <outline text="時間依存性のコルチコステロイド治療"/>
        </outline>
        <outline text="聴力検査で気導・骨導・語音弁別">
          <outline text="音叉検査は代わりにならない"/>
        </outline>
      </outline>
      <outline text="外耳および中耳疾患">
        <outline text="外耳炎は湿気・外傷後に多い">
          <outline text="耳珠の圧痛、掻痒、耳漏"/>
          <outline text="清掃と局所抗微生物薬"/>
        </outline>
        <outline text="糖尿病での侵襲性頭蓋底感染">
          <outline text="緊急画像と全身性抗緑膿菌治療"/>
        </outline>
        <outline text="急性中耳炎は耳管機能障害に続く">
          <outline text="膨隆した鼓膜と中耳貯留液"/>
          <outline text="鎮痛が中心、抗菌薬は条件次第"/>
        </outline>
        <outline text="持続貯留液は言語発達に影響"/>
        <outline text="真珠腫は拡大する角化上皮">
          <outline text="骨びらん、顔面神経麻痺、頭蓋内感染"/>
          <outline text="根治治療は通常手術"/>
        </outline>
        <outline text="穿孔では汚染水と耳毒性点耳薬を避ける"/>
      </outline>
      <outline text="耳鳴と聴覚リハビリテーション">
        <outline text="外部音源なしに知覚される音"/>
        <outline text="一側性、非対称、拍動性は要検査">
          <outline text="拍動性は血流か頭蓋内圧亢進"/>
        </outline>
        <outline text="非拍動性の多くは難聴に伴う">
          <outline text="補聴器、音響療法、認知行動的対応"/>
          <outline text="万能の治療法を約束しない"/>
        </outline>
        <outline text="加齢性・騒音性難聴は高周波を障害"/>
        <outline text="重度難聴では人工内耳が聴神経を刺激"/>
      </outline>
      <outline text="前庭生理と回転性めまい">
        <outline text="半規管は角加速度を検出"/>
        <outline text="卵形囊・球形囊は直線加速度と重力"/>
        <outline text="回転性めまいは運動の錯覚">
          <outline text="前失神や平衡障害も含まれ得る"/>
        </outline>
        <outline text="耳石移動による良性発作性頭位めまい症">
          <outline text="潜時と減衰を伴う頭位眼振"/>
          <outline text="耳石置換法で治療"/>
        </outline>
        <outline text="前庭神経炎は聴力保持、迷路炎は蝸牛症状"/>
        <outline text="メニエール病は発作性めまいと変動性難聴"/>
        <outline text="脳卒中は末梢前庭疾患に似る">
          <outline text="熟練者の頭部インパルス・眼振・斜偏位"/>
          <outline text="激しい頭痛、起立不能、垂直性眼振"/>
        </outline>
        <outline text="抑制薬は短期、早期離床"/>
      </outline>
      <outline text="鼻および副鼻腔">
        <outline text="鼻腔は加温、加湿、濾過"/>
        <outline text="アレルギーは掻痒、くしゃみ、水様性鼻漏">
          <outline text="生理食塩水、鼻腔内コルチコステロイド"/>
        </outline>
        <outline text="局所充血除去薬で反跳性鼻閉"/>
        <outline text="急性鼻副鼻腔炎の多くはウイルス性">
          <outline text="眼窩・頭蓋内への波及は緊急"/>
        </outline>
        <outline text="前方鼻出血は前傾し鼻翼をつまむ">
          <outline text="後方出血は専門的止血"/>
        </outline>
        <outline text="片側症状は悪性腫瘍を示し得る"/>
      </outline>
      <outline text="咽頭、扁桃、および深頸部感染">
        <outline text="咽頭炎の多くはウイルス性、選択的検査"/>
        <outline text="伝染性単核球症では脆弱な脾臓を守る">
          <outline text="アレルギーなしのアミノペニシリン発疹"/>
        </outline>
        <outline text="扁桃周囲膿瘍は開口障害、口蓋垂偏位"/>
        <outline text="咽後感染は気道を脅かす"/>
        <outline text="ルートヴィヒアンギーナは舌を挙上">
          <outline text="早期気道確保、抗菌薬、排液"/>
        </outline>
      </outline>
      <outline text="発声、喉頭、および気道">
        <outline text="嗄声は喉頭炎からがんまで">
          <outline text="持続や警告所見で喉頭鏡検査"/>
        </outline>
        <outline text="喘鳴は緊急徴候">
          <outline text="吸気性は胸郭外閉塞"/>
          <outline text="二相性は声門・声門下狭窄"/>
        </outline>
        <outline text="落ち着かせ、酸素、気道専門家"/>
        <outline text="アドレナリン、異物除去、外科的気道"/>
      </outline>
      <outline text="嚥下">
        <outline text="口腔、咽頭、括約筋、食道の協調"/>
        <outline text="障害で咳、湿性嗄声、反復性肺炎"/>
        <outline text="ベッドサイドスクリーニングはリスク推定のみ">
          <outline text="不顕性誤嚥には機器評価"/>
        </outline>
        <outline text="姿勢、食形態、リハビリテーション、口腔ケア"/>
        <outline text="増粘液は水分摂取を損ない得る"/>
      </outline>
    </outline>
  </body>
</opml>
