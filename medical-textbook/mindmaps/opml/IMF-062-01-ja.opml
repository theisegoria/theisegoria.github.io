<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>062-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="集中治療の基礎">
      <outline text="概説と認識">
        <outline text="生理を支え、原因治療し、害を予防"/>
        <outline text="臓器不全は相互に作用する">
          <outline text="換気は循環を変える"/>
          <outline text="ショックは腎臓と脳を傷害する"/>
          <outline text="不動は呼吸筋を弱らせる"/>
        </outline>
        <outline text="目標、再評価、最小侵襲、多職種連携"/>
        <outline text="単一スコアより傾向と懸念"/>
        <outline text="支援を呼びつつ気道から全身曝露を評価"/>
        <outline text="監視は明確な問いに答える">
          <outline text="ラインと採血は感染と貧血を起こす"/>
        </outline>
      </outline>
      <outline text="酸素生理と投与">
        <outline text="酸素運搬量は心拍出量と酸素含量の積">
          <outline text="含量の大部分はヘモグロビン結合酸素"/>
          <outline text="正常飽和度でも貧血や低血流を補えない"/>
        </outline>
        <outline text="運搬低下で抽出率が上がる">
          <outline text="不均衡持続で乳酸、臓器障害、細胞死"/>
        </outline>
        <outline text="乳酸は酸素量を直接示す計器でない"/>
        <outline text="過剰酸素は無気肺と酸化傷害を起こす"/>
        <outline text="鼻カニューレは低流量、ベンチュリーは制御濃度"/>
        <outline text="高流量は死腔再呼吸と仕事量を減らす"/>
        <outline text="オキシメトリーは灌流、色素、異常ヘモグロビン"/>
      </outline>
      <outline text="非侵襲的呼吸補助">
        <outline text="持続気道陽圧は肺胞を開き後負荷を低下"/>
        <outline text="二相性陽圧は吸気補助を追加"/>
        <outline text="心原性肺水腫と高二酸化炭素性増悪に強い"/>
        <outline text="気道保護不能や嘔吐では危険"/>
        <outline text="数分から数時間以内に再評価">
          <outline text="酸血症、呼吸数、意識の悪化は失敗"/>
          <outline text="不成功の長い試行は気道確保を遅らせる"/>
        </outline>
      </outline>
      <outline text="挿管と侵襲的換気">
        <outline text="挿管は生理学的処置でもある">
          <outline text="陽圧前に低血圧を是正"/>
          <outline text="陽圧換気は静脈還流を減らす"/>
        </outline>
        <outline text="迅速導入は誤嚥リスク時間を制限"/>
        <outline text="持続する呼気二酸化炭素で確認"/>
        <outline text="一回換気量と呼吸数で二酸化炭素排出"/>
        <outline text="吸入酸素と呼気終末陽圧で酸素化"/>
        <outline text="モード名より目標と同調性"/>
      </outline>
      <outline text="肺保護と急性呼吸窮迫症候群">
        <outline text="過剰伸展、圧、反復開閉による損傷"/>
        <outline text="予測体重で一回換気量を設定">
          <outline text="肺の大きさは身長と性に従う"/>
        </outline>
        <outline text="プラトー圧と駆動圧を制限"/>
        <outline text="呼気終末陽圧で虚脱を防ぐ"/>
        <outline text="心不全で説明できない両側陰影">
          <outline text="低一回換気量、ショック後の保守的輸液"/>
          <outline text="重症例には腹臥位"/>
        </outline>
        <outline text="許容性高二酸化炭素血症は頭蓋内圧亢進に不適"/>
      </outline>
      <outline text="同調性と離脱">
        <outline text="興奮は疼痛、せん妄、分泌物を反映"/>
        <outline text="鎮静強化の前に原因を治療"/>
        <outline text="鎮痛優先の浅い鎮静"/>
        <outline text="離脱には原因改善と気道保護が必要"/>
        <outline text="自発呼吸試験は統合的予備力を評価">
          <outline text="上気道閉塞が残れば抜管は安全でない"/>
        </outline>
        <outline text="高リスク例は高流量か非侵襲的補助"/>
      </outline>
      <outline text="ショックと心血管補助">
        <outline text="容量低下、ポンプ不全、血管拡張、閉塞"/>
        <outline text="中心静脈圧は輸液反応性を予測しない"/>
        <outline text="輸液負荷は量、反応、停止基準を持つ">
          <outline text="過剰輸液はガス交換と回復を損なう"/>
        </outline>
        <outline text="分布異常性ショックの第一選択はノルアドレナリン"/>
        <outline text="低心拍出が続けば強心薬">
          <outline text="不整脈と酸素需要の増加"/>
        </outline>
        <outline text="感染源制御などで機序を治療"/>
      </outline>
      <outline text="腎および代謝補助">
        <outline text="利尿薬はネフロンを回復させない"/>
        <outline text="腎代替療法はクレアチニンでなく合併症で"/>
        <outline text="間欠的透析は速く、持続療法は不安定例"/>
        <outline text="低血糖を避け、厳格すぎる管理は有害"/>
        <outline text="腸が機能すれば早期経腸栄養"/>
        <outline text="ステロイドは副腎不全と難治性敗血症"/>
      </outline>
      <outline text="神経集中治療">
        <outline text="瞳孔、運動反応、鎮静中断で評価"/>
        <outline text="頭蓋内圧は低酸素と低血圧で悪化"/>
        <outline text="短時間過換気はヘルニアへの橋渡し"/>
        <outline text="重積はベンゾジアゼピン後に長時間薬"/>
        <outline text="非痙攣性発作に脳波検査"/>
        <outline text="脳死判定は正式な法的過程"/>
      </outline>
      <outline text="感染予防、せん妄、長期転帰">
        <outline text="培養のため抗菌薬を遅らせない"/>
        <outline text="発熱は薬剤、血栓症、輸血でも生じる"/>
        <outline text="器具抜去を毎日見直す"/>
        <outline text="せん妄は変動する注意・認知障害">
          <outline text="ベンゾジアゼピンと抗コリン薬を最小化"/>
        </outline>
        <outline text="期間限定の治療試行と見直し時点"/>
        <outline text="生存者の筋力低下、認知障害、苦痛"/>
      </outline>
    </outline>
  </body>
</opml>
