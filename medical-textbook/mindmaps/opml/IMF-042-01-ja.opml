<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>042-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="小児・新生児の生理学と評価">
      <outline text="小児は小さな成人ではない">
        <outline text="解剖、薬物、疾患、測定値は発達で変化"/>
        <outline text="予備能が限られ急速に進行">
          <outline text="気道径、体液、ブドウ糖、心肺予備能"/>
        </outline>
        <outline text="外観、呼吸、循環、経過から評価"/>
        <outline text="家族中心ケアで本人の声と同意を守る"/>
      </outline>
      <outline text="出生時の移行">
        <outline text="胎盤でガス交換、短絡で肺を迂回"/>
        <outline text="含気で肺血管抵抗が低下"/>
        <outline text="臍帯結紮で体血管抵抗が上昇"/>
        <outline text="左房圧上昇、短絡が機能的閉鎖"/>
        <outline text="肺、心臓、感染、低体温、代謝で障害"/>
        <outline text="動脈管依存病変は閉鎖で悪化">
          <outline text="プロスタグランジンで開存維持"/>
          <outline text="無呼吸があり専門的支援を要する"/>
        </outline>
        <outline text="蘇生は保温、体位、乾燥、次に換気">
          <outline text="心拍数の反応が換気成功を示す"/>
          <outline text="圧迫と薬剤より肺膨張が先"/>
        </outline>
      </outline>
      <outline text="新生児の生理的予備能">
        <outline text="大きな体表面積と薄い皮膚で熱喪失"/>
        <outline text="褐色脂肪は酸素とブドウ糖を消費">
          <outline text="低体温で呼吸窮迫・低血糖・アシドーシス悪化"/>
        </outline>
        <outline text="ブドウ糖は胎盤から哺乳と内因性産生へ">
          <outline text="早産、胎児発育不全、母体糖尿病"/>
          <outline text="無症状、振戦様運動、無呼吸、発作"/>
        </outline>
        <outline text="エリスロポエチン低下でヘモグロビン減少"/>
      </outline>
      <outline text="新生児黄疸と哺乳">
        <outline text="赤血球代謝回転が多く抱合は未熟"/>
        <outline text="生理的黄疸は生後一日以降"/>
        <outline text="危険徴候：一日以内、急上昇、淡色便">
          <outline text="溶血、感染、肝疾患、閉塞"/>
        </outline>
        <outline text="非抱合型ビリルビンは脳へ移行">
          <outline text="急性ビリルビン脳症または核黄疸"/>
          <outline text="早産、アシドーシス、アルブミン結合低下"/>
        </outline>
        <outline text="光線療法で排泄可能な形へ"/>
        <outline text="抱合型黄疸は決して生理的でない"/>
        <outline text="哺乳は吸着、尿便、体重で評価">
          <outline text="過剰な体重減少で高ナトリウム血症性脱水"/>
          <outline text="非難せず障壁を同定"/>
        </outline>
      </outline>
      <outline text="成長と発達">
        <outline text="一回の百分位より連続した成長速度"/>
        <outline text="成長不良：摂取、喪失、需要、養育放棄"/>
        <outline text="発達指標は範囲で締め切りではない"/>
        <outline text="退行は孤立した軽度遅延より懸念"/>
        <outline text="聴覚・視覚障害は全般性遅滞に見える"/>
        <outline text="原因確定前の早期介入"/>
      </outline>
      <outline text="年齢特異的生理">
        <outline text="柔らかい胸壁、狭い気道、高い酸素消費">
          <outline text="気道半径の小さな減少で抵抗急増"/>
        </outline>
        <outline text="陥没呼吸、鼻翼呼吸、呻吟、頭部上下運動"/>
        <outline text="チアノーゼは晩期で皮膚色に左右"/>
        <outline text="乳児の心拍出量は心拍数に依存">
          <outline text="徐脈は低酸素を反映し不吉"/>
        </outline>
        <outline text="総体水分量が多く急速に脱水"/>
        <outline text="血管収縮でショック後期まで血圧維持">
          <outline text="頻脈、再充満遅延、尿量減少が先行"/>
        </outline>
      </outline>
      <outline text="栄養と予防接種">
        <outline text="母乳または適切に調製した人工乳"/>
        <outline text="欠乏は身体所見より先に発達を障害">
          <outline text="鉄、ビタミンD、ビタミンB12"/>
        </outline>
        <outline text="肥満と欠乏は併存し得る"/>
        <outline text="予防接種は曝露前に免疫記憶"/>
        <outline text="軽症疾患で延期はほぼ不要"/>
        <outline text="重度免疫不全・妊娠で生ワクチン注意"/>
      </outline>
      <outline text="病歴、観察、診察">
        <outline text="まず離れた位置から観察">
          <outline text="静かで動かない小児はより懸念"/>
        </outline>
        <outline text="出産、発達、社会環境を含む病歴"/>
        <outline text="思春期の患者には個別に尋ねる"/>
        <outline text="養育者は普段との差に先に気づく"/>
        <outline text="侵襲性の低い診察から高いものへ"/>
        <outline text="酸素飽和度を小児の状態と照合"/>
      </outline>
      <outline text="急性症候群と蘇生">
        <outline text="クループ：安静時喘鳴は重症"/>
        <outline text="流涎、起坐位：刺激を最小限に"/>
        <outline text="胆汁性嘔吐は閉塞を示唆"/>
        <outline text="発熱のリスクは年齢に依存">
          <outline text="解熱薬は熱性けいれんを予防しない"/>
        </outline>
        <outline text="低酸素が心停止の原因となることが多い"/>
        <outline text="体重に基づき反復評価する輸液"/>
        <outline text="実測体重で投与し独立に確認">
          <outline text="小数点と単位の誤りは重大な危険"/>
        </outline>
      </outline>
      <outline text="セーフガーディングとコミュニケーション">
        <outline text="病歴の不一致、説明できない損傷、遅延"/>
        <outline text="非移動乳児の皮下出血、熱傷、骨折"/>
        <outline text="保護を遅らせず類似病態も考える"/>
        <outline text="発言を正確に、非難せず記録"/>
        <outline text="賛意を求め、守れない約束をしない"/>
      </outline>
    </outline>
  </body>
</opml>
