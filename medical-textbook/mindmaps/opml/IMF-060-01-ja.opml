<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>060-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="職業、旅行、集団の感染リスク">
      <outline text="概説">
        <outline text="暮らし、仕事、旅行、集まる場所が疾患を形成"/>
        <outline text="曝露評価は患者を環境・状況と結ぶ"/>
        <outline text="同じ症状でも鑑別が異なる">
          <outline text="鉱業、農業、避難生活、飛行、淡水接触"/>
        </outline>
        <outline text="個人保護と集団発生の認識"/>
      </outline>
      <outline text="職業歴">
        <outline text="職種名だけでは不十分">
          <outline text="作業、材料、粉塵、煙霧、微生物"/>
        </outline>
        <outline text="強度、頻度、期間、潜伏期間"/>
        <outline text="勤務中または休暇中との関係"/>
        <outline text="吸入、皮膚、摂取、接種"/>
        <outline text="記載限界値は安全の証明でない"/>
        <outline text="仕事は一般的疾患を悪化させる"/>
        <outline text="客観的記録と同意">
          <outline text="収入、補償、他の労働者に影響"/>
        </outline>
        <outline text="除去と代替は防護具より上位"/>
      </outline>
      <outline text="職業性呼吸器疾患">
        <outline text="刺激性煙霧：気管支攣縮、肺水腫"/>
        <outline text="職業性喘息：感作または刺激">
          <outline text="勤務中と非勤務中の連続最大呼気流量"/>
          <outline text="感作物質の早期除去で予後改善"/>
        </outline>
        <outline text="シリカ：結節性線維化">
          <outline text="自己免疫、がん、結核"/>
        </outline>
        <outline text="長い潜伏期間後のアスベスト疾患">
          <outline text="喫煙が肺がんリスクを相乗的に増加"/>
        </outline>
        <outline text="線維化は一般に不可逆的">
          <outline text="曝露管理とサーベイランス"/>
        </outline>
        <outline text="過敏性肺臓炎：吸入抗原への免疫反応">
          <outline text="抗原回避が中心"/>
        </outline>
      </outline>
      <outline text="皮膚、筋骨格、物理的危険因子">
        <outline text="刺激性接触皮膚炎：累積バリア損傷"/>
        <outline text="アレルギー性：遅延型過敏反応">
          <outline text="分布と時間経過がパッチテストを導く"/>
        </outline>
        <outline text="手袋は密閉、刺激、アレルギーを起こす"/>
        <outline text="筋骨格：力、反復、姿勢、回復不足">
          <outline text="長期の完全安静は回復を悪化"/>
        </outline>
        <outline text="騒音：不可逆的な高周波難聴"/>
        <outline text="手腕振動：血管性蒼白、神経障害"/>
        <outline text="放射線：時間、距離、遮蔽、線量測定"/>
      </outline>
      <outline text="針刺しおよび生物学的曝露">
        <outline text="洗浄、絞らない、直ちに報告"/>
        <outline text="体液、経路、器材、感染源の状態"/>
        <outline text="ヒト免疫不全ウイルス予防は早期に">
          <outline text="専門的再評価後に継続または中止"/>
        </outline>
        <outline text="B型肝炎：抗体に応じワクチン等"/>
        <outline text="C型肝炎：予防薬なし、追跡検査"/>
        <outline text="安全器材、リキャップ禁止、ワクチン"/>
        <outline text="医療従事者の呼吸器・エアロゾル曝露"/>
      </outline>
      <outline text="渡航前評価">
        <outline text="目的地、季節、活動、健康でリスク決定"/>
        <outline text="ワクチンシリーズのため早めに開始"/>
        <outline text="生ワクチンは妊娠・免疫抑制で危険"/>
        <outline text="マラリア：蚊の回避と化学予防">
          <outline text="完全に予防できる方法はない"/>
          <outline text="除外まで発熱は緊急事態"/>
        </outline>
        <outline text="昼間吸血：デング、チクングニア、ジカ"/>
        <outline text="デング熱：解熱期前後の漏出とショック">
          <outline text="除外まで非ステロイド性抗炎症薬を避ける"/>
        </outline>
        <outline text="下痢：経口補水が中心">
          <outline text="侵襲性赤痢では腸運動抑制薬を避ける"/>
        </outline>
        <outline text="高度：緩徐な上昇">
          <outline text="運動失調・意識混乱は高地脳浮腫"/>
          <outline text="下降と酸素が優先"/>
        </outline>
      </outline>
      <outline text="帰国旅行者">
        <outline text="旅程、日付、曝露、予防薬"/>
        <outline text="潜伏期間が鑑別を絞る"/>
        <outline text="発熱：マラリア、デング熱、腸チフスなど"/>
        <outline text="好酸球増加は初期に欠くことがある"/>
        <outline text="高危険度病原体は検査室へ連絡"/>
        <outline text="二週間超の下痢：原虫"/>
        <outline text="旅行ラベルで普遍的疾患を見落とさない"/>
      </outline>
      <outline text="移住、避難、健康格差">
        <outline text="出身国は生物学的診断ではない"/>
        <outline text="訓練された通訳"/>
        <outline text="同意の上で個人リスクに応じ検査"/>
        <outline text="開示を強制しないトラウマ配慮ケア"/>
        <outline text="感染対策をスティグマにしない"/>
      </outline>
      <outline text="集団発生と公衆衛生">
        <outline text="予想超過、まれな疾患は一例でも対応"/>
        <outline text="症例定義と人・場所・時間"/>
        <outline text="隔離は感染性症例を分離"/>
        <outline text="検疫は曝露者を制限"/>
        <outline text="直ちに公衆衛生当局へ届出"/>
        <outline text="有効な最小限の制限"/>
        <outline text="ワンヘルス：人、動物、環境"/>
      </outline>
    </outline>
  </body>
</opml>
