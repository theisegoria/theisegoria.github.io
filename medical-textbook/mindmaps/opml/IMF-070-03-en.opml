<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>070-03 Management, monitoring, prevention, safety, ethics, systems issues, and longitudinal care</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Paediatric management and longitudinal care">
      <outline text="Aims of paediatric management">
        <outline text="Relieve illness, protect development"/>
        <outline text="Adapt doses, devices, consent to age"/>
        <outline text="Prevention shapes decades of outcome"/>
      </outline>
      <outline text="Safe prescribing">
        <outline text="Dose from accurate current weight">
          <outline text="Check adult maximum, concentration, route"/>
        </outline>
        <outline text="Per-dose vs per-day confusion causes errors"/>
        <outline text="Record calculated and administered dose">
          <outline text="Avoid trailing zeros, ambiguous decimals"/>
        </outline>
        <outline text="Immature infant pharmacokinetics">
          <outline text="Body water, binding, liver enzymes, clearance"/>
        </outline>
        <outline text="Obesity: actual, ideal, or adjusted weight">
          <outline text="Calculator cannot choose the weight scalar"/>
        </outline>
        <outline text="Liquids: prescribe mass and volume">
          <outline text="Oral syringe, demonstration, teach-back"/>
        </outline>
        <outline text="Reconcile over-the-counter and shared drugs"/>
        <outline text="Pain assessed with developmental tools">
          <outline text="Presence, distraction, topical anaesthesia"/>
          <outline text="Replace restraint with analgesia, sedation"/>
        </outline>
      </outline>
      <outline text="Fluids and nutrition">
        <outline text="Oral rehydration: glucose-sodium cotransport">
          <outline text="Small frequent amounts overcome vomiting"/>
        </outline>
        <outline text="Isotonic intravenous fluid for shock"/>
        <outline text="Maintenance separate from deficit and losses"/>
        <outline text="Hypotonic fluid plus non-osmotic ADH">
          <outline text="Hospital-acquired hyponatraemia"/>
        </outline>
        <outline text="Formula concentration">
          <outline text="Over-dilution: malnutrition, hyponatraemia"/>
          <outline text="Over-concentration: dehydration, solute load"/>
        </outline>
        <outline text="Complementary foods: iron, texture, allergens"/>
        <outline text="Refeeding: phosphate, potassium, thiamine"/>
      </outline>
      <outline text="Vaccination and stewardship">
        <outline text="Check the actual vaccination record"/>
        <outline text="Interrupted schedules: catch-up, not restart"/>
        <outline text="Live vaccines: immunosuppression, pregnancy"/>
        <outline text="Temporal association is not causation"/>
        <outline text="No antibiotic benefit in viral illness">
          <outline text="Culture without delaying urgent therapy"/>
          <outline text="Narrowest effective agent, written stop date"/>
          <outline text="Repeat courses delay asthma, foreign body"/>
        </outline>
      </outline>
      <outline text="Anticipatory guidance">
        <outline text="Infancy: safe sleep, smoke avoidance"/>
        <outline text="Mobility: choking, poisoning, water, falls"/>
        <outline text="Adolescence: sexual health, substances, mood"/>
        <outline text="Tie advice to family resources"/>
      </outline>
      <outline text="Development, disability, school">
        <outline text="Hearing and vision assessment"/>
        <outline text="Support before final diagnosis">
          <outline text="Early intervention uses neuroplasticity"/>
        </outline>
        <outline text="Functional, family-centred goals"/>
        <outline text="Neurodiversity-affirming care">
          <outline text="Behaviour may communicate pain or fear"/>
        </outline>
        <outline text="School as a health partner">
          <outline text="Consented, limited information sharing"/>
          <outline text="Accommodations reduce barriers"/>
        </outline>
      </outline>
      <outline text="Adolescent health">
        <outline text="Private time, confidentiality limits explained"/>
        <outline text="Decision-specific capacity"/>
        <outline text="Direct mental health questions">
          <outline text="Safety plan, not a verbal promise"/>
        </outline>
        <outline text="Eating disorders at any body size">
          <outline text="Unstable despite looking well"/>
        </outline>
        <outline text="Inclusive sexual and reproductive care">
          <outline text="Consent versus coercion or exploitation"/>
        </outline>
      </outline>
      <outline text="Child maltreatment">
        <outline text="No single bruise proves abuse"/>
        <outline text="Sentinel injuries in non-mobile infants"/>
        <outline text="Stabilise, document exactly, involve specialists"/>
        <outline text="Avoid repeated leading interviews"/>
        <outline text="Uncertainty does not justify silence"/>
        <outline text="Neglect: deprivation is not indifference"/>
      </outline>
      <outline text="Transitions and complex care">
        <outline text="Shared plan: devices, risks, clinicians"/>
        <outline text="Technology dependence: power, supply, exhaustion"/>
        <outline text="Transition is gradual, not a birthday letter">
          <outline text="Self-management, medication responsibility"/>
        </outline>
        <outline text="Adult services need an accessible summary"/>
        <outline text="Follow-up across transitions"/>
      </outline>
    </outline>
  </body>
</opml>
