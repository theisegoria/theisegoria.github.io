<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>038-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="敗血症、適正使用、感染予防">
      <outline text="敗血症の概念と病態生理">
        <outline text="感染への制御不全反応による臓器障害">
          <outline text="培養結果ではなく症候群"/>
          <outline text="発熱や低血圧がなくても生じ得る"/>
        </outline>
        <outline text="自然免疫受容体、補体、凝固、内皮"/>
        <outline text="炎症促進信号と抗炎症信号が同時に生じる">
          <outline text="組織損傷と免疫疲弊"/>
        </outline>
        <outline text="血管拡張と漏出で有効循環血液量減少"/>
        <outline text="血圧が十分でも微小循環シャント"/>
        <outline text="乳酸はリスク指標でありその推移が有用">
          <outline text="正常値でも重症敗血症は除外できない"/>
          <outline text="持続上昇は輸液追加でなく再評価"/>
        </outline>
      </outline>
      <outline text="認識と鑑別診断">
        <outline text="感染に急性の臓器悪化を伴う"/>
        <outline text="高齢、妊婦、新生児、免疫抑制で非典型">
          <outline text="好中球減少は局所炎症を隠す"/>
          <outline text="ベータ遮断薬は頻脈を隠す"/>
        </outline>
        <outline text="スコアは臨床判断の代わりにならない"/>
        <outline text="医療機器を含め感染源を診察する"/>
        <outline text="非感染性類似病態を探す"/>
        <outline text="敗血症性ショックは昇圧薬と乳酸上昇">
          <outline text="灌流破綻時は基準を待たない"/>
        </outline>
      </outline>
      <outline text="即時評価と培養">
        <outline text="気道、呼吸、循環、血糖、尿量を評価"/>
        <outline text="各介入後に再評価する"/>
        <outline text="遅延なければ抗菌薬前に血液培養"/>
        <outline text="分子検査は診断を早め得る">
          <outline text="定着を検出する場合がある"/>
          <outline text="パネル陰性でも標的外菌は除外不可"/>
        </outline>
      </outline>
      <outline text="抗微生物薬の投与時期と選択">
        <outline text="同じ時計でなく重症度に比例した緊急性">
          <outline text="ショックでは迅速培養後に緊急投与"/>
          <outline text="安定し不確実なら焦点を絞った検査"/>
        </outline>
        <outline text="経験的選択は感染源、曝露、耐性、宿主"/>
        <outline text="敗血症は分布、蛋白結合、除去を変える">
          <outline text="腎機能障害でも負荷量が必要"/>
        </outline>
        <outline text="毎日再評価し狭域化、最適化、期間設定"/>
        <outline text="改善だけでは診断は証明されない"/>
      </outline>
      <outline text="輸液、血管作動療法、臓器支持">
        <outline text="反応を評価しつつ晶質液ボーラス">
          <outline text="画一的大量投与は予備能低下で有害"/>
        </outline>
        <outline text="下肢挙上、再充満、尿量、意識、心エコー"/>
        <outline text="分布異常性ショックはノルアドレナリン"/>
        <outline text="一部の心筋機能障害に強心薬"/>
        <outline text="糖質コルチコイドは昇圧薬依存性のみ"/>
        <outline text="過剰伸展回避、血糖、せん妄の管理"/>
        <outline text="輸血は酸素運搬と出血状況に従う"/>
      </outline>
      <outline text="感染源制御">
        <outline text="抗菌薬は排膿も壊死除去もできない"/>
        <outline text="排液、デブリ、手術、閉塞解除、抜去"/>
        <outline text="安全に可能となり次第実施する">
          <outline text="壊死性感染や穿孔で画像待ちをしない"/>
        </outline>
        <outline text="深部培養を採取する"/>
        <outline text="改善しなければ別の感染源を探す"/>
      </outline>
      <outline text="抗微生物薬適正使用">
        <outline text="毒性、耐性、費用を抑え最良の転帰"/>
        <outline text="監査、フィードバック、アレルギー確認"/>
        <outline text="無症候性細菌尿は定められた場合のみ"/>
        <outline text="定着やウイルス性症候群は治療しない"/>
        <outline text="バイオマーカーは単独で決めない"/>
        <outline text="期間は症候群、感染源、宿主、反応">
          <outline text="多くは従来より短期間でよい"/>
          <outline text="自動的延長は有害になり得る"/>
        </outline>
      </outline>
      <outline text="予防策と医療機器関連感染">
        <outline text="標準予防策はすべての患者に適用">
          <outline text="手袋は手指衛生の代わりにならない"/>
          <outline text="汚れ、芽胞、集団発生時は石鹸と水"/>
        </outline>
        <outline text="接触、飛沫、空気予防策は経路が異なる"/>
        <outline text="隔離は孤独とケアの見落としを生む"/>
        <outline text="侵襲的機器はすべて防御障壁を破る">
          <outline text="継続する適応と毎日の確認"/>
        </outline>
        <outline text="尿道カテーテルは正当な適応と早期抜去"/>
        <outline text="人工呼吸器では鎮静最小化と口腔ケア"/>
        <outline text="手術では適時予防投与とクリッパー">
          <outline text="ドレーンは予防投与継続の理由でない"/>
        </outline>
      </outline>
      <outline text="環境制御と集団発生">
        <outline text="清掃、消毒、滅菌は異なる"/>
        <outline text="処理方法は器具の接触部位で決まる"/>
        <outline text="有機物は消毒を妨げる"/>
        <outline text="診断確認、症例定義、人、場所、時間"/>
        <outline text="ゲノム上の関連には疫学的文脈が必要"/>
        <outline text="報告、検体保存、制御策の監査"/>
      </outline>
      <outline text="ワクチン接種と回復">
        <outline text="ワクチンは感受性と重症化を減らす">
          <outline text="生ワクチンは免疫抑制、妊娠で危険"/>
        </outline>
        <outline text="職員はワクチン、適合確認、針刺し予防"/>
        <outline text="針刺し後は応急処置、同意検査、予防投与"/>
        <outline text="生存者は筋力低下、認知変化、臓器障害"/>
        <outline text="薬剤照合、耐性記録、リハビリ計画"/>
      </outline>
    </outline>
  </body>
</opml>
