<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>050-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="栄養不良、微量栄養素、栄養療法、肥満">
      <outline text="概説">
        <outline text="エネルギー、栄養素、水分、電解質を供給"/>
        <outline text="食事の文化的、社会的、心理的意味"/>
        <outline text="栄養不良の機序は複数ある">
          <outline text="摂取不足、異化、吸収障害、利用変化"/>
          <outline text="栄養の質が低い過剰な脂肪蓄積"/>
        </outline>
        <outline text="体格は誤る、肥満でも筋肉を失う"/>
        <outline text="機序、重症度、機能、再栄養、経路を評価"/>
      </outline>
      <outline text="エネルギー、蛋白質、および適応">
        <outline text="基礎代謝は勾配、代謝回転、修復を維持"/>
        <outline text="総消費量に活動、成長、疾患が加わる"/>
        <outline text="代謝されない蛋白質の予備はない">
          <outline text="負の収支で筋肉と臓器の蛋白質を消費"/>
        </outline>
        <outline text="絶食時はインスリン低下、グルカゴン上昇">
          <outline text="グリコーゲン分解、脂肪分解、糖新生"/>
          <outline text="ケトン体利用は蛋白喪失を抑えるが防げない"/>
        </outline>
        <outline text="栄養投与下でも炎症性異化が進む">
          <outline text="基礎疾患の制御まで逆転しない"/>
          <outline text="蛋白質と離床・運動で機能を維持"/>
        </outline>
      </outline>
      <outline text="栄養不良の認識">
        <outline text="危険因子は摂取低下、疾患、貧困、喪失"/>
        <outline text="摂取量、期間、体重推移、食料アクセス">
          <outline text="体重変化は組織量か体液量か"/>
        </outline>
        <outline text="筋肉、脂肪、浮腫、口腔、皮膚、筋力を診る">
          <outline text="腹水と浮腫は体重減少を隠す"/>
        </outline>
        <outline text="体格指数は否定も体組成測定もできない"/>
        <outline text="スクリーニングは危険、診断は統合">
          <outline text="表現型と摂取不足、吸収不良、炎症"/>
        </outline>
        <outline text="単一の血液検査では診断できない">
          <outline text="アルブミンは炎症、漏出、希釈で低下"/>
        </outline>
      </outline>
      <outline text="蛋白質・エネルギー栄養不良">
        <outline text="筋力低下、免疫障害、創傷遅延、転倒"/>
        <outline text="重症疾患は体重が安定でも筋肉を失う"/>
        <outline text="サルコペニアは筋力と筋肉量の低下"/>
        <outline text="フレイルは複数生理系の広い脆弱性"/>
        <outline text="レジスタンス運動、蛋白質、絶食短縮"/>
        <outline text="経路強化の前に食事を改善する">
          <outline text="補助食品は好む食事の代わりにしない"/>
        </outline>
        <outline text="管理栄養士が必要量と実投与量を確認"/>
        <outline text="画一的なカロリー目標を避ける"/>
      </outline>
      <outline text="微量栄養素欠乏">
        <outline text="鉄欠乏">
          <outline text="出血、喪失、摂取、需要を調べる"/>
          <outline text="フェリチンは炎症でも上昇"/>
          <outline text="静注鉄は迅速補充、不耐容、喪失時"/>
        </outline>
        <outline text="葉酸とB十二欠乏はDNA合成を障害">
          <outline text="B十二は神経、後索、認知、視神経障害"/>
          <outline text="葉酸単独で神経障害が進行し得る"/>
        </outline>
        <outline text="チアミンは炭水化物の酸化的代謝に必要">
          <outline text="ウェルニッケ脳症は混乱、眼球、失調"/>
          <outline text="炭水化物前に投与、緊急糖は遅らせない"/>
        </outline>
        <outline text="Cはコラーゲン、Dは骨、Kは凝固"/>
        <outline text="A、E、亜鉛、銅、セレンはリスク別検査"/>
      </outline>
      <outline text="再栄養症候群">
        <outline text="インスリンでリン、K、Mgが細胞内へ">
          <outline text="チアミン需要増加、ナトリウムと水貯留"/>
          <outline text="不整脈、心不全、呼吸筋力低下、死亡"/>
        </outline>
        <outline text="危険は低体重、摂取僅少、飲酒、枯渇"/>
        <outline text="栄養開始前の予防">
          <outline text="チアミン、総合ビタミン、電解質補正"/>
          <outline text="慎重に開始し段階的に増量"/>
        </outline>
        <outline text="水分、心症状、電解質、腎機能を監視"/>
        <outline text="ブドウ糖静注を含むどの経路でも起こる"/>
      </outline>
      <outline text="経腸栄養">
        <outline text="消化管が機能すれば優先する">
          <outline text="粘膜を維持し、感染と代謝合併症が少ない"/>
        </outline>
        <outline text="短期は経鼻管、長期は胃瘻や空腸瘻"/>
        <outline text="承認された方法で先端位置を確認"/>
        <outline text="上体挙上、口腔ケア、フラッシュ、剤形"/>
        <outline text="胃残量だけでは誤嚥を示せない"/>
        <outline text="下痢は薬剤、感染、投与速度が多い"/>
      </outline>
      <outline text="静脈栄養">
        <outline text="消化管から十分に吸収できない場合">
          <outline text="腸閉塞、短腸症候群、高排液量の瘻孔"/>
        </outline>
        <outline text="中心静脈路で高濃度溶液を使用"/>
        <outline text="専用ラインを無菌的に、毎日見直す">
          <outline text="カテーテル感染と血栓症は致命的"/>
        </outline>
        <outline text="代謝性合併症">
          <outline text="高血糖、中性脂肪、肝、胆嚢うっ滞"/>
        </outline>
        <outline text="計画的に経腸・経口へ移行する"/>
      </outline>
      <outline text="慢性疾患としての肥満">
        <outline text="生物学、環境、睡眠、薬剤、遺伝"/>
        <outline text="脂肪組織機能不全が多くの合併症を招く"/>
        <outline text="広く評価し、敬意を払い、許可を求める"/>
        <outline text="目標は数値でなく健康と機能"/>
        <outline text="基礎は食事、運動、睡眠、心理支援"/>
        <outline text="抗肥満薬は長期の維持戦略が必要"/>
        <outline text="代謝手術は持続的減量と生涯の管理">
          <outline text="急速な減量で胆石とサルコペニア"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
