<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>085-03 胎盤、胎膜、母体胎児交換、双胎、発生時期</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="胎盤、胎膜、双胎、発生時期">
      <outline text="胎盤の構造">
        <outline text="胎児絨毛膜と母体脱落膜"/>
        <outline text="母体血と胎児血は大量には混ざらない"/>
        <outline text="一次、二次、三次絨毛">
          <outline text="細胞性栄養膜柱、次に中胚葉の芯"/>
          <outline text="胎児毛細血管で三次絨毛"/>
        </outline>
        <outline text="固定絨毛は脱落膜へ結ぶ"/>
        <outline text="遊離終末絨毛が交換面"/>
        <outline text="合胞体性栄養膜下の関門層">
          <outline text="絨毛結合組織のホーフバウアー細胞"/>
        </outline>
      </outline>
      <outline text="交換">
        <outline text="妊娠進行で関門が薄くなる">
          <outline text="拡散距離が短くなる"/>
        </outline>
        <outline text="ガスは拡散"/>
        <outline text="ブドウ糖は促進輸送"/>
        <outline text="アミノ酸は能動または担体輸送"/>
        <outline text="免疫グロブリンGは受容体依存性通過"/>
        <outline text="酸素移動の決定因子">
          <outline text="分圧、面積、関門厚、流量"/>
          <outline text="胎児ヘモグロビン、二重ボーア効果"/>
        </outline>
        <outline text="胎盤自体も酸素を消費"/>
        <outline text="単純な濾過器ではない">
          <outline text="老廃物は母体循環へ"/>
        </outline>
      </outline>
      <outline text="母体血流">
        <outline text="螺旋動脈から絨毛間腔へ"/>
        <outline text="絨毛外栄養膜が螺旋動脈を改築">
          <outline text="広い低抵抗管へ"/>
        </outline>
        <outline text="不十分な改築">
          <outline text="胎児発育不全と妊娠高血圧腎症"/>
        </outline>
        <outline text="臍動脈は比較的脱酸素血を運ぶ"/>
      </outline>
      <outline text="内分泌と免疫">
        <outline text="ヒト絨毛性ゴナドトロピンが黄体維持"/>
        <outline text="プロゲステロンが子宮収縮を抑制"/>
        <outline text="エストリオールは胎児副腎・肝が必要"/>
        <outline text="胎盤性ラクトゲンが母体代謝を変える">
          <outline text="インスリン抵抗性が胎児燃料を保つ"/>
          <outline text="過剰は妊娠糖尿病"/>
        </outline>
        <outline text="副腎皮質刺激ホルモン放出ホルモンと分娩"/>
        <outline text="母体胎児境界は免疫学的に活発">
          <outline text="一部の主要組織適合分子を発現せず"/>
          <outline text="子宮自然殺傷細胞とマクロファージ"/>
          <outline text="全身免疫抑制でなく調整状態"/>
        </outline>
      </outline>
      <outline text="脱落膜と胎膜">
        <outline text="基底脱落膜が母体胎盤成分"/>
        <outline text="被包脱落膜が壁側脱落膜と融合"/>
        <outline text="有毛絨毛膜は残り平滑絨毛膜は退縮">
          <outline text="円盤状胎盤"/>
        </outline>
        <outline text="脱落膜中隔で胎盤葉に区分"/>
        <outline text="分娩後に胎盤を検査"/>
        <outline text="羊水は胎児尿で増え嚥下で除去">
          <outline text="羊水過少は肺低形成"/>
          <outline text="羊水過多は嚥下障害、母体糖尿病"/>
        </outline>
        <outline text="尿膜は尿膜管へ">
          <outline text="遺残は正中臍索"/>
        </outline>
        <outline text="臍帯は二動脈一静脈とワルトン膠質"/>
      </outline>
      <outline text="胎児循環">
        <outline text="静脈管が肝を迂回"/>
        <outline text="卵円孔の右左短絡">
          <outline text="酸素化血を心・脳へ"/>
        </outline>
        <outline text="動脈管が肺を迂回">
          <outline text="高い肺血管抵抗"/>
        </outline>
        <outline text="出生時の変化">
          <outline text="肺膨張で肺抵抗低下"/>
          <outline text="左房圧増加で卵円孔閉鎖"/>
          <outline text="酸素上昇とプロスタグランジン低下で動脈管収縮"/>
        </outline>
      </outline>
      <outline text="双胎">
        <outline text="二卵性は二卵母細胞、通常二絨毛膜"/>
        <outline text="一卵性は分離時期で決まる">
          <outline text="非常に早ければ二絨毛膜二羊膜"/>
          <outline text="胚盤胞期なら一絨毛膜二羊膜"/>
          <outline text="さらに遅ければ一絨毛膜一羊膜"/>
          <outline text="不完全な晩期分離は結合双胎"/>
        </outline>
        <outline text="接合性より絨毛膜性が重要">
          <outline text="双胎間輸血"/>
          <outline text="一羊膜双胎の臍帯絡み"/>
        </outline>
      </outline>
      <outline text="発生時期と催奇形">
        <outline text="頭殿長は早期に正確"/>
        <outline text="発育不全と体質的に小さい健常胎児"/>
        <outline text="最初の二週は全か無か則、絶対でない"/>
        <outline text="三から八週は主要器官形成期"/>
        <outline text="胎児期は成長、中枢神経は脆弱"/>
        <outline text="用量、時期、遺伝子型に依存"/>
        <outline text="絶対リスクと不確実性を示す"/>
      </outline>
    </outline>
  </body>
</opml>
