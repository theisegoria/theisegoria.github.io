<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>063-02 Syndrome clarification, high-risk collapse, dynamic observation, and safe uncertainty</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Clarification, high-risk collapse, observation, safe uncertainty">
      <outline text="Clarifying vague labels">
        <outline text="Translate labels into failed functions and a timeline">
          <outline text="Collapse: syncope, seizure, fall, intoxication, sleep"/>
          <outline text="Dizziness: motion illusion, faint, imbalance"/>
          <outline text="Weakness: force, fatigue, pain, dyspnoea, initiative"/>
        </outline>
        <outline text="Clarify alongside stabilisation"/>
      </outline>
      <outline text="First observations and hidden shock">
        <outline text="Look before instruments are attached"/>
        <outline text="Interventions normalise numbers without removing cause">
          <outline text="Record lowest pre-intervention state"/>
        </outline>
        <outline text="Compensated shock with normal blood pressure">
          <outline text="Integrate pulse pressure, refill, oliguria, lactate trend"/>
          <outline text="Young and pregnant compensate strongly"/>
          <outline text="Beta-blocker or pacemaker prevents tachycardia"/>
        </outline>
        <outline text="Concealed haemorrhage, embolism, aortic disease"/>
      </outline>
      <outline text="Fever, hyperthermia, infection">
        <outline text="Cytokines raise hypothalamic set point">
          <outline text="Vasoconstriction and shivering cause chill"/>
          <outline text="Vasodilation and sweating when set point falls"/>
        </outline>
        <outline text="Hyperthermia: no raised set point">
          <outline text="Rapid cooling without waiting for infection tests"/>
        </outline>
        <outline text="Infection without fever in vulnerable groups"/>
        <outline text="Fever does not prove infection"/>
        <outline text="Cultures useful in sepsis, harmful if contaminated"/>
        <outline text="Antibiotics proportional, daily reassessment"/>
      </outline>
      <outline text="Syncope and high-risk collapse">
        <outline text="Global cerebral hypoperfusion, rapid recovery"/>
        <outline text="Witness detail on posture, trigger, recovery"/>
        <outline text="Reflex features: nausea, warmth, sweating, dimming"/>
        <outline text="Cardiac risk features">
          <outline text="Unheralded exertional or supine collapse"/>
        </outline>
        <outline text="Pregnancy: ectopic pregnancy and haemorrhage"/>
        <outline text="Postpartum: haemorrhage, embolism, cardiomyopathy"/>
        <outline text="Older people report a simple fall">
          <outline text="Facial injury, no protective reaction"/>
        </outline>
        <outline text="Exertional syncope: no sport or driving before diagnosis"/>
      </outline>
      <outline text="Seizure, orthostasis, rhythm">
        <outline text="Brief jerks do not prove epilepsy"/>
        <outline text="Seizure: aura, sustained tonic-clonic, sleep onset"/>
        <outline text="Normal interictal EEG does not exclude epilepsy"/>
        <outline text="Orthostatic heart-rate response">
          <outline text="Appropriate tachycardia: volume loss or pooling"/>
          <outline text="Small response: autonomic failure or drugs"/>
        </outline>
        <outline text="Brief normal measurement misses delayed hypotension"/>
        <outline text="Electrocardiogram cannot exclude intermittent arrhythmia"/>
        <outline text="Monitoring device matches event frequency"/>
        <outline text="Echocardiography answers a structural question"/>
      </outline>
      <outline text="Dizziness by timing and triggers">
        <outline text="Seconds, triggered by rolling: positional vertigo"/>
        <outline text="Spontaneous minutes to hours: migraine, Meniere, panic"/>
        <outline text="Continuous: neuritis or posterior-circulation stroke"/>
        <outline text="Triggered versus merely worsened by movement"/>
        <outline text="Central features raise stroke concern"/>
        <outline text="Head-impulse, nystagmus, skew: continuous syndrome only"/>
        <outline text="Imaging weak; repeat neurological and gait exam"/>
      </outline>
      <outline text="Weakness and respiratory threat">
        <outline text="True weakness after pain, effort, comprehension"/>
        <outline text="Upper motor neuron: brisk reflexes, plantar response"/>
        <outline text="Lower motor neuron: atrophy, fasciculation, low reflexes"/>
        <outline text="Junction fluctuates; muscle proximal, sensation kept"/>
        <outline text="Oximetry normal until late in ventilatory weakness">
          <outline text="Serial vital capacity, carbon dioxide, cough, swallow"/>
        </outline>
        <outline text="Measurements read as a trend">
          <outline text="Poor effort or mouth leak falsely low"/>
          <outline text="Fatiguing patient falls steeply"/>
        </outline>
        <outline text="Call intensive care before intubation is difficult"/>
      </outline>
      <outline text="Metabolic mimics and fatigue">
        <outline text="Potassium, phosphate, magnesium disorders"/>
        <outline text="Adrenal crisis treated before cortisol result"/>
        <outline text="Medication review and withdrawal"/>
        <outline text="Fatigue real but not muscle disease"/>
        <outline text="Untargeted panels entrench unsupported explanations"/>
        <outline text="Negative test does not invalidate disability"/>
      </outline>
      <outline text="Observation as a diagnostic intervention">
        <outline text="Specify duration, checks, escalation thresholds"/>
        <outline text="Nonspecific responses to fluid or antipyretic"/>
        <outline text="Predict in advance, then interpret"/>
        <outline text="Order states who re-examines and when"/>
        <outline text="Read laboratory values for direction"/>
        <outline text="Walking test checks pulse, oxygen, pressure"/>
      </outline>
      <outline text="Disposition, safety net, synthesis">
        <outline text="Integrate probability, reserve, function, support"/>
        <outline text="Normal test cannot make unsafe home safe"/>
        <outline text="Assign owner and deadline for pending results"/>
        <outline text="Teach-back and adapted written material"/>
        <outline text="Final synthesis states mechanism and alternatives"/>
        <outline text="Calibrated uncertainty is not failure">
          <outline text="False precision stops observation too early"/>
        </outline>
        <outline text="Temporary restriction of driving, swimming, heights"/>
      </outline>
    </outline>
  </body>
</opml>
