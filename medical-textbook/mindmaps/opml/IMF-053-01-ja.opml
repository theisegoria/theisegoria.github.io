<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>053-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="婦人科疾患、月経、妊孕性、避妊">
      <outline text="概説">
        <outline text="内分泌生理と出血、疼痛、感染、がんの統合"/>
        <outline text="説明、同意、同席者の提案、中止の保証"/>
        <outline text="緊急：不安定、異所性妊娠、捻転、感染、出血"/>
      </outline>
      <outline text="月経生理と病歴">
        <outline text="卵胞のエストラジオールが内膜を増殖">
          <outline text="高エストラジオール持続で黄体形成ホルモン急上昇">
            <outline text="排卵"/>
          </outline>
        </outline>
        <outline text="黄体プロゲステロンで内膜が分泌期へ">
          <outline text="着床なし：ホルモン消退で月経"/>
        </outline>
        <outline text="初経後と閉経前は排卵が不規則"/>
        <outline text="病歴：間隔、量、疼痛、妊娠、生殖の希望"/>
        <outline text="生理用品の使用数は不正確">
          <outline text="貧血、漏れ、活動制限、本人の経験"/>
        </outline>
      </outline>
      <outline text="異常子宮出血">
        <outline text="原因：構造病変、凝固障害、排卵障害、薬剤"/>
        <outline text="思春期：無排卵だが出血性疾患も考慮"/>
        <outline text="閉経移行期：無排卵だが加齢でがん増加"/>
        <outline text="最初に全身状態と妊娠を評価">
          <outline text="血算と鉄検査で影響を把握"/>
        </outline>
        <outline text="生検：高年齢、無拮抗エストロゲン、肥満など"/>
        <outline text="急性：蘇生、トラネキサム酸、ホルモン、手術"/>
        <outline text="慢性：子宮内システム、ホルモン、抗炎症薬"/>
        <outline text="子宮内膜焼灼術は避妊法ではない">
          <outline text="将来の妊娠希望には不適"/>
        </outline>
      </outline>
      <outline text="骨盤痛と子宮内膜症">
        <outline text="急性の鑑別：異所性妊娠、捻転、嚢胞、感染"/>
        <outline text="妊娠可能なら妊娠検査を通常行う"/>
        <outline text="悪心を伴う突然の片側痛は捻転を示唆">
          <outline text="正常ドプラでも間欠性・部分捻転あり"/>
        </outline>
        <outline text="子宮内膜症：子宮腔外の内膜様組織">
          <outline text="炎症、線維化、癒着">
            <outline text="疼痛と不妊"/>
          </outline>
          <outline text="症状負担は病変範囲と相関しない"/>
          <outline text="臨床診断、腹腔鏡は必須でない"/>
        </outline>
        <outline text="子宮腺筋症：筋層内の子宮内膜組織">
          <outline text="有痛性大量出血、圧痛を伴う子宮腫大"/>
        </outline>
        <outline text="子宮筋腫：良性平滑筋腫瘍">
          <outline text="大きさと部位で症状が決まる"/>
        </outline>
      </outline>
      <outline text="感染と帯下">
        <outline text="帯下：生理的、感染、萎縮、悪性腫瘍">
          <outline text="病歴だけでは不確実、症候群で検査"/>
        </outline>
        <outline text="骨盤内炎症性疾患：上行性、多菌性が多い">
          <outline text="下腹部痛と頸部移動痛・子宮・付属器圧痛"/>
          <outline text="遅れで不妊、異所性妊娠、膿瘍、疼痛"/>
          <outline text="広域治療、検査、パートナー対応、再評価"/>
        </outline>
        <outline text="ヒトパピローマウイルスは複数のがんを起こす">
          <outline text="ワクチンと検診はリスクを減らすが残る"/>
        </outline>
        <outline text="トラウマに配慮し本人の選択に従う"/>
      </outline>
      <outline text="多嚢胞性卵巣症候群と無月経">
        <outline text="排卵障害、アンドロゲン過剰、卵巣形態">
          <outline text="インスリン抵抗性が関与"/>
          <outline text="無拮抗エストロゲンで内膜過形成"/>
        </outline>
        <outline text="治療は本人の優先事項に沿う">
          <outline text="配合避妊法やプロゲストーゲンで保護"/>
        </outline>
        <outline text="嚢胞は必須でなく超音波だけで診断不可"/>
        <outline text="無月経：まず妊娠を除外">
          <outline text="ホルモン検査と画像で障害部位を推定"/>
          <outline text="低エネルギー抑制は骨と妊孕性を脅かす">
            <outline text="利用可能エネルギーを回復"/>
          </outline>
        </outline>
      </outline>
      <outline text="不妊">
        <outline text="高年齢、月経不順、既知疾患では早期評価"/>
        <outline text="両方のパートナーを同時に評価"/>
        <outline text="女性因子：排卵、予備能、卵管、子宮、年齢"/>
        <outline text="周期や時期を合わせたプロゲステロンで排卵確認"/>
        <outline text="予備能検査は刺激反応を予測、自然妊娠は否"/>
        <outline text="治療：時期指導から体外受精、提供、養子縁組"/>
      </outline>
      <outline text="避妊">
        <outline text="コンドームは感染伝播を減らす"/>
        <outline text="インプラントと子宮内避妊具：使用者失敗が少ない"/>
        <outline text="配合法は排卵を抑制">
          <outline text="エストロゲンは血栓症リスクを増加"/>
        </outline>
        <outline text="プロゲストーゲン単剤：エストロゲン回避、影響は多様"/>
        <outline text="銅付加子宮内避妊具：ホルモンなし、出血と疼痛増"/>
        <outline text="緊急避妊は着床した妊娠を中断しない"/>
        <outline text="酵素誘導薬は一部ホルモン避妊法を弱める"/>
      </outline>
      <outline text="閉経と骨盤底の健康">
        <outline text="持続的無月経の後に遡って診断"/>
        <outline text="ホルモン療法は血管運動症状に最も有効">
          <outline text="子宮があれば全身性エストロゲンに内膜保護"/>
        </outline>
        <outline text="腟用局所エストロゲン：全身曝露が少ない"/>
        <outline text="骨盤臓器脱と尿失禁：出産、加齢、組織">
          <outline text="理学療法、ペッサリー、手術を負担と目標で"/>
        </outline>
      </outline>
      <outline text="婦人科がん">
        <outline text="閉経後出血には子宮内膜評価"/>
        <outline text="検診は症状前に前がん病変を検出"/>
        <outline text="卵巣がん：持続する非特異的症状"/>
        <outline text="持続する警告徴候には生検と紹介"/>
        <outline text="腫瘍マーカーは一般的スクリーニングではない"/>
      </outline>
    </outline>
  </body>
</opml>
