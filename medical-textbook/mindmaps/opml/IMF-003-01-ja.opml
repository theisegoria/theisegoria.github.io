<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>003-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="遺伝子、タンパク質、適応、傷害、細胞死">
      <outline text="方向づけ">
        <outline text="細胞が自らを維持できないと疾患が始まる"/>
        <outline text="転帰はストレスの性質、強さ、時間、細胞種"/>
        <outline text="軽度のストレスでは適応"/>
        <outline text="重度でも短時間なら可逆性傷害"/>
        <outline text="持続的・圧倒的な傷害は細胞死"/>
        <outline text="細胞の出来事が臓器不全へ拡大する"/>
      </outline>
      <outline text="情報の流れとタンパク質機能">
        <outline text="DNAはヌクレオチド配列に情報を保存"/>
        <outline text="転写によりRNAが産生される">
          <outline text="mRNAは加工されリボソームで翻訳"/>
        </outline>
        <outline text="遺伝子からタンパク質へは有用だが不完全">
          <outline text="選択的スプライシングで異なる転写産物"/>
          <outline text="タンパク質は切断、修飾、折りたたみ、分解"/>
          <outline text="表現型は多段階の調節に依存する"/>
        </outline>
        <outline text="発現はホルモン、栄養素、酸素に応答"/>
        <outline text="エピジェネティクスはヒストン修飾とDNAメチル化">
          <outline text="配列を変えずに安定した発現変化"/>
        </outline>
      </outline>
      <outline text="変異と遺伝">
        <outline text="置換、挿入、欠失、コピー数、再構成"/>
        <outline text="同義変化ではアミノ酸が保たれ得る"/>
        <outline text="ミスセンスは置換、ナンセンスは終止コドン"/>
        <outline text="調節領域のバリアントは配列でなく発現を変える"/>
        <outline text="優性は1つの対立遺伝子が表現型に影響">
          <outline text="頻度、重症、有益を意味しない"/>
        </outline>
        <outline text="劣性は通常両対立遺伝子に病的バリアント"/>
        <outline text="ミトコンドリアDNAは主に卵母細胞から">
          <outline text="ヘテロプラスミーで重症度が変わる"/>
        </outline>
        <outline text="浸透率は表現型を示す人の割合"/>
        <outline text="表現度は程度や現れ方の変動"/>
      </outline>
      <outline text="変化した対立遺伝子が顕性を示す理由">
        <outline text="機能喪失は潜性を示すことが多い"/>
        <outline text="ハプロ不全は残った産物量では不十分"/>
        <outline text="ドミナントネガティブは正常タンパク質を妨害">
          <outline text="正常サブユニットが必要な複合体に組み込む"/>
        </outline>
        <outline text="機能獲得は過剰、不適切、新しい活性"/>
        <outline text="同じ遺伝子でも機序で異なる疾患"/>
        <outline text="家系図だけでは分子機序を特定できない"/>
      </outline>
      <outline text="細胞の適応">
        <outline text="肥大は細胞サイズの増大">
          <outline text="負荷増大と限られた分裂能"/>
          <outline text="後に線維化と拡張障害で有害化"/>
        </outline>
        <outline text="過形成は細胞数の増加">
          <outline text="妊娠では生理的、エストロゲンでは病的"/>
          <outline text="癌ではないが悪性化リスクを高め得る"/>
        </outline>
        <outline text="萎縮は細胞サイズと時に数の減少">
          <outline text="合成低下、分解とオートファジー亢進"/>
          <outline text="資源を節約するが予備能を下げる"/>
        </outline>
        <outline text="化生は成熟細胞プログラムの可逆的置換">
          <outline text="喫煙者の扁平上皮は粘液線毛機能を失う"/>
          <outline text="持続するストレスは異形成へ進行し得る"/>
        </outline>
      </outline>
      <outline text="可逆性細胞傷害">
        <outline text="中心はATP産生の障害">
          <outline text="虚血は酸素、基質、老廃物除去を妨げる"/>
          <outline text="低酸素血症は酸素低下だが血流は保たれ得る"/>
        </outline>
        <outline text="ポンプ障害でNaと水が流入、Kが流出">
          <outline text="細胞と細胞小器官が腫脹し、Caが蓄積"/>
        </outline>
        <outline text="小胞体腫脹、リボソーム脱落、合成低下"/>
        <outline text="unfolded-protein response"/>
        <outline text="時間枠内の血流回復で細胞を救える">
          <outline text="再灌流は活性酸素種とCa負荷で傷害を追加"/>
          <outline text="それでも適時の灌流回復は不可欠"/>
        </outline>
      </outline>
      <outline text="不可逆性傷害と壊死">
        <outline text="ミトコンドリア機能不全と深刻な膜障害"/>
        <outline text="核変化はpyknosisからkaryolysisへ"/>
        <outline text="凝固壊死は輪郭が保たれ、充実臓器の虚血"/>
        <outline text="融解壊死は脳梗塞と膿瘍"/>
        <outline text="乾酪壊死はもろく、古典的に結核"/>
        <outline text="脂肪壊死はリパーゼ放出か外傷"/>
        <outline text="フィブリノイド壊死は免疫介在性血管傷害"/>
        <outline text="放出された細胞内タンパク質がバイオマーカー">
          <outline text="トロポニンは傷害を示すが原因は示さない"/>
          <outline text="アミノトランスフェラーゼは肝機能ではない"/>
        </outline>
      </outline>
      <outline text="アポトーシスと制御された細胞死">
        <outline text="最小限の漏出で細胞を除去する"/>
        <outline text="内因性はミトコンドリア制御とシトクロムc"/>
        <outline text="外因性はデスレセプターから"/>
        <outline text="両者がカスパーゼを活性化する"/>
        <outline text="少なすぎると癌や自己免疫"/>
        <outline text="過剰では神経変性、免疫枯渇"/>
        <outline text="ネクロプトーシス、パイロトーシスは炎症を伴う"/>
        <outline text="オートファジーはリソソームで再利用する">
          <outline text="善悪より状況、程度、時期が重要"/>
        </outline>
      </outline>
      <outline text="臨床的統合">
        <outline text="1つの症状や検査値では診断しない"/>
        <outline text="ストレス、脆弱組織、可逆性、予備能を問う"/>
        <outline text="治療の論理は機序に従う">
          <outline text="灌流回復、毒素除去、臓器支持"/>
        </outline>
        <outline text="介入そのものが害を及ぼし得る"/>
      </outline>
    </outline>
  </body>
</opml>
