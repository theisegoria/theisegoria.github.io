<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>080-03 Cranial nerves, arterial and venous pathways, autonomic ganglia, and lymphatics</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Cranial nerves, vessels, ganglia, and lymphatics">
      <outline text="Olfactory and optic pathways">
        <outline text="Olfactory filaments cross cribriform plate">
          <outline text="Shearing: anosmia and CSF leak"/>
        </outline>
        <outline text="No obligatory thalamic relay">
          <outline text="Smell linked to memory and emotion"/>
        </outline>
        <outline text="Optic nerve is a CNS tract within meninges">
          <outline text="Raised pressure along sheath: papilloedema"/>
        </outline>
        <outline text="Chiasm: nasal fibres cross"/>
        <outline text="Chiasm above pituitary, near carotid vessels"/>
      </outline>
      <outline text="Ocular motor nerves and cavernous sinus">
        <outline text="Oculomotor between posterior cerebral, superior cerebellar"/>
        <outline text="Oculomotor: levator, three recti, inferior oblique"/>
        <outline text="Trochlear: long course, vulnerable in trauma"/>
        <outline text="Abducens through Dorello canal">
          <outline text="Within cavernous sinus beside carotid"/>
        </outline>
        <outline text="Lateral wall: oculomotor, trochlear, V1, V2"/>
        <outline text="Ophthalmic and facial veins transmit infection"/>
        <outline text="Parasympathetic: ciliary ganglion to sphincter"/>
        <outline text="Sympathetic: superior cervical ganglion to dilator"/>
      </outline>
      <outline text="Trigeminal divisions">
        <outline text="Ganglion in Meckel cave"/>
        <outline text="Ophthalmic: lacrimal, frontal, nasociliary">
          <outline text="Forehead, cornea, upper lid, nasal dorsum"/>
        </outline>
        <outline text="Maxillary via rotundum to pterygopalatine fossa">
          <outline text="Midface, upper teeth, palate, maxillary sinus"/>
        </outline>
        <outline text="Mandibular exits ovale with motor root">
          <outline text="Motor: mastication, mylohyoid, tensors"/>
        </outline>
        <outline text="Lingual nerve receives chorda tympani"/>
        <outline text="Injury level determines deficit pattern"/>
      </outline>
      <outline text="Facial nerve">
        <outline text="Meatus, facial canal, geniculate, stylomastoid"/>
        <outline text="Branches within the canal">
          <outline text="Greater petrosal to pterygopalatine ganglion"/>
          <outline text="Nerve to stapedius"/>
          <outline text="Chorda tympani: taste and salivary fibres"/>
        </outline>
        <outline text="Parotid plexus and five terminal branches">
          <outline text="Does not supply parotid secretion"/>
        </outline>
        <outline text="Intracranial lesion: taste, tears, stapedius"/>
        <outline text="Upper motor-neuron lesion spares forehead">
          <outline text="Bilateral cortical input"/>
        </outline>
      </outline>
      <outline text="Lower cranial nerves">
        <outline text="Glossopharyngeal: stylopharyngeus, posterior tongue">
          <outline text="Carotid sinus and body afferents"/>
          <outline text="Parotid via lesser petrosal and otic ganglion"/>
        </outline>
        <outline text="Vagus descends in carotid sheath">
          <outline text="Superior laryngeal: internal sensory, external motor"/>
        </outline>
        <outline text="Accessory superficial in posterior triangle">
          <outline text="Weak shoulder elevation, head rotation"/>
        </outline>
        <outline text="Hypoglossal hooks over hyoglossus">
          <outline text="Vulnerable in submandibular, carotid surgery"/>
        </outline>
      </outline>
      <outline text="Autonomic ganglia">
        <outline text="Four parasympathetic ganglia with trigeminal branches">
          <outline text="Ciliary: oculomotor to eye"/>
          <outline text="Pterygopalatine: greater petrosal to glands"/>
          <outline text="Submandibular: chorda tympani to two glands"/>
          <outline text="Otic: glossopharyngeal to parotid"/>
        </outline>
        <outline text="Postganglionic fibres hitchhike on trigeminal"/>
        <outline text="Sympathetic fibres pass through without synapse">
          <outline text="Shared routes give combined deficits"/>
        </outline>
        <outline text="Horner syndrome">
          <outline text="Ptosis, miosis, apparent enophthalmos"/>
          <outline text="Anhidrosis localises pre or postganglionic"/>
        </outline>
      </outline>
      <outline text="Arterial supply">
        <outline text="Internal carotid: petrous, cavernous, orbit, brain"/>
        <outline text="External carotid: face, scalp, dura, neck"/>
        <outline text="Maxillary artery through two fossae">
          <outline text="Middle meningeal via foramen spinosum"/>
          <outline text="Sphenopalatine: key in epistaxis"/>
        </outline>
        <outline text="Vertebral enters C6 foramen, curves round atlas"/>
        <outline text="Carotid anastomoses: collateral or embolic route"/>
      </outline>
      <outline text="Venous drainage">
        <outline text="Dural sinuses are valveless channels"/>
        <outline text="Superior sagittal to transverse, sigmoid, jugular"/>
        <outline text="Straight sinus receives great cerebral vein"/>
        <outline text="Cavernous sinuses communicate across midline"/>
        <outline text="Pterygoid plexus links face and cavernous sinus"/>
        <outline text="Emissary veins valveless through foramina">
          <outline text="Equalise pressure, carry infection and tumour"/>
        </outline>
      </outline>
      <outline text="Lymphatics">
        <outline text="Superficial ring drains to deep cervical chain"/>
        <outline text="Deep nodes follow internal jugular"/>
        <outline text="Clinical levels guide cancer surgery"/>
        <outline text="Waldeyer ring around pharyngeal entry">
          <outline text="Palatine tonsil near glossopharyngeal nerve">
            <outline text="Referred ear pain, bleeding risk"/>
          </outline>
        </outline>
        <outline text="Virchow node enlarges via thoracic duct"/>
        <outline text="Right lymphatic duct drains right upper body"/>
      </outline>
      <outline text="Localisation as routing">
        <outline text="Trace deficit from brainstem exit to lymph"/>
        <outline text="Connected pathways, not isolated names"/>
      </outline>
    </outline>
  </body>
</opml>
