<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>072-03 Management, monitoring, prevention, safety, ethics, systems issues, and longitudinal care</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Rehabilitation management and longitudinal care">
      <outline text="Principles of management">
        <outline text="Task practice, conditioning, equipment, environment"/>
        <outline text="More intensity is not always better">
          <outline text="Dose fits healing, reserve, fatigue"/>
        </outline>
        <outline text="Goals organise; measurement tests strategy"/>
      </outline>
      <outline text="Exercise prescription">
        <outline text="Frequency, intensity, time, type, progression"/>
        <outline text="Contraindications depend on intensity, not age"/>
        <outline text="Aerobic intensity">
          <outline text="Heart rate, oxygen uptake, perceived exertion"/>
          <outline text="Heart rate unreliable with beta blockade"/>
          <outline text="Warm-up and cool-down smooth transitions"/>
        </outline>
        <outline text="Resistance training">
          <outline text="Progress without pain or loss of form"/>
          <outline text="Power training helps older adults"/>
          <outline text="Avoid prolonged breath-holding"/>
        </outline>
        <outline text="Balance training challenges safely"/>
        <outline text="Stretching does not fix neural weakness"/>
      </outline>
      <outline text="Motor rehabilitation by diagnosis">
        <outline text="Stroke">
          <outline text="Repetitive task-specific practice"/>
          <outline text="Do not wait for spasticity to resolve"/>
          <outline text="Prevent shoulder pain and learned non-use"/>
        </outline>
        <outline text="Spasticity">
          <outline text="Treat triggers: pain, infection, constipation"/>
          <outline text="Splints, toxin, intrathecal, surgery"/>
          <outline text="Lower tone can worsen transfers"/>
        </outline>
        <outline text="Parkinson disease">
          <outline text="Large amplitude, cueing, freezing strategies"/>
          <outline text="Medication timing affects performance"/>
        </outline>
        <outline text="Spinal cord injury">
          <outline text="Pressure relief, transfers, wheelchair skills"/>
          <outline text="Dysreflexia: sit up, find trigger, monitor"/>
        </outline>
      </outline>
      <outline text="Assistive technology">
        <outline text="Orthoses">
          <outline text="Stabilise, assist clearance, prevent deformity"/>
          <outline text="Risk skin injury and non-use"/>
        </outline>
        <outline text="Prostheses">
          <outline text="Level, limb, cognition, capacity, goals"/>
          <outline text="Phantom pain: education, mirror, desensitise"/>
        </outline>
        <outline text="Wheelchairs: manual, powered, power-assisted"/>
        <outline text="Needs maintenance, charging, backup, funding"/>
      </outline>
      <outline text="Preventing secondary complications">
        <outline text="Pressure: weight shifts, surfaces, inspection"/>
        <outline text="Venous thrombosis follows mobility and risk"/>
        <outline text="Contracture: positioning, movement, splints"/>
        <outline text="Osteoporosis after immobility"/>
        <outline text="Respiratory care">
          <outline text="Bulbar weakness risks aspiration"/>
          <outline text="Normal saturation does not exclude risk"/>
        </outline>
        <outline text="Falls prevention integrates many factors">
          <outline text="Restricting activity increases future falls"/>
        </outline>
      </outline>
      <outline text="Fatigue, pacing, return to roles">
        <outline text="Energy conservation and delegation"/>
        <outline text="Pacing avoids overactivity and collapse">
          <outline text="Energy envelope in post-exertional syndromes"/>
        </outline>
        <outline text="Return to work begins with task analysis">
          <outline text="Graded hours, modified duties, remote work"/>
          <outline text="Disclosure is the person&#x27;s decision"/>
        </outline>
        <outline text="Driving">
          <outline text="On-road tests integrated performance"/>
          <outline text="Know reporting obligations"/>
        </outline>
        <outline text="Adaptive sport supports identity">
          <outline text="Para-sport classes are not severity scales"/>
        </outline>
      </outline>
      <outline text="Interdisciplinary care">
        <outline text="Distinct professional expertise"/>
        <outline text="Interdisciplinary integrates shared goals">
          <outline text="Multidisciplinary may stay fragmented"/>
        </outline>
        <outline text="Team meetings: barriers, accountable actions"/>
        <outline text="Patient and supporters are team members"/>
        <outline text="Early discharge planning">
          <outline text="Stable yet unsafe without home access"/>
        </outline>
      </outline>
      <outline text="Disability-informed ethics">
        <outline text="Clinicians underestimate quality of life"/>
        <outline text="Disability is not solely tragedy"/>
        <outline text="Supported communication, least restriction">
          <outline text="Informed choice of risky activity"/>
        </outline>
        <outline text="Convenience does not justify restraint"/>
        <outline text="Unequal access">
          <outline text="Rapid-gain selection excludes severe disability"/>
          <outline text="Allocate by need and equity"/>
        </outline>
      </outline>
      <outline text="Outcomes and sustaining gains">
        <outline text="Monitor participation and caregiver burden"/>
        <outline text="No progress prompts review">
          <outline text="Diagnosis, dose, mood, equipment, goal"/>
        </outline>
        <outline text="Maintenance">
          <outline text="Community exercise, self-management"/>
          <outline text="Ageing, pregnancy, caregiver change destabilise"/>
        </outline>
        <outline text="Success: skills, supports, environment"/>
      </outline>
    </outline>
  </body>
</opml>
