<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>058-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="アレルギー、免疫不全、移植、免疫療法">
      <outline text="概説">
        <outline text="自己や無害な抗原を傷つけず脅威を排除">
          <outline text="破綻でアレルギー、自己免疫、免疫不全"/>
        </outline>
        <outline text="免疫修飾治療は毒性を伴う"/>
        <outline text="障害経路を特定し合併症を先に予防"/>
      </outline>
      <outline text="過敏反応の機序">
        <outline text="即時型：免疫グロブリンEの架橋">
          <outline text="ヒスタミン、トリプターゼ、ロイコトリエン"/>
          <outline text="血管拡張、漏出、平滑筋収縮">
            <outline text="蕁麻疹、血管性浮腫、気管支攣縮、ショック"/>
          </outline>
        </outline>
        <outline text="感作は必ずしも臨床的アレルギーでない"/>
        <outline text="細胞傷害：細胞・基質、補体、受容体"/>
        <outline text="免疫複合体は血管、糸球体、関節、皮膚で炎症"/>
        <outline text="遅延型：T細胞媒介、数時間から数日">
          <outline text="接触皮膚炎、多くの薬疹"/>
        </outline>
      </outline>
      <outline text="アレルギー歴と検査">
        <outline text="誘因、経路、量、時間、以前の耐容を記録"/>
        <outline text="補助因子：運動、アルコール、感染、喘息"/>
        <outline text="不耐容、毒性、血管迷走神経反応と区別">
          <outline text="不正確な表示は第一選択治療を妨げる"/>
        </outline>
        <outline text="特異的免疫グロブリンE検査は感作を検出">
          <outline text="確率を変えるが重症度は予測しない"/>
          <outline text="広範な食物パネルは偽陽性を生む"/>
        </outline>
        <outline text="監視下負荷試験が診断基準となることが多い"/>
      </outline>
      <outline text="アナフィラキシー">
        <outline text="気道、呼吸、循環を脅かす急速な全身反応">
          <outline text="皮膚症状を伴わないこともある"/>
          <outline text="検査確認を待たずに治療"/>
        </outline>
        <outline text="アドレナリンを大腿前外側へ筋注"/>
        <outline text="下肢挙上仰臥位、立位で虚脱の危険">
          <outline text="妊娠中は左側臥位、意識なしは回復体位"/>
        </outline>
        <outline text="高流量酸素、静脈路、等張晶質液"/>
        <outline text="補助治療はアドレナリンの代わりでない">
          <outline text="抗ヒスタミン薬は皮膚症状のみ軽減"/>
          <outline text="コルチコステロイドに即時救命効果なし"/>
        </outline>
        <outline text="難治例：監視下アドレナリン静注持続">
          <outline text="ベータ遮断薬で反応低下、グルカゴン検討"/>
        </outline>
        <outline text="二相性再発に応じて観察"/>
        <outline text="退院時：紹介、自己注射器、行動計画"/>
      </outline>
      <outline text="蕁麻疹、血管性浮腫、アレルギー疾患">
        <outline text="膨疹は移動し一日以内に消失"/>
        <outline text="慢性特発性蕁麻疹は自己免疫性が多い">
          <outline text="第二世代抗ヒスタミン薬が第一選択"/>
        </outline>
        <outline text="ヒスタミン性：掻痒・膨疹、標準治療に反応"/>
        <outline text="ブラジキニン性血管性浮腫">
          <outline text="アンジオテンシン変換酵素阻害薬・遺伝性"/>
          <outline text="蕁麻疹なく、アドレナリン反応が乏しい"/>
          <outline text="気道保護、原因特異的阻害薬"/>
        </outline>
        <outline text="アトピー疾患は上皮バリアと二型免疫を共有"/>
        <outline text="経口免疫療法は閾値を上げるが自由摂取不可"/>
      </outline>
      <outline text="原発性免疫不全">
        <outline text="抗体、T細胞、食細胞、補体、免疫調節"/>
        <outline text="一般的感染を超える警告パターン">
          <outline text="重症、反復、日和見、通常と異なる部位"/>
          <outline text="成長不良、深部膿瘍、臍帯脱落遅延"/>
        </outline>
        <outline text="表現型で検査、年齢・薬剤・疾患が影響"/>
        <outline text="抗体不全に免疫グロブリン補充"/>
        <outline text="細胞性免疫不全で生ワクチン回避"/>
        <outline text="重症例に造血幹細胞移植・遺伝子治療"/>
      </outline>
      <outline text="続発性免疫不全">
        <outline text="パターンが病原体を予測">
          <outline text="好中球減少：細菌と真菌"/>
          <outline text="T細胞障害：ウイルス、抗酸菌、原虫"/>
          <outline text="抗体不全：莢膜を持つ細菌"/>
        </outline>
        <outline text="ヒト免疫不全ウイルスはCD4陽性T細胞枯渇">
          <outline text="多剤併用療法を速やかに開始し抑制"/>
        </outline>
        <outline text="脾機能喪失：莢膜を持つ細菌の劇症感染"/>
      </outline>
      <outline text="免疫抑制療法と生物学的製剤">
        <outline text="糖質コルチコイドは炎症を広範に抑制">
          <outline text="代謝、骨、眼、気分への毒性"/>
          <outline text="副腎抑制：突然中止しない"/>
        </outline>
        <outline text="毒性は機序に従う">
          <outline text="腫瘍壊死因子阻害で結核再活性化"/>
          <outline text="補体阻害で髄膜炎菌リスク上昇"/>
          <outline text="チェックポイント阻害薬はほぼ全臓器に炎症"/>
        </outline>
        <outline text="事前評価と不活化ワクチン接種"/>
        <outline text="発熱が目立たず白血球正常でも重症感染"/>
        <outline text="発熱性好中球減少症：直ちに抗緑膿菌薬"/>
      </outline>
      <outline text="移植">
        <outline text="時期による拒絶">
          <outline text="超急性：数分から数時間"/>
          <outline text="急性：数日から数か月"/>
          <outline text="慢性：血管と間質の進行性損傷"/>
        </outline>
        <outline text="他の移植片障害にはしばしば生検"/>
        <outline text="維持療法：カルシニューリン阻害薬など三剤">
          <outline text="毒性のため薬物血中濃度を監視"/>
        </outline>
        <outline text="感染：早期は外科的、後に日和見"/>
        <outline text="前処置は骨髄と粘膜を損傷">
          <outline text="移植片対宿主病と移植片対腫瘍効果"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
