<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>028-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="運動制御の基礎">
      <outline text="分散した運動制御">
        <outline text="脊髄回路は反射とパターン出力"/>
        <outline text="脳幹は姿勢、平衡、注視、定位"/>
        <outline text="運動皮質は熟練動作を規定"/>
        <outline text="大脳基底核は動作を選択し調節"/>
        <outline text="小脳は予測、比較、適応"/>
        <outline text="筋力低下、筋緊張、反射、歩行で局在"/>
      </outline>
      <outline text="運動単位と筋力">
        <outline text="アルファ運動ニューロンと支配筋線維">
          <outline text="小さい単位は精密、大きい単位は力"/>
        </outline>
        <outline text="発火頻度増加と大きな単位の動員"/>
        <outline text="非同期的活性化で収縮が滑らか"/>
        <outline text="アセチルコリンによる神経筋伝達">
          <outline text="ニコチン性終板電位からNaチャネル"/>
          <outline text="受容体減少や放出障害で安全率破綻"/>
        </outline>
        <outline text="下位運動ニューロン喪失は萎縮と線維束性収縮"/>
        <outline text="神経筋接合部疾患は感覚障害なき易疲労性"/>
        <outline text="筋疾患は左右対称の近位筋力低下"/>
      </outline>
      <outline text="筋紡錘と腱器官">
        <outline text="筋紡錘は並列で筋長と伸展速度を検出">
          <outline text="Iaは同じ筋を興奮、拮抗筋を抑制"/>
          <outline text="ガンマ運動ニューロンが感度を保持"/>
        </outline>
        <outline text="腱器官は直列でIbにより張力を感知">
          <outline text="負荷を分配し歩行にも柔軟に関与"/>
        </outline>
        <outline text="どの受容器も単独では働かない"/>
      </outline>
      <outline text="脊髄反射">
        <outline text="伸張反射は突然の伸長に抵抗"/>
        <outline text="腱叩打は反射弓全体を評価">
          <outline text="注意、年齢、手技で大きさが変化"/>
          <outline text="単独の尺度より対称性と他徴候"/>
        </outline>
        <outline text="屈曲逃避反射と交叉性伸展反射"/>
        <outline text="レンショウ細胞の反回抑制と相反抑制"/>
        <outline text="脊髄ショック後に反射亢進"/>
        <outline text="中枢パターン発生器は下行性開始が必要"/>
      </outline>
      <outline text="下行性経路">
        <outline text="皮質脊髄路は下部延髄で交叉">
          <outline text="外側皮質脊髄路は対側遠位の熟練運動"/>
        </outline>
        <outline text="皮質延髄路入力は多くが両側性">
          <outline text="顔面下部と舌は対側性優位"/>
          <outline text="大脳半球病変では額が保たれる"/>
        </outline>
        <outline text="網様体脊髄路は筋緊張、姿勢、歩行"/>
        <outline text="前庭脊髄路は重力に対し安定"/>
        <outline text="視蓋脊髄路は刺激へ頭頸部を向ける"/>
        <outline text="ショック消失後の上位運動ニューロン病変">
          <outline text="反射亢進、クローヌス、伸展性足底反射"/>
          <outline text="痙縮は速度依存性、固縮は非依存"/>
        </outline>
      </outline>
      <outline text="運動皮質と運動計画">
        <outline text="一次運動野は力の方向と遂行"/>
        <outline text="運動前野は外的手掛かりを利用"/>
        <outline text="補足運動野は系列動作と両手協調"/>
        <outline text="後頭頂皮質は空間情報を計画へ変換"/>
        <outline text="運動地図は重なり学習で変化"/>
        <outline text="遠心性コピーで感覚結果を予測"/>
        <outline text="練習で必要な注意量が減る"/>
      </outline>
      <outline text="小脳の構造と機能">
        <outline text="意図した計画と実際の遂行を比較"/>
        <outline text="反復する小脳皮質回路">
          <outline text="登上線維は教師信号"/>
          <outline text="プルキンエ細胞は深部核を抑制"/>
        </outline>
        <outline text="正中部は体軸、外側は計画とタイミング"/>
        <outline text="内部モデルが誤差に基づく学習を支える"/>
        <outline text="小脳半球病変は同側四肢に徴候"/>
        <outline text="測定障害、企図振戦、開脚性歩行"/>
        <outline text="感覚性運動失調は閉眼で悪化"/>
      </outline>
      <outline text="大脳基底核回路">
        <outline text="運動、認知、辺縁系の並列ループ"/>
        <outline text="抑制性出力が皮質の動作を選ぶ"/>
        <outline text="直接路は選択された動作を促進"/>
        <outline text="間接路は競合する動作を抑制"/>
        <outline text="ドパミンはD1で直接路、D2で間接路低下"/>
        <outline text="ドパミン減少によるパーキンソニズム">
          <outline text="補充療法は有効だがジスキネジア"/>
        </outline>
        <outline text="舞踏運動、ジストニア、チック、バリズム"/>
        <outline text="ドパミン遮断薬で急性ジストニア等"/>
      </outline>
      <outline text="姿勢、歩行、平衡">
        <outline text="静かな立位も能動的">
          <outline text="足関節、股関節、踏み出し戦略"/>
        </outline>
        <outline text="随意運動に先立つ予測的姿勢調整"/>
        <outline text="加齢、ニューロパチー、鎮静薬で予備能低下"/>
        <outline text="歩行パターンが障害部位を示す">
          <outline text="パーキンソン歩行は小刻みとすくみ足"/>
          <outline text="前頭葉性歩行障害は開始が障害"/>
        </outline>
      </outline>
      <outline text="運動学習とリハビリテーション">
        <outline text="機能の回復、代償、練習、環境調整"/>
        <outline text="課題特異的で難度があり安全な反復"/>
        <outline text="過剰な外部修正は自立した制御を妨げる"/>
        <outline text="疼痛、拘縮、機能のため痙縮を治療">
          <outline text="硬さが移乗の支えになり得る"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
