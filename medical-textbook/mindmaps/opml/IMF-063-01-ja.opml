<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>063-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="未分化急性疾患の基礎">
      <outline text="概説">
        <outline text="未分化症状は診断名ではない"/>
        <outline text="良性自然軽快から時間的猶予のない破綻まで">
          <outline text="循環、呼吸、脳、代謝、生体防御"/>
        </outline>
        <outline text="安定化、定義、危険パターン、機序的鑑別"/>
        <outline text="反復診察と治療反応で確率を更新"/>
      </outline>
      <outline text="普遍的な初期評価">
        <outline text="質問する前に観察する">
          <outline text="気道、呼吸、灌流、体温、意識、血糖"/>
        </outline>
        <outline text="早期の心電図">
          <outline text="虚脱、めまい、胸部症状、動悸、高齢"/>
        </outline>
        <outline text="妊娠検査はほぼすべての鑑別を変える"/>
        <outline text="検査と並行して即時の脅威を治療">
          <outline text="低血糖、低酸素、アナフィラキシー、ショック等"/>
        </outline>
        <outline text="一過性疾患後の正常観察値は安全を証明しない">
          <outline text="来院前、回復、基礎機能、再発リスク"/>
        </outline>
      </outline>
      <outline text="発熱と体温">
        <outline text="発熱は視床下部設定値の調節性上昇"/>
        <outline text="高体温は調節されない熱の蓄積">
          <outline text="解熱薬に反応しない"/>
        </outline>
        <outline text="悪寒は急速上昇、菌血症とは限らない"/>
        <outline text="高熱なしの重症感染">
          <outline text="高齢、フレイル、妊娠、免疫抑制、薬剤"/>
        </outline>
        <outline text="病歴、曝露、全身の診察">
          <outline text="定着菌部位から無差別に培養しない"/>
        </outline>
        <outline text="敗血症は調節不全反応による臓器機能障害">
          <outline text="抗菌薬を遅らせず培養を採取"/>
          <outline text="灌流回復、酸素、感染源制御"/>
        </outline>
        <outline text="非感染性発熱">
          <outline text="薬剤熱は発疹や好酸球増加を欠き得る"/>
        </outline>
        <outline text="高体温症候群は急速冷却が必要"/>
        <outline text="持続する発熱は再評価し自動広域化しない"/>
      </outline>
      <outline text="虚脱と一過性意識消失">
        <outline text="虚脱が何を意味したか確認"/>
        <outline text="失神は全脳灌流の一過性低下">
          <outline text="急速発症、短時間、自然で完全な回復"/>
        </outline>
        <outline text="本人と目撃者からの情報"/>
        <outline text="反射性失神は疼痛、恐怖、暑熱、立位"/>
        <outline text="起立性失神は立位への代償不十分">
          <outline text="無症候性低下、初回正常でも除外不可"/>
        </outline>
        <outline text="心原性失神は不整脈、閉塞、塞栓、ポンプ">
          <outline text="労作中、仰臥位、前駆なし、家族突然死"/>
          <outline text="監視期間は事象頻度に合わせる"/>
        </outline>
        <outline text="痙攣所見は前兆、強直後間代、舌側面損傷">
          <outline text="失神でも短いけいれん様運動が起こる"/>
        </outline>
        <outline text="心因性非てんかん発作は陽性診断を要する"/>
        <outline text="意識消失を伴わない虚脱">
          <outline text="高齢者は多因子、外傷と安全保護"/>
        </outline>
      </outline>
      <outline text="めまいと回転性めまい">
        <outline text="症状を表す言葉は一貫しない"/>
        <outline text="時間と誘因で分類">
          <outline text="誘発性反復、自発性反復、持続性急性"/>
        </outline>
        <outline text="頭位誘発の短時間発作は良性発作性頭位めまい症"/>
        <outline text="自発性発作は片頭痛、メニエール、不整脈等"/>
        <outline text="持続性は前庭神経炎か後方循環脳卒中"/>
        <outline text="頭部インパルス、眼振、斜偏位検査">
          <outline text="自発眼振ありの持続性のみ、訓練者が実施"/>
        </outline>
        <outline text="脳卒中を懸念させる所見">
          <outline text="頭痛、局所症状、垂直眼振、立位不能"/>
        </outline>
        <outline text="早期CTとMRIは後頭蓋窩虚血を見逃し得る"/>
      </outline>
      <outline text="全身性筋力低下と疲労">
        <outline text="筋力低下、疲労、眠気は異なる"/>
        <outline text="突然の局所性筋力低下は脳卒中とみなす"/>
        <outline text="上行性、球麻痺、呼吸症状は緊急監視"/>
        <outline text="診察で局在を診断">
          <outline text="疼痛と理解不良は筋力低下に似る"/>
        </outline>
        <outline text="ギラン・バレーは対称性筋力低下と反射低下">
          <outline text="努力性肺活量を連続測定、飽和度は遅れる"/>
        </outline>
        <outline text="重症筋無力症は変動し感覚は保たれる"/>
        <outline text="ボツリヌス症は下行性、自律神経と瞳孔"/>
        <outline text="カリウム、リン、マグネシウム異常で麻痺"/>
        <outline text="客観的筋力低下のない疲労">
          <outline text="病歴に基づいて検査を選ぶ"/>
          <outline text="障害を認め誤った確信を与えない"/>
        </outline>
      </outline>
      <outline text="標的を定めた検査">
        <outline text="症候群に応じた基本検査"/>
        <outline text="臨床的問いに答える場合のみ追加"/>
        <outline text="事前確率を用いて解釈">
          <outline text="軽度異常は注意をそらす"/>
          <outline text="時点不適切な正常値で鑑別を終えない"/>
        </outline>
        <outline text="無差別検査は偶発所見と検査連鎖を生む"/>
        <outline text="処遇が安全な理由を記録"/>
      </outline>
      <outline text="治療、観察、安全網">
        <outline text="診断情報を保ちつつ脅威を治療"/>
        <outline text="体液不足には補液、反射的急速投与はしない"/>
        <outline text="原因薬剤を中止し再開基準を定める"/>
        <outline text="観察は能動的診断戦略">
          <outline text="期間、反復観察、対応強化基準"/>
        </outline>
        <outline text="退院前確認は基礎状態、機能、担当者"/>
        <outline text="不確実性を説明し具体的再受診条件を伝える"/>
      </outline>
    </outline>
  </body>
</opml>
