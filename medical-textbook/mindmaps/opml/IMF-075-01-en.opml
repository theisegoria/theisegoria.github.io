<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>075-01 Anatomical orientation, body organisation, variation, and relationships</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Anatomical orientation and relationships">
      <outline text="Relational language">
        <outline text="Supports physiology and clinical localisation"/>
        <outline text="Consistent across position, plane, organ shift"/>
        <outline text="Conventions, not the observer&#x27;s viewpoint"/>
      </outline>
      <outline text="Anatomical position and planes">
        <outline text="Upright, facing forward, palms anterior"/>
        <outline text="Right and left refer to the subject">
          <outline text="Prone position or rotated image changes nothing"/>
        </outline>
        <outline text="Paired directional terms">
          <outline text="Superior-inferior, anterior-posterior"/>
          <outline text="Medial-lateral relative to the midline"/>
          <outline text="Proximal-distal need a stated origin"/>
          <outline text="Superficial-deep measure distance from surface"/>
        </outline>
        <outline text="Internal-external: inside or outside a structure">
          <outline text="Not generally medial and lateral"/>
        </outline>
        <outline text="Deep and lateral are independent relations"/>
        <outline text="Sagittal, coronal, transverse, oblique planes">
          <outline text="Section appearance depends on plane and convention"/>
        </outline>
        <outline text="Imaging display conventions">
          <outline text="Axial viewed from feet: right on viewer&#x27;s left"/>
          <outline text="Coronal viewed facing the patient"/>
          <outline text="Sagittal needs orientation markers"/>
        </outline>
      </outline>
      <outline text="Movement about joints">
        <outline text="Flexion decreases, extension increases angle"/>
        <outline text="Dorsiflexion and plantarflexion at the ankle"/>
        <outline text="Abduction and adduction relative to midline"/>
        <outline text="Rotation around a longitudinal axis">
          <outline text="Supinated palm anterior, pronated posterior"/>
          <outline text="Inversion and eversion of the sole"/>
        </outline>
        <outline text="Opposition and reposition of the thumb"/>
        <outline text="Elevation, depression, protraction, retraction"/>
        <outline text="Circumduction combines movements in a cone"/>
        <outline text="Terms give direction, not muscle or force">
          <outline text="Path set by geometry, ligaments, muscles, load"/>
        </outline>
      </outline>
      <outline text="Regions and cavities">
        <outline text="Axial body versus appendicular limbs"/>
        <outline text="Abdominal quadrants or nine regions">
          <outline text="Organs cross boundaries and shift"/>
        </outline>
        <outline text="Cranial and vertebral cavities hold the CNS"/>
        <outline text="Ventral cavity divided by the diaphragm">
          <outline text="Thorax: two pleural cavities and mediastinum"/>
        </outline>
        <outline text="Peritoneal cavity is a potential space">
          <outline text="Intraperitoneal organs suspended by mesentery"/>
          <outline text="Retroperitoneal organs: primary or secondary"/>
        </outline>
        <outline text="Serous membranes: parietal and visceral layers">
          <outline text="Air, blood, or fluid expands the spaces">
            <outline text="Organ function impaired"/>
          </outline>
        </outline>
      </outline>
      <outline text="Tissue layers and continuity">
        <outline text="Superficial fascia permits skin movement"/>
        <outline text="Deep fascia invests muscles, forms compartments"/>
        <outline text="Tendons, aponeuroses, ligaments"/>
        <outline text="Raphe, retinaculum, bursa: form and function"/>
        <outline text="Arteries leave the heart regardless of oxygen"/>
        <outline text="Anastomoses may provide collateral flow">
          <outline text="Presence does not guarantee capacity"/>
        </outline>
        <outline text="Lymphatics return fluid via regional nodes">
          <outline text="Explain oedema, infection spread, metastasis"/>
          <outline text="Sentinel node, but pathways can change"/>
        </outline>
      </outline>
      <outline text="Organs by surfaces and relations">
        <outline text="Relations predict structures at risk"/>
        <outline text="Hilum: where vessels and ducts enter"/>
        <outline text="Mesenteries carry vessels, allow movement"/>
        <outline text="Adventitia blends, serosa gives free surface"/>
        <outline text="Hollow organ wall layers">
          <outline text="Mucosa, submucosa, muscle, outer layer"/>
          <outline text="Arrangement predicts spread of disease"/>
        </outline>
      </outline>
      <outline text="Anatomical variation">
        <outline text="Vessels, muscles, nerves, organs, ducts, skeleton"/>
        <outline text="Most asymptomatic, some alter procedure risk"/>
        <outline text="Variant versus anomaly: prevalence and function"/>
        <outline text="Malformation, disruption, deformation, dysplasia"/>
        <outline text="Laterality: organ reversal to heterotaxy"/>
        <outline text="Plan on the patient&#x27;s actual anatomy"/>
        <outline text="Averages are not rigid categories">
          <outline text="Gender identity does not establish organs"/>
        </outline>
      </outline>
      <outline text="Surface anatomy as a probabilistic map">
        <outline text="Palpable bones, tendons, pulses, creases"/>
        <outline text="Projections shift with breathing and position"/>
        <outline text="Ultrasound gives direct visual guidance"/>
        <outline text="Dermatomes and nerve territories overlap">
          <outline text="Sensory loss rarely follows drawn lines"/>
        </outline>
        <outline text="Myotomes: predominant root contribution"/>
        <outline text="Translate among body, dissection, diagram, image"/>
      </outline>
    </outline>
  </body>
</opml>
