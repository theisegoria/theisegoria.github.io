<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>013-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="換気、灌流、拡散、ガス運搬">
      <outline text="概説と機能解剖">
        <outline text="酸素化と換気は別の概念である">
          <outline text="肺胞換気が二酸化炭素排出を決める"/>
        </outline>
        <outline text="伝導気道は加温、加湿、濾過を行う">
          <outline text="大きな気道は軟骨、小さな気道は平滑筋"/>
        </outline>
        <outline text="I型肺胞上皮細胞が薄い拡散面を作る"/>
        <outline text="II型細胞はサーファクタント産生と修復"/>
        <outline text="境界面：上皮、間質、内皮、血漿、赤血球膜"/>
        <outline text="肺循環は通常、低圧かつ低抵抗">
          <outline text="気管支動脈が少量の生理的シャントを作る"/>
        </outline>
      </outline>
      <outline text="換気と死腔">
        <outline text="分時換気量は一回換気量と呼吸数の積"/>
        <outline text="解剖学的死腔は伝導気道内に残る"/>
        <outline text="肺胞死腔は換気されるが灌流がない"/>
        <outline text="肺胞換気はまず死腔量を差し引く">
          <outline text="500ミリリットル12回で毎分4.2リットル"/>
          <outline text="250ミリリットル24回で毎分2.4リットル"/>
          <outline text="同じ分時換気量でも排出能は低い"/>
          <outline text="機序の説明であり設定の指示ではない"/>
        </outline>
        <outline text="依存部肺胞は小さいがコンプライアンスが高い"/>
      </outline>
      <outline text="肺胞気と分圧">
        <outline text="加湿により吸入酸素分圧が低下する"/>
        <outline text="肺胞酸素は吸入酸素、気圧、二酸化炭素に依存"/>
        <outline text="高地では濃度でなく気圧が低下する"/>
        <outline text="低換気は二酸化炭素を上げ酸素を下げる">
          <outline text="連動する変化が純粋な低換気を区別する"/>
        </outline>
      </outline>
      <outline text="拡散">
        <outline text="表面積、拡散係数、分圧勾配で上昇する"/>
        <outline text="膜が厚いほど低下する"/>
        <outline text="二酸化炭素は溶解度が高く拡散しやすい"/>
        <outline text="肺気腫は交換表面積を破壊する"/>
        <outline text="線維症と肺水腫は拡散距離を延長する"/>
        <outline text="一酸化炭素は毛細血管内分圧が低い">
          <outline text="肺気腫、線維症、貧血、肺血管疾患で低値"/>
          <outline text="肺胞出血では高値となり得る"/>
        </outline>
      </outline>
      <outline text="換気血流比">
        <outline text="全肺平均は大きな局所差を覆い隠す"/>
        <outline text="肺尖部は換気より灌流の低下が大きい"/>
        <outline text="肺底部は灌流が優位で比率が低い"/>
        <outline text="低酸素性肺血管収縮が血流を振り向ける">
          <outline text="広範囲の低酸素は肺動脈圧を上げる"/>
        </outline>
        <outline text="シャントは換気を伴わない灌流である">
          <outline text="肺胞虚脱、液体や膿、心内右左シャント"/>
          <outline text="酸素投与への反応は不完全である"/>
        </outline>
        <outline text="死腔は有効灌流を伴わない換気である"/>
        <outline text="較差は不均衡やシャントで増大する"/>
      </outline>
      <outline text="酸素運搬">
        <outline text="含量はヘモグロビン、飽和度、溶解酸素"/>
        <outline text="分圧は拡散と飽和度を決める"/>
        <outline text="協同的結合により解離曲線はS字状">
          <outline text="平坦部は肺での飽和度を保つ"/>
          <outline text="急峻部は組織での酸素放出を促す"/>
        </outline>
        <outline text="右方移動：二酸化炭素、酸、熱、2,3-BPG"/>
        <outline text="貧血は飽和度正常でも含量を下げる"/>
        <outline text="一酸化炭素は部位占拠と親和性上昇を起こす"/>
        <outline text="メトヘモグロビンは鉄が酸化され結合できない"/>
      </outline>
      <outline text="二酸化炭素運搬と酸塩基">
        <outline text="溶存、カルバミノ、主に重炭酸として運ぶ"/>
        <outline text="炭酸脱水酵素が赤血球内で反応を促進"/>
        <outline text="ヘモグロビンが緩衝し塩化物と交換される"/>
        <outline text="肺では酸素化が反応を逆転させる"/>
        <outline text="急性低換気は二酸化炭素上昇とpH低下"/>
        <outline text="過換気は二酸化炭素低下とpH上昇"/>
      </outline>
      <outline text="運動、高地、胎児循環">
        <outline text="心拍出量、換気、灌流、拡散能が協調して増える"/>
        <outline text="混合静脈血酸素は低下し動脈血は維持"/>
        <outline text="息切れだけでは障害部位を特定できない"/>
        <outline text="高地の低酸素は呼吸性アルカローシスを生む">
          <outline text="腎臓が数日かけて重炭酸を排泄する"/>
          <outline text="高地肺水腫と脳浮腫の危険がある"/>
          <outline text="重症では下山と酸素投与を優先する"/>
        </outline>
        <outline text="胎児のガス交換は胎盤で行われる">
          <outline text="胎児ヘモグロビンは酸素親和性が高い"/>
          <outline text="出生：肺拡張、胎盤分離、シャント閉鎖"/>
        </outline>
      </outline>
      <outline text="臨床的解釈とオキシメータの限界">
        <outline text="低酸素血症には五つの機序がある"/>
        <outline text="高二酸化炭素血症の主な機序は低換気"/>
        <outline text="酸素投与下の正常飽和度は換気を保証しない"/>
        <outline text="正常な二酸化炭素値も不適切なことがある"/>
        <outline text="オキシメータは拍動性光吸収から推定する">
          <outline text="低灌流、体動、異常ヘモグロビンで精度低下"/>
        </outline>
        <outline text="二酸化炭素、pH、含量は測定しない"/>
        <outline text="安心できる数値が悪化を覆してはならない"/>
      </outline>
    </outline>
  </body>
</opml>
