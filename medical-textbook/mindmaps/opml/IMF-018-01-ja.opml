<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>018-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="ナトリウム、水、カリウム、体液量の調節">
      <outline text="総量と濃度を分ける">
        <outline text="体内ナトリウム量が細胞外液量を決める"/>
        <outline text="溶質に対する水が血漿ナトリウムを決める"/>
        <outline text="容量減少でもナトリウムは高低いずれもあり得る"/>
        <outline text="カリウムは総量が変わらず血漿濃度が動く"/>
      </outline>
      <outline text="体液区画と張度">
        <outline text="細胞内液が体内水分の大部分を占める"/>
        <outline text="細胞外液は血漿、間質液、経細胞液"/>
        <outline text="細胞外はナトリウム、細胞内はカリウム塩"/>
        <outline text="ナトリウム・カリウムポンプが勾配を維持"/>
        <outline text="実測と計算の差が浸透圧ギャップ"/>
        <outline text="張度は有効浸透圧物質のみを数える">
          <outline text="尿素は浸透圧に寄与するが張度は弱い"/>
          <outline text="高血糖は水を引き出しナトリウムを希釈"/>
        </outline>
      </outline>
      <outline text="水分平衡と抗利尿ホルモン">
        <outline text="浸透圧受容器が口渇とホルモン分泌を促す"/>
        <outline text="ホルモンは集合管の水透過性を高める"/>
        <outline text="有効循環血液量低下は圧受容器経由で刺激">
          <outline text="体液量防御が浸透圧調節に優先する"/>
        </outline>
        <outline text="希釈尿には抑制、濾過、希釈部位、遠位送達"/>
        <outline text="濃縮尿には髄質勾配と反応性集合管"/>
        <outline text="排泄可能な溶質量が自由水排泄を制限"/>
      </outline>
      <outline text="低ナトリウム血症">
        <outline text="交換可能陽イオンに対する水の過剰"/>
        <outline text="まず低張性かどうかを判断する">
          <outline text="高血糖は高張性低ナトリウム血症"/>
          <outline text="脂質やタンパク質は偽性低ナトリウム血症"/>
        </outline>
        <outline text="低容量性は消化管または腎性ナトリウム喪失"/>
        <outline text="正常容量性は不適切ホルモン、内分泌欠乏、低溶質"/>
        <outline text="高容量性は心不全、肝硬変、腎不全、ネフローゼ"/>
        <outline text="急性重症例は脳浮腫を起こす"/>
        <outline text="慢性適応が脳の腫脹を軽減する">
          <outline text="急速補正は浸透圧性脱髄の危険"/>
        </outline>
        <outline text="高張食塩水は補正速度を厳密に管理"/>
      </outline>
      <outline text="高ナトリウム血症">
        <outline text="体内ナトリウムに対する水の欠乏"/>
        <outline text="アクセス不足、口渇障害、尿濃縮障害"/>
        <outline text="消化管や皮膚からの喪失、浸透圧利尿"/>
        <outline text="神経障害、乳幼児、フレイル、依存で高リスク"/>
        <outline text="尿崩症は産生不足または腎性抵抗性"/>
        <outline text="自由水と併せ容量、持続喪失、原因に対処"/>
        <outline text="慢性例は徐々に補正する"/>
      </outline>
      <outline text="有効循環血液量と浮腫">
        <outline text="身体は有効動脈充満を感知する"/>
        <outline text="心不全と肝硬変は浮腫下で充満不足"/>
        <outline text="交感神経、アルドステロン、ホルモン、口渇"/>
        <outline text="貯留が浮腫と希釈性低ナトリウム血症を悪化"/>
        <outline text="単一の体液量所見では確定できない"/>
        <outline text="静脈うっ血自体が腎機能を低下させる"/>
      </outline>
      <outline text="カリウムの分布と腎処理">
        <outline text="カリウムの大部分は細胞内に存在する"/>
        <outline text="インスリンとベータ2刺激が取り込みを促す"/>
        <outline text="アシドーシスの移動は酸と輸送機序による"/>
        <outline text="細胞崩壊、運動、高浸透圧、インスリン不足"/>
        <outline text="遠位分泌が可変的な調節段階である">
          <outline text="アルドステロン、カリウム、送達、流量で増加"/>
          <outline text="腎不全やチャネル遮断で減少する"/>
        </outline>
      </outline>
      <outline text="カリウム異常">
        <outline text="低カリウム血症は喪失、移動、摂取不足">
          <outline text="利尿薬、ミネラルコルチコイド過剰、嘔吐、下痢"/>
          <outline text="筋力低下、腸管麻痺、不整脈、尿濃縮能低下"/>
          <outline text="T波平低化、ST低下、U波"/>
          <outline text="マグネシウム欠乏は補正を困難にする"/>
        </outline>
        <outline text="高カリウム血症は放出、移動、排泄低下、摂取">
          <outline text="検体溶血が高値を模倣する"/>
          <outline text="尖鋭T波、P波消失、QRS幅増大"/>
          <outline text="典型的心電図変化がなくても危険"/>
          <outline text="カルシウムで安定化、インスリンで移動"/>
          <outline text="腎臓、吸着薬、透析で体外へ除去"/>
        </outline>
      </outline>
      <outline text="カルシウム、マグネシウム、リン酸">
        <outline text="活性があるのはイオン化カルシウム">
          <outline text="アルカローシスは結合を増やし活性型を下げる"/>
        </outline>
        <outline text="ビタミンD、副甲状腺、腎、膵炎で低カルシウム"/>
        <outline text="高カルシウム血症は副甲状腺機能亢進か悪性腫瘍"/>
        <outline text="マグネシウム欠乏は消化管喪失、利尿薬、飲酒">
          <outline text="治療抵抗性低カリウムとトルサードの危険"/>
        </outline>
        <outline text="リン酸欠乏はエネルギーと筋機能を障害">
          <outline text="再栄養はリン酸を細胞内へ移動させる"/>
        </outline>
      </outline>
      <outline text="輸液処方と監視">
        <outline text="維持輸液は予想される必要量を補う"/>
        <outline text="補充輸液は異常な持続喪失に合わせる"/>
        <outline text="蘇生輸液は灌流不全に対応する"/>
        <outline text="体重、出納、診察、検査値、尿量で修正"/>
        <outline text="記録上の正の出納は診察を促す所見"/>
      </outline>
    </outline>
  </body>
</opml>
