<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>090-02 一炭素代謝、ヘム合成、ビリルビン、特殊アミノ酸産物</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="一炭素代謝、ヘム、ビリルビン、特殊アミノ酸産物">
      <outline text="葉酸一炭素回路">
        <outline text="テトラヒドロ葉酸が一炭素単位を受ける"/>
        <outline text="セリンヒドロキシメチル転移酵素でグリシン"/>
        <outline text="メチレン型はチミジル酸合成を支える"/>
        <outline text="還元酵素でメチル型となる"/>
        <outline text="メチオニン合成酵素はB十二依存">
          <outline text="B十二欠乏で葉酸がメチル型へ捕捉"/>
          <outline text="総葉酸十分でもヌクレオチド合成障害"/>
        </outline>
      </outline>
      <outline text="メチル化と硫黄転移">
        <outline text="Sアデノシルメチオニンが主要メチル供与体"/>
        <outline text="DNA、RNA、タンパク質、リン脂質を修飾"/>
        <outline text="血漿ホモシステインでメチル化能は推定不可"/>
        <outline text="シスタチオニンベータ合成酵素で硫黄転移">
          <outline text="システインはグルタチオン、タウリン、硫酸へ"/>
          <outline text="重度欠損でホモシスチン尿症">
            <outline text="血栓、レンズ偏位、骨格異常"/>
          </outline>
        </outline>
        <outline text="軽度高値はビタミン欠乏、腎障害から">
          <outline text="ビタミンによる低下で事象は一貫して減らず"/>
        </outline>
      </outline>
      <outline text="葉酸とB十二欠乏">
        <outline text="葉酸欠乏はチミジル酸・プリン合成障害">
          <outline text="巨赤芽球性造血"/>
          <outline text="消化管・胎児組織も侵す"/>
        </outline>
        <outline text="B十二欠乏はメチルマロニル補酵素Aムターゼ障害">
          <outline text="メチルマロン酸上昇と神経損傷"/>
        </outline>
        <outline text="葉酸単独で神経障害が進行し得る"/>
      </outline>
      <outline text="ヘム合成">
        <outline text="プロトポルフィリン環に二価鉄"/>
        <outline text="ミトコンドリアで始まり終わる"/>
        <outline text="グリシンとスクシニル補酵素Aを縮合">
          <outline text="肝型はヘムで抑制、薬で誘導"/>
          <outline text="赤芽球型は鉄・グロビンと協調"/>
          <outline text="B六欠乏で鉄芽球性貧血"/>
        </outline>
        <outline text="亜鉛依存脱水酵素でポルフォビリノゲン"/>
        <outline text="ウロポルフィリノゲン、コプロポルフィリノゲン"/>
        <outline text="フェロケラターゼが二価鉄を挿入"/>
      </outline>
      <outline text="鉛とポルフィリン症">
        <outline text="鉛は脱水酵素とフェロケラターゼを阻害">
          <outline text="好塩基性斑点を伴う貧血"/>
          <outline text="血中鉛測定と曝露歴が中心"/>
        </outline>
        <outline text="早期前駆体で急性神経内臓発作">
          <outline text="腹痛、神経障害、低ナトリウム血症"/>
          <outline text="薬物、絶食、アルコールがヘム需要誘導"/>
        </outline>
        <outline text="後期ポルフィリンで光依存皮膚損傷">
          <outline text="尿、血漿、便、赤血球のパターン"/>
          <outline text="検体は遮光を要する"/>
        </outline>
        <outline text="前駆体抑制、鉄除去、誘因回避"/>
      </outline>
      <outline text="ビリルビン">
        <outline text="ヘムオキシゲナーゼが環を開きビリベルジン"/>
        <outline text="非抱合型はアルブミンに結合"/>
        <outline text="UDPグルクロン酸転移酵素で肝が抱合"/>
        <outline text="腸内微生物がウロビリノゲン関連物へ">
          <outline text="便の褐色色素ステルコビリン"/>
          <outline text="少量が尿ウロビリンとなる"/>
        </outline>
        <outline text="非抱合型高値は尿へ濾過されない"/>
        <outline text="抱合型高値は排泄不全・胆汁うっ滞">
          <outline text="暗色尿と淡色便"/>
        </outline>
        <outline text="新生児の核黄疸リスク">
          <outline text="産生増加、未熟抱合、腸肝循環"/>
          <outline text="光線療法で排泄しやすい異性体へ"/>
        </outline>
      </outline>
      <outline text="チロシンとトリプトファンの産物">
        <outline text="フェニルアラニン水酸化でチロシン"/>
        <outline text="カテコールアミン、甲状腺ホルモン、メラニン">
          <outline text="チロシン水酸化酵素が律速"/>
        </outline>
        <outline text="フェニルケトン尿症は脳発達を乱す">
          <outline text="早期食餌管理で知的障害を防ぐ"/>
          <outline text="テトラヒドロビオプテリン欠損は伝達物質療法"/>
        </outline>
        <outline text="トリプトファンからセロトニン、メラトニン">
          <outline text="カルチノイドでナイアシン欠乏"/>
        </outline>
      </outline>
      <outline text="ヒスタミン、ガンマアミノ酪酸、一酸化窒素">
        <outline text="ヒスチジン脱炭酸でヒスタミン">
          <outline text="アレルギー、胃酸、覚醒"/>
        </outline>
        <outline text="グルタミン酸脱炭酸でガンマアミノ酪酸"/>
        <outline text="アルギニンから一酸化窒素とシトルリン">
          <outline text="内皮型、神経型、誘導型"/>
          <outline text="補因子不足で脱共役しスーパーオキシド"/>
        </outline>
      </outline>
      <outline text="クレアチン、グルタチオン、メラニン">
        <outline text="アルギニン、グリシン、メチル基から合成">
          <outline text="クレアチンキナーゼが急速需要を緩衝"/>
          <outline text="血漿クレアチニンは分解と腎処理"/>
        </outline>
        <outline text="グルタミン酸、システイン、グリシン">
          <outline text="過酸化物無毒化と求電子物質抱合"/>
          <outline text="システイン律速でNアセチルシステイン"/>
        </outline>
        <outline text="チロシナーゼがメラノソームで開始">
          <outline text="白皮症は複数分子疾患"/>
          <outline text="網膜発達を介し視覚にも影響"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
