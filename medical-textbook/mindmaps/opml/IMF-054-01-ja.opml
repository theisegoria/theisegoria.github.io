<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>054-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="妊婦健診、妊娠合併症、分娩、産褥期">
      <outline text="二人の患者と胎盤循環">
        <outline text="正常な適応が疾患に似る"/>
        <outline text="母体の悪化が胎盤灌流を脅かす"/>
        <outline text="管理は妊娠週数で異なる"/>
      </outline>
      <outline text="妊娠の確認、週数決定、初期評価">
        <outline text="ヒト絨毛性ゴナドトロピンは栄養膜活性">
          <outline text="妊娠部位や生存性は証明しない"/>
        </outline>
        <outline text="最終月経と早期超音波で週数決定">
          <outline text="妊娠部位、胎児数、心拍、頭殿長"/>
        </outline>
        <outline text="妊娠部位不明は評価を反復">
          <outline text="子宮内、異所性、喪失の確定まで"/>
        </outline>
        <outline text="催奇形性薬と不可欠な薬剤を整理">
          <outline text="突然の中止は曝露の危険を上回る"/>
        </outline>
        <outline text="葉酸は神経管閉鎖障害を減らす"/>
      </outline>
      <outline text="母体の適応と監視">
        <outline text="血漿量が赤血球量より増加">
          <outline text="生理的希釈性貧血"/>
        </outline>
        <outline text="心拍出量増加、全身血管抵抗低下"/>
        <outline text="換気増加、二酸化炭素と重炭酸低下"/>
        <outline text="濾過増加でクレアチニンと薬物変化"/>
        <outline text="凝固系は血栓形成へ傾く"/>
        <outline text="出血、塞栓、感染への予備力低下"/>
        <outline text="遺伝学的スクリーニングは任意">
          <outline text="スクリーニングと診断、偽の結果"/>
          <outline text="絨毛検査と羊水検査は侵襲的"/>
        </outline>
      </outline>
      <outline text="妊娠初期の疼痛と出血">
        <outline text="流産症状は生存妊娠や異所性と重なる">
          <outline text="灌流、腹膜刺激、ホルモン、超音波"/>
        </outline>
        <outline text="妊娠喪失は待機、薬物、手術療法"/>
        <outline text="異所性妊娠は多くが卵管">
          <outline text="多くの患者に危険因子はない"/>
          <outline text="ホルモン値が低くても破裂し得る"/>
          <outline text="不安定例は直ちに手術と蘇生"/>
          <outline text="安定例はメトトレキサートか観察"/>
        </outline>
        <outline text="妊娠悪阻は体重減少、脱水、ケトーシス">
          <outline text="大量の炭水化物の前にチアミン"/>
        </outline>
      </outline>
      <outline text="妊娠高血圧症候群">
        <outline text="慢性高血圧は妊娠前か妊娠早期"/>
        <outline text="妊娠高血圧は後半発症、臓器障害なし"/>
        <outline text="妊娠高血圧腎症は新規高血圧と臓器障害">
          <outline text="胎盤形成異常、内皮障害、毛細血管漏出"/>
          <outline text="頭痛、視覚症状、心窩部痛は緊急"/>
        </outline>
        <outline text="降圧薬は重症高血圧の合併症を減らす"/>
        <outline text="硫酸マグネシウムは子癇発作を予防"/>
        <outline text="分娩が根治、早産リスクと均衡">
          <outline text="ステロイドで胎児肺成熟を促進"/>
        </outline>
        <outline text="選択例に低用量アスピリン"/>
      </outline>
      <outline text="妊娠中の糖尿病">
        <outline text="胎盤ホルモンがインスリン抵抗性を高める">
          <outline text="ベータ細胞の代償不十分で発症"/>
        </outline>
        <outline text="妊娠前からの糖尿病は受胎時から危険"/>
        <outline text="高血糖で先天異常、過成長、新生児低血糖"/>
        <outline text="胎盤娩出後にインスリン必要量が急減"/>
        <outline text="産後に二型糖尿病リスクを再評価"/>
      </outline>
      <outline text="胎盤および胎児の合併症">
        <outline text="前置胎盤は無痛性出血">
          <outline text="位置判明まで指による内診を避ける"/>
        </outline>
        <outline text="早期剝離は疼痛、圧痛、胎児機能不全">
          <outline text="隠れた出血で重症度を過小評価"/>
        </outline>
        <outline text="アールエイチ・ディー同種免疫">
          <outline text="抗ディー免疫グロブリンで感作予防"/>
        </outline>
        <outline text="発育不全は生体計測、羊水量、ドプラ"/>
        <outline text="早産期前期破水は感染の危険">
          <outline text="発熱、圧痛、悪臭羊水は羊膜腔内感染"/>
        </outline>
      </outline>
      <outline text="陣痛と出産">
        <outline text="子宮頸部を変化させる規則的子宮活動"/>
        <outline text="胎児心拍パターンで是正を判断">
          <outline text="低血圧、過剰収縮、臍帯圧迫"/>
        </outline>
        <outline text="進行遅延は収縮不良、胎位異常、不均衡"/>
        <outline text="肩甲難産は訓練した一連の手技"/>
        <outline text="臍帯脱出は圧迫解除と緊急分娩"/>
        <outline text="子宮破裂は瘢痕子宮、開腹術"/>
      </outline>
      <outline text="産後出血">
        <outline text="子宮弛緩、組織遺残、外傷、凝固障害"/>
        <outline text="支援要請、静脈路、保温、出血量定量"/>
        <outline text="子宮収縮薬と早期トラネキサム酸"/>
        <outline text="バルーン、塞栓術、子宮摘出へ進む"/>
        <outline text="血圧低下より先にショックが生じる"/>
      </outline>
      <outline text="産褥期と授乳">
        <outline text="子宮内膜炎、乳腺炎、尿路感染、敗血症"/>
        <outline text="下肢腫脹、頭痛、神経症状は警告">
          <outline text="血栓塞栓症、妊娠高血圧腎症、脳卒中"/>
        </outline>
        <outline text="プロラクチンは産生、オキシトシンは射乳">
          <outline text="肌と肌の接触、吸着、頻回の乳汁除去"/>
        </outline>
        <outline text="乳腺炎は排出継続、膿瘍は画像検査"/>
        <outline text="ブルーズは短期、持続症状は緊急">
          <outline text="産後精神病は緊急事態"/>
        </outline>
        <outline text="合併症を長期予防につなげる"/>
      </outline>
    </outline>
  </body>
</opml>
