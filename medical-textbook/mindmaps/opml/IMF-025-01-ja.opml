<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>025-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="生殖生理、妊娠、授乳">
      <outline text="性分化と思春期">
        <outline text="染色体上の性は受精時に決まる">
          <outline text="性腺と解剖は遺伝子とホルモンに依存"/>
        </outline>
        <outline text="精巣は抗ミュラー管ホルモンとアンドロゲン">
          <outline text="ない場合は卵巣と女性生殖路の経路"/>
        </outline>
        <outline text="差異には正確で敬意ある評価"/>
        <outline text="思春期は拍動性活動が性腺刺激ホルモンを駆動">
          <outline text="性腺ステロイドで二次性徴、成長、骨"/>
        </outline>
        <outline text="副腎アンドロゲンは体毛、部分的に独立"/>
      </outline>
      <outline text="卵巣周期">
        <outline text="顆粒膜細胞が莢膜由来アンドロゲンを変換"/>
        <outline text="エストラジオールは初期に抑制">
          <outline text="高値持続で正のフィードバックへ"/>
          <outline text="黄体形成ホルモンサージで排卵と黄体化"/>
        </outline>
        <outline text="黄体はプロゲステロンとエストラジオール">
          <outline text="着床に適した分泌期内膜"/>
        </outline>
        <outline text="妊娠がなければ黄体が退縮">
          <outline text="ホルモン低下、らせん動脈収縮、剥離"/>
        </outline>
        <outline text="周期長は卵胞期で変動、黄体期は一定"/>
        <outline text="無月経や異常出血では妊娠検査"/>
      </outline>
      <outline text="精巣機能と性反応">
        <outline text="黄体形成ホルモンがライディッヒ細胞を刺激"/>
        <outline text="卵胞刺激ホルモンとテストステロンがセルトリ細胞"/>
        <outline text="産生は数週間を要し傷害に弱い"/>
        <outline text="勃起は副交感神経性一酸化窒素">
          <outline text="平滑筋弛緩、動脈流入、静脈閉鎖"/>
        </outline>
        <outline text="射精は交感神経と体性神経経路"/>
        <outline text="性機能障害は領域を分けて評価"/>
      </outline>
      <outline text="受精、着床、胎盤">
        <outline text="胚盤胞が受容性子宮内膜へ着床"/>
        <outline text="絨毛性ゴナドトロピンが黄体を維持"/>
        <outline text="両循環を混合せず交換">
          <outline text="血流、面積、膜、代謝、濃度勾配に依存"/>
        </outline>
        <outline text="受動的フィルターでなく能動的内分泌臓器"/>
        <outline text="侵入不全で胎児発育不全、妊娠高血圧腎症"/>
        <outline text="出生前の胎盤剥離は有痛性出血"/>
        <outline text="前置胎盤は典型的に無痛性出血"/>
      </outline>
      <outline text="母体の生理的適応">
        <outline text="血漿量、赤血球量、心拍出量、心拍数が増加">
          <outline text="血漿増加が上回り生理的血液希釈"/>
        </outline>
        <outline text="うっ滞と凝固変化で血栓塞栓症リスク"/>
        <outline text="仰臥位の子宮圧迫で静脈還流低下"/>
        <outline text="プロゲステロンで換気増加">
          <outline text="二酸化炭素と重炭酸低下、軽度アルカローシス"/>
        </outline>
        <outline text="濾過量増加でクレアチニン低下"/>
        <outline text="後半のインスリン抵抗性は胎児栄養を保つ">
          <outline text="代償不全で妊娠糖尿病"/>
        </outline>
        <outline text="基準範囲と薬物動態が変わる"/>
      </outline>
      <outline text="胎児循環と出生時移行">
        <outline text="静脈管、卵円孔、動脈管">
          <outline text="高い肺抵抗と低い胎盤抵抗がシャント維持"/>
        </outline>
        <outline text="出生時は肺拡張で肺血管抵抗低下"/>
        <outline text="臍帯結紮で全身血管抵抗上昇">
          <outline text="左房圧上昇で卵円孔が機能的閉鎖"/>
        </outline>
        <outline text="酸素とプロスタグランジン低下で動脈管閉鎖"/>
        <outline text="動脈管開存に依存する先天性心疾患"/>
      </outline>
      <outline text="分娩、産後、授乳">
        <outline text="頸管伸展とオキシトシンの正のフィードバック"/>
        <outline text="胎盤剥離後は子宮収縮が血管を圧迫">
          <outline text="子宮弛緩は産後出血の主要原因"/>
        </outline>
        <outline text="ステロイドは乳房発達を促し分泌を抑制">
          <outline text="胎盤娩出後の低下でプロラクチン合成"/>
        </outline>
        <outline text="吸啜でドパミン減少、プロラクチン増加">
          <outline text="オキシトシンで射乳"/>
        </outline>
        <outline text="有効な乳汁除去が供給を維持"/>
      </outline>
      <outline text="避妊と妊孕性">
        <outline text="長時間作用型は使用者依存性が低い"/>
        <outline text="混合ホルモン法は血栓リスクを上げる"/>
        <outline text="危険因子があれば不妊を早期評価"/>
        <outline text="両パートナーを評価する"/>
      </outline>
      <outline text="閉経と生殖加齢">
        <outline text="卵胞喪失でエストラジオールとインヒビン低下">
          <outline text="性腺刺激ホルモン上昇"/>
        </outline>
        <outline text="心血管リスクは加齢と代謝因子で変化"/>
        <outline text="ホルモン療法は血管運動症状に最も有効">
          <outline text="内膜保護なしのエストロゲンでがんリスク"/>
        </outline>
      </outline>
      <outline text="妊娠中の処方と催奇形性">
        <outline text="未治療疾患が治療より危険なこともある"/>
        <outline text="初期曝露は器官形成を乱す"/>
        <outline text="後期曝露は成長、分娩、新生児適応へ"/>
        <outline text="葉酸は神経管障害リスクを下げる"/>
        <outline text="必要な治療を突然中止しない"/>
      </outline>
    </outline>
  </body>
</opml>
