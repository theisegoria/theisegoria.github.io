<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>055-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="眼の基礎">
      <outline text="概説">
        <outline text="光学系、網膜、伝導路、眼球運動、皮質"/>
        <outline text="眼症状は局所・神経・全身疾患を示す"/>
        <outline text="直ちに対応">
          <outline text="突然の視力喪失、視力低下を伴う有痛性赤眼"/>
          <outline text="化学損傷と穿通性外傷"/>
          <outline text="閉塞隅角、動脈閉塞、眼内炎、動脈炎"/>
        </outline>
      </outline>
      <outline text="光学系と網膜シグナル">
        <outline text="角膜が屈折力の大部分、水晶体が微調整">
          <outline text="毛様体筋収縮で水晶体が厚くなり近見"/>
        </outline>
        <outline text="屈折異常">
          <outline text="近視は網膜前方、遠視は後方に結像"/>
          <outline text="屈折矯正は網膜・神経性の喪失を回復しない"/>
        </outline>
        <outline text="杆体は暗所視、錐体は色覚と高視力"/>
        <outline text="光は視細胞を過分極させる">
          <outline text="双極細胞へのグルタミン酸放出が変化"/>
        </outline>
        <outline text="鼻側線維が視交叉で交差し特徴的視野欠損"/>
        <outline text="瞳孔反応は求心路と副交感神経遠心路を検査">
          <outline text="相対的求心性瞳孔障害は左右非対称な障害"/>
        </outline>
        <outline text="房水の流出抵抗が眼圧を決める"/>
      </outline>
      <outline text="病歴">
        <outline text="片眼性か両眼性か、発症、進行"/>
        <outline text="光視症、飛蚊症、カーテン、虹視、色覚低下"/>
        <outline text="一眼を覆っても複視が続くか">
          <outline text="単眼性複視は通常光学的原因"/>
          <outline text="両眼性複視は眼位ずれを反映"/>
        </outline>
        <outline text="薬剤歴">
          <outline text="ステロイドは白内障、緑内障、感染を促進"/>
          <outline text="抗コリン作用の散瞳は閉塞隅角を誘発"/>
        </outline>
      </outline>
      <outline text="診察">
        <outline text="普段の矯正で片眼ずつ視力を最初に測定">
          <outline text="ピンホールで改善すれば屈折性"/>
        </outline>
        <outline text="フルオレセインで上皮欠損を検出"/>
        <outline text="瞳孔、視野、眼球運動、遮閉試験"/>
        <outline text="眼底：赤色反射、乳頭、血管、黄斑">
          <outline text="散瞳は緊急専門診察の代わりにならない"/>
        </outline>
        <outline text="開放性眼球損傷の疑い">
          <outline text="圧迫を避け、眼帯でなく保護眼盾"/>
          <outline text="眼圧測定せず、超音波は慎重に"/>
        </outline>
      </outline>
      <outline text="赤眼">
        <outline text="結膜炎：眼脂、視力は保たれる"/>
        <outline text="角膜潰瘍：疼痛、混濁、フルオレセイン染色">
          <outline text="緊急の培養と抗微生物療法"/>
        </outline>
        <outline text="前部ぶどう膜炎：毛様充血、前房細胞">
          <outline text="ステロイド点眼はヘルペス性角膜炎を悪化"/>
        </outline>
        <outline text="強膜炎は深部痛、上強膜炎は自然軽快"/>
        <outline text="急性閉塞隅角：眼痛、虹視、中等度散瞳">
          <outline text="速やかな眼圧下降で視神経を保護"/>
        </outline>
        <outline text="化学損傷：病歴より先に洗浄">
          <outline text="アルカリは特に深く浸透"/>
        </outline>
      </outline>
      <outline text="突然の視力喪失">
        <outline text="網膜動脈閉塞：無痛性の網膜虚血">
          <outline text="巨細胞性動脈炎、塞栓源、脳卒中を評価"/>
        </outline>
        <outline text="網膜静脈閉塞：出血と浮腫"/>
        <outline text="網膜剥離：光視症、飛蚊症、カーテン">
          <outline text="後部硝子体剥離は裂孔を生じ得る"/>
          <outline text="黄斑未剥離の網膜剥離は特に緊急"/>
        </outline>
        <outline text="視神経炎：亜急性、運動時痛、色覚低下"/>
        <outline text="虚血性視神経症：突然、乳頭腫脹"/>
        <outline text="高齢者の巨細胞性動脈炎">
          <outline text="直ちにステロイドで反対側の眼を保護"/>
        </outline>
        <outline text="後頭葉障害：同名性欠損、瞳孔反応保持"/>
        <outline text="新たな視力低下を片頭痛と決めつけない"/>
      </outline>
      <outline text="緑内障">
        <outline text="進行性視神経症、眼圧上昇は必須でない"/>
        <outline text="開放隅角は無痛で周辺視野から欠損"/>
        <outline text="危険因子：加齢、家族歴、眼圧、薄い角膜"/>
        <outline text="治療は眼圧を下げる">
          <outline text="プロスタグランジン類似薬は流出を増加"/>
          <outline text="ベータ遮断薬は産生を減らし喘息を悪化"/>
          <outline text="治療継続と点眼手技が重要"/>
        </outline>
        <outline text="閉塞隅角は解剖学的治療を要する"/>
      </outline>
      <outline text="白内障、黄斑疾患、糖尿病">
        <outline text="白内障：無痛性の霧視、まぶしさ、低コントラスト"/>
        <outline text="加齢黄斑変性は中心視力を障害">
          <outline text="地図状萎縮：徐々に低下"/>
          <outline text="脈絡膜新生血管：歪視、急速な低下">
            <outline text="抗血管内皮増殖因子薬の硝子体内注射"/>
          </outline>
        </outline>
        <outline text="糖尿病網膜症：漏出から新生血管へ">
          <outline text="黄斑浮腫はどの病期でも中心視力を脅かす"/>
          <outline text="急速な血糖改善で一時的に悪化し得る"/>
        </outline>
      </outline>
      <outline text="小児および神経眼科の原則">
        <outline text="弱視：感受性期、年齢で可逆性低下"/>
        <outline text="白色瞳孔、斜視、固視不能は緊急評価">
          <outline text="網膜芽細胞腫は白色瞳孔の重要な原因"/>
        </outline>
        <outline text="複視：脳神経麻痺、接合部、甲状腺、眼窩"/>
        <outline text="有痛性眼球運動麻痺、眼球突出、発熱">
          <outline text="眼窩蜂窩織炎、海綿静脈洞、動脈瘤"/>
        </outline>
        <outline text="乳頭浮腫：頭蓋内圧亢進"/>
      </outline>
    </outline>
  </body>
</opml>
