<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>022-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="糖尿病、エネルギー代謝、肥満、代謝性緊急事態">
      <outline text="摂食、絶食、ストレス状態">
        <outline text="インスリンは摂食状態を支配">
          <outline text="アデノシン三リン酸がカリウムチャネル閉鎖"/>
          <outline text="インクレチンはブドウ糖依存性分泌を増強"/>
          <outline text="取り込み、グリコーゲン、脂質、カリウム移動"/>
          <outline text="肝ブドウ糖産生、脂肪分解、ケトン産生を抑制"/>
        </outline>
        <outline text="血糖とインスリン低下でグルカゴン上昇">
          <outline text="まず肝グリコーゲン、次に糖新生"/>
          <outline text="ケトン体が脳と筋を養いタンパク温存"/>
        </outline>
        <outline text="ストレスホルモンはインスリンに拮抗">
          <outline text="限られたベータ細胞予備能を露呈"/>
          <outline text="反復低血糖で警告が鈍化し無自覚に"/>
        </outline>
      </outline>
      <outline text="糖尿病の分類と病因">
        <outline text="1型：ベータ細胞の免疫性破壊">
          <outline text="絶対的欠乏、インスリン不可欠"/>
          <outline text="自己抗体は分類用で傷害原因でない"/>
        </outline>
        <outline text="2型：抵抗性とベータ細胞機能障害">
          <outline text="糖毒性と脂肪毒性で代償が破綻"/>
          <outline text="不均一：抵抗性型と分泌不全型"/>
        </outline>
        <outline text="単一遺伝子性、膵性、内分泌、薬剤、妊娠"/>
        <outline text="病型で治療、遺伝、ケトーシスが異なる"/>
      </outline>
      <outline text="診断とモニタリング">
        <outline text="空腹時ブドウ糖、負荷試験、糖化ヘモグロビン"/>
        <outline text="臨床像が明確でなければ再確認"/>
        <outline text="赤血球寿命変化で糖化ヘモグロビンが誤る"/>
        <outline text="センサーは方向、変動、範囲内時間"/>
        <outline text="欠乏、疾患、妊娠、共輸送体阻害薬でケトン"/>
      </outline>
      <outline text="慢性組織傷害">
        <outline text="高血糖は微小血管を傷害">
          <outline text="網膜症：漏出、虚血、血管新生"/>
          <outline text="腎疾患：アルブミン尿、濾過低下"/>
          <outline text="感覚、疼痛、自律神経ニューロパチー"/>
        </outline>
        <outline text="アテローム性心血管疾患の加速"/>
        <outline text="足潰瘍はニューロパチー、圧、虚血から"/>
        <outline text="予防は血糖治療だけではない"/>
      </outline>
      <outline text="血糖降下療法">
        <outline text="生活基盤と個別化した目標"/>
        <outline text="メトホルミンは肝産生低下、低血糖少"/>
        <outline text="スルホニル尿素薬：低血糖と体重増加"/>
        <outline text="チアゾリジン薬：浮腫、骨折、心不全"/>
        <outline text="グルカゴン様ペプチド1作動薬で食欲低下"/>
        <outline text="共輸送体2阻害薬：心臓・腎臓への利益">
          <outline text="著明な高血糖を伴わないケトアシドーシス"/>
        </outline>
        <outline text="基礎は空腹時産生、食事時は食事を担う"/>
      </outline>
      <outline text="低血糖">
        <outline text="多くはインスリンか分泌促進薬"/>
        <outline text="アドレナリン作動性症状と神経糖欠乏"/>
        <outline text="嚥下可能なら速効性炭水化物"/>
        <outline text="重度障害には静注ブドウ糖かグルカゴン"/>
        <outline text="スルホニル尿素薬関連は再発し得る"/>
      </outline>
      <outline text="糖尿病性ケトアシドーシス">
        <outline text="実効インスリン欠乏と拮抗ホルモン過剰">
          <outline text="高血糖が浸透圧利尿を起こす"/>
          <outline text="重炭酸消費で高アニオンギャップ性"/>
          <outline text="カリウムは細胞外へ、総量は枯渇"/>
        </outline>
        <outline text="ブドウ糖は中等度上昇のこともある"/>
        <outline text="輸液、インスリン、カリウム、ブドウ糖">
          <outline text="ケトーシス解消までインスリン継続"/>
        </outline>
        <outline text="感染、インスリン中断、梗塞を探索"/>
      </outline>
      <outline text="高浸透圧高血糖状態">
        <outline text="大きなケトン産生を抑えるインスリン"/>
        <outline text="浸透圧利尿で水分喪失と高張性"/>
        <outline text="高齢者や脆弱な人で緩徐に進行"/>
        <outline text="緩徐な輸液と慎重な張度補正">
          <outline text="急速な変化は神経傷害を悪化"/>
        </outline>
        <outline text="混合型は多い"/>
      </outline>
      <outline text="肥満と代謝機能障害">
        <outline text="レプチンと視床下部が体重信号を統合"/>
        <outline text="減量で空腹増加、消費低下">
          <outline text="生物学的抵抗で個人の失敗ではない"/>
        </outline>
        <outline text="内臓脂肪と異所性脂肪が合併症を促す"/>
        <outline text="体格指数だけで評価しない"/>
        <outline text="食事、活動、薬、選択的手術を併用"/>
      </outline>
      <outline text="脂質異常症と脂肪肝">
        <outline text="抵抗性がトリグリセリド粒子を増加">
          <outline text="高比重リポタンパクコレステロール低下"/>
        </outline>
        <outline text="スタチンは合成低下と受容体除去増加"/>
        <outline text="脂肪性肝疾患は脂肪蓄積からがんまで">
          <outline text="線維化でもアミノトランスフェラーゼ正常"/>
        </outline>
        <outline text="体重、活動、脂質、飲酒、予防"/>
      </outline>
    </outline>
  </body>
</opml>
