<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>080-01 Skull, scalp, face, orbit, nasal cavity, and oral cavity</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Skull, scalp, face, orbit, nose, and mouth">
      <outline text="Skull and cranial base">
        <outline text="Neurocranium surrounds brain, viscerocranium forms face"/>
        <outline text="Calvaria: outer and inner tables with diploic veins"/>
        <outline text="Sutures permit growth, then interdigitate"/>
        <outline text="Fontanelles allow moulding and assessment">
          <outline text="Palpation also reflects position, hydration, crying"/>
        </outline>
        <outline text="Anterior fossa: cribriform plate and optic canals">
          <outline text="Fracture: anosmia and CSF rhinorrhoea"/>
        </outline>
        <outline text="Middle fossa: orbital fissure, rotundum, ovale, spinosum"/>
        <outline text="Posterior fossa: acoustic meatus, jugular, hypoglossal"/>
        <outline text="Foramen magnum: medulla and vertebral arteries"/>
      </outline>
      <outline text="Scalp and meninges">
        <outline text="Five scalp layers">
          <outline text="Dense tissue holds cut vessels open">
            <outline text="Profuse bleeding"/>
          </outline>
          <outline text="Loose layer connects via emissary veins">
            <outline text="Historical dangerous area"/>
          </outline>
        </outline>
        <outline text="Aponeurosis links frontal and occipital bellies">
          <outline text="Subaponeurotic blood spreads widely"/>
          <outline text="Cephalohaematoma limited by sutures"/>
        </outline>
        <outline text="Dura: periosteal and meningeal layers">
          <outline text="Separation forms venous sinuses"/>
          <outline text="Folds: falx, tentorium, diaphragma sellae"/>
          <outline text="Tentorial notch: pressure boundary in herniation"/>
        </outline>
        <outline text="Pterion fracture tears middle meningeal artery">
          <outline text="Epidural haematoma"/>
        </outline>
        <outline text="Acceleration tears bridging veins">
          <outline text="Subdural bleeding"/>
        </outline>
      </outline>
      <outline text="Face">
        <outline text="Expression muscles: second arch, facial nerve"/>
        <outline text="Mastication muscles: first arch, mandibular nerve"/>
        <outline text="Trigeminal territories meet and overlap">
          <outline text="Angle of mandible: upper cervical nerve"/>
        </outline>
        <outline text="Facial artery crosses mandible anterior to masseter"/>
        <outline text="Valveless facial vein links to cavernous sinus">
          <outline text="Central face infection can spread, rarely severe"/>
        </outline>
        <outline text="Parotid duct pierces buccinator at upper second molar"/>
        <outline text="Facial nerve traverses parotid, not secretomotor"/>
        <outline text="Parotid fascia limits swelling, causing pain"/>
      </outline>
      <outline text="Temporomandibular joint and chewing">
        <outline text="Synovial joint divided by articular disc">
          <outline text="Lower compartment rotates, upper translates"/>
          <outline text="Wide opening: condyle-disc onto eminence"/>
        </outline>
        <outline text="Masseter, temporalis, medial pterygoid elevate"/>
        <outline text="Lateral pterygoid protrudes and assists opening">
          <outline text="Unilateral action moves jaw contralaterally"/>
        </outline>
        <outline text="Auriculotemporal nerve: joint sensation, parotid fibres"/>
        <outline text="Disc, muscle, arthritis, referred pain look alike"/>
      </outline>
      <outline text="Orbit">
        <outline text="Pyramid: base anterior, apex posterior"/>
        <outline text="Thin floor and medial wall">
          <outline text="Vulnerable in blowout fracture"/>
        </outline>
        <outline text="Apex joins cranium via canal and fissure"/>
        <outline text="Orbital septum limits anterior infection">
          <outline text="Postseptal infection threatens vision and sinus"/>
        </outline>
        <outline text="Oculomotor supplies most extraocular muscles">
          <outline text="Lateral rectus abducens, superior oblique trochlear"/>
        </outline>
        <outline text="Tears drain via nasolacrimal duct to inferior meatus"/>
        <outline text="Secretomotor: facial, pterygopalatine, trigeminal"/>
      </outline>
      <outline text="Nasal cavity and sinuses">
        <outline text="Septum: cartilage, ethmoid plate, vomer"/>
        <outline text="Conchae warm, humidify, direct airflow"/>
        <outline text="Meatal drainage">
          <outline text="Middle meatus: frontal, maxillary, anterior ethmoid"/>
          <outline text="Inferior meatus: nasolacrimal duct"/>
        </outline>
        <outline text="High maxillary ostium limits gravity drainage"/>
        <outline text="Sphenoid sinus near pituitary, optic nerves, carotids"/>
        <outline text="Kiesselbach region: common anterior bleeding"/>
        <outline text="Posterior bleeding near sphenopalatine, hard to see"/>
      </outline>
      <outline text="Ear">
        <outline text="External canal: cartilaginous lateral, bony medial"/>
        <outline text="Tympanic membrane: malleus handle, umbo, light reflex"/>
        <outline text="Middle ear: air space with ossicles, chorda tympani">
          <outline text="Tube to nasopharynx, back to mastoid cells"/>
          <outline text="Infection reaches mastoid, facial nerve, dura, sinus"/>
        </outline>
        <outline text="Tensor tympani trigeminal, stapedius facial"/>
        <outline text="Inner ear: endolymph within perilymph">
          <outline text="Vestibule senses acceleration, cochlea vibration"/>
        </outline>
      </outline>
      <outline text="Oral cavity, palate, tongue, and teeth">
        <outline text="Soft palate separates nasopharynx in swallowing"/>
        <outline text="Tensor veli palatini mandibular, others vagal"/>
        <outline text="Intrinsic muscles shape, extrinsic position tongue"/>
        <outline text="Hypoglossal supplies all but palatoglossus">
          <outline text="Weakness deviates tongue toward weak side"/>
        </outline>
        <outline text="Anterior two-thirds: lingual nerve, chorda tympani"/>
        <outline text="Posterior third: glossopharyngeal for both"/>
        <outline text="Dental infection follows roots and muscle attachments"/>
      </outline>
      <outline text="Clinical localisation">
        <outline text="Rigid compartments linked by foramina"/>
        <outline text="Trace symptoms through bone, space, nerve, vessel"/>
      </outline>
    </outline>
  </body>
</opml>
