<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>036-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="感染と診断微生物学の基礎">
      <outline text="感染の成立と伝播">
        <outline text="曝露は必ずしも定着をもたらさない">
          <outline text="定着は必ずしも疾患をもたらさない"/>
          <outline text="検出は因果関係を保証しない"/>
        </outline>
        <outline text="保有宿主：ヒト、動物、土壌、水、食品、器具"/>
        <outline text="経路：接触、飛沫、エアロゾル、糞口、血液、垂直">
          <outline text="飛沫は短距離、エアロゾルは浮遊"/>
        </outline>
        <outline text="潜伏期間は症状、感染待機期間は感染性で終了">
          <outline text="感染可能期間は発症前から回復後まで"/>
        </outline>
      </outline>
      <outline text="定着と侵入">
        <outline text="線毛、表面蛋白、莢膜で付着"/>
        <outline text="組織指向性：受容体、温度、栄養、酸素"/>
        <outline text="粘液、線毛運動、体液流、咳、蠕動に抵抗"/>
        <outline text="細胞、食細胞、リンパ、血液、神経を介し侵入"/>
        <outline text="細胞内生存">
          <outline text="ファゴリソソーム融合阻害、細胞質へ脱出"/>
        </outline>
        <outline text="感染成立量と侵入門戸が臨床像を形成">
          <outline text="医療機器、皮膚破綻、誤嚥が新たな生態的地位"/>
        </outline>
      </outline>
      <outline text="毒素と組織損傷">
        <outline text="外毒素：特定の標的を持つ分泌蛋白">
          <outline text="A-B毒素：結合成分と酵素成分"/>
          <outline text="スーパー抗原は多数のT細胞を活性化"/>
        </outline>
        <outline text="内毒素：グラム陰性菌のリポ多糖">
          <outline text="リピドAが自然免疫センサーを活性化">
            <outline text="発熱、血管拡張、毛細血管漏出、ショック"/>
          </outline>
        </outline>
        <outline text="病原性は相対的で状況依存">
          <outline text="日和見病原体は宿主防御の変化を利用"/>
          <outline text="防御不足または過剰反応で損傷"/>
        </outline>
      </outline>
      <outline text="自然免疫の障壁と認識">
        <outline text="皮膚、粘液、胃酸、尿流、常在微生物叢"/>
        <outline text="パターン認識受容体が保存構造を検出">
          <outline text="インフラマソーム、インターフェロン、細胞死"/>
        </outline>
        <outline text="補体：古典、レクチン、第二経路">
          <outline text="オプソニン化、炎症動員、膜侵襲複合体"/>
          <outline text="調節蛋白が宿主表面を保護"/>
        </outline>
        <outline text="好中球：貪食、活性酸素種、細胞外トラップ"/>
        <outline text="マクロファージ：取り込み、抗原提示、修復"/>
        <outline text="ナチュラルキラー細胞はストレス細胞を殺傷"/>
      </outline>
      <outline text="獲得免疫">
        <outline text="B細胞は形質細胞または記憶細胞へ">
          <outline text="免疫グロブリンMは早期に出現"/>
          <outline text="免疫グロブリンGは全身記憶、胎盤通過"/>
          <outline text="免疫グロブリンAは粘膜と母乳を保護"/>
        </outline>
        <outline text="T細胞の助けでクラススイッチ">
          <outline text="結合型ワクチンは莢膜への記憶を作る"/>
        </outline>
        <outline text="CD4陽性T細胞は亜型に応じて協調"/>
        <outline text="CD8陽性T細胞はクラス1提示細胞を殺傷"/>
        <outline text="ワクチン防御は程度が異なり低下し得る"/>
      </outline>
      <outline text="免疫回避と免疫不全">
        <outline text="回避の戦略">
          <outline text="莢膜、抗原変異、潜伏"/>
        </outline>
        <outline text="障害の種類が感染症を予測">
          <outline text="好中球減少：侵襲性細菌・真菌、膿が乏しい"/>
          <outline text="T細胞不全：日和見、細胞内病原体"/>
          <outline text="抗体欠乏：反復性副鼻腔肺感染、莢膜細菌"/>
          <outline text="補体終末経路欠損：ナイセリア属"/>
          <outline text="脾機能欠如：莢膜微生物"/>
        </outline>
        <outline text="二次性免疫障害は原発性より多い">
          <outline text="発熱がなくともわずかな悪化に対応"/>
        </outline>
      </outline>
      <outline text="検体の選択と採取">
        <outline text="定着部位でなく病変部位から採取"/>
        <outline text="治療を遅らせず抗微生物療法前に採取"/>
        <outline text="無菌操作、十分量、迅速輸送"/>
        <outline text="不良検体は拒否した方が安全なことも"/>
      </outline>
      <outline text="顕微鏡検査、培養、同定">
        <outline text="グラム染色：細胞壁分類と形態">
          <outline text="感度は微生物量と検体に依存"/>
        </outline>
        <outline text="培養は生存性を示し感受性検査を可能に">
          <outline text="治療後、不良採取、遅い増殖で陰性"/>
        </outline>
        <outline text="生化学、抗原、質量分析、塩基配列で同定"/>
        <outline text="無菌部位の常在菌は重要、皮膚では通常"/>
      </outline>
      <outline text="抗原、核酸、血清学">
        <outline text="核酸増幅は同時検出と定量が可能">
          <outline text="定着や非生存性物質も検出し得る"/>
          <outline text="遺伝子があっても発現するとは限らない"/>
        </outline>
        <outline text="血清学は抗体または抗原を検出">
          <outline text="免疫グロブリンMは残存・交差反応し得る"/>
          <outline text="抗体陽転や抗体価上昇が強い証拠"/>
          <outline text="早期や免疫不全では抗体が存在しない"/>
        </outline>
      </outline>
      <outline text="感受性と結果解釈">
        <outline text="薬剤曝露を考慮したブレイクポイント">
          <outline text="最小発育阻止濃度で薬剤を順位づけ不可"/>
        </outline>
        <outline text="組織移行、用量、感染源制御が成功を決定"/>
        <outline text="検査前確率を通じて解釈">
          <outline text="予測値は有病率で変化"/>
        </outline>
        <outline text="一組の血液培養の皮膚常在菌は汚染かも">
          <outline text="医療機器や免疫不全なら真の感染"/>
        </outline>
        <outline text="低価値検査の反復は偶発的陽性を生む"/>
      </outline>
    </outline>
  </body>
</opml>
