<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>045-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="精神状態診察、能力、リスク、一般的症候群">
      <outline text="概説と病歴">
        <outline text="語り、精神状態、身体、周囲情報、経過"/>
        <outline text="薬物、感染、神経、内分泌、ストレスも原因"/>
        <outline text="苦痛があっても自律性は失われない">
          <outline text="診断名で能力やリスクは決まらない"/>
        </outline>
        <outline text="プライバシー、役割、秘密保持の限界、通訳"/>
        <outline text="不安定、中毒、暴力、扶養者の安全に対処"/>
        <outline text="何が起きたか、なぜ今か、何を望むか"/>
        <outline text="病歴が制限されれば周囲からの情報">
          <outline text="秘密情報を開示せず受け取れる"/>
        </outline>
      </outline>
      <outline text="精神状態診察">
        <outline text="現在の面接を記述する"/>
        <outline text="外観と行動を善悪判断なく記述"/>
        <outline text="気分は主観、感情表出は観察">
          <outline text="報告と観察の感情は異なり得る"/>
        </outline>
        <outline text="思考形式は思考のつながり"/>
        <outline text="思考内容は罪悪感、妄想、自傷">
          <outline text="妄想は文化的文脈外の固定した誤信念"/>
        </outline>
        <outline text="幻視は神経、物質、せん妄原因を示唆"/>
        <outline text="不注意と変動はせん妄を示唆"/>
        <outline text="病識と判断力は同意ではない"/>
      </outline>
      <outline text="定式化と鑑別診断">
        <outline text="素因、誘発因子、持続因子、保護因子">
          <outline text="生物学的、心理的、社会的領域で"/>
        </outline>
        <outline text="診断名の羅列でなくその人を説明"/>
        <outline text="表現型に応じ身体・物質原因を除外">
          <outline text="突然の発症、高齢での初発、注意変動"/>
          <outline text="局在神経徴候、発熱、新規発作、薬剤変更"/>
        </outline>
        <outline text="標的検査、広範検査は偶発所見を生む"/>
      </outline>
      <outline text="意思決定能力">
        <outline text="決定と時点に固有"/>
        <outline text="理解、保持、比較衡量、伝達"/>
        <outline text="通訳、補助、鎮痛、平易な説明で支援"/>
        <outline text="賢明でない選択は能力欠如の証明でない"/>
        <outline text="妄想は比較衡量を妨げる時のみ影響"/>
        <outline text="欠如時は緊急性、事前指示、代理、法">
          <outline text="最小制限の代替手段"/>
          <outline text="根拠、支援、推論、再評価計画を記録"/>
        </outline>
      </outline>
      <outline text="自殺と自傷リスク">
        <outline text="念慮、計画、意図、手段を直接尋ねる">
          <outline text="質問は考えを植えつけない"/>
        </outline>
        <outline text="得点や低・中・高の分類に還元しない">
          <outline text="動的・持続的因子と状況を定式化"/>
        </outline>
        <outline text="緊急性は退院、意図増大、命令幻聴、中毒"/>
        <outline text="安全計画は共同で具体的">
          <outline text="警告徴候、対処、連絡先、手段制限"/>
          <outline text="約束や自殺しない契約ではない"/>
        </outline>
      </outline>
      <outline text="暴力、脆弱性、養育放棄">
        <outline text="脅迫、標的、武器、被害妄想"/>
        <outline text="精神疾患の人の大部分は暴力的でない">
          <outline text="物質、過去の行動、手段がより予測"/>
        </outline>
        <outline text="搾取、虐待、被扶養者への脆弱性"/>
        <outline text="鎮静化は落ち着いた声、空間、選択肢、限界"/>
      </outline>
      <outline text="抑うつと躁病">
        <outline text="気分低下または興味喪失と諸変化"/>
        <outline text="悲嘆があっても大うつ病は除外されない"/>
        <outline text="双極性障害歴、甲状腺、貧血、薬剤を考慮"/>
        <outline text="抗うつ薬は発現に時間、副作用あり"/>
        <outline text="重度うつ病に電気けいれん療法"/>
        <outline text="躁病は著しい機能障害か精神病">
          <outline text="軽躁病はより軽い"/>
        </outline>
        <outline text="脱水と相互作用でリチウム毒性"/>
      </outline>
      <outline text="不安、強迫、トラウマ">
        <outline text="パニックは不整脈、喘息、発作に類似"/>
        <outline text="認知行動療法と曝露療法で回避を減らす"/>
        <outline text="ベンゾジアゼピン長期は依存、転倒"/>
        <outline text="強迫観念は侵入、強迫行為は苦痛軽減"/>
        <outline text="心的外傷後ストレスは再体験、回避"/>
        <outline text="トラウマ配慮ケアは選択と制御">
          <outline text="毎回の詳細な語り直しは不要"/>
        </outline>
      </outline>
      <outline text="精神病と緊張病">
        <outline text="妄想、幻覚、解体、現実検討障害"/>
        <outline text="初回は原因の長期的除外が必要"/>
        <outline text="抗精神病薬は代謝、QT、運動障害"/>
        <outline text="クロザピンは抵抗性に有益、監視要"/>
        <outline text="緊張病は不動、無言、姿勢保持">
          <outline text="脱水、血栓症、悪性の悪化"/>
          <outline text="ベンゾジアゼピン負荷と電気けいれん療法"/>
          <outline text="抗精神病薬は一部症例を悪化"/>
        </outline>
      </outline>
      <outline text="物質、摂食障害、パーソナリティ">
        <outline text="使用と目標を評価的でなく尋ねる"/>
        <outline text="陽性結果は現在の障害を証明しない"/>
        <outline text="アルコール・鎮静薬離脱は発作、せん妄"/>
        <outline text="摂食障害はあらゆる体格で生じる">
          <outline text="再栄養でリン酸と体液が移動"/>
        </outline>
        <outline text="パーソナリティ診断には長期的文脈">
          <outline text="軽蔑的な略称にしない"/>
          <outline text="一貫した境界、ケアチーム分裂を避ける"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
