<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>072-01 機序的基礎、分類、正常変異、臨床像</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="リハビリテーションの基礎と臨床像">
      <outline text="リハビリテーション医学の対象">
        <outline text="疾患、外傷、環境、個人的要因の相互作用"/>
        <outline text="活動、参加、適応、生活の質"/>
        <outline text="回復の経路">
          <outline text="生物学的修復、神経可塑性、代償"/>
          <outline text="支援技術、環境変更、目標の再定義"/>
        </outline>
      </outline>
      <outline text="生物心理社会モデルで機能を捉える">
        <outline text="国際生活機能分類">
          <outline text="筋力低下は機能障害"/>
          <outline text="着替えの困難は活動制限"/>
          <outline text="復職不能は参加制約"/>
        </outline>
        <outline text="関係は双方向">
          <outline text="交通機関は軽い障害を増幅"/>
          <outline text="支援と技術が参加を可能にする"/>
        </outline>
        <outline text="医学モデルは病態と治療"/>
        <outline text="社会モデルは障壁、差別、排除"/>
        <outline text="機能は課題と状況に依存">
          <outline text="診察室歩行は道路、階段、仕事と別"/>
        </outline>
      </outline>
      <outline text="不動と活動への適応">
        <outline text="臥床">
          <outline text="血漿量、有酸素能力、筋力の低下"/>
          <outline text="萎縮、骨吸収、結合組織短縮"/>
          <outline text="褥瘡、血栓症、せん妄"/>
          <outline text="高齢者と重症患者で予備能喪失"/>
        </outline>
        <outline text="筋力">
          <outline text="初期向上は神経性、後に筋肥大"/>
          <outline text="廃用は合成減少、分解増加"/>
        </outline>
        <outline text="有酸素運動">
          <outline text="ミトコンドリア、毛細血管、一回拍出量"/>
          <outline text="強度、時間、様式に特異的"/>
          <outline text="回復なき過負荷は有害"/>
        </outline>
        <outline text="動的運動の生理">
          <outline text="心拍出量と酸素較差が増加"/>
          <outline text="収縮期血圧上昇、血管抵抗低下"/>
          <outline text="換気性閾値を超え換気増加"/>
        </outline>
        <outline text="回復動態">
          <outline text="心拍回復遅延は副交感神経低下"/>
          <outline text="症状はセッション後に出得る"/>
        </outline>
        <outline text="骨は機械的ひずみで再構築"/>
        <outline text="腱は心肺体力より遅く適応"/>
      </outline>
      <outline text="回復、代償、代替を区別する">
        <outline text="原機能回復は元の機能を回復"/>
        <outline text="代償は異なる方法で達成"/>
        <outline text="代替は機器や人的介助を使う"/>
        <outline text="早すぎる代償は回復を制限し得る"/>
        <outline text="神経可塑性">
          <outline text="反復、重要性、強度、睡眠、気分"/>
          <outline text="痙縮、疼痛、幻肢にも寄与"/>
        </outline>
        <outline text="運動学習">
          <outline text="認知、連合、自動化の段階"/>
          <outline text="変動練習は転移を高める"/>
          <outline text="フィードバックは徐々に減らす"/>
        </outline>
      </outline>
      <outline text="主要機能系の障害を分類する">
        <outline text="筋力低下は中枢性から廃用性まで"/>
        <outline text="上位運動ニューロン：反射亢進、痙縮"/>
        <outline text="下位運動ニューロン：萎縮、線維束性収縮"/>
        <outline text="痙縮">
          <outline text="速度依存性抵抗"/>
          <outline text="立位や移乗を支える場合"/>
          <outline text="筋緊張値でなく機能を治療"/>
        </outline>
        <outline text="運動失調、失行、半側空間無視"/>
        <outline text="失語、構音障害、発声障害は別"/>
        <outline text="嚥下障害">
          <outline text="誤嚥は無症候性のこともある"/>
          <outline text="気道安全、栄養、食の楽しみ"/>
        </outline>
      </outline>
      <outline text="疼痛、疲労、認知は機能修飾因子">
        <outline text="疼痛は運動制御、睡眠、意欲を変える">
          <outline text="恐怖と感作が回避を持続させる"/>
          <outline text="段階的曝露、架空とは示唆しない"/>
        </outline>
        <outline text="疲労の原因は多様">
          <outline text="労作後症状増悪にはペーシング"/>
        </outline>
        <outline text="認知は安全、学習、復職に影響"/>
      </outline>
      <outline text="頻度の高い経過">
        <outline text="脳卒中">
          <outline text="早期は再灌流、浮腫、ネットワーク"/>
          <outline text="検査上のプラトーは限界でない"/>
        </outline>
        <outline text="脊髄損傷">
          <outline text="神経学的高位と完全性"/>
          <outline text="脊髄ショック、後に痙縮"/>
          <outline text="自律神経過反射で高血圧"/>
        </outline>
        <outline text="外傷性脳損傷">
          <outline text="身体回復が認知障害を隠す"/>
        </outline>
        <outline text="切断">
          <outline text="義肢は道具で終点でない"/>
        </outline>
        <outline text="心臓・呼吸・がんリハビリテーション"/>
      </outline>
      <outline text="参加とアイデンティティの目標">
        <outline text="具体的、測定可能、期限ある目標"/>
        <outline text="アイデンティティ、文化、役割"/>
        <outline text="残存障害とともに良く生きる"/>
        <outline text="大切なことを妨げるものは何か"/>
      </outline>
    </outline>
  </body>
</opml>
