<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>017-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="糸球体濾過、尿細管輸送、尿濃縮、クリアランス">
      <outline text="腎臓の役割と内分泌機能">
        <outline text="血漿を濾過し再吸収と分泌を行う"/>
        <outline text="酸塩基、血圧、造血、ビタミンD"/>
        <outline text="エリスロポエチンは低酸素で産生される">
          <outline text="慢性腎臓病では低増殖性貧血を生じる"/>
        </outline>
        <outline text="近位尿細管細胞がビタミンDを活性化する">
          <outline text="副甲状腺ホルモンと低リン酸が刺激する"/>
          <outline text="破綻で副甲状腺機能亢進と骨病変へ"/>
        </outline>
      </outline>
      <outline text="腎循環とネフロンの構成">
        <outline text="輸入細動脈が糸球体係蹄へ血液を送る"/>
        <outline text="血液は輸出細動脈から出る">
          <outline text="尿細管周囲毛細血管が皮質尿細管を囲む"/>
          <outline text="直血管は髄質へ下降する"/>
        </outline>
        <outline text="嚢、近位、係蹄、遠位、集合管と続く"/>
        <outline text="傍髄質ネフロンの長い係蹄が濃縮を担う"/>
        <outline text="血流の大部分は皮質へ向かう">
          <outline text="髄質の酸素需要はナトリウム輸送による"/>
        </outline>
      </outline>
      <outline text="糸球体濾過障壁">
        <outline text="有窓性内皮、基底膜、足細胞スリット"/>
        <outline text="大きさ、形、電荷が通過性を決める"/>
        <outline text="アルブミンは制限され近位で回収される"/>
        <outline text="傷害は血尿、タンパク尿、濾過低下を生む">
          <outline text="変形赤血球と円柱は糸球体性出血を示す"/>
          <outline text="ネフローゼは浮腫と低アルブミン血症"/>
          <outline text="炎症性では高血圧と濾過低下を伴う"/>
        </outline>
      </outline>
      <outline text="濾過圧と自動調節">
        <outline text="糸球体毛細血管静水圧が濾過を促す"/>
        <outline text="ボーマン腔圧と膠質浸透圧が抵抗する"/>
        <outline text="濾過量は正味濾過圧と濾過係数の積">
          <outline text="濾過係数は透過性と表面積を反映する"/>
        </outline>
        <outline text="中等度の輸出枝収縮は糸球体圧を上げる">
          <outline text="強い収縮は血流と濾過を低下させる"/>
        </outline>
        <outline text="筋原性反応は伸展された輸入枝を収縮させる"/>
        <outline text="緻密斑が塩化ナトリウム送達量を感知する">
          <outline text="送達量が輸入枝緊張とレニンを決める"/>
        </outline>
      </outline>
      <outline text="近位尿細管">
        <outline text="ナトリウム、水、重炭酸を大量に再吸収"/>
        <outline text="通常は糖とアミノ酸をほぼ全量回収する"/>
        <outline text="ナトリウム・カリウムポンプが輸送を駆動">
          <outline text="水が溶質に追随し等浸透圧性となる"/>
        </outline>
        <outline text="重炭酸は回収されるが新生はされない"/>
        <outline text="輸送最大量を超えると浸透圧利尿となる"/>
        <outline text="有機酸と有機塩基、多くの薬剤を分泌する"/>
        <outline text="傷害で重炭酸、リン酸、糖、アミノ酸を失う"/>
      </outline>
      <outline text="ヘンレ係蹄と対向流系">
        <outline text="薄い下行脚で尿細管液が濃縮される"/>
        <outline text="太い上行脚がナトリウムと塩化物を回収">
          <outline text="水を通さず尿細管液は希釈される"/>
        </outline>
        <outline text="反復通過が小さな勾配を増幅する"/>
        <outline text="尿素再循環が内髄の勾配に寄与する"/>
        <outline text="直血管は組織へ供給し流出を抑える"/>
      </outline>
      <outline text="遠位ネフロンと集合管">
        <outline text="遠位前半はナトリウムと塩化物を回収する"/>
        <outline text="主細胞はナトリウム再吸収とカリウム分泌">
          <outline text="アルドステロンが発現と活性を高める"/>
        </outline>
        <outline text="抗利尿ホルモンがアクアポリン2を挿入">
          <outline text="作用がなければ希釈尿が排泄される"/>
        </outline>
        <outline text="アルファ細胞は酸、ベータ細胞は重炭酸"/>
        <outline text="遠位酸分泌とアンモニウムが重炭酸を新生"/>
      </outline>
      <outline text="クリアランスと濾過マーカー">
        <outline text="単位時間に除去される仮想的血漿量"/>
        <outline text="濾過のみ受ける物質では濾過量に等しい">
          <outline text="イヌリンは実験的な理想に近い"/>
          <outline text="クレアチニンは濾過され一部分泌される"/>
        </outline>
        <outline text="基準値が低いと小さな上昇でも大きな低下"/>
        <outline text="急性変化では推算式が不正確になる"/>
        <outline text="濾過率は濾過量を腎血漿流量で割った値"/>
        <outline text="分画排泄率は利尿薬や病態で変動する"/>
      </outline>
      <outline text="尿検査と沈渣">
        <outline text="試験紙はpH、潜血、タンパク、糖をみる">
          <outline text="偽陽性と偽陰性の両方が起こる"/>
        </outline>
        <outline text="顕微鏡で細胞、円柱、結晶を同定する">
          <outline text="硝子円柱は正常でもみられる"/>
          <outline text="赤血球円柱は糸球体腎炎を支持する"/>
          <outline text="泥状顆粒円柱は尿細管傷害を支持する"/>
        </outline>
        <outline text="アルブミンとタンパクの比で濃度を補正"/>
      </outline>
      <outline text="生理学的指標としての利尿薬">
        <outline text="炭酸脱水酵素阻害薬は近位回収を減らす"/>
        <outline text="ループ利尿薬は髄質勾配を弱める">
          <outline text="カルシウムとマグネシウム排泄が増える"/>
        </outline>
        <outline text="サイアザイドは遠位の輸送を阻害する">
          <outline text="カルシウム排泄が減る"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
