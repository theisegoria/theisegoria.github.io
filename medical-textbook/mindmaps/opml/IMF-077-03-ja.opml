<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>077-03 肺、気道、肺血管、リンパ管、胸部局在</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="肺、気道、胸部局在">
      <outline text="右肺と左肺">
        <outline text="右肺は肝臓で短く幅広い"/>
        <outline text="左肺には心切痕と舌区"/>
        <outline text="右は三葉、左は二葉"/>
        <outline text="葉間裂は変異し不完全もある">
          <outline text="側副換気と疾患拡大に影響"/>
        </outline>
        <outline text="肺根は胸膜鞘に包まれる">
          <outline text="肺根下方に肺間膜"/>
        </outline>
        <outline text="肺門の配列">
          <outline text="右は上葉気管支が肺動脈の上"/>
          <outline text="左は肺動脈が気管支の上"/>
          <outline text="前から肺静脈、肺動脈、気管支"/>
        </outline>
      </outline>
      <outline text="気管支樹">
        <outline text="気管はC6付近の輪状軟骨下から">
          <outline text="C字軟骨輪と後方膜性壁"/>
          <outline text="分岐部は胸骨角面付近"/>
        </outline>
        <outline text="右主気管支は幅広く短く垂直">
          <outline text="吸引は右が多く体位で決まる"/>
        </outline>
        <outline text="区域は区域気管支と動脈枝">
          <outline text="肺静脈は区域間を走る"/>
          <outline text="結合組織面で切除できる"/>
        </outline>
        <outline text="右肺は十区域"/>
        <outline text="細気管支は軟骨・腺を欠く">
          <outline text="終末細気管支で伝導域が終わる"/>
        </outline>
        <outline text="側副路は閉塞を迂回する">
          <outline text="疾患拡大も許す"/>
          <outline text="完全な裂は葉間流を制限"/>
        </outline>
        <outline text="分画症は体循環供給で気管支なし"/>
      </outline>
      <outline text="腺房と肺胞">
        <outline text="腺房は終末細気管支より末梢"/>
        <outline text="二次小葉は高分解能CTで重要"/>
        <outline text="一型細胞がガス交換面を作る"/>
        <outline text="二型細胞は産生と上皮置換"/>
        <outline text="マクロファージが粒子と微生物を除く"/>
        <outline text="基底膜融合が拡散距離を最小化"/>
        <outline text="サーファクタントは表面張力を減らす">
          <outline text="肺胞安定化とコンプライアンス増加"/>
          <outline text="喪失で虚脱と呼吸窮迫"/>
        </outline>
      </outline>
      <outline text="二重血流">
        <outline text="肺動脈は気管支に伴う"/>
        <outline text="肺静脈は区域間から左心房へ"/>
        <outline text="気管支動脈は気道と胸膜を供給">
          <outline text="肺静脈へ戻り生理的シャント"/>
        </outline>
        <outline text="低圧で高コンプライアンスの肺循環">
          <outline text="塞栓は下葉に多い"/>
          <outline text="二重供給が梗塞を制限"/>
        </outline>
        <outline text="重症喀血は主に気管支循環">
          <outline text="塞栓術には脊髄動脈起始の知識"/>
        </outline>
      </outline>
      <outline text="リンパ流">
        <outline text="表在胸膜下・深部気管支周囲リンパ叢"/>
        <outline text="肺門から気管気管支、気管傍節へ"/>
        <outline text="左下葉は右へ流れ得る">
          <outline text="がん病期と進展に影響"/>
        </outline>
        <outline text="肺胞壁にリンパ管はない"/>
        <outline text="リンパ節ステーションは解剖で定義">
          <outline text="気管支内超音波で肺門節"/>
          <outline text="食道超音波で後方節"/>
        </outline>
      </outline>
      <outline text="自律神経と感覚支配">
        <outline text="肺神経叢は迷走・交感線維を受ける"/>
        <outline text="副交感は気管支収縮と分泌"/>
        <outline text="交感はカテコールアミンで拡張"/>
        <outline text="迷走求心線維が伸展反射を運ぶ"/>
        <outline text="実質は鈍く壁側胸膜は痛む"/>
        <outline text="咳受容体は大きな気道に集中"/>
      </outline>
      <outline text="疾患の局在">
        <outline text="吸引物は重力依存区域へ">
          <outline text="立位は下葉底部"/>
          <outline text="仰臥位は下葉上区と上葉後区域"/>
        </outline>
        <outline text="虚脱は構造を患部へ引く"/>
        <outline text="浸潤影は容量保持、エアブロンコグラム"/>
        <outline text="胸膜疾患は表面と裂に沿う">
          <outline text="隔壁化液体は癒着で制限"/>
          <outline text="膿胸はレンズ状、膿瘍は実質内"/>
        </outline>
        <outline text="肺尖腫瘍は神経叢、交感神経幹へ">
          <outline text="手筋力低下、疼痛、ホルネル症候群"/>
        </outline>
        <outline text="中心腫瘍は閉塞し浸潤する"/>
      </outline>
      <outline text="胸部画像の読影">
        <outline text="正面X線は解剖順に追う">
          <outline text="肺門濃度は主に血管"/>
          <outline text="通常左肺門が高い"/>
          <outline text="回旋と低吸気は疾患を模倣"/>
        </outline>
        <outline text="シルエットサインで陰影を局在">
          <outline text="右心縁は右中葉"/>
          <outline text="左心縁は舌区"/>
        </outline>
        <outline text="軸位は大動脈が左、奇静脈が右"/>
        <outline text="所見を各断面で追う"/>
        <outline text="胸部は分枝と境界で構成される"/>
      </outline>
    </outline>
  </body>
</opml>
