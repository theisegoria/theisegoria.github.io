<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>085-01 配偶子形成、受精、卵割、胚盤胞形成、着床</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="配偶子形成から着床まで">
      <outline text="時期と始原生殖細胞">
        <outline text="発生学的年齢は受精から数える">
          <outline text="妊娠週数は最終月経初日から"/>
          <outline text="妊娠週数が約二週長い"/>
        </outline>
        <outline text="始原生殖細胞は性腺外で指定">
          <outline text="生殖隆起へ移動"/>
          <outline text="生存は周囲体細胞の信号に依存"/>
          <outline text="ゲノム刷込みの消去と再確立"/>
          <outline text="失敗は不妊、性腺形成不全、腫瘍"/>
        </outline>
      </outline>
      <outline text="精子形成">
        <outline text="思春期に精細管内で開始"/>
        <outline text="基底側精原細胞が幹細胞を保つ"/>
        <outline text="第一分裂で相同染色体が分離"/>
        <outline text="第二分裂で姉妹染色分体が分離"/>
        <outline text="精子完成は追加分裂なしの再構成">
          <outline text="核凝縮、ゴルジ由来の先体"/>
          <outline text="鞭毛と近位部のミトコンドリア"/>
        </outline>
        <outline text="セルトリ細胞が血液精巣関門を維持"/>
        <outline text="精巣上体通過中に成熟"/>
        <outline text="テストステロンと卵胞刺激ホルモン"/>
        <outline text="高温、毒物、閉塞が精子を低下"/>
      </outline>
      <outline text="卵形成と卵胞">
        <outline text="胎生期に第一前期で停止">
          <outline text="有限の卵胞は閉鎖と排卵で減少"/>
        </outline>
        <outline text="優位卵胞が第一分裂を完了">
          <outline text="二次卵母細胞と第一極体"/>
        </outline>
        <outline text="第二分裂は中期で停止">
          <outline text="受精後のみ完了"/>
        </outline>
        <outline text="不均等細胞質分裂が細胞質を保存"/>
        <outline text="長期停止で異数性リスク上昇"/>
        <outline text="顆粒膜細胞突起が分裂停止を調節"/>
        <outline text="莢膜はアンドロゲン、顆粒膜は芳香化"/>
        <outline text="黄体形成ホルモンサージで排卵と黄体"/>
      </outline>
      <outline text="受精">
        <outline text="女性生殖路での受精能獲得">
          <outline text="単一スイッチでない一連の変化"/>
        </outline>
        <outline text="卵管膨大部で起こる"/>
        <outline text="卵丘、透明帯結合、膜融合"/>
        <outline text="融合がカルシウム振動を誘発">
          <outline text="第二分裂完了と代謝活性化"/>
        </outline>
        <outline text="皮質反応が透明帯を変化">
          <outline text="多精子受精とゲノム不均衡を防ぐ"/>
        </outline>
        <outline text="精子は父性ゲノムと中心小体"/>
        <outline text="卵母細胞は細胞質、ミトコンドリア、伝令RNA"/>
        <outline text="前核は第一紡錘体へ並ぶ"/>
        <outline text="多くの受胎は臨床認識前に失われる"/>
      </outline>
      <outline text="卵割と胚盤胞">
        <outline text="透明帯内で成長なしに分裂"/>
        <outline text="約八細胞期のコンパクション">
          <outline text="位置と極性が系列を偏らせる"/>
        </outline>
        <outline text="約三日で桑実胚"/>
        <outline text="栄養外胚葉は主に胎盤へ"/>
        <outline text="内部細胞塊は胚本体へ"/>
        <outline text="孵化で透明帯から脱出"/>
        <outline text="卵管輸送遅延で異所性妊娠">
          <outline text="破裂による致死的出血"/>
        </outline>
      </outline>
      <outline text="着床">
        <outline text="プロゲステロン依存の受容期間"/>
        <outline text="脱落膜化でグリコーゲンと脂質蓄積"/>
        <outline text="接近、接着、胚極の配向"/>
        <outline text="合胞体性栄養膜が侵入・侵食"/>
        <outline text="細胞性栄養膜は増殖源"/>
        <outline text="第一週に部分埋没、第二週に包埋"/>
        <outline text="ヒト絨毛性ゴナドトロピンが黄体救済">
          <outline text="単回値より推移と超音波"/>
        </outline>
        <outline text="腔隙が子宮胎盤循環を開始"/>
        <outline text="侵入は制御が必要">
          <outline text="不足は機能不全と高血圧性障害"/>
          <outline text="過剰は子宮壁へ異常に深く"/>
        </outline>
      </outline>
      <outline text="二層性胚盤と腔">
        <outline text="上胚葉は三胚葉すべてを作る"/>
        <outline text="下胚葉は卵黄嚢内面へ寄与"/>
        <outline text="羊膜芽細胞が羊膜を作る"/>
        <outline text="一次、次いで二次卵黄嚢"/>
        <outline text="胚外中胚葉と絨毛膜腔">
          <outline text="体性層は栄養膜・羊膜を覆う"/>
          <outline text="臓性層は卵黄嚢を覆う"/>
        </outline>
        <outline text="連結茎は後に臍帯へ"/>
        <outline text="前脊索板が頭側を示す"/>
      </outline>
      <outline text="生殖補助医療と統合">
        <outline text="卵巣刺激、採取、媒精または注入"/>
        <outline text="着床前検査は栄養外胚葉を採取">
          <outline text="着床や健康を保証しない"/>
        </outline>
        <outline text="各移行の障害が異なる転帰を生む"/>
      </outline>
    </outline>
  </body>
</opml>
