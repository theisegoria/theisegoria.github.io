<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>044-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="外傷、蘇生、意識変容、周術期評価">
      <outline text="概説と一次評価">
        <outline text="診断より先に可逆的脅威を治療">
          <outline text="正常値一回より経過が重要"/>
        </outline>
        <outline text="人員、保温、輸血、気道、画像を準備"/>
        <outline text="順序は出血、気道、呼吸、循環"/>
        <outline text="発見ごとに治療し各介入後に再評価"/>
        <outline text="出血部位に応じた止血">
          <outline text="止血帯は近位、締めて時刻記録"/>
        </outline>
      </outline>
      <outline text="気道と頸椎">
        <outline text="血液、熱傷、喘鳴、拡大血腫を探す"/>
        <outline text="下顎挙上、吸引、酸素、補助具"/>
        <outline text="保護や経過を確保できねば確実な気道"/>
        <outline text="迅速導入挿管は心停止を誘発し得る">
          <outline text="循環血液量減少、右心系閉塞、アシドーシス"/>
          <outline text="先に蘇生し挿管失敗計画を準備"/>
          <outline text="波形二酸化炭素で留置確認"/>
        </outline>
        <outline text="脊椎制限で気道・止血を遅らせない"/>
      </outline>
      <outline text="呼吸と胸部損傷">
        <outline text="緊張性気胸は画像を待たず治療"/>
        <outline text="大量血胸は失血と肺圧迫"/>
        <outline text="動揺胸郭と肺挫傷">
          <outline text="疼痛、換気障害、遅発性低酸素血症"/>
          <outline text="鎮痛、理学療法、選択的換気補助"/>
        </outline>
        <outline text="心タンポナーデは閉塞性ショック"/>
      </outline>
      <outline text="循環と出血性ショック">
        <outline text="否定されるまで出血性と考える"/>
        <outline text="早期徴候は低血圧に先行">
          <outline text="若年者は晩期まで血圧を保つ"/>
        </outline>
        <outline text="過剰晶質液でなく加温血液成分">
          <outline text="晶質液は凝固希釈、低体温、アシドーシス"/>
        </outline>
        <outline text="時間枠内のトラネキサム酸早期投与"/>
        <outline text="ダメージコントロール蘇生">
          <outline text="止血まで許容低血圧"/>
          <outline text="重症外傷性脳損傷では不適切"/>
        </outline>
        <outline text="致死的三徴は相互に悪化">
          <outline text="加温、止血、処置短縮"/>
        </outline>
      </outline>
      <outline text="神経障害と意識変容">
        <outline text="意識、瞳孔、四肢、血糖、体温"/>
        <outline text="昏睡尺度は合計点でなく各項目"/>
        <outline text="原因は外傷、低酸素、血糖、毒物など"/>
        <outline text="ブドウ糖、ナロキソン、抗発作治療">
          <outline text="換気や画像を遅らせない"/>
        </outline>
        <outline text="二次性脳損傷の予防">
          <outline text="低酸素、低血圧、発熱、血糖極値を回避"/>
        </outline>
        <outline text="脳ヘルニア徴候は緊急対応">
          <outline text="高浸透圧療法、画像、脳神経外科"/>
        </outline>
      </outline>
      <outline text="全身露出、二次評価、画像診断">
        <outline text="背部、会陰、腋窩、頭皮、皮膚を露出"/>
        <outline text="脅威対処後に頭から足先まで診察">
          <outline text="疼痛、注意をそらす損傷、ショックが隠す"/>
        </outline>
        <outline text="焦点超音波は全損傷を除外できない"/>
        <outline text="断層撮影は安定化した患者のみ"/>
        <outline text="妊娠は必要な診断を控える理由でない"/>
      </outline>
      <outline text="特定の損傷パターン">
        <outline text="外傷性脳損傷の病型">
          <outline text="抗凝固でリスク増、緊急中和も"/>
        </outline>
        <outline text="脊髄損傷は高位に応じた障害">
          <outline text="神経原性ショックは交感神経緊張喪失"/>
          <outline text="相対的徐脈、出血除外後に判断"/>
        </outline>
        <outline text="早期腹膜刺激徴候のない腹部損傷"/>
        <outline text="骨盤バインダーは大転子上"/>
        <outline text="動脈、区画、開放骨折、圧挫の脅威">
          <outline text="介入前後の神経血管状態"/>
        </outline>
      </outline>
      <outline text="心停止と蘇生後ケア">
        <outline text="胸骨圧迫、除細動器、中断最小化"/>
        <outline text="非除細動適応はアドレナリンと原因検索"/>
        <outline text="気道介入で圧迫の質を下げない">
          <outline text="波形二酸化炭素は位置、質、再開"/>
        </outline>
        <outline text="自己心拍再開後">
          <outline text="長時間の高酸素を避け酸素化"/>
          <outline text="交絡除去まで予後判断を控える"/>
        </outline>
      </outline>
      <outline text="術前評価、薬剤、絶食">
        <outline text="リスク修正であり手術許可でない"/>
        <outline text="緊急度、規模、失血、術後管理場所"/>
        <outline text="管理を変える検査だけ行う">
          <outline text="正常検査は機能不良を打ち消さない"/>
        </outline>
        <outline text="各薬剤の明確な計画">
          <outline text="出血と血栓症を均衡"/>
          <outline text="副腎抑制には糖質コルチコイド補充"/>
        </outline>
        <outline text="絶食は誤嚥を減らすが過度は脱水"/>
        <outline text="共輸送体阻害薬を術前休薬">
          <outline text="正常血糖性ケトアシドーシス"/>
        </outline>
      </outline>
      <outline text="術後生理と合併症">
        <outline text="麻酔と手術は全臓器を変化させる"/>
        <outline text="気道から手術部位まで監視"/>
        <outline text="新しい悪化は予想される変化でない"/>
        <outline text="多面的鎮痛、肺膨張、早期離床で予防"/>
        <outline text="時期と表現型で鑑別"/>
      </outline>
    </outline>
  </body>
</opml>
