<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>015-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="閉塞性、拘束性、血管性、感染性、腫瘍性肺疾患">
      <outline text="概説">
        <outline text="気道、肺胞、間質、血管、胸膜"/>
        <outline text="呼吸筋と呼吸調節も障害される"/>
        <outline text="異なる区画が似た症状を起こす"/>
        <outline text="曝露歴、時間経過、生理、画像、病理"/>
        <outline text="原因除去、疾患治療、予防、リハビリテーション"/>
      </outline>
      <outline text="喘息">
        <outline text="気道過敏性と炎症を伴う可変性気流閉塞"/>
        <outline text="誘因：アレルゲン、感染、運動、冷気、煙"/>
        <outline text="肥満細胞、好酸球、粘液、浮腫、平滑筋収縮"/>
        <outline text="発作間欠期が正常でも除外できない">
          <outline text="気管支拡張薬への反応と最大呼気流量の変動"/>
          <outline text="誘発試験や抗炎症療法後の変化"/>
        </outline>
        <outline text="吸入コルチコステロイドが炎症と増悪を抑える"/>
        <outline text="長時間作用性ベータ刺激薬は必ず併用する"/>
        <outline text="重度発作：呼吸仕事量増加、頻呼吸、静かな胸部">
          <outline text="二酸化炭素の正常化や上昇は疲労を示唆"/>
        </outline>
      </outline>
      <outline text="慢性閉塞性肺疾患">
        <outline text="持続性気流制限にリモデリングと肺気腫"/>
        <outline text="喫煙、バイオマス、職業、アルファ1欠乏"/>
        <outline text="慢性気管支炎は粘液過剰分泌表現型"/>
        <outline text="肺気腫は終末細気管支より末梢を破壊"/>
        <outline text="弾性収縮力喪失、呼気時虚脱、粘液性閉塞"/>
        <outline text="換気血流比不均衡が低酸素血症を生む">
          <outline text="進行期は高二酸化炭素血症と右心不全"/>
        </outline>
        <outline text="診断は気管支拡張薬投与後の気流閉塞"/>
        <outline text="長期酸素療法は重度安静時低酸素血症へ"/>
      </outline>
      <outline text="気管支拡張症と嚢胞性線維症">
        <outline text="悪循環による不可逆的な気管支拡張">
          <outline text="排出障害、感染、炎症、気管支壁傷害"/>
        </outline>
        <outline text="慢性湿性咳嗽、反復感染、喀血、粗い捻髪音"/>
        <outline text="気道浄化、検体採取、標的抗菌薬、原因治療"/>
        <outline text="嚢胞性線維症は塩化物輸送障害で分泌物が脱水">
          <outline text="適格な変異では修飾薬が機能を改善"/>
        </outline>
      </outline>
      <outline text="肺炎と結核">
        <outline text="肺炎は肺実質の感染である"/>
        <outline text="病原体は曝露、免疫、年齢、地理で異なる"/>
        <outline text="高齢者や免疫不全では徴候が目立たない"/>
        <outline text="合併症：敗血症、膿瘍、壊死、胸水">
          <outline text="膿胸は抗菌薬に加えて排液が必要"/>
        </outline>
        <outline text="結核は空気感染し潜伏または活動性">
          <outline text="免疫検査は感染を示すが活動性は示さない"/>
        </outline>
      </outline>
      <outline text="コンソリデーションとその限界">
        <outline text="炎症細胞と液体が肺胞のガスを置き換える"/>
        <outline text="病原体名ではなく構造上の所見"/>
        <outline text="組織と液体は空気よりエックス線を減弱"/>
        <outline text="副雑音がなくても過程は除外できない"/>
        <outline text="陰影だけでは感染を確定できない">
          <outline text="浮腫、出血、無気肺も密度を増す"/>
        </outline>
        <outline text="区画、過程、障害の程度を分けて問う"/>
      </outline>
      <outline text="間質性および職業性肺疾患">
        <outline text="肺胞壁と支持組織の炎症と線維化"/>
        <outline text="労作時呼吸困難、乾性咳嗽、細かい捻髪音"/>
        <outline text="肺気量低下、拡散障害、労作時の酸素低下"/>
        <outline text="高分解能コンピュータ断層撮影が鑑別を絞る"/>
        <outline text="鳥、カビ、粉塵、シリカ、アスベストを問う"/>
        <outline text="曝露除去と進行性線維症への抗線維化療法"/>
      </outline>
      <outline text="肺血管疾患">
        <outline text="肺塞栓は死腔と右室後負荷を増やす"/>
        <outline text="無症候性血栓からショックまで幅がある"/>
        <outline text="臨床確率がDダイマーと画像検査を導く"/>
        <outline text="抗凝固療法、破綻例では再灌流や介入"/>
        <outline text="心エコーは推定、右心カテーテルが確定"/>
        <outline text="ある群で有効な血管拡張薬が別群では有害"/>
      </outline>
      <outline text="胸膜、気胸、肺がん">
        <outline text="胸水は圧、炎症、感染、悪性腫瘍から生じる"/>
        <outline text="胸腔穿刺が漏出性と滲出性を区別する"/>
        <outline text="気胸は自然、外傷性、医原性に分かれる"/>
        <outline text="緊張性は画像を待たず臨床所見で減圧"/>
        <outline text="小細胞がんと非小細胞がん、分子亜型"/>
        <outline text="喫煙以外にラドン、職業曝露、大気汚染"/>
        <outline text="画像、組織、組織型、分子検査、病期診断"/>
      </outline>
      <outline text="急性肺傷害、誤嚥、免疫不全">
        <outline text="透過性亢進、両側陰影、コンプライアンス低下"/>
        <outline text="心不全だけでは説明できない低酸素血症"/>
        <outline text="肺保護換気と重症例での腹臥位"/>
        <outline text="誤嚥は化学性肺炎から細菌性肺炎まで">
          <outline text="抗菌薬は感染成立または強い疑いに限る"/>
        </outline>
        <outline text="ニューモシスチスはびまん性低酸素性肺炎"/>
      </outline>
    </outline>
  </body>
</opml>
