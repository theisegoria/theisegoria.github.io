<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>054-02 母体適応、胎盤生理、産科救急、および産褥移行</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="母体適応、胎盤生理、産科救急、産褥移行">
      <outline text="母体適応と妊婦の蘇生">
        <outline text="適応は疾患に似ることがある">
          <outline text="非妊娠時正常のクレアチニンも腎障害"/>
          <outline text="代償破綻で少量出血も急速に危険"/>
        </outline>
        <outline text="母体蘇生は胎児蘇生でもある">
          <outline text="子宮左方移動で大動静脈圧迫を軽減"/>
          <outline text="胸骨圧迫と除細動を遅らせない"/>
          <outline text="緊急子宮内容娩出を早期に準備"/>
        </outline>
        <outline text="原因を並行検索し蘇生を止めない"/>
      </outline>
      <outline text="臓器系の適応">
        <outline text="総赤血球量増加でも希釈性貧血"/>
        <outline text="仰臥位の下大静脈圧迫、側方移動で改善"/>
        <outline text="プロゲステロンが換気を刺激">
          <outline text="非妊娠時正常の二酸化炭素は低換気"/>
        </outline>
        <outline text="機能的残気量が減少">
          <outline text="無呼吸時の酸素予備能が小さい"/>
        </outline>
        <outline text="濾過増加で尿素とクレアチニン低下">
          <outline text="糖尿は妊娠糖尿病の診断にならない"/>
        </outline>
        <outline text="凝固亢進">
          <outline text="分娩出血を抑える"/>
          <outline text="特に産褥期に静脈血栓症を増やす"/>
        </outline>
      </outline>
      <outline text="胎盤生理">
        <outline text="交換臓器かつ内分泌臓器"/>
        <outline text="らせん動脈は低抵抗血管へ改築">
          <outline text="改築不全で胎盤虚血"/>
          <outline text="抗血管新生シグナルが内皮を障害"/>
          <outline text="妊娠高血圧腎症、発育不全、早期剥離"/>
        </outline>
        <outline text="母体血圧が高くても胎盤血流は不十分"/>
      </outline>
      <outline text="妊娠初期">
        <outline text="ゴナドトロピン陽性は部位を示さない"/>
        <outline text="識別値は絶対ではない"/>
        <outline text="低値や低下中でも異所性妊娠は破裂">
          <outline text="肩先痛、失神、ショックは外科治療"/>
        </outline>
        <outline text="妊娠悪阻は多胎、胞状奇胎を除外"/>
        <outline text="長期嘔吐でチアミンが枯渇">
          <outline text="糖質先行でウェルニッケ脳症"/>
        </outline>
      </outline>
      <outline text="妊娠高血圧腎症、HELLP、子癇">
        <outline text="胎盤由来の多臓器内皮疾患">
          <outline text="蛋白尿がなくても診断し得る"/>
        </outline>
        <outline text="頭痛、視覚変化、心窩部痛、腱反射亢進"/>
        <outline text="重症高血圧は緊急治療">
          <outline text="母体頭蓋内出血を防ぐ"/>
        </outline>
        <outline text="硫酸マグネシウムで子癇発作に対応">
          <outline text="反射、呼吸、尿量監視、カルシウム準備"/>
        </outline>
        <outline text="内皮漏出で肺水腫、輸液は慎重"/>
        <outline text="胎盤娩出が根治、時期を比較"/>
        <outline text="HELLPは溶血、肝酵素上昇、血小板減少"/>
        <outline text="子癇は分娩前、中、後に起こる"/>
        <outline text="生涯の心血管疾患リスク"/>
      </outline>
      <outline text="妊娠糖尿病">
        <outline text="インスリン抵抗がベータ細胞予備能を超える"/>
        <outline text="母体ブドウ糖が胎児インスリンを増やす">
          <outline text="成長と脂肪蓄積"/>
          <outline text="出生後の新生児低血糖"/>
        </outline>
        <outline text="胎盤娩出後にインスリン需要が急減"/>
        <outline text="産後検査で持続糖尿病を判定"/>
      </outline>
      <outline text="妊娠後半の出血と胎児評価">
        <outline text="前置胎盤は無痛性出血、膣診回避"/>
        <outline text="早期剥離は有痛性、出血が隠れる"/>
        <outline text="前置血管は破水時に胎児出血"/>
        <outline text="発育不全と体質的小児を区別">
          <outline text="脳と心臓への循環再分配"/>
          <outline text="単回でなく連続測定"/>
        </outline>
      </outline>
      <outline text="分娩と分娩時救急">
        <outline text="胎児心拍監視は間接的指標">
          <outline text="自律神経反応であり酸素計ではない"/>
        </outline>
        <outline text="肩甲難産の児頭牽引は腕神経叢損傷">
          <outline text="恥骨上圧、内旋手技、後方上肢娩出"/>
        </outline>
        <outline text="臍帯脱出は先進部を持ち上げる"/>
        <outline text="子宮破裂は胎児徐脈、下降消失"/>
      </outline>
      <outline text="産後出血">
        <outline text="収縮不全、胎盤組織、外傷、凝固障害"/>
        <outline text="子宮弛緩はマッサージ、膀胱排空、収縮薬"/>
        <outline text="目測は出血量を過小評価"/>
        <outline text="数値でなく生理的悪化で手順起動"/>
        <outline text="フィブリノゲンは早期に低下">
          <outline text="基準値が高く軽度低値でも重症"/>
        </outline>
      </outline>
      <outline text="産褥移行">
        <outline text="自己輸血で心不全が顕在化"/>
        <outline text="子宮内膜炎は発熱、圧痛、悪臭悪露"/>
        <outline text="敗血症では発熱が目立たないことも">
          <outline text="経時変化と臓器機能を重視"/>
        </outline>
        <outline text="授乳は意欲でなく移送量を評価"/>
        <outline text="服薬で一律に授乳中止しない"/>
        <outline text="ブルーズから精神病まで幅広い">
          <outline text="侵入思考も危険評価は明示的に"/>
        </outline>
        <outline text="母体と新生児の別々の安全計画"/>
        <outline text="記録を一次診療へ引き継ぐ"/>
      </outline>
    </outline>
  </body>
</opml>
