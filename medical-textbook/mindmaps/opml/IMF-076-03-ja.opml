<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>076-03 下肢の骨、関節、筋、血管、神経、歩行統合</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="下肢の解剖と歩行">
      <outline text="可動性より支持">
        <outline text="体重支持、衝撃吸収、推進、平衡"/>
        <outline text="関節の拘束が強く骨が頑丈"/>
        <outline text="骨盤から足へ整列した力の伝達"/>
      </outline>
      <outline text="股関節">
        <outline text="寛骨臼は関節唇で深くなる"/>
        <outline text="腸骨大腿靱帯は過伸展へ抵抗">
          <outline text="少ない筋活動で直立を支える"/>
        </outline>
        <outline text="大腿骨頭靱帯の動脈は小児で重要"/>
        <outline text="内側大腿回旋動脈からの支帯枝">
          <outline text="関節包内骨折で損傷"/>
          <outline text="無腐性壊死と偽関節"/>
        </outline>
        <outline text="屈曲股関節を通る力で後方脱臼">
          <outline text="坐骨神経を傷害し得る"/>
        </outline>
        <outline text="鼠径部、大腿、膝への関連痛"/>
      </outline>
      <outline text="臀部と大腿">
        <outline text="大臀筋は股を伸展・外旋"/>
        <outline text="中・小臀筋は立位中の骨盤を安定化">
          <outline text="上臀神経損傷で非支持側骨盤が下垂"/>
        </outline>
        <outline text="梨状筋は大坐骨孔を分ける">
          <outline text="坐骨神経は通常下方から出るが変異"/>
        </outline>
        <outline text="前区画は大腿神経">
          <outline text="膝蓋骨は四頭筋モーメントアームを増す"/>
        </outline>
        <outline text="内側内転筋群は閉鎖神経"/>
        <outline text="ハムストリングスは主に脛骨部">
          <outline text="大腿二頭筋短頭は総腓骨神経部"/>
          <outline text="股伸展、膝屈曲、遊脚の減速"/>
        </outline>
      </outline>
      <outline text="大腿三角と内転筋管">
        <outline text="外側から神経、動脈、静脈、リンパ腔">
          <outline text="大腿鞘は神経を包まない"/>
          <outline text="大腿管は静脈内側のヘルニア部位"/>
        </outline>
        <outline text="大腿深動脈が大腿を供給"/>
        <outline text="大腿動脈は裂孔を通り膝窩動脈へ">
          <outline text="伏在神経は裂孔を通らない"/>
        </outline>
        <outline text="大伏在静脈は内果前方"/>
        <outline text="小伏在静脈は外果後方"/>
      </outline>
      <outline text="膝">
        <outline text="大腿骨顆は平坦な脛骨高原上を転がり滑る"/>
        <outline text="半月板は面を深め荷重分散、衝撃吸収">
          <outline text="内側半月板は強く固定され可動性低い"/>
        </outline>
        <outline text="十字靱帯は前方・後方移動へ抵抗"/>
        <outline text="脛側側副靱帯は外反へ、関節包と連続"/>
        <outline text="腓側側副靱帯は内反へ、半月板と分離"/>
        <outline text="終末伸展でロック、膝窩筋が解除"/>
        <outline text="膝窩動脈は膝窩の最深部">
          <outline text="自然整復した脱臼も血管損傷を残し得る"/>
        </outline>
      </outline>
      <outline text="下腿区画">
        <outline text="前区画は背屈、深腓骨神経">
          <outline text="前脛骨動脈は足背動脈へ続く"/>
        </outline>
        <outline text="外側区画は外反、浅腓骨神経"/>
        <outline text="総腓骨神経は腓骨頸を回る">
          <outline text="圧迫で下垂足"/>
        </outline>
        <outline text="後方浅層は踵骨腱を介し底屈"/>
        <outline text="後方深層は足趾屈曲、内反、足弓支持"/>
        <outline text="内果後方の足根管">
          <outline text="脛骨神経圧迫"/>
        </outline>
      </outline>
      <outline text="足関節と足弓">
        <outline text="足関節ほぞは背屈位で最も安定">
          <outline text="幅広い距骨前部がはまり込む"/>
        </outline>
        <outline text="外側靱帯と強い三角靱帯"/>
        <outline text="距骨下関節は地面へ適応"/>
        <outline text="距骨は筋付着がなく血流が脆弱"/>
        <outline text="距骨頭は内側縦足弓の要石"/>
        <outline text="外側弓は低く剛性が高い"/>
        <outline text="ウィンドラス機構で足底腱膜が緊張"/>
      </outline>
      <outline text="腰仙神経叢">
        <outline text="腰神経叢は大腰筋内に形成">
          <outline text="外側大腿皮神経の圧迫で神経痛"/>
        </outline>
        <outline text="坐骨神経は脛骨部と総腓骨部"/>
        <outline text="上臀神経は外転筋、下臀神経は大臀筋"/>
        <outline text="陰部神経は会陰を支配"/>
        <outline text="深腓骨神経は第一趾間の感覚"/>
      </outline>
      <outline text="歩行統合">
        <outline text="立脚期と遊脚期の交互">
          <outline text="両脚支持は走行で消える"/>
        </outline>
        <outline text="股外転筋は立脚中の骨盤を安定化"/>
        <outline text="四頭筋は接地後の膝屈曲を制御"/>
        <outline text="底屈筋は脛骨前進を抑え蹴り出す"/>
        <outline text="背屈筋は足の下降を制御し足趾を離す"/>
        <outline text="障害は他部位の代償を生む"/>
        <outline text="一関節でなく連結した運動連鎖"/>
      </outline>
    </outline>
  </body>
</opml>
