<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>081-01 脊髄の構成、上行路、下行路、病変パターン</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="脊髄の構成と病変パターン">
      <outline text="分節と向き">
        <outline text="高位、左右、索、交叉、体部位で欠損が決まる"/>
        <outline text="延髄から第一・第二腰椎付近の円錐">
          <outline text="脊柱が長く成長し下位根は馬尾に"/>
        </outline>
        <outline text="後根神経節は偽単極性感覚細胞体"/>
        <outline text="前根は体性運動と節前自律軸索"/>
        <outline text="比率で高位を知る">
          <outline text="頸髄は白質が多い"/>
          <outline text="腰膨大は灰白質角が太い"/>
          <outline text="胸髄には側角"/>
        </outline>
      </outline>
      <outline text="灰白質回路">
        <outline text="後角は感覚求心線維を受ける">
          <outline text="表層は侵害受容と温度"/>
          <outline text="深層は触覚と固有感覚"/>
        </outline>
        <outline text="前角の下位運動ニューロン">
          <outline text="内側は体幹・近位、外側は遠位"/>
          <outline text="アルファは錘外筋、ガンマは紡錘感度"/>
        </outline>
        <outline text="中間帯">
          <outline text="中間外側細胞柱は第一胸髄〜第二腰髄"/>
          <outline text="仙髄副交感は第二〜第四仙髄"/>
          <outline text="クラーク核は固有感覚を小脳へ中継"/>
        </outline>
        <outline text="反射">
          <outline text="伸張反射は単シナプス中核、調節される"/>
          <outline text="強度は末梢と中枢の興奮性を反映"/>
        </outline>
      </outline>
      <outline text="後索内側毛帯路">
        <outline text="識別性触覚、振動覚、意識的固有感覚"/>
        <outline text="一次軸索は同側を上行">
          <outline text="薄束は下半身で内側、楔状束は外側"/>
        </outline>
        <outline text="薄束核と楔状束核でシナプス"/>
        <outline text="内側弓状線維が交叉し内側毛帯へ">
          <outline text="視床腹側後外側核から体性感覚皮質"/>
        </outline>
        <outline text="脊髄病変は病変以下の同側障害"/>
        <outline text="感覚性失調は閉眼で悪化"/>
      </outline>
      <outline text="前外側系">
        <outline text="痛覚、温度覚、掻痒、粗大触覚"/>
        <outline text="リサウエル路を経て後角でシナプス"/>
        <outline text="前白交連を交叉">
          <outline text="病変より少し下から対側喪失"/>
        </outline>
        <outline text="脊髄視床線維は局在と識別"/>
        <outline text="脊髄網様体路・中脳路は覚醒と調節"/>
        <outline text="脊髄空洞症は交叉線維を傷害">
          <outline text="後索を保つ両側分節性喪失"/>
        </outline>
      </outline>
      <outline text="脊髄小脳路">
        <outline text="後脊髄小脳路はクラーク核から下小脳脚"/>
        <outline text="前脊髄小脳路は再交叉し同側で終わる"/>
        <outline text="小脳は意図と実際の運動を比較"/>
        <outline text="病変は同側失調、意識的感覚喪失なし"/>
      </outline>
      <outline text="運動路">
        <outline text="皮質脊髄路は内包と錐体を下行">
          <outline text="大部分は錐体交叉で交叉"/>
          <outline text="脊髄病変は同側、交叉より上は対側"/>
        </outline>
        <outline text="外側路は遠位部の分離運動"/>
        <outline text="前皮質脊髄路は体幹筋"/>
        <outline text="脳幹運動路">
          <outline text="網様体脊髄路は姿勢、筋緊張、歩行"/>
          <outline text="前庭脊髄路は安定と抗重力反応"/>
          <outline text="視蓋脊髄路は定位、赤核脊髄路は上肢"/>
        </outline>
        <outline text="上位運動ニューロン：反射亢進、クローヌス"/>
        <outline text="下位運動ニューロン：萎縮、線維束性収縮"/>
        <outline text="脊髄高位では混合像"/>
      </outline>
      <outline text="自律神経経路">
        <outline text="視床下部からの線維は脊髄背外側部">
          <outline text="頸髄病変でホルネル症候群"/>
        </outline>
        <outline text="膀胱は橋・皮質の調整を要する">
          <outline text="仙髄より上は排尿筋括約筋協調不全"/>
          <outline text="円錐、馬尾、末梢は無反射性"/>
        </outline>
        <outline text="高位損傷で神経原性ショック"/>
        <outline text="第六胸髄より上で自律神経過反射"/>
      </outline>
      <outline text="動脈支配領域">
        <outline text="前脊髄動脈は前方三分の二">
          <outline text="梗塞は両側運動麻痺と痛温覚喪失"/>
        </outline>
        <outline text="後脊髄動脈は後索と後角"/>
        <outline text="下位脊髄はアダムキーヴィッツ動脈に依存"/>
        <outline text="境界領域は大動脈手術で脆弱"/>
      </outline>
      <outline text="代表的脊髄症候群">
        <outline text="ブラウン・セカール症候群">
          <outline text="同側筋力低下と後索感覚喪失"/>
          <outline text="少し下からの対側痛温覚喪失"/>
        </outline>
        <outline text="中心性脊髄症候群は上肢優位"/>
        <outline text="前脊髄症候群は後索を保つ"/>
        <outline text="後脊髄症候群は感覚性失調"/>
        <outline text="円錐は早期の対称性鞍部・括約筋障害"/>
        <outline text="馬尾は非対称の根性痛、下位運動徴候"/>
      </outline>
      <outline text="局在の手順">
        <outline text="最も高い異常高位から始める"/>
        <outline text="一つのパターンで全所見を説明"/>
        <outline text="仙髄感覚温存は不完全な中心性病変"/>
        <outline text="画像は解剖学と照合して解釈"/>
      </outline>
    </outline>
  </body>
</opml>
