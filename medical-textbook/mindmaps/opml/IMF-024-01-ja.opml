<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>024-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="甲状腺、副腎、カルシウム、骨の基礎">
      <outline text="甲状腺ホルモンの合成と作用">
        <outline text="ナトリウム・ヨウ化物共輸送体で濃縮"/>
        <outline text="甲状腺ペルオキシダーゼが酸化し結合">
          <outline text="縮合でサイロキシンとトリヨードサイロニン"/>
        </outline>
        <outline text="コロイド貯蔵とタンパク分解で放出"/>
        <outline text="分泌の大部分はサイロキシン">
          <outline text="脱ヨード酵素が活性型か不活性代謝物へ"/>
        </outline>
        <outline text="遊離ホルモンが核内受容体に結合"/>
        <outline text="甲状腺刺激ホルモンと負のフィードバック"/>
      </outline>
      <outline text="甲状腺機能低下症">
        <outline text="原発性は自己免疫、治療、ヨウ素、薬剤"/>
        <outline text="刺激ホルモンと遊離サイロキシンの組">
          <outline text="原発性は刺激ホルモン高値、遊離低値"/>
          <outline text="中枢性は不適切に低値か正常"/>
        </outline>
        <outline text="レボチロキシン用量を個別に決める">
          <outline text="鉄、カルシウム、食物で吸収低下"/>
        </outline>
        <outline text="粘液水腫性昏睡は重度非代償状態">
          <outline text="緊急ホルモン、グルココルチコイド、誘因治療"/>
        </outline>
      </outline>
      <outline text="甲状腺中毒症と構造的甲状腺疾患">
        <outline text="組織の甲状腺ホルモン過剰曝露">
          <outline text="バセドウ病は受容体を刺激"/>
          <outline text="中毒性結節は自律性に分泌"/>
          <outline text="甲状腺炎は貯蔵ホルモンを放出"/>
          <outline text="外因性ホルモンは合成を迂回"/>
        </outline>
        <outline text="放射性核種取り込みで原因を区別">
          <outline text="増加は活発な合成"/>
          <outline text="低下は破壊性甲状腺炎か外因性"/>
        </outline>
        <outline text="チオナミドは合成を阻害">
          <outline text="無顆粒球症：発熱や咽頭痛は緊急"/>
        </outline>
        <outline text="クリーゼは作用から誘因まで遮断"/>
        <outline text="結節は超音波リスク評価と穿刺吸引"/>
      </outline>
      <outline text="副腎皮質の構成">
        <outline text="球状帯はアンジオテンシンIIとカリウム"/>
        <outline text="束状帯は副腎皮質刺激ホルモンでコルチゾール"/>
        <outline text="網状帯は副腎アンドロゲン"/>
        <outline text="コルチゾールは血管反応性と糖新生を支持"/>
        <outline text="アルドステロンは主細胞に作用">
          <outline text="ナトリウム再吸収とカリウム分泌"/>
        </outline>
        <outline text="レニンは灌流低下、緻密斑、交感神経"/>
      </outline>
      <outline text="副腎不全と副腎クリーゼ">
        <outline text="原発性は皮質を破壊">
          <outline text="コルチゾールとアルドステロン欠乏"/>
        </outline>
        <outline text="中枢性はアルドステロンが保たれる"/>
        <outline text="慢性グルココルチコイドが系を抑制"/>
        <outline text="原発性で色素沈着、塩分欲求、高カリウム"/>
        <outline text="両型で低ナトリウム血症"/>
        <outline text="クリーゼはショック、嘔吐、低血糖">
          <outline text="検査のため治療を遅らせない"/>
          <outline text="ヒドロコルチゾン、等張液、ブドウ糖"/>
        </outline>
        <outline text="病日時増量、緊急識別、注射用救命"/>
      </outline>
      <outline text="コルチゾール過剰">
        <outline text="クッシング症候群は医原性が最多"/>
        <outline text="依存性は下垂体または異所性分泌"/>
        <outline text="非依存性は副腎病変"/>
        <outline text="抑制喪失、遊離コルチゾール、深夜最低値">
          <outline text="確認と外因性除外の後に局在化"/>
        </outline>
        <outline text="原因治療と治癒後の一時的補充"/>
      </outline>
      <outline text="アルドステロン異常と副腎腫瘤">
        <outline text="原発性アルドステロン症は高血圧とレニン抑制">
          <outline text="カリウムは正常なこともある"/>
          <outline text="アルドステロン・レニン関係から局在診断へ"/>
          <outline text="片側性は手術、両側性は受容体遮断"/>
        </outline>
        <outline text="カテコールアミン腫瘍は頭痛、発汗、動悸">
          <outline text="ベータ遮断より先にアルファ遮断"/>
        </outline>
      </outline>
      <outline text="カルシウム調節">
        <outline text="イオン化カルシウムは興奮性と凝固を支持">
          <outline text="総カルシウムはアルブミンとpHで変化"/>
        </outline>
        <outline text="低下で副甲状腺ホルモン上昇">
          <outline text="腎カルシウム再吸収とリン酸排泄"/>
        </outline>
        <outline text="ビタミンDは皮膚または食事、肝、腎"/>
        <outline text="マグネシウムは副甲状腺機能に必要">
          <outline text="重度欠乏で治療抵抗性低カルシウム"/>
        </outline>
      </outline>
      <outline text="高カルシウム血症と低カルシウム血症">
        <outline text="大部分は副甲状腺機能亢進症か悪性腫瘍"/>
        <outline text="早期に副甲状腺ホルモンを測定">
          <outline text="高値か不適切正常なら副甲状腺依存"/>
          <outline text="抑制なら別原因を探索"/>
        </outline>
        <outline text="重症は体液回復、骨吸収抑制、監視"/>
        <outline text="低カルシウム血症はしびれ、テタニー、QT延長">
          <outline text="心電図監視下で静注カルシウム"/>
        </outline>
      </outline>
      <outline text="骨リモデリングと骨粗鬆症">
        <outline text="破骨細胞は吸収、骨芽細胞は形成、骨細胞は感知">
          <outline text="過剰吸収は骨構築を弱める"/>
        </outline>
        <outline text="無症状椎体骨折と大腿骨近位部骨折"/>
        <outline text="運動、転倒予防、カルシウム、ビタミンD"/>
        <outline text="骨吸収抑制薬と骨形成促進薬">
          <outline text="一部は反跳するため終了戦略"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
