<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>068-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="緩和医療の基礎">
      <outline text="対象と必要性の特定">
        <outline text="症状、意思決定、調整、全人的な必要"/>
        <outline text="疾患治療と並行して開始">
          <outline text="がんや最期の数日間に限定されない"/>
        </outline>
        <outline text="死の認識は安楽へ努力を移す"/>
        <outline text="進行、反復入院、機能低下、介護者負担"/>
        <outline text="驚くかの問いは未対応の計画を発見">
          <outline text="予後予測そのものではない"/>
        </outline>
        <outline text="疾患ごとに経過が異なる">
          <outline text="がんは比較的予測可能に低下"/>
          <outline text="臓器不全は急性増悪を伴い変動"/>
          <outline text="フレイル・認知症は緩徐に低下"/>
        </outline>
      </outline>
      <outline text="目標と共同意思決定">
        <outline text="理解、希望する情報量、今重要なこと"/>
        <outline text="希望は治癒から達成可能な優先事項へ"/>
        <outline text="利益、負担、不確実性、代替法を比較"/>
        <outline text="期間限定治療試行">
          <outline text="介入、客観的指標、期間、無効時の対応"/>
        </outline>
        <outline text="代理人、事前指示、蘇生方針、療養場所"/>
      </outline>
      <outline text="意思疎通と予後">
        <outline text="予告し平易に話し、間を置き感情を認める"/>
        <outline text="予後は日付ではなく範囲">
          <outline text="最良、最悪、最も可能性の高いシナリオ"/>
        </outline>
        <outline text="詳細を望まなければ受け取る人を確認"/>
        <outline text="対立は事実、価値観、悲嘆、信頼の違い">
          <outline text="共通目標、セカンドオピニオン、調停"/>
          <outline text="目標を達成できない治療には推奨を提示"/>
        </outline>
      </outline>
      <outline text="全人的な症状評価">
        <outline text="症状には複数の側面がある"/>
        <outline text="診療を変える場合だけ検査"/>
        <outline text="非薬物ケア：説明、体位、扇風機、口腔ケア"/>
        <outline text="予後に合わない予防薬を中止">
          <outline text="依存を生じる治療からの離脱を避ける"/>
        </outline>
      </outline>
      <outline text="疼痛">
        <outline text="疼痛の種類を特定し原因を治療"/>
        <outline text="ステロイド、ビスホスホネート、放射線、神経ブロック"/>
        <outline text="オピオイドは中心だが唯一ではない"/>
        <outline text="経皮吸収システムは調節が遅い">
          <outline text="急速に増悪する疼痛に適さない"/>
        </outline>
        <outline text="換算表は推定値">
          <outline text="不完全な交差耐性を考慮し減量"/>
        </outline>
        <outline text="呼吸抑制：急速増量、相互作用、腎不全、誤薬"/>
        <outline text="依存症への恐れで疼痛を未治療にしない"/>
      </outline>
      <outline text="呼吸困難">
        <outline text="不安と知覚を含む複数の機序"/>
        <outline text="酸素は低酸素血症に有効、他は効果乏しい"/>
        <outline text="上体挙上、携帯扇風機、活動調整、指導"/>
        <outline text="低用量オピオイドは中枢知覚を変える"/>
        <outline text="ベンゾジアゼピンは強い不安にのみ"/>
        <outline text="非侵襲的換気は目的を明確に">
          <outline text="症状軽減も生命延長もあり得る"/>
        </outline>
      </outline>
      <outline text="悪心、腸管、および分泌物">
        <outline text="腸閉塞は目標に応じて管理">
          <outline text="完全閉塞では消化管運動促進薬を避ける"/>
        </outline>
        <outline text="便秘は疼痛、悪心、せん妄を起こす">
          <outline text="オピオイド性便秘に刺激性薬と浸透圧性薬"/>
          <outline text="好中球・血小板減少で直腸処置を避ける"/>
        </outline>
        <outline text="分泌音は患者より家族を苦しめる">
          <outline text="抗ムスカリン薬は既存の液体を除去しない"/>
          <outline text="深部吸引は持続的利益なく苦痛を与える"/>
        </outline>
      </outline>
      <outline text="せん妄、興奮、および苦痛">
        <outline text="せん妄：感染、尿閉、薬剤、臓器不全">
          <outline text="慣れた環境、見当識、睡眠の手掛かり、安全"/>
          <outline text="抗精神病薬は危険な興奮に、悪化もある"/>
        </outline>
        <outline text="終末期興奮：疼痛、膀胱膨満、恐怖、離脱"/>
        <outline text="破局的出血：濃色のタオル、速効性鎮静薬"/>
        <outline text="悲しみは治療可能なうつ病を除外しない"/>
        <outline text="死を早めたい希望に関心をもって応じる"/>
        <outline text="抗うつ薬の効果発現が予後より遅い"/>
      </outline>
      <outline text="栄養と水分">
        <outline text="摂取を強制せず口腔痛と悪心を治療"/>
        <outline text="カロリー目標より好みの食品"/>
        <outline text="悪液質はカロリーだけで逆転しない"/>
        <outline text="人工栄養は選択された可逆的病態に">
          <outline text="進行認知症や死の過程では改善しない"/>
        </outline>
        <outline text="補助的水分投与は浮腫、分泌物を悪化">
          <outline text="口腔ケアの方が乾燥をよく軽減"/>
        </outline>
      </outline>
      <outline text="最期の日々、死、および悲嘆">
        <outline text="徴候：寝たきり、摂取極少、網状斑、嚥下不能"/>
        <outline text="安楽を改善しない観察、検査、器具を中止"/>
        <outline text="使用可能な経路で予測的薬剤"/>
        <outline text="蘇生方針は診療放棄ではない"/>
        <outline text="不開始と中止は倫理的に同等"/>
        <outline text="緩和的鎮静は必要最小限と多職種審査"/>
        <outline text="死亡確認、死亡診断書、遺体と過ごす時間"/>
        <outline text="悲嘆は直線的に進まない">
          <outline text="リスク：外傷性の死、孤立、支援不足"/>
          <outline text="正常な悲しみを医療化せず追跡"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
