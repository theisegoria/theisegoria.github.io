<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>061-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="疼痛、鎮痛、麻酔、鎮静の安全性">
      <outline text="概説">
        <outline text="疼痛は防御的だが持続で障害に"/>
        <outline text="呼吸、循環、認知を保つ鎮痛"/>
        <outline text="麻酔と鎮静は意識と反射を変化">
          <outline text="急速な気道・循環動態の緊急事態"/>
        </outline>
        <outline text="機序、同意、監視、救命対応"/>
      </outline>
      <outline text="疼痛の機序と評価">
        <outline text="侵害受容器は機械的・熱的・化学的脅威を検出"/>
        <outline text="脊髄で信号を増幅または抑制">
          <outline text="視床と大脳皮質へ上行"/>
        </outline>
        <outline text="下行性経路、恐怖、気分、睡眠が調節"/>
        <outline text="損傷が見えずとも現実、訴えは機序でない"/>
        <outline text="侵害受容性は体性または内臓性"/>
        <outline text="神経障害性は体性感覚経路の病変">
          <outline text="灼熱性、電撃性、しびれ、アロディニア"/>
        </outline>
        <outline text="痛覚変調性は病変のない処理異常"/>
        <outline text="がん、腰痛、糖尿病、外傷で混在"/>
        <outline text="意思疎通に適した尺度、機能評価は代替不可"/>
        <outline text="意思疎通障害は行動徴候、介護者、試行"/>
      </outline>
      <outline text="多角的鎮痛">
        <outline text="原因治療と異なる経路の併用"/>
        <outline text="体位、固定、理学療法、心理療法"/>
        <outline text="区域麻酔はオピオイド必要量を減らす"/>
        <outline text="パラセタモールは鎮痛・解熱、抗炎症は乏しい">
          <outline text="配合薬を含めた総投与量を確認"/>
          <outline text="過量で初期症状のない肝障害"/>
        </outline>
        <outline text="非ステロイド性抗炎症薬はシクロオキシゲナーゼ阻害">
          <outline text="潰瘍、出血、腎障害、ナトリウム貯留"/>
          <outline text="加齢、脱水、抗凝固、心不全でリスク増"/>
          <outline text="最小有効量、最短期間、局所に外用"/>
        </outline>
      </outline>
      <outline text="オピオイド">
        <outline text="伝達物質放出と興奮性を低下"/>
        <outline text="鎮静、呼吸抑制、便秘、掻痒"/>
        <outline text="睡眠時無呼吸、フレイル、未使用、鎮静薬併用"/>
        <outline text="迅速な効果には監視下で少量静注"/>
        <outline text="安定した疼痛には経口が安全"/>
        <outline text="換算表は推定、交差耐性は不完全">
          <outline text="薬剤変更時は計算用量を減らす"/>
        </outline>
        <outline text="未使用者の速やかな調節に長時間型は不適"/>
        <outline text="呼吸抑制は呼吸数、深さ、覚醒度が低下">
          <outline text="酸素投与で飽和度は見かけ上正常"/>
          <outline text="刺激、気道開放、換気、ナロキソン調節"/>
          <outline text="ナロキソンが先に切れ得る"/>
        </outline>
        <outline text="慢性非がん性疼痛は機能目標と利益">
          <outline text="高用量は機能でなく過量リスクを増す"/>
        </outline>
        <outline text="身体依存は適応、依存症は制御不能">
          <outline text="突然の中止を避ける"/>
        </outline>
      </outline>
      <outline text="神経障害性疼痛と特殊な鎮痛">
        <outline text="抗うつ薬、ガバペンチノイド、リドカイン外用">
          <outline text="低用量開始、転倒と鎮静を見直す"/>
        </outline>
        <outline text="ケタミン">
          <outline text="エヌ・メチル・ディー・アスパラギン酸受容体拮抗"/>
          <outline text="比較的呼吸を保ちながら鎮痛"/>
          <outline text="解離、高血圧、覚醒時反応"/>
        </outline>
        <outline text="局所麻酔薬はナトリウムチャネル遮断">
          <outline text="口周囲症状、耳鳴、痙攣、不整脈"/>
          <outline text="中止、気道、修正蘇生、脂肪乳剤"/>
        </outline>
        <outline text="がん疼痛は疾患治療と多角的ケア">
          <outline text="体動時痛に事前のレスキュー投与"/>
        </outline>
      </outline>
      <outline text="麻酔前評価">
        <outline text="処置、緊急性、気道、逆流、絶食、フレイル"/>
        <outline text="記録で挿管困難、悪性高熱症を確認"/>
        <outline text="単一検査で困難は予測できない">
          <outline text="前頸部からの緊急気道確保まで備える"/>
        </outline>
        <outline text="診療を変える検査だけ行う"/>
        <outline text="緊急手術を遅らせずに最適化"/>
        <outline text="過度の絶食は脱水を起こす"/>
        <outline text="胃排出遅延、絶食患者でも誤嚥"/>
      </outline>
      <outline text="全身麻酔と区域麻酔">
        <outline text="催眠、健忘、鎮痛、不動、反射抑制"/>
        <outline text="交感神経緊張、血管抵抗、呼吸を低下"/>
        <outline text="監視で用量調整と異常を検出"/>
        <outline text="前酸素化は安全な無呼吸時間を延長"/>
        <outline text="持続する呼気二酸化炭素で留置確認"/>
        <outline text="酸素化不能時は試行反復より酸素化"/>
        <outline text="神経根と交感神経流出を遮断">
          <outline text="低血圧、尿閉、頭痛、高位ブロック"/>
          <outline text="抗血栓薬の時期で脊髄血腫を予防"/>
        </outline>
        <outline text="末梢神経ブロックは用量、監視、肢の保護"/>
      </outline>
      <outline text="処置時鎮静">
        <outline text="不安軽減から無反応までの連続体"/>
        <outline text="一段深い状態を救命できる能力"/>
        <outline text="深い鎮静では監視専任の医療者"/>
        <outline text="酸素、吸引、バッグマスク、拮抗薬"/>
        <outline text="カプノグラフィは低換気を先に検出"/>
        <outline text="ベンゾジアゼピンとオピオイドは相乗抑制"/>
        <outline text="プロポフォールは無呼吸、低血圧、拮抗薬なし"/>
        <outline text="ケタミンは反射保持も喉頭痙攣あり"/>
        <outline text="亜酸化窒素は閉鎖腔内ガスを膨張"/>
      </outline>
      <outline text="周術期緊急事態と回復">
        <outline text="発疹のないアナフィラキシーにアドレナリン"/>
        <outline text="悪性高熱症は二酸化炭素上昇、強剛、高体温">
          <outline text="誘因中止、ダントロレン、冷却"/>
        </outline>
        <outline text="術中覚醒の訴えを真剣に受け止める"/>
        <outline text="低体温は出血と感染を増やす"/>
        <outline text="回復は気道、循環、意識の安定"/>
        <outline text="退院は付き添い、書面助言、制限"/>
      </outline>
    </outline>
  </body>
</opml>
