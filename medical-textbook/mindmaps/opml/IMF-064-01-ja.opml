<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>064-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="臨床検査、画像診断、検査適正化">
      <outline text="概説、確率と閾値">
        <outline text="検査は不確実性を変え推論に代わらない">
          <outline text="害：疼痛、貧血、放射線、検査連鎖、遅延"/>
          <outline text="結果が行動を変える場合に依頼"/>
        </outline>
        <outline text="標的疾患と検査前確率を明示"/>
        <outline text="感度と特異度">
          <outline text="予測値は有病率で変化"/>
          <outline text="尤度比は検査前を検査後オッズへ変換"/>
        </outline>
        <outline text="高感度の陰性は除外、高特異度の陽性は確定">
          <outline text="時期、手技、スペクトラム、カットオフで破綻"/>
        </outline>
        <outline text="閾値は結果の重大性を反映">
          <outline text="危険で治療可能なら低確率でも行動"/>
        </outline>
        <outline text="基準範囲は健康集団の中央95%">
          <outline text="項目増加で偶然の異常値"/>
        </outline>
      </outline>
      <outline text="検体の質と分析前誤差">
        <outline text="識別、時期、採血管、部位、運搬"/>
        <outline text="姿勢、絶食、薬剤、駆血帯が結果を変える"/>
        <outline text="溶血はカリウムと酵素を上昇"/>
        <outline text="遅延は血糖と血液ガスを変化"/>
        <outline text="充填不足クエン酸管は凝固を歪める"/>
        <outline text="予想外の結果は患者評価と妥当性確認">
          <outline text="緊急再検、重大な結果を退けない"/>
        </outline>
        <outline text="閉ループ：受信者、意味、行動、責任者"/>
      </outline>
      <outline text="血算と血液塗抹">
        <outline text="診断ではなく全体像"/>
        <outline text="複数欠乏で平均赤血球容積は正常"/>
        <outline text="網赤血球は貧血重症度を考慮"/>
        <outline text="好中球減少リスクは深さと期間"/>
        <outline text="血小板数は機能を測定しない">
          <outline text="出血リスク：血管、薬剤、臓器、処置"/>
        </outline>
        <outline text="塗抹：破砕、芽球、寄生虫、凝集"/>
      </outline>
      <outline text="電解質、腎機能、浸透圧">
        <outline text="ナトリウム値は主に水分収支">
          <outline text="慢性異常は緩徐に補正"/>
        </outline>
        <outline text="カリウム：採血、酸塩基、インスリン、薬剤">
          <outline text="重症か心電図変化なら直ちに治療"/>
        </outline>
        <outline text="クレアチニンは不完全で遅れる">
          <outline text="変化中の推算糸球体濾過量は低信頼"/>
        </outline>
        <outline text="尿検査は血清値で分からない型を示す"/>
        <outline text="浸透圧ギャップとアニオンギャップ">
          <outline text="いずれも危険な中毒を除外できない"/>
        </outline>
      </outline>
      <outline text="肝臓、心臓、炎症、内分泌マーカー">
        <outline text="アミノトランスフェラーゼは肝細胞損傷">
          <outline text="高酵素値が機能不全の重さではない"/>
        </outline>
        <outline text="トロポニンは心筋傷害で梗塞ではない">
          <outline text="梗塞：上昇か低下と虚血の証拠"/>
        </outline>
        <outline text="ナトリウム利尿ペプチドは壁応力"/>
        <outline text="シー反応性蛋白質と赤血球沈降速度は非特異的"/>
        <outline text="自己抗体には適合する表現型が必要"/>
        <outline text="副腎クリーゼ疑いは検査前に治療"/>
        <outline text="糖化ヘモグロビンは赤血球変化で歪む"/>
      </outline>
      <outline text="凝固および輸血検査">
        <outline text="プロトロンビン時間でビタミンK拮抗薬監視"/>
        <outline text="正常でもフォン・ヴィレブランド病を除外不可"/>
        <outline text="異常：欠乏、インヒビター、検体誤差"/>
        <outline text="血液型、抗体、交差適合で不適合防止">
          <outline text="出血が遅れを上回れば緊急未交差血"/>
        </outline>
        <outline text="輸血は単一閾値でなく生理状態で"/>
      </outline>
      <outline text="微生物学的検査と分子検査">
        <outline text="抗微生物薬前に感染部位から採取"/>
        <outline text="培養陽性：病原体、定着菌、汚染菌"/>
        <outline text="感受性は組織移行を保証しない"/>
        <outline text="ポリメラーゼ連鎖反応は消失後も陽性"/>
        <outline text="血清学的検査は初期に陰性"/>
      </outline>
      <outline text="単純画像、超音波、断層撮影、磁気共鳴">
        <outline text="単純X線：重なりが疾患を隠す">
          <outline text="正常胸部画像で早期感染・小気胸除外不可"/>
        </outline>
        <outline text="超音波：放射線なし、術者依存"/>
        <outline text="コンピュータ断層撮影：迅速な断層解剖">
          <outline text="放射線は累積するが救命画像を遅らせない"/>
          <outline text="ヨード造影剤：利益と腎機能を評価"/>
        </outline>
        <outline text="磁気共鳴画像：高コントラストだが遅い">
          <outline text="重度腎不全・妊娠でガドリニウム慎重"/>
        </outline>
      </outline>
      <outline text="核医学および画像下治療">
        <outline text="放射性トレーサーは生理機能を画像化">
          <outline text="炎症はがんに似る"/>
        </outline>
        <outline text="画像下治療：生検、排液、塞栓">
          <outline text="生検経路は将来の手術を妨げない"/>
        </outline>
      </outline>
      <outline text="検査適正化と偶発所見">
        <outline text="問い、結果の影響、時期、害を問う"/>
        <outline text="治療を導かない監視は中止"/>
        <outline text="問いに答える最も害の少ない検査"/>
        <outline text="スクリーニング：低有病率、過剰診断"/>
        <outline text="偶発所見はリスクとフォローアップで記述"/>
        <outline text="すべての移行時に担当者を指定"/>
      </outline>
    </outline>
  </body>
</opml>
