<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>076-01 背部、脊柱、脊柱管、体軸支持</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="背部、脊柱、脊柱管">
      <outline text="背部の体軸的役割">
        <outline text="頭蓋・胸郭・骨盤・四肢を結ぶ保護柱"/>
        <outline text="安定性、柔軟性、荷重、神経保護の均衡">
          <outline text="小さな変化が疼痛、運動、神経へ影響"/>
        </outline>
      </outline>
      <outline text="領域ごとの脊柱">
        <outline text="典型的椎骨は前方の椎体と後方の椎弓">
          <outline text="連続する椎孔が脊柱管を形成"/>
          <outline text="椎弓根の切痕が椎間孔を作る"/>
        </outline>
        <outline text="頸椎は小さな椎体と横突孔">
          <outline text="椎骨動脈は通常第六頸椎で入る"/>
          <outline text="環椎は椎体を欠き後頭顆を支える"/>
          <outline text="軸椎の歯突起は環椎回旋の軸"/>
        </outline>
        <outline text="胸椎は肋骨窩と冠状面に近い関節">
          <outline text="回旋を許し屈曲・伸展を制限"/>
        </outline>
        <outline text="腰椎は大きな椎体と矢状面の関節面">
          <outline text="屈曲・伸展を許し回旋へ抵抗"/>
        </outline>
        <outline text="仙骨は五椎の癒合">
          <outline text="仙腸関節から骨盤輪へ荷重を伝える"/>
        </outline>
        <outline text="尾骨は骨盤底構造を付着させる"/>
      </outline>
      <outline text="弯曲と荷重伝達">
        <outline text="一次性後弯は胎児の屈曲を反映"/>
        <outline text="二次性前弯は頭の挙上と立位で発達"/>
        <outline text="弯曲は荷重を分散し弾性を高める">
          <outline text="年齢と症状に照らして解釈"/>
        </outline>
        <outline text="累積荷重で椎体は下方ほど大きい"/>
        <outline text="腰仙角は前方剪断力を作る">
          <outline text="椎間関節、椎間板、靱帯、筋が抵抗"/>
        </outline>
        <outline text="座位は坐骨結節、立位は寛骨臼へ"/>
        <outline text="側弯症は椎骨回旋を伴う側方弯曲">
          <outline text="肋骨隆起は胸椎回旋から生じる"/>
          <outline text="構築性は残り、機能性は修正され得る"/>
        </outline>
      </outline>
      <outline text="椎間板と関節">
        <outline text="線維輪の層は捻りと張力へ抵抗"/>
        <outline text="髄核は静水圧で圧縮を分散"/>
        <outline text="無血管の椎間板は終板から拡散"/>
        <outline text="画像上の変性は無痛者にも多い"/>
        <outline text="後縦靱帯が弱い部位で後外側ヘルニア">
          <outline text="通過する神経根へ影響し得る"/>
        </outline>
        <outline text="椎間関節の方向が運動を誘導・制限"/>
        <outline text="鉤椎関節の骨棘が椎間孔へ影響"/>
        <outline text="環軸関節は回旋を許す">
          <outline text="環椎横靱帯が歯突起を保持"/>
          <outline text="破綻すると上位脊髄を脅かす"/>
        </outline>
      </outline>
      <outline text="脊柱靱帯">
        <outline text="前縦靱帯は伸展を制限"/>
        <outline text="後縦靱帯は屈曲を制限"/>
        <outline text="黄色靱帯は屈曲から復帰させたわみを防ぐ"/>
        <outline text="頸部で棘上靱帯は項靱帯へ広がる"/>
        <outline text="受動的安定性と機械感覚入力">
          <outline text="石灰化、肥厚、断裂、弛緩を生じ得る"/>
        </outline>
      </outline>
      <outline text="脊柱管と被膜">
        <outline text="脊髄は第一・第二腰椎付近で円錐として終わる">
          <outline text="馬尾は硬膜嚢内を下降"/>
          <outline text="終糸が脊髄と硬膜を固定"/>
        </outline>
        <outline text="脊髄神経は後枝と前枝へ分かれる">
          <outline text="後枝は固有背部構造を支配"/>
          <outline text="前枝は前外側体幹と四肢を支配"/>
        </outline>
        <outline text="脊髄膜は軟膜、くも膜、硬膜">
          <outline text="硬膜外腔の脂肪と内椎骨静脈叢"/>
          <outline text="歯状靱帯が脊髄を安定化"/>
        </outline>
        <outline text="前脊髄動脈一本と後脊髄動脈二本">
          <outline text="前脊髄動脈領域は前方約三分の二"/>
          <outline text="大動脈疾患や手術で脆弱"/>
          <outline text="大前根動脈の側と高位は変異"/>
        </outline>
        <outline text="腰椎穿刺は脊髄終末より下方">
          <outline text="針は靱帯、硬膜外腔、硬膜を通る"/>
        </outline>
      </outline>
      <outline text="背筋">
        <outline text="表在外来筋は僧帽筋、広背筋"/>
        <outline text="中間層の後鋸筋は肋骨と呼吸"/>
        <outline text="深部固有筋は脊髄神経後枝支配">
          <outline text="脊柱起立筋は腸肋筋、最長筋、棘筋"/>
          <outline text="横突棘筋は半棘筋、多裂筋、回旋筋"/>
          <outline text="後頭下筋は頭部運動を微調整"/>
        </outline>
        <outline text="安定性は動的協調である">
          <outline text="多裂筋と腹壁筋が分節剛性に寄与"/>
          <outline text="横隔膜と骨盤底が圧を調節"/>
        </outline>
      </outline>
      <outline text="解剖学的症候群">
        <outline text="神経根症は神経根刺激から生じる">
          <outline text="皮節と筋節が重なり分布は近似"/>
        </outline>
        <outline text="頸・胸椎の中心管狭窄は脊髄症">
          <outline text="病変以下の上位運動ニューロン徴候"/>
        </outline>
        <outline text="腰部狭窄は屈曲で軽快する間欠跛行"/>
        <outline text="馬尾症候群は鞍部感覚低下と膀胱・腸">
          <outline text="緊急の局在と減圧評価"/>
        </outline>
        <outline text="見える変性は疼痛発生源を証明しない"/>
      </outline>
    </outline>
  </body>
</opml>
