<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>067-02 倫理的対立の解決、支援付き意思決定、デジタルプライバシー、およびセーフガーディング実務</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="倫理的対立、支援付き意思決定、守秘、保護">
      <outline text="倫理的対立の構造化">
        <outline text="事実、価値、手続を分ける"/>
        <outline text="状態、選択肢、緊急性、可逆性を定義"/>
        <outline text="利益、決定権、権力差を確認"/>
        <outline text="再評価時点を定めた公正な手続"/>
        <outline text="苦しい転帰でも非倫理的とは限らない">
          <outline text="避けられない損失が対立を生む"/>
        </outline>
      </outline>
      <outline text="支援付き意思決定と能力">
        <outline text="自律性は個人的かつ関係的"/>
        <outline text="代行前に本人の主体性を強める">
          <outline text="疼痛・せん妄治療、専門通訳"/>
          <outline text="段階説明、十分な時間、良い時間帯"/>
          <outline text="支援者は患者の声を置き換えない"/>
        </outline>
        <outline text="能力評価は実際の決定に対応">
          <outline text="患者が選択肢と結果を説明"/>
          <outline text="珍しい信念でも能力はあり得る"/>
          <outline text="せん妄なら普通の答えでも不十分"/>
          <outline text="可逆障害治療後に再評価"/>
        </outline>
      </outline>
      <outline text="能力がない場合">
        <outline text="決定は本人中心のまま"/>
        <outline text="有効で適用可能な事前拒否が優先し得る"/>
        <outline text="代行者は自身でなく本人の価値を用いる"/>
        <outline text="価値不明なら最善利益"/>
        <outline text="親族間不一致は多数決でない">
          <outline text="法的役割を確認し未解決対立を上申"/>
        </outline>
        <outline text="緊急例外">
          <outline text="死亡・重大不可逆害を防ぐ治療"/>
          <outline text="便利さや予定処置には使わない"/>
          <outline text="安定後は通常の同意過程へ戻す"/>
        </outline>
      </outline>
      <outline text="同意、自発性、反対意思">
        <outline text="比例的だが形式だけにしない"/>
        <outline text="確率を結果へ結ぶ"/>
        <outline text="ティーチバックは説明の質を試す"/>
        <outline text="用紙は強制や能力欠如を修復しない"/>
        <outline text="自発性を損なう圧力">
          <outline text="推奨は適切、操作は不適切"/>
          <outline text="能力ある拒否には害低減計画"/>
        </outline>
        <outline text="反対意思に対する治療">
          <outline text="最小制限の有効手段を最短時間"/>
          <outline text="化学的拘束にも保護が必要"/>
        </outline>
      </outline>
      <outline text="守秘とデジタルプライバシー">
        <outline text="開示判断の構造化された閾値">
          <outline text="必要最小限、再開示を制限"/>
        </outline>
        <outline text="心配する親族は提供できても受けない"/>
        <outline text="診察室を超えるデジタルの危険">
          <outline text="好奇心の閲覧、画面撮影、オンライン"/>
          <outline text="メタデータや珍しい事実で再同定"/>
        </outline>
        <outline text="生成AIと外部解析サービス">
          <outline text="承認、保存、学習、削除可能性を確認"/>
          <outline text="氏名を削るだけでは不十分"/>
          <outline text="責任は臨床家から移らない"/>
        </outline>
      </outline>
      <outline text="決定を再現可能にする記録">
        <outline text="価値、危険、代替、決定を記す"/>
        <outline text="能力は機能評価と可逆因子"/>
        <outline text="保護では引用、観察、推論を分ける"/>
        <outline text="見えない変更でなく日付付き訂正"/>
      </outline>
      <outline text="セーフガーディング実務">
        <outline text="証明でなく信号"/>
        <outline text="危険を増やさず私的環境を作る">
          <outline text="関与し得る親族でなく専門通訳"/>
        </outline>
        <outline text="危険、武器、絞扼を優先"/>
        <outline text="開示には信じる姿勢で応じる">
          <outline text="尋問せず加害疑い者と対決しない"/>
          <outline text="警察関与を支援条件にしない"/>
        </outline>
        <outline text="強制報告は法域などで異なる"/>
        <outline text="非致死性絞扼">
          <outline text="遅発気道浮腫、脳低酸素"/>
          <outline text="将来の致死暴力の危険"/>
        </outline>
        <outline text="安全計画で端末監視を確認"/>
      </outline>
      <outline text="子どもと専門職境界">
        <outline text="福祉保護と発達に合う参加"/>
        <outline text="重大な危険で親の権限は狭まる"/>
        <outline text="敏感な質問前に秘密保持の限界を説明"/>
        <outline text="境界は小さな変化で試される"/>
        <outline text="境界保護は冷淡さではない"/>
      </outline>
      <outline text="有害事象、希少資源、研究">
        <outline text="正直な説明と証拠保全"/>
        <outline text="事実を創作しない誠実な謝罪"/>
        <outline text="公正文化も無謀行為に対処"/>
        <outline text="予後推定には偏りが埋め込まれ得る"/>
        <outline text="同等適格者には公正な同順位基準"/>
        <outline text="研究参加は診療同意と分ける">
          <outline text="拒否しても標準診療は損なわれない"/>
        </outline>
      </outline>
      <outline text="意思疎通、長引く対立、苦悩">
        <outline text="推奨と決定を変え得る条件を示す"/>
        <outline text="法は思いやりの代わりにならない"/>
        <outline text="権力を可視化し最小制限を用いる"/>
        <outline text="道徳的苦悩には監督と職員支援">
          <outline text="良心を理由に診療を突然放棄しない"/>
          <outline text="組織は問題を制度改善へ変える"/>
        </outline>
        <outline text="不一致が事実、価値、権限のどこか特定"/>
        <outline text="独立意見は公正な再検討手段"/>
        <outline text="最終判断者と再評価時期を明確に"/>
      </outline>
    </outline>
  </body>
</opml>
