<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>081-02 脳幹核、脳神経路、網様体、小脳回路</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="脳幹核と小脳回路">
      <outline text="脳幹の向きを定める">
        <outline text="小病変でも交叉性所見">
          <outline text="同側脳神経障害と対側身体障害"/>
        </outline>
        <outline text="延髄：錐体、オリーブ、第四脳室へ開く"/>
        <outline text="橋：腹側橋底部と背側被蓋">
          <outline text="中小脳脚が外側の大部分"/>
        </outline>
        <outline text="中脳は中脳水道を囲む">
          <outline text="大脳脚、黒質、赤核"/>
          <outline text="蓋：上丘と下丘"/>
        </outline>
      </outline>
      <outline text="脳神経の核列">
        <outline text="第四脳室が開き感覚核は外側へ"/>
        <outline text="体性運動核が正中に最も近い">
          <outline text="舌下、外転、滑車、動眼神経核"/>
        </outline>
        <outline text="鰓性運動核">
          <outline text="疑核、顔面神経運動核、三叉神経運動核"/>
        </outline>
        <outline text="副交感核">
          <outline text="迷走神経背側運動核、唾液核"/>
          <outline text="動眼神経に伴うエディンガー・ウェストファル核"/>
        </outline>
        <outline text="感覚核：孤束、前庭、蝸牛、三叉"/>
      </outline>
      <outline text="三叉神経系">
        <outline text="主知覚核は顔面の識別性触覚"/>
        <outline text="脊髄路核は痛温覚"/>
        <outline text="中脳路核は一次ニューロンが中枢内"/>
        <outline text="二次線維は交叉し腹側後内側核へ"/>
        <outline text="運動核は咀嚼筋を支配"/>
        <outline text="外側病変で交叉性痛温覚障害"/>
      </outline>
      <outline text="眼球運動の統合">
        <outline text="滑車神経線維は交叉して背側から出る">
          <outline text="核病変は対側、神経病変は同側"/>
        </outline>
        <outline text="外転神経核には介在ニューロン">
          <outline text="核病変は同側水平注視麻痺"/>
          <outline text="神経束病変は単独の外転障害"/>
        </outline>
        <outline text="傍正中橋網様体は水平サッカード"/>
        <outline text="中脳構造が垂直注視を調整"/>
        <outline text="内側縦束病変">
          <outline text="核間性眼筋麻痺"/>
        </outline>
        <outline text="瞳孔線維は動眼神経の表層">
          <outline text="動脈瘤は圧迫、微小血管性は保存も"/>
        </outline>
      </outline>
      <outline text="延髄の内臓ネットワーク">
        <outline text="孤束核は内臓反射を統合"/>
        <outline text="迷走背側核と疑核は副交感出力"/>
        <outline text="呼吸リズムは分散ネットワーク">
          <outline text="プレベッツィンガー複合体、呼吸群"/>
          <outline text="両側損傷やオピオイドで呼吸不全"/>
        </outline>
        <outline text="最後野は血中催吐信号を検出">
          <outline text="吃逆と嘔吐は延髄病変を示す"/>
        </outline>
      </outline>
      <outline text="聴覚路と前庭路">
        <outline text="蝸牛神経核は橋延髄境界"/>
        <outline text="聴覚路は両側性に上行">
          <outline text="一側病変で片耳の完全聾は少ない"/>
        </outline>
        <outline text="前庭神経核は注視と姿勢を安定"/>
        <outline text="所見で末梢性と中枢性を鑑別"/>
        <outline text="片葉と小節が前庭動眼機能を調節"/>
      </outline>
      <outline text="小脳構築">
        <outline text="前庭小脳、脊髄小脳、大脳小脳"/>
        <outline text="皮質：分子層、プルキンエ層、顆粒層">
          <outline text="苔状線維は顆粒細胞と平行線維経由"/>
          <outline text="登上線維は誤差信号を与える"/>
          <outline text="プルキンエ細胞は深部核を抑制"/>
        </outline>
        <outline text="深部核：室頂核、中位核、歯状核"/>
        <outline text="小脳脚">
          <outline text="下小脳脚：脊髄、前庭、オリーブ入力"/>
          <outline text="中小脳脚：対側橋小脳入力"/>
          <outline text="上小脳脚：深部核出力"/>
        </outline>
        <outline text="二回交叉か非交叉で同側性"/>
      </outline>
      <outline text="小脳機能障害">
        <outline text="虫部：体幹・歩行失調"/>
        <outline text="半球：同側の測定障害、企図振戦"/>
        <outline text="片葉小節葉：平衡障害、眼球運動異常"/>
        <outline text="歩行不能のみで小脳梗塞のことも"/>
        <outline text="小脳認知情動症候群は皮質ループ経由"/>
      </outline>
      <outline text="網様体と意識">
        <outline text="覚醒、自律、疼痛、筋緊張、睡眠"/>
        <outline text="上行性覚醒系は視床・視床下部経由"/>
        <outline text="意識には両側半球と覚醒系が必要">
          <outline text="上位脳幹の小病変で障害され得る"/>
          <outline text="一側性皮質病変では通常障害されない"/>
        </outline>
        <outline text="異常肢位は重篤病変、局在は不完全"/>
      </outline>
      <outline text="脳幹血管症候群">
        <outline text="傍正中、短周回、長周回領域"/>
        <outline text="後下小脳動脈は外側延髄"/>
        <outline text="外側延髄症候群">
          <outline text="めまい、同側失調、顔面感覚低下"/>
          <outline text="嚥下障害、嗄声、ホルネル症候群"/>
        </outline>
        <outline text="内側延髄症候群">
          <outline text="対側筋力低下、同側舌筋力低下"/>
        </outline>
        <outline text="脳底動脈血栓症で閉じ込め症候群">
          <outline text="意識と垂直眼球運動は保たれる"/>
        </outline>
        <outline text="精密な診察で解剖学的仮説を立てる"/>
      </outline>
    </outline>
  </body>
</opml>
