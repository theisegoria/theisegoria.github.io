<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>099-02 生涯発達、認知、社会情動的成長</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="生涯発達と成長">
      <outline text="発達の原則">
        <outline text="遺伝子、成熟、経験、文化、歴史条件"/>
        <outline text="硬直した時刻表でも無限の可塑性でもない"/>
        <outline text="技能は範囲内で複数の有効経路を取る"/>
        <outline text="領域、経時変化、機会、機能困難を問う"/>
        <outline text="一つの遅い節目では原因を決められない"/>
        <outline text="獲得済み技能の喪失は懸念が大きい"/>
      </outline>
      <outline text="脳発達と感受性期">
        <outline text="増殖、移動、分化、選択的細胞死"/>
        <outline text="シナプスは過剰形成され活動で精緻化"/>
        <outline text="髄鞘化と専門化は数十年続く"/>
        <outline text="感受性期は常に絶対期限ではない">
          <outline text="回復は時期、持続、系に依存"/>
        </outline>
      </outline>
      <outline text="愛着と気質">
        <outline text="乳児は養育者との相互作用で調節"/>
        <outline text="愛着は安全基地で固定人格ラベルでない">
          <outline text="利用可能性、気質、文化が形作る"/>
        </outline>
        <outline text="非典型様式は適応を反映し得る"/>
        <outline text="気質は反応性、注意、自己調節の個人差"/>
        <outline text="子どもと環境の適合性">
          <outline text="高反応性の子も穏やかな日課で成長"/>
        </outline>
        <outline text="難しい気質ラベルは傾向を運命扱い"/>
      </outline>
      <outline text="運動発達と言語発達">
        <outline text="運動は神経成熟、身体、筋力、練習"/>
        <outline text="乳児は制約への安定解を発見する"/>
        <outline text="新しい移動は認知経験を変える"/>
        <outline text="視聴覚、筋緊張、左右差、疼痛を評価"/>
        <outline text="言語は生物学的準備と社会学習"/>
        <outline text="受容言語は表出に先行する"/>
        <outline text="共同注意と身振りが焦点を語へ結ぶ"/>
        <outline text="受動メディアは随伴フィードバックを欠く"/>
        <outline text="多言語曝露は言語障害を起こさない"/>
      </outline>
      <outline text="認知と実行機能">
        <outline text="幼児は親しい文脈で優れた推論">
          <outline text="言語や抑制を要する課題で失敗"/>
        </outline>
        <outline text="段階理論は早期能力を過小評価"/>
        <outline text="知識は領域特異的"/>
        <outline text="実行機能は抑制、更新、切替、計画"/>
        <outline text="前頭頭頂、皮質下、小脳網"/>
        <outline text="遂行は睡眠、ストレス、環境に左右される"/>
        <outline text="日課と視覚手掛かりで要求を外在化"/>
      </outline>
      <outline text="社会的理解と道徳的理解">
        <outline text="心の理論は信念や意図を表す"/>
        <outline text="誤信念課題は一節目にすぎない"/>
        <outline text="実際の社会認知は曖昧な手掛かりを統合"/>
        <outline text="差異は共感の欠如を意味しない"/>
        <outline text="道徳は感情、社会学習、推論、制度"/>
        <outline text="道徳的害と任意規約を区別する"/>
        <outline text="推論は罰回避から原理へ広がる"/>
        <outline text="道徳言語は行動を保証しない"/>
      </outline>
      <outline text="青年期と同一性">
        <outline text="思春期と拡大する社会的・法的役割"/>
        <outline text="報酬系が調節系の成熟前に高反応">
          <outline text="特に感情的な仲間文脈で"/>
        </outline>
        <outline text="一様に非合理的ではない"/>
        <outline text="強い報酬、監督不足で危険行動が有害"/>
        <outline text="同一性は価値、役割、身体、文化を統合"/>
        <outline text="探索と関与は一時段階となり得る"/>
        <outline text="苦痛を同一性自体へ自動帰属しない"/>
      </outline>
      <outline text="成人期と加齢">
        <outline text="親密性、仕事、養育、次世代への貢献"/>
        <outline text="処理速度は徐々に低下し得る"/>
        <outline text="知識、語彙、専門性は維持・増加"/>
        <outline text="横断は世代歴、縦断は選択的生存"/>
        <outline text="正常加齢は検索が遅いが認知症でない"/>
        <outline text="感覚低下は認知障害に見える"/>
        <outline text="急性低下はせん妄、疾患、薬物を考える"/>
        <outline text="将来時間が短いと優先順位が変わる"/>
        <outline text="悲嘆は多様で必須段階はない"/>
      </outline>
      <outline text="文脈、分類、定式化">
        <outline text="入れ子状制度が日々の入力を形作る"/>
        <outline text="逆境はストレス生理を変えるが必然でない"/>
        <outline text="保護的関係とサービスが危険を緩衝"/>
        <outline text="レジリエンスで責任を個人へ移さない"/>
        <outline text="診断閾値は連続特性を分ける"/>
        <outline text="マスキングは負担を伴い困難を隠す"/>
        <outline text="プロフィール、文脈、目標、配慮を記述"/>
        <outline text="集団期待だけでなく本人の軌道と比較"/>
      </outline>
    </outline>
  </body>
</opml>
