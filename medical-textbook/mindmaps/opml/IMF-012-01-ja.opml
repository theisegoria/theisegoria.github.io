<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>012-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="心血管系の病歴、診察、基本検査">
      <outline text="評価が果たすべきこと">
        <outline text="不安定性、症状、血行動態、局在"/>
        <outline text="同じ所見でも機序は異なる"/>
        <outline text="病名でなく機能と経過"/>
      </outline>
      <outline text="主訴と症状">
        <outline text="胸部不快感">
          <outline text="労作時圧迫感は心筋虚血を示唆"/>
          <outline text="等価症状：灼熱感、消化不良、悪心"/>
          <outline text="背部への引き裂かれる痛み：急性大動脈疾患"/>
          <outline text="胸膜性疼痛：心膜、肺、胸壁"/>
          <outline text="触診で再現しても除外できない"/>
        </outline>
        <outline text="呼吸困難">
          <outline text="起座呼吸：仰臥位の静脈還流と再分布"/>
          <outline text="発作性夜間呼吸困難はうっ血に特異的"/>
        </outline>
        <outline text="動悸">
          <outline text="症状時の調律を捉える"/>
        </outline>
        <outline text="失神">
          <outline text="全脳低灌流による一過性意識消失"/>
          <outline text="高リスク：労作時、構造的心疾患、突然死家族歴"/>
        </outline>
        <outline text="血管症状：安静時痛、冷たい肢、脳卒中"/>
      </outline>
      <outline text="危険因子と背景">
        <outline text="血管危険因子と腎疾患"/>
        <outline text="早発性疾患または突然死の家族歴"/>
        <outline text="薬剤確認">
          <outline text="抗血栓薬、抗炎症薬、刺激薬"/>
          <outline text="電解質やQT間隔に影響する薬剤"/>
        </outline>
        <outline text="機能状態：基準と変化速度"/>
      </outline>
      <outline text="全身診察とバイタルサイン">
        <outline text="苦悶、呼吸仕事量、皮膚色、意識状態"/>
        <outline text="脈拍、血圧、酸素飽和度、体温の正確な測定"/>
        <outline text="両上肢の比較と立位血圧"/>
        <outline text="末梢所見は特異度に限界"/>
      </outline>
      <outline text="脈拍と静脈圧">
        <outline text="立ち上がりが遅く小さい脈：流出路閉塞"/>
        <outline text="虚脱性脈：高拍出と速い拡張期流出"/>
        <outline text="橈骨・大腿動脈間の遅延や左右差"/>
        <outline text="脈拍欠損：末梢へ届かない収縮"/>
        <outline text="頸静脈圧は右房圧を推定">
          <outline text="胸骨角からの垂直高"/>
          <outline text="上昇：容量過剰、右心不全、タンポナーデ"/>
          <outline text="吸気時上昇：右心系充満障害"/>
          <outline text="手技と体格で精度が制限"/>
        </outline>
      </outline>
      <outline text="前胸部と末梢">
        <outline text="傍胸骨隆起：右室圧負荷"/>
        <outline text="付加心音">
          <outline text="III音：急速な心室流入"/>
          <outline text="IV音：硬い心室への心房収縮"/>
        </outline>
        <outline text="心雑音">
          <outline text="時相、最強点、放散、強度、形状"/>
          <outline text="拡張期雑音は一般に病的"/>
          <outline text="低流量では強度が重症度と一致しない"/>
          <outline text="負荷手技は還流、後負荷、心腔サイズを変える"/>
        </outline>
        <outline text="浮腫は心不全に特異的でない"/>
      </outline>
      <outline text="心電図とモニタリング">
        <outline text="調律、伝導、電気軸、虚血、薬物影響"/>
        <outline text="胸痛、失神、不安定時は迅速に記録"/>
        <outline text="連続記録で動的変化を捉える"/>
        <outline text="正常でも除外できない"/>
        <outline text="モニタリング期間は症状頻度に合わせる"/>
        <outline text="症状と調律の対応が目的"/>
      </outline>
      <outline text="バイオマーカーと画像検査">
        <outline text="トロポニン：測定法固有の時間経過と変化"/>
        <outline text="ナトリウム利尿ペプチドは年齢や腎機能で変動"/>
        <outline text="胸部X線は重要疾患でも正常となり得る"/>
        <outline text="心エコー：心腔、弁、心膜、圧推定"/>
        <outline text="冠動脈コンピュータ断層撮影は解剖を示す"/>
        <outline text="負荷試験は酸素需要を増やす"/>
        <outline text="心臓磁気共鳴画像は組織性状と瘢痕を評価"/>
        <outline text="最適な検査は検査前確率と判断で決まる"/>
      </outline>
      <outline text="ベッドサイドでの統合">
        <outline text="安定か不安定か"/>
        <outline text="うっ血か乾燥か、温かいか低灌流か"/>
        <outline text="冠動脈、ポンプ、弁、心膜、血管、非心臓"/>
        <outline text="時間依存的な代替診断と次の判断"/>
      </outline>
      <outline text="血管検査">
        <outline text="足関節上腕血圧比は足関節と上腕を比較">
          <outline text="石灰化した非圧縮性血管で偽高値"/>
          <outline text="足趾血圧や波形評価が役立つ"/>
        </outline>
        <outline text="二重超音波検査：解剖と血流速度"/>
        <outline text="コンピュータ断層血管造影：放射線と造影剤"/>
        <outline text="深部静脈血栓症：確率、Dダイマー、圧迫超音波"/>
        <outline text="肺塞栓症：確率、酸素化、選択した画像"/>
        <outline text="肢や大動脈の緊急では検査で治療を遅らせない"/>
        <outline text="介入後の再確認：出血、塞栓、造影剤傷害"/>
      </outline>
    </outline>
  </body>
</opml>
