<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>060-01 Foundations</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Occupational, travel, and population infection risks">
      <outline text="Orientation">
        <outline text="Where people live, work, travel, gather shapes illness"/>
        <outline text="Exposure links patient to environment and conditions"/>
        <outline text="Same symptom, different differential">
          <outline text="Mining, farming, displacement, flight, freshwater"/>
        </outline>
        <outline text="Protect individual, recognise clusters"/>
      </outline>
      <outline text="Occupational history">
        <outline text="Job title is insufficient">
          <outline text="Tasks, materials, dusts, fumes, organisms"/>
        </outline>
        <outline text="Intensity, frequency, duration, latency"/>
        <outline text="Relation to work or leave"/>
        <outline text="Inhalation, skin, ingestion, inoculation"/>
        <outline text="Listed limits do not prove safety"/>
        <outline text="Work worsens common disease"/>
        <outline text="Objective documentation and consent">
          <outline text="Income, compensation, other workers affected"/>
        </outline>
        <outline text="Elimination and substitution outrank protection"/>
      </outline>
      <outline text="Occupational respiratory disease">
        <outline text="Irritant fumes: bronchospasm, pulmonary oedema"/>
        <outline text="Occupational asthma: sensitisation or irritation">
          <outline text="Serial peak flow at work and away"/>
          <outline text="Early sensitiser removal improves prognosis"/>
        </outline>
        <outline text="Silica: nodular fibrosis">
          <outline text="Autoimmunity, cancer, tuberculosis"/>
        </outline>
        <outline text="Asbestos disease after long latency">
          <outline text="Smoking multiplies lung-cancer risk"/>
        </outline>
        <outline text="Fibrosis generally irreversible">
          <outline text="Exposure control and surveillance"/>
        </outline>
        <outline text="Hypersensitivity pneumonitis to inhaled antigens">
          <outline text="Antigen avoidance is central"/>
        </outline>
      </outline>
      <outline text="Skin, musculoskeletal, and physical hazards">
        <outline text="Irritant dermatitis: cumulative barrier injury"/>
        <outline text="Allergic dermatitis: delayed hypersensitivity">
          <outline text="Distribution and timing guide patch testing"/>
        </outline>
        <outline text="Gloves can occlude, irritate, cause allergy"/>
        <outline text="Musculoskeletal: force, repetition, posture, recovery">
          <outline text="Prolonged complete rest worsens recovery"/>
        </outline>
        <outline text="Noise: irreversible high-frequency loss"/>
        <outline text="Vibration: blanching, neuropathy"/>
        <outline text="Radiation: time, distance, shielding, dosimetry"/>
      </outline>
      <outline text="Needlestick and biological exposure">
        <outline text="Wash, irrigate, no squeezing, report"/>
        <outline text="Fluid, route, device, source status"/>
        <outline text="Human immunodeficiency virus prophylaxis promptly">
          <outline text="Continue or stop after expert reassessment"/>
        </outline>
        <outline text="Hepatitis B: vaccine, immunoglobulin by antibody"/>
        <outline text="Hepatitis C: no prophylaxis, follow-up testing"/>
        <outline text="Safety devices, no recapping, vaccination"/>
        <outline text="Healthcare respiratory and aerosol exposures"/>
      </outline>
      <outline text="Pre-travel assessment">
        <outline text="Risk by destination, season, activity, health"/>
        <outline text="Start early for vaccine series"/>
        <outline text="Live vaccines unsafe in pregnancy, suppression"/>
        <outline text="Malaria: bite avoidance plus chemoprophylaxis">
          <outline text="No regimen completely protective"/>
          <outline text="Fever is an emergency until excluded"/>
        </outline>
        <outline text="Day-biting vectors: dengue, chikungunya, Zika"/>
        <outline text="Dengue: leak and shock around defervescence">
          <outline text="Avoid non-steroidal drugs until excluded"/>
        </outline>
        <outline text="Diarrhoea: oral rehydration first">
          <outline text="No antimotility drugs with invasive dysentery"/>
        </outline>
        <outline text="Altitude: gradual ascent">
          <outline text="Ataxia or confusion: cerebral oedema"/>
          <outline text="Descent and oxygen are priorities"/>
        </outline>
      </outline>
      <outline text="The returned traveller">
        <outline text="Itinerary, dates, exposures, prophylaxis"/>
        <outline text="Incubation narrows the differential"/>
        <outline text="Fever: malaria, dengue, enteric fever, others"/>
        <outline text="Eosinophilia may be absent early"/>
        <outline text="Alert laboratory for high-consequence pathogens"/>
        <outline text="Diarrhoea beyond two weeks: protozoa"/>
        <outline text="Travel label must not hide universal disease"/>
      </outline>
      <outline text="Migration, displacement, and inequity">
        <outline text="Country of origin is not a diagnosis"/>
        <outline text="Trained interpreters"/>
        <outline text="Screen by individual risk with consent"/>
        <outline text="Trauma-informed care without forced disclosure"/>
        <outline text="Infection control must not become stigma"/>
      </outline>
      <outline text="Outbreaks and public health">
        <outline text="Exceeds expected; one rare case may act"/>
        <outline text="Case definition, person, place, time"/>
        <outline text="Isolation separates infectious cases"/>
        <outline text="Quarantine restricts exposed people"/>
        <outline text="Notify public health promptly"/>
        <outline text="Least restrictive effective measure"/>
        <outline text="One Health: human, animal, environment"/>
      </outline>
    </outline>
  </body>
</opml>
