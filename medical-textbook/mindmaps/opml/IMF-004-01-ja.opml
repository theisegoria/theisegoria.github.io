<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>004-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="炎症、治癒、免疫、および感染">
      <outline text="聴き方">
        <outline text="感染、損傷、異物への防御的反応"/>
        <outline text="過剰や遷延で組織を損傷する"/>
        <outline text="免疫は特異性と記憶を加える"/>
        <outline text="感染は炎症の一原因で同義ではない"/>
      </outline>
      <outline text="認識と即時防御">
        <outline text="物理的バリアが最初の防御">
          <outline text="皮膚はケラチン、脂質、常在微生物、落屑"/>
          <outline text="粘液が捕捉し線毛が咽頭へ運ぶ"/>
          <outline text="バリア障害が侵入門戸を生む"/>
        </outline>
        <outline text="自然免疫細胞が微生物と障害シグナルを認識">
          <outline text="パターン認識受容体がインフラマソームを活性化"/>
        </outline>
        <outline text="ヒスタミンは細動脈拡張と細静脈透過性"/>
        <outline text="メディエーターが血管、痛み、発熱、動員を協調"/>
      </outline>
      <outline text="補体が生む異なる作用">
        <outline text="不活性前駆体として循環し厳密に制御"/>
        <outline text="C3転換酵素はC3aを放出しC3bを生む">
          <outline text="表面結合C3bがオプソニン化を担う"/>
          <outline text="標識で殺されず取り込まれやすくなる"/>
        </outline>
        <outline text="C5転換酵素はC5aとC5bを生む">
          <outline text="C5aは炎症作用と走化作用"/>
          <outline text="C5bが開始しC6からC9が膜侵襲複合体へ"/>
        </outline>
        <outline text="動員、認識促進、穿孔は別の働き">
          <outline text="一つに抵抗しても別の作用に弱い"/>
          <outline text="活性化は直接溶菌を意味しない"/>
        </outline>
      </outline>
      <outline text="急性炎症">
        <outline text="血流増加で発赤と熱感"/>
        <outline text="透過性増加でタンパク質に富む液体と腫脹"/>
        <outline text="古典的所見は有用なパターンで必須でない"/>
        <outline text="血流低下とともに白血球動員">
          <outline text="セレクチンがローリングを支える"/>
          <outline text="ケモカインがインテグリンを活性化し強固結合"/>
        </outline>
        <outline text="初期は好中球、単球はマクロファージへ"/>
        <outline text="貪食は認識、取り込み、殺菌、消化">
          <outline text="細胞外へ放出されると周囲組織も損傷"/>
        </outline>
        <outline text="膿瘍は貯留を囲い込みドレナージを要する">
          <outline text="抗菌薬浸透不良と感染源制御の不完全"/>
        </outline>
        <outline text="消退、瘢痕、膿瘍、慢性炎症へ"/>
      </outline>
      <outline text="適応免疫">
        <outline text="樹状細胞が自然免疫と適応免疫をつなぐ"/>
        <outline text="クラス1は細胞内ペプチドをCD8へ"/>
        <outline text="クラス2は細胞外由来ペプチドをCD4へ"/>
        <outline text="活性化には共刺激とサイトカインも必要"/>
        <outline text="CD4陽性T細胞は特化した様式で調整">
          <outline text="細胞内寄生性微生物へマクロファージ活性化"/>
          <outline text="好酸球と免疫グロブリンE応答"/>
          <outline text="制御性T細胞は抑制し免疫寛容を支える"/>
        </outline>
        <outline text="CD8陽性T細胞が感染細胞や異常細胞を殺す"/>
        <outline text="B細胞は形質細胞か記憶細胞になる">
          <outline text="免疫グロブリンMは早期で補体を活性化"/>
          <outline text="免疫グロブリンGは豊富で胎盤を通過"/>
          <outline text="免疫グロブリンAは粘膜表面を防御"/>
          <outline text="免疫グロブリンEは肥満細胞に結合"/>
        </outline>
        <outline text="記憶は再応答を速めるが持続性は一定でない"/>
      </outline>
      <outline text="免疫による障害と免疫不全">
        <outline text="即時型は免疫グロブリンEと肥満細胞"/>
        <outline text="免疫複合体が沈着し補体を活性化"/>
        <outline text="遅延型はT細胞と活性化マクロファージ"/>
        <outline text="自己免疫は寛容破綻、遺伝、環境誘因">
          <outline text="自己抗体陽性だけでは診断でない"/>
        </outline>
        <outline text="感染パターンが障害された免疫成分を示唆">
          <outline text="好中球減少症は侵襲性細菌と真菌"/>
          <outline text="T細胞障害は細胞内寄生性と日和見微生物"/>
          <outline text="抗体欠乏は莢膜を有する細菌"/>
        </outline>
      </outline>
      <outline text="発熱と全身性炎症">
        <outline text="視床下部プロスタグランジンが設定値を上昇">
          <outline text="寒さ、血管収縮、悪寒戦慄"/>
          <outline text="設定値低下で血管拡張と発汗"/>
        </outline>
        <outline text="高体温症は熱負荷が熱放散能を上回る"/>
        <outline text="肝臓が急性期タンパクを産生しアルブミン低下"/>
        <outline text="重度炎症は毛細血管漏出と凝固活性化"/>
        <outline text="敗血症は制御不良な応答による臓器機能障害">
          <outline text="発熱のみで定義されず平熱でも起こる"/>
          <outline text="培養、抗菌薬、感染源制御、灌流支持"/>
        </outline>
      </outline>
      <outline text="治癒と線維化">
        <outline text="止血が暫定的な足場を作る"/>
        <outline text="マクロファージが修復へシグナルを切替"/>
        <outline text="再生には増殖可能な細胞と足場が必要"/>
        <outline text="広範な損傷では瘢痕形成が優位">
          <outline text="線維芽細胞がコラーゲン、筋線維芽細胞が収縮"/>
          <outline text="引張強度は数か月で増すが完全に戻らない"/>
        </outline>
        <outline text="灌流不良、感染、糖質コルチコイド、糖尿病"/>
        <outline text="過剰修復でケロイド、狭窄、臓器線維化"/>
      </outline>
      <outline text="抗菌薬と抗炎症の基本原理">
        <outline text="微生物、部位、重症度、宿主、耐性に適合"/>
        <outline text="感染源制御はドレナージ、デブリドマン"/>
        <outline text="抗炎症薬は宿主反応を修飾する">
          <outline text="非ステロイド性抗炎症薬は消化管、腎、心血管"/>
          <outline text="糖質コルチコイドは感染、高血糖、骨量減少"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
