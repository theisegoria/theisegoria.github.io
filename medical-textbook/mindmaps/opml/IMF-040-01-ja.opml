<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>040-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="癌生物学と治療の基礎">
      <outline text="クローン進化とドライバー">
        <outline text="癌は組織内のクローン進化">
          <outline text="単なる急速増殖ではない"/>
        </outline>
        <outline text="癌原遺伝子は変異、増幅、融合で活性化"/>
        <outline text="癌抑制遺伝子は多く両対立遺伝子が障害"/>
        <outline text="修復障害は変異率を高める">
          <outline text="特徴的なゲノム変異パターン"/>
        </outline>
        <outline text="パッセンジャー変異は優位性なく蓄積"/>
        <outline text="脆弱性の異なるサブクローン">
          <outline text="治療が耐性集団を選択"/>
          <outline text="新変異と可塑性が進化を継続"/>
        </outline>
        <outline text="遺伝性病的変異は素因を与える">
          <outline text="血縁者、監視、治療に関係"/>
          <outline text="腫瘍のみの所見は確認検査へ"/>
        </outline>
      </outline>
      <outline text="悪性腫瘍の特質">
        <outline text="増殖維持、抑制回避、細胞死抵抗"/>
        <outline text="ゲノム不安定性と炎症が特質を可能に"/>
        <outline text="固有の特質はなく組み合わせと持続"/>
        <outline text="増殖信号の自律化"/>
        <outline text="チェックポイント喪失で損傷細胞が分裂"/>
        <outline text="テロメア維持が複製危機を防ぐ"/>
        <outline text="他の細胞死・ストレス経路は標的"/>
        <outline text="代謝は生体物質、酸化還元、低酸素生存"/>
      </outline>
      <outline text="発癌物質と予防">
        <outline text="直接損傷または代謝的活性化"/>
        <outline text="紫外線の特徴的損傷、電離放射線の切断"/>
        <outline text="曝露量、組織、修復、年齢、潜伏期間"/>
        <outline text="発癌性感染症">
          <outline text="微生物蛋白、炎症、免疫抑制"/>
          <outline text="ワクチンと抗微生物療法で予防"/>
        </outline>
        <outline text="リスクは確率的">
          <outline text="非難を避け社会的・商業的要因を考慮"/>
        </outline>
      </outline>
      <outline text="腫瘍微小環境と血管新生">
        <outline text="間質は状況により促進または抑制"/>
        <outline text="低酸素が転写プログラムを安定化">
          <outline text="血管新生、解糖、浸潤、治療抵抗性"/>
        </outline>
        <outline text="異常で漏出性の新生血管">
          <outline text="資源供給と不均一な灌流"/>
        </outline>
        <outline text="血管新生阻害療法">
          <outline text="高血圧、血栓症、出血、蛋白尿"/>
          <outline text="代替血管経路や既存血管で回避"/>
        </outline>
      </outline>
      <outline text="浸潤と転移">
        <outline text="基底膜を破り間質へ浸潤"/>
        <outline text="上皮間葉転換は可塑性を高める">
          <outline text="一方向の不可逆的スイッチではない"/>
        </outline>
        <outline text="脈管侵入、生存、停止、血管外、適応"/>
        <outline text="播種細胞の大部分は失敗">
          <outline text="数年間の休眠後に増殖"/>
        </outline>
        <outline text="リンパ節は拡散を反映、順番の通過でない"/>
        <outline text="組織特異的な転移パターン">
          <outline text="門脈還流は肝、体静脈還流は肺"/>
        </outline>
      </outline>
      <outline text="免疫監視と免疫回避">
        <outline text="樹状細胞、T細胞、ナチュラルキラー細胞"/>
        <outline text="回避：抗原喪失、リガンド、排除"/>
        <outline text="チェックポイント阻害薬が抑制を解除">
          <outline text="バイオマーカーは確率を高めるが不完全"/>
        </outline>
        <outline text="ほぼあらゆる臓器の免疫毒性">
          <outline text="早期認識と重症度に応じた免疫抑制"/>
        </outline>
      </outline>
      <outline text="命名、悪性度、病期、診断">
        <outline text="良性腫瘍も分泌、出血、圧迫を生じる"/>
        <outline text="上皮内癌は基底膜浸潤がない"/>
        <outline text="悪性度は生物学的侵襲性を概算"/>
        <outline text="病期は解剖学的広がりを記述"/>
        <outline text="組織が診断を確立">
          <outline text="手術経路を保ち十分な組織を得る"/>
        </outline>
        <outline text="予測、予後、監視マーカー">
          <outline text="腫瘍マーカー単独の診断はまれ"/>
        </outline>
      </outline>
      <outline text="手術と放射線療法">
        <outline text="手術は切除縁とリンパ節評価、機能温存"/>
        <outline text="術前補助療法は縮小と反応評価"/>
        <outline text="術後補助療法は微小病変を根絶"/>
        <outline text="放射線は直接とラジカルで損傷">
          <outline text="分割照射は正常組織に修復時間"/>
        </outline>
        <outline text="毒性は急性炎症性または晩期線維性"/>
      </outline>
      <outline text="全身療法と細胞療法">
        <outline text="細胞傷害性薬は分裂細胞に優先作用">
          <outline text="骨髄、粘膜、毛包、性腺も損傷"/>
        </outline>
        <outline text="併用療法は異なる経路を攻撃"/>
        <outline text="分子標的薬は特異的依存性を阻害"/>
        <outline text="抗体と抗体薬物複合体"/>
        <outline text="内分泌療法は増殖信号を奪う"/>
        <outline text="耐性：標的変異、迂回、系統変化">
          <outline text="再検査が次の治療を導く"/>
        </outline>
        <outline text="移植と遺伝子改変免疫細胞">
          <outline text="サイトカイン放出、神経毒性、感染"/>
        </outline>
      </outline>
      <outline text="支持療法と長期生存者ケア">
        <outline text="支持療法は症状と毒性を予防"/>
        <outline text="性腺毒性治療前に妊孕性を相談"/>
        <outline text="緩和ケアは治療と並行"/>
        <outline text="緊急病態は原因確認中に即治療"/>
        <outline text="利益が害を上回る時のみスクリーニング"/>
        <outline text="再発と晩期影響のケア計画"/>
      </outline>
    </outline>
  </body>
</opml>
