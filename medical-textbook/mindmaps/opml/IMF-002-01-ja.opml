<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>002-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="膜、シグナル伝達、興奮性細胞">
      <outline text="静止膜電位と活動電位">
        <outline text="カリウムは細胞内、ナトリウムは細胞外に高濃度"/>
        <outline text="選択的透過性とナトリウム・カリウムポンプ">
          <outline text="細胞内は細胞外に対して陰性"/>
        </outline>
        <outline text="段階電位は刺激の強さで大きさが変化"/>
        <outline text="閾値到達で電位依存性ナトリウムチャネル開口">
          <outline text="ナトリウム流入が立ち上がり相を生む"/>
        </outline>
        <outline text="ナトリウム不活性化とカリウム流出で再分極">
          <outline text="カリウム伝導の持続で短時間の過分極"/>
        </outline>
        <outline text="全か無か、強い刺激は頻度増加と動員"/>
      </outline>
      <outline text="不応期と伝導">
        <outline text="絶対不応期はナトリウムチャネル不活性化">
          <outline text="強い刺激でも直ちには再開口しない"/>
        </outline>
        <outline text="相対不応期はカリウムコンダクタンスが持続">
          <outline text="より強い入力で生じ得る"/>
        </outline>
        <outline text="エネルギー枯渇でなく分子状態の変化"/>
        <outline text="不応期は発火頻度を制限し一方向性を促す"/>
        <outline text="局所電流が隣接膜を脱分極させる">
          <outline text="信号は再生され、イオンの塊は移動しない"/>
        </outline>
        <outline text="ミエリンによる跳躍伝導、絞輪で再生"/>
      </outline>
      <outline text="シナプスと自律神経性制御">
        <outline text="シナプス前カルシウム流入が放出を起こす"/>
        <outline text="イオンチャネル型受容体は直接で速い"/>
        <outline text="代謝調節型受容体は経路を介し遅く長い"/>
        <outline text="興奮性シナプス後電位は閾値へ近づける"/>
        <outline text="抑制性シナプス後電位は遠ざけるか安定化"/>
        <outline text="空間的加重と時間的加重で入力を統合"/>
        <outline text="自律神経系は心筋、平滑筋、腺を調節">
          <outline text="交感神経は動員、副交感神経は保存"/>
          <outline text="協調した傾向、多くの臓器は両方の入力"/>
        </outline>
      </outline>
      <outline text="ホルモンの分類とフィードバック">
        <outline text="受容体をもつ細胞にのみ作用"/>
        <outline text="ペプチドとカテコールアミンは水溶性">
          <outline text="膜受容体とセカンドメッセンジャー"/>
        </outline>
        <outline text="ステロイドと甲状腺ホルモンは脂溶性">
          <outline text="細胞内受容体で遺伝子発現を変化"/>
          <outline text="発現は遅いが長く持続"/>
        </outline>
        <outline text="甲状腺軸は放出ホルモンと刺激ホルモン">
          <outline text="上昇した甲状腺ホルモンが両者を抑制"/>
        </outline>
        <outline text="インスリンとグルカゴンの拮抗的調節">
          <outline text="インスリンは取り込みと合成を促進"/>
          <outline text="グルカゴンはグリコーゲン分解と糖新生"/>
        </outline>
        <outline text="副腎髄質は速く、コルチゾール応答は遅い"/>
      </outline>
      <outline text="神経と内分泌の統合">
        <outline text="ニューロンは標的を絞りミリ秒から秒"/>
        <outline text="ホルモンは広範に秒から日単位"/>
        <outline text="視床下部が神経情報を内分泌命令へ変換"/>
        <outline text="ホルモンは脳機能と行動を変化させる"/>
      </outline>
      <outline text="感覚コーディング">
        <outline text="変換はエネルギーを電気信号へ変える"/>
        <outline text="受容器は完全に特異的でなく選択的"/>
        <outline text="強度は活動電位頻度と動員で符号化"/>
        <outline text="位置は受容野と経路で符号化"/>
        <outline text="順応は一定刺激への応答を減弱">
          <outline text="速順応性は変化、振動、運動を強調"/>
          <outline text="遅順応性は強度や位置を報告"/>
        </outline>
        <outline text="疼痛は損傷後に過敏になり得る">
          <outline text="炎症性メディエーターと中枢経路が閾値低下"/>
        </outline>
      </outline>
      <outline text="運動の階層と反射">
        <outline text="脊髄回路は反射と定型的活動"/>
        <outline text="脳幹は姿勢、平衡、眼球運動、呼吸"/>
        <outline text="皮質は計画、大脳基底核は選択と調整"/>
        <outline text="小脳は意図と実際の運動を比較"/>
        <outline text="伸張反射は筋紡錘から同じ筋の運動ニューロン">
          <outline text="相反抑制で拮抗筋を抑える"/>
          <outline text="下降路が反射ゲインを調整"/>
        </outline>
      </outline>
      <outline text="内分泌軸の詳細">
        <outline text="濃度は分泌、結合、代謝、排泄に依存">
          <outline text="結合画分は貯蔵庫、遊離画分が作用"/>
          <outline text="拍動性と概日性のタイミングが重要"/>
        </outline>
        <outline text="副腎軸は放出ホルモンからコルチゾールへ">
          <outline text="過剰は筋分解、高血糖、骨量減少"/>
          <outline text="欠乏は血圧維持とストレス耐性を損なう"/>
        </outline>
        <outline text="成長ホルモンは拍動性、インスリン様成長因子1"/>
        <outline text="プロラクチンはドパミンが持続的に抑制"/>
        <outline text="カルシウム低下が副甲状腺ホルモンを刺激">
          <outline text="腎はカルシウム保持、リン酸再吸収低下"/>
          <outline text="活性型ビタミンDが腸管吸収を増加"/>
        </outline>
      </outline>
      <outline text="受容体、相互作用、可塑性">
        <outline text="応答は濃度、受容体量、親和性、下流機構">
          <outline text="飽和に近づくと追加効果は小さい"/>
          <outline text="予備受容体で最大応答が得られる"/>
        </outline>
        <outline text="許容的、相乗的、拮抗的な相互作用">
          <outline text="甲状腺ホルモンはカテコールアミンに許容的"/>
        </outline>
        <outline text="疾患は過剰、欠乏、抵抗性、フィードバック喪失">
          <outline text="原発性では甲状腺刺激ホルモン高値"/>
          <outline text="下垂体機能不全は両者とも不適切に低い"/>
        </outline>
        <outline text="可塑性でシナプスは強化も弱化もする">
          <outline text="長期記憶には遺伝子発現が必要"/>
          <outline text="慢性疼痛、依存症、恐怖を維持し得る"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
