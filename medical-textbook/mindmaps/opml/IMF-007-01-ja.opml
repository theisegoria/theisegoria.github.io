<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>007-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="心臓電気生理学と心周期">
      <outline text="ペースメーカー活動">
        <outline text="安定した静止電位をもたない">
          <outline text="過分極活性化チャネルの内向き電流"/>
          <outline text="カリウム流出の減少"/>
          <outline text="閾値へ向かうカルシウム流入"/>
        </outline>
        <outline text="立ち上がり相はカルシウム電流が担う"/>
        <outline text="拡張期脱分極の傾きが心拍数を決める"/>
        <outline text="自律神経性調節">
          <outline text="β1受容体が cyclic adenosine monophosphate を増やす"/>
          <outline text="脱分極が急峻になり伝導が速まる"/>
          <outline text="ムスカリン性アセチルコリンが結節と伝導を遅くする"/>
        </outline>
      </outline>
      <outline text="伝導の順序">
        <outline text="洞房結節から心房筋へ"/>
        <outline text="房室結節の遅延が心房収縮による充満を可能にする"/>
        <outline text="His束、脚、Purkinje線維"/>
        <outline text="中隔と心尖部が自由壁より先に興奮する"/>
      </outline>
      <outline text="作業心筋の活動電位">
        <outline text="急速なナトリウム流入が脱分極を生む"/>
        <outline text="早期カリウム電流が再分極を開始する"/>
        <outline text="プラトー相：L型カルシウム流入とカリウム流出の均衡"/>
        <outline text="遅延性カリウム電流が再分極を完了する"/>
        <outline text="長い不応期が強縮を防ぐ"/>
      </outline>
      <outline text="興奮収縮連関">
        <outline text="横行小管のL型チャネルが開く"/>
        <outline text="リアノジン受容体を介するカルシウム誘発性カルシウム放出"/>
        <outline text="カルシウムがトロポニンCに結合しトロポミオシンが動く"/>
        <outline text="アクチン-ミオシン架橋サイクル"/>
        <outline text="弛緩にはカルシウム除去が必要">
          <outline text="筋小胞体ポンプ"/>
          <outline text="ナトリウム-カルシウム交換体"/>
          <outline text="膜カルシウムポンプ"/>
        </outline>
      </outline>
      <outline text="心電図">
        <outline text="P波：心房脱分極"/>
        <outline text="PR間隔：心房内伝導と房室結節遅延"/>
        <outline text="QRS：心室脱分極"/>
        <outline text="ST部分：心室プラトー相"/>
        <outline text="T波：心室再分極"/>
        <outline text="収縮、心拍出量、冠動脈解剖は示さない"/>
        <outline text="補正QT延長">
          <outline text="早期後脱分極"/>
          <outline text="torsades de pointes"/>
          <outline text="徐脈、低カリウム血症、低マグネシウム血症、薬物"/>
        </outline>
      </outline>
      <outline text="機械的事象">
        <outline text="拡張期：房室弁が開き受動的に充満する"/>
        <outline text="拡張末期容積が最大となる"/>
        <outline text="第1心音は僧帽弁と三尖弁の閉鎖"/>
        <outline text="等容性収縮期：容積一定のまま圧が上昇する"/>
        <outline text="心室圧が動脈圧を超えると駆出が始まる"/>
        <outline text="一回拍出量＝拡張末期容積−収縮末期容積"/>
        <outline text="駆出率＝一回拍出量÷拡張末期容積"/>
        <outline text="第2心音、続いて等容性弛緩期"/>
        <outline text="頻脈はまず拡張期時間を奪う"/>
      </outline>
      <outline text="僧帽弁逆流をたどる">
        <outline text="収縮期に心房へ逆流する"/>
        <outline text="駆出率は良好に見えうる"/>
        <outline text="急性：適応していない心房が肺へ圧を伝える"/>
        <outline text="慢性：拡大とコンプライアンス増加が症状を遅らせる"/>
      </outline>
      <outline text="前負荷、後負荷、収縮性">
        <outline text="前負荷は収縮前の線維伸展"/>
        <outline text="Frank-Starling機序が拍出を静脈還流に合わせる"/>
        <outline text="後負荷：動脈圧、流出路閉塞、インピーダンス、形状"/>
        <outline text="圧負荷は求心性肥大を生む"/>
        <outline text="容量負荷は拡大と遠心性リモデリングを生む"/>
        <outline text="収縮性は一定負荷での力発生、lusitropy は弛緩"/>
        <outline text="心拍出量＝心拍数×一回拍出量"/>
      </outline>
      <outline text="冠循環の需給">
        <outline text="安静時から高い酸素抽出のため血流増加が必要"/>
        <outline text="左室の冠血流は主に拡張期"/>
        <outline text="需要：心拍数、収縮性、壁応力、筋量"/>
        <outline text="供給：動脈血酸素含量、冠灌流圧、開存性、拡張期時間"/>
      </outline>
      <outline text="不整脈">
        <outline text="異常なインパルス形成または伝導"/>
        <outline text="自動能亢進と撃発活動"/>
        <outline text="リエントリーには回路、一方向性ブロック、タイミングが要る"/>
        <outline text="心房細動：心房収縮の消失と血栓リスク"/>
        <outline text="心室頻拍は心室細動へ移行しうる"/>
        <outline text="電解質">
          <outline text="高カリウム血症は伝導を遅らせQRSを拡大する"/>
          <outline text="低カリウム血症は異所性拍動と再分極遅延を増やす"/>
          <outline text="マグネシウム欠乏とカルシウムはプラトーとQTを変える"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
