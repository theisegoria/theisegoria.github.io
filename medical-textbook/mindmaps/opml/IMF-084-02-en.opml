<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>084-02 Gastrointestinal, hepatic, pancreatic, renal, and endocrine histology</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Gut, liver, pancreas, kidney, endocrine histology">
      <outline text="Gut wall plan">
        <outline text="Mucosa, submucosa, muscularis externa, serosa">
          <outline text="Mucosa: epithelium, lamina propria, muscularis"/>
          <outline text="Submucosal plexus in submucosa"/>
          <outline text="Myenteric plexus between muscle layers"/>
        </outline>
        <outline text="Serosa is mesothelium, adventitia binds"/>
      </outline>
      <outline text="Oesophagus and stomach">
        <outline text="Oesophagus: non-keratinised stratified squamous">
          <outline text="Skeletal to smooth muscle downward"/>
          <outline text="Reflux causes columnar metaplasia"/>
        </outline>
        <outline text="Gastric pits lined by surface mucous cells"/>
        <outline text="Parietal cells: acid and intrinsic factor"/>
        <outline text="Chief cells: basophilic, pepsinogen"/>
        <outline text="Fundus and body: short pits, long glands"/>
        <outline text="Pylorus: deep pits, G and D cells"/>
        <outline text="Inner oblique layer aids mixing"/>
      </outline>
      <outline text="Small intestine">
        <outline text="Plicae, villi, microvilli amplify surface"/>
        <outline text="Villus: lacteal, capillaries, smooth muscle"/>
        <outline text="Crypts hold stem and Paneth cells">
          <outline text="Paneth granules are antimicrobial"/>
        </outline>
        <outline text="Enteroendocrine cells release hormones basally"/>
        <outline text="Duodenum: Brunner glands"/>
        <outline text="Jejunum: prominent folds, long villi"/>
        <outline text="Ileum: Peyer patches into submucosa"/>
      </outline>
      <outline text="Large intestine and anal canal">
        <outline text="No villi, straight goblet-rich crypts"/>
        <outline text="Taeniae coli except appendix and rectum"/>
        <outline text="Appendix: extensive lymphoid tissue"/>
        <outline text="Anal canal: columnar to keratinised skin"/>
      </outline>
      <outline text="Liver and gallbladder">
        <outline text="Blood portal to central, bile opposite"/>
        <outline text="Portal tract: vein, artery, bile duct"/>
        <outline text="Sinusoids mix portal and arterial blood">
          <outline text="Fenestrated, no continuous basement membrane"/>
          <outline text="Space of Disse for exchange"/>
        </outline>
        <outline text="Kupffer cells: sinusoidal macrophages"/>
        <outline text="Stellate cells store vitamin A">
          <outline text="Chronic injury: matrix-producing cells"/>
        </outline>
        <outline text="Canaliculi sealed by tight junctions"/>
        <outline text="Acinus zones explain hypoxic vulnerability"/>
        <outline text="Gallbladder concentrates bile">
          <outline text="No muscularis mucosae or submucosa"/>
        </outline>
      </outline>
      <outline text="Pancreas">
        <outline text="Serous acini with zymogen granules"/>
        <outline text="Centroacinar cells begin intercalated ducts"/>
        <outline text="No striated ducts, unlike salivary glands"/>
        <outline text="Enzyme activation damages acini and fat"/>
        <outline text="Islet cell types need immunolabelling">
          <outline text="Beta insulin, alpha glucagon"/>
        </outline>
      </outline>
      <outline text="Kidney">
        <outline text="Cortex corpuscles, medulla loops and ducts"/>
        <outline text="Podocytes wrap capillaries with foot processes"/>
        <outline text="Barrier: endothelium, basement membrane, slits">
          <outline text="Injury target shapes the pattern"/>
        </outline>
        <outline text="Mesangial cells support and clear"/>
        <outline text="Proximal tubule: brush border, eosinophilic"/>
        <outline text="Distal tubule: pale, clear lumen"/>
        <outline text="Collecting ducts: distinct cell boundaries"/>
        <outline text="Juxtaglomerular apparatus">
          <outline text="Macula densa senses sodium chloride"/>
          <outline text="Granular cells release renin"/>
        </outline>
      </outline>
      <outline text="Endocrine glands">
        <outline text="Anterior pituitary: cords around sinusoids"/>
        <outline text="Posterior pituitary: axons, Herring bodies"/>
        <outline text="Thyroid follicles filled with colloid">
          <outline text="Iodination apical, release basal"/>
          <outline text="Cell height reflects activity"/>
        </outline>
        <outline text="C cells secrete calcitonin"/>
        <outline text="Parathyroid chief cells secrete hormone"/>
        <outline text="Adrenal cortex: three zones">
          <outline text="Glomerulosa: mineralocorticoids"/>
          <outline text="Fasciculata: glucocorticoids"/>
          <outline text="Reticularis: androgens"/>
        </outline>
        <outline text="Medulla: chromaffin cells"/>
      </outline>
      <outline text="Tracing flow">
        <outline text="Food, portal blood, bile, filtrate, hormones"/>
        <outline text="Direction links form to physiology"/>
      </outline>
    </outline>
  </body>
</opml>
