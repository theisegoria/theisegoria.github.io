<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>048-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="肝臓、胆道、膵臓疾患">
      <outline text="概説と肝機能検査">
        <outline text="門脈血は栄養素、毒素、微生物産物を運ぶ"/>
        <outline text="肝細胞は合成、薬物処理、尿素と胆汁形成"/>
        <outline text="予備能枯渇まで症状は軽微"/>
        <outline text="アミノトランスフェラーゼは膜損傷、機能でない"/>
        <outline text="アルカリホスファターゼは胆汁うっ滞と骨"/>
        <outline text="アルブミンは数週間の合成能、多因子で変化"/>
        <outline text="プロトロンビン時間は合成低下で急速に変化"/>
      </outline>
      <outline text="パターンと検査">
        <outline text="肝細胞性パターンはアミノトランスフェラーゼ"/>
        <outline text="胆汁うっ滞性はアルカリホスファターゼとビリルビン"/>
        <outline text="極端な高値は虚血、パラセタモール、肝炎">
          <outline text="高さだけでは転帰を予測できない"/>
        </outline>
        <outline text="超音波で胆管、胆嚢、肝実質、血管、腹水"/>
      </outline>
      <outline text="黄疸">
        <outline text="非抱合型は溶血、無効造血、抱合低下"/>
        <outline text="抱合型は水溶性で尿を濃くする"/>
        <outline text="淡色便と掻痒は腸への胆汁減少"/>
        <outline text="発熱を伴う有痛性黄疸は上行性胆管炎"/>
        <outline text="無痛性進行性黄疸は悪性閉塞"/>
        <outline text="凝固障害、意識変容、低血糖なら緊急"/>
      </outline>
      <outline text="急性肝炎と肝不全">
        <outline text="ウイルス、薬剤、毒物、免疫、虚血、代謝"/>
        <outline text="生薬を含む正確な曝露時間経過">
          <outline text="パラセタモールは用量と時刻が重要"/>
        </outline>
        <outline text="肝不全は新規肝障害、凝固障害、脳症"/>
        <outline text="脳浮腫、低血糖、感染、循環虚脱"/>
        <outline text="血糖反復測定、毒物中止、鎮静回避"/>
        <outline text="早期に移植施設と相談"/>
        <outline text="Nアセチルシステインはグルタチオン補充"/>
      </outline>
      <outline text="慢性肝疾患と肝硬変">
        <outline text="再生結節と瘢痕で肝内抵抗増大">
          <outline text="機能が低下する"/>
        </outline>
        <outline text="代償期は無症状のことがある"/>
        <outline text="非代償化は腹水、静脈瘤出血、脳症"/>
        <outline text="アルコールは脂肪化から肝炎、肝硬変">
          <outline text="断酒支援が中心"/>
        </outline>
        <outline text="代謝性脂肪性肝疾患とインスリン抵抗性">
          <outline text="肝転帰は線維化病期に依存"/>
        </outline>
        <outline text="B型肝炎は組み込まれ肝硬変なしに癌"/>
        <outline text="C型肝炎治癒後も高度線維化は監視"/>
      </outline>
      <outline text="門脈圧亢進と腹水">
        <outline text="側副血行路、脾腫、腹水"/>
        <outline text="静脈瘤は破局的に出血し得る">
          <outline text="予防にベータ遮断薬か結紮"/>
        </outline>
        <outline text="急性出血は過剰な昇圧を避け蘇生">
          <outline text="血管作動療法、抗菌薬、内視鏡的止血"/>
          <outline text="持続出血や高リスクなら短絡術"/>
        </outline>
        <outline text="腹水は門脈圧、血管拡張、腎ナトリウム貯留"/>
        <outline text="新規や悪化の腹水は診断的腹腔穿刺"/>
        <outline text="腹膜炎は局所圧痛に乏しいことがある">
          <outline text="迅速な抗菌薬、選択例にアルブミン"/>
        </outline>
        <outline text="再発性腹水は塩分制限、利尿薬、穿刺">
          <outline text="大量排液時はアルブミン補充"/>
        </outline>
      </outline>
      <outline text="脳症と肝腎機能障害">
        <outline text="注意、睡眠、行動、意識の変化"/>
        <outline text="ラクツロースは結腸のアンモニア排出促進">
          <outline text="規則的な軟便へ調整"/>
        </outline>
        <outline text="リファキシミンは再発を減らす"/>
        <outline text="アンモニア濃度だけで確定も除外も不可"/>
        <outline text="腎障害は容量、敗血症、腎毒性薬を先に"/>
        <outline text="肝腎症候群は血管拡張下の腎血管収縮">
          <outline text="アルブミンと血管収縮薬で移植へ橋渡し"/>
        </outline>
      </outline>
      <outline text="肝癌と移植">
        <outline text="肝硬変とB型肝炎は肝細胞癌リスク"/>
        <outline text="監視は根治可能な腫瘍の発見"/>
        <outline text="アルファフェトプロテインは単独で診断不可"/>
        <outline text="移植は機能を置換し門脈圧亢進を除く">
          <outline text="生涯の免疫抑制と監視"/>
        </outline>
      </outline>
      <outline text="胆石と胆道疾患">
        <outline text="胆汁過飽和と胆嚢うっ滞"/>
        <outline text="胆道痛は一過性胆嚢管閉塞"/>
        <outline text="胆嚢炎は遷延痛、発熱、局所圧痛">
          <outline text="超音波が第一選択、早期胆嚢摘出"/>
        </outline>
        <outline text="総胆管結石は黄疸または膵炎"/>
        <outline text="胆管炎は感染を伴う閉塞">
          <outline text="輸液、抗菌薬、緊急胆道ドレナージ"/>
        </outline>
      </outline>
      <outline text="膵炎と膵癌">
        <outline text="急性膵炎は酵素の早期活性化">
          <outline text="胆石とアルコールが代表的原因"/>
        </outline>
        <outline text="重症度は臓器不全で決まり酵素値でない"/>
        <outline text="鎮痛、調整した輸液、経腸栄養"/>
        <outline text="予防的抗菌薬は無菌性壊死を治療しない"/>
        <outline text="慢性膵炎は不可逆的線維化">
          <outline text="外分泌不全、糖尿病、癌リスク"/>
          <outline text="食事時の膵酵素、ビタミン、糖尿病ケア"/>
        </outline>
        <outline text="膵癌は遅れて無痛性黄疸などで発見">
          <outline text="専用画像で切除可能性を判断"/>
          <outline text="全身療法併用の手術が主要な治癒機会"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
