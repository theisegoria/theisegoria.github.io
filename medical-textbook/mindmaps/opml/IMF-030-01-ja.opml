<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>030-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="脳卒中、発作、ニューロパチー、神経変性、頭蓋内圧">
      <outline text="解剖、機序、時間経過による解釈">
        <outline text="突然の局在性障害はまず血管障害"/>
        <outline text="反復する定型的障害は発作か一過性障害"/>
        <outline text="進行性低下は変性、腫瘍、炎症、圧迫"/>
        <outline text="局在推定と安定化を同時に進める">
          <outline text="根本治療は数分の差で変わる"/>
        </outline>
      </outline>
      <outline text="脳虚血">
        <outline text="持続供給が必要で基質をほぼ貯蔵しない"/>
        <outline text="閉塞で不可逆的中心部と低灌流ペナンブラ">
          <outline text="血流回復でペナンブラは救済され得る"/>
        </outline>
        <outline text="グルタミン酸、カルシウム等が損傷を拡大"/>
        <outline text="側副血行、部位、血圧、血糖、時間が生存を決定"/>
        <outline text="一過性脳虚血発作は確立した梗塞なし">
          <outline text="直後の脳卒中リスクは高いことがある"/>
        </outline>
        <outline text="前方循環は対側の筋力低下と感覚低下">
          <outline text="優位半球で失語、非優位で半側空間無視"/>
        </outline>
        <outline text="後方循環は複視、構音障害、失調、交叉性徴候"/>
        <outline text="孤立性めまいの多くは脳卒中でない">
          <outline text="中枢性徴候を伴う重度持続性前庭症候群"/>
        </outline>
      </outline>
      <outline text="急性期脳卒中治療">
        <outline text="最終正常時刻、抗凝固薬、発症前機能を記録"/>
        <outline text="単純コンピュータ断層撮影で出血と類似疾患">
          <outline text="早期に正常でも虚血は除外できない"/>
        </outline>
        <outline text="血管画像で治療可能な閉塞を同定"/>
        <outline text="拡散強調画像は感度高いが治療を遅らせない"/>
        <outline text="検証された時間枠内の静注血栓溶解療法"/>
        <outline text="選択された大血管閉塞に機械的血栓回収">
          <outline text="救済可能組織があれば遅い来院も対象"/>
        </outline>
        <outline text="無差別な急速降圧はペナンブラ血流を低下"/>
        <outline text="悪性大脳半球・小脳梗塞に減圧手術"/>
        <outline text="二次予防は原因機序を標的とする"/>
      </outline>
      <outline text="頭蓋内出血">
        <outline text="脳内出血は組織破壊、占拠効果、浮腫">
          <outline text="ときに脳室閉塞"/>
        </outline>
        <outline text="高血圧、脳アミロイド血管症、抗凝固療法"/>
        <outline text="画一的な発作予防薬は有益とは限らない"/>
        <outline text="くも膜下出血は突然最大の頭痛">
          <outline text="再出血、血管攣縮、水頭症、ナトリウム異常"/>
        </outline>
        <outline text="初回画像で診断できなければ追加検査"/>
        <outline text="早期の動脈瘤閉鎖とニモジピン"/>
      </outline>
      <outline text="発作とてんかん">
        <outline text="一過性の過剰または同期した神経活動"/>
        <outline text="焦点発作は一側半球起始、意識障害や進展"/>
        <outline text="全般発作は発症時から両側性ネットワーク"/>
        <outline text="てんかんは非誘発性発作を起こし続ける素因"/>
        <outline text="正常な脳波でもてんかんは除外できない"/>
        <outline text="外傷から守り、気道、血糖、押さえつけない"/>
        <outline text="約5分持続か回復せず反復で重積状態">
          <outline text="ベンゾジアゼピン後に長時間作用薬"/>
          <outline text="昏睡持続は非けいれん性重積、脳波"/>
        </outline>
        <outline text="運転、水辺、職業、妊娠計画の安全"/>
        <outline text="薬物無効の焦点てんかんに手術、刺激、食事"/>
      </outline>
      <outline text="頭蓋内圧亢進">
        <outline text="硬い頭蓋骨に脳、血液、脳脊髄液"/>
        <outline text="予備能を使い果たすと圧が急上昇"/>
        <outline text="脳灌流圧は平均動脈圧から頭蓋内圧を引く"/>
        <outline text="頭痛、嘔吐、外転神経麻痺、乳頭浮腫">
          <outline text="急速悪化時は乳頭浮腫を欠くことがある"/>
        </outline>
        <outline text="高血圧、徐脈、不規則呼吸は晩期徴候"/>
        <outline text="頭部挙上、低張液回避、発熱治療"/>
        <outline text="高張食塩水かマンニトールで一時的に軽減"/>
        <outline text="短時間の過換気は救命的な橋渡しのみ"/>
        <outline text="圧較差があれば腰椎穿刺は危険"/>
      </outline>
      <outline text="中枢神経系の感染と炎症">
        <outline text="髄膜炎は発熱、頭痛、項部硬直、発疹">
          <outline text="古典的な組み合わせが揃わないことも"/>
        </outline>
        <outline text="培養と経験的抗微生物療法を遅らせない"/>
        <outline text="自己免疫性脳炎は亜急性記憶障害、精神症状"/>
        <outline text="多発性硬化症は時間的・空間的多発性">
          <outline text="視神経炎、脳幹症候群、脊髄炎"/>
        </outline>
        <outline text="再発に糖質コルチコイド、疾患修飾療法"/>
      </outline>
      <outline text="末梢ニューロパチー">
        <outline text="分布、線維の種類、病理、進行速度で分類"/>
        <outline text="長さ依存性は手より先に足"/>
        <outline text="小径線維は灼熱痛、自律神経、検査正常"/>
        <outline text="大径線維は振動覚、固有感覚、反射"/>
        <outline text="神経伝導検査で軸索喪失と脱髄を識別"/>
        <outline text="ギラン・バレーは急速な筋力低下と反射消失">
          <outline text="肺活量、嚥下、心調律を監視"/>
          <outline text="免疫グロブリン静注か血漿交換で修飾"/>
          <outline text="糖質コルチコイド単独は無効"/>
        </outline>
      </outline>
      <outline text="神経変性">
        <outline text="アルツハイマー病は記憶障害、アミロイドとタウ"/>
        <outline text="レビー小体病は変動、幻視、パーキンソニズム"/>
        <outline text="前頭側頭葉変性症は行動、実行機能、言語"/>
        <outline text="パーキンソン病はドパミン作動性回路の変性"/>
        <outline text="運動ニューロン疾患は感覚が保たれ進行"/>
        <outline text="可逆的な要因を検討する"/>
        <outline text="意思決定能力、自律性、個人の目標を尊重"/>
      </outline>
    </outline>
  </body>
</opml>
