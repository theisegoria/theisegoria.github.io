<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>067-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="倫理、同意、守秘義務、医事法">
      <outline text="概説と倫理的推論">
        <outline text="法律は最低基準、倫理はそれ以上を求める"/>
        <outline text="四つの原則">
          <outline text="自律尊重は自己決定を支える"/>
          <outline text="善行は福祉を促進する"/>
          <outline text="無危害は不釣り合いな害を避ける"/>
          <outline text="正義は公平な分配と平等な尊重"/>
        </outline>
        <outline text="原則は衝突し、機械的に答えを生まない"/>
        <outline text="事実、選択肢、価値観、能力、法律を明確化"/>
        <outline text="最も制限の少ない有効な選択肢を記録"/>
        <outline text="倫理コンサルテーションは支援で、決定に代わらない"/>
      </outline>
      <outline text="インフォームド・コンセント">
        <outline text="自発的、情報に基づく、能力あり、具体的"/>
        <outline text="署名ではなく過程"/>
        <outline text="目的、リスク、代替法、無治療を説明"/>
        <outline text="重要なリスク">
          <outline text="合理的な人が重要とみなすもの"/>
          <outline text="その患者が特に重視するもの"/>
        </outline>
        <outline text="平易な言葉、通訳、理解の確認"/>
        <outline text="同意はいつでも撤回できる"/>
        <outline text="緊急の必要性">
          <outline text="能力なし、有効な拒否なし、遅延で害"/>
          <outline text="都合のよい非緊急治療は認めない"/>
        </outline>
        <outline text="治療上の特権は極めて限定的"/>
      </outline>
      <outline text="意思決定能力">
        <outline text="決定ごと、時点ごとに異なる"/>
        <outline text="理解、保持、利用・比較衡量、伝達"/>
        <outline text="診断や賢明でない選択で失われない"/>
        <outline text="まず能力を支える">
          <outline text="疼痛、せん妄、低酸素、離脱、恐怖を治療"/>
          <outline text="通訳、支援者、最適な時期"/>
        </outline>
        <outline text="能力がない場合">
          <outline text="事前指示と任命された意思決定者"/>
          <outline text="代理判断は患者なら何を選ぶか"/>
          <outline text="最善利益は福祉と希望を統合"/>
          <outline text="家族は自動的に法的決定者ではない"/>
        </outline>
      </outline>
      <outline text="小児と青年">
        <outline text="親の権限は子どもの福祉で制限"/>
        <outline text="発達に応じて賛意を求める"/>
        <outline text="一部の青年は独立して同意できる"/>
        <outline text="秘密を守る診療は開示を促す">
          <outline text="重大リスクとセーフガーディングの限界を説明"/>
        </outline>
        <outline text="有害な親の拒否は強化対応、放棄しない"/>
      </outline>
      <outline text="守秘義務とプライバシー">
        <outline text="信頼と率直な開示を可能にする"/>
        <outline text="診療に必要な情報のみ収集・閲覧"/>
        <outline text="まれな詳細で匿名化は破れる"/>
        <outline text="同意なしの開示">
          <outline text="重大な害、保護、法定義務"/>
          <outline text="最小限、患者へ伝え、記録する"/>
        </outline>
        <outline text="死後も続く"/>
        <outline text="遺伝情報は家族へ影響する">
          <outline text="患者自身の共有と専門カウンセリング"/>
        </outline>
      </outline>
      <outline text="記録と専門職としての境界">
        <outline text="記録はケアの道具かつ法的文書"/>
        <outline text="観察、申し立て、推論を区別"/>
        <outline text="日付付き追跡可能な訂正">
          <outline text="不正確な文章のコピーは害を拡大"/>
        </outline>
        <outline text="境界は搾取を防ぐ">
          <outline text="力関係は診療終了後も続く"/>
        </outline>
        <outline text="同席者は同意の代わりにならない"/>
      </outline>
      <outline text="セーフガーディングと暴力">
        <outline text="虐待、ネグレクト、搾取、強制的支配"/>
        <outline text="警告徴候は単独で虐待を証明しない"/>
        <outline text="訓練された通訳を用い私的に話す"/>
        <outline text="加害者と対決せず、秘密を約束しない"/>
        <outline text="患者の言葉と外傷を記録"/>
        <outline text="親密なパートナーからの暴力">
          <outline text="別居・妊娠中に悪化しやすい"/>
          <outline text="絞頸は所見乏しく遅発性損傷"/>
          <outline text="計画なしの突然の介入は危険"/>
        </outline>
      </outline>
      <outline text="誤り、率直説明義務、過失">
        <outline text="安定化、証拠保全、事実の開示"/>
        <outline text="謝罪と分析は両立する"/>
        <outline text="公正な文化は誤り、近道、無謀を区別"/>
        <outline text="過失は義務、違反、因果関係、損害">
          <outline text="転帰不良だけでは過失でない"/>
        </outline>
        <outline text="移行なき診療終了は診療放棄"/>
        <outline text="良心的拒否の限界"/>
      </outline>
      <outline text="資源配分と公衆衛生倫理">
        <outline text="透明で一貫した臨床基準">
          <outline text="社会的価値、富、固定観念は用いない"/>
        </outline>
        <outline text="障害は生命価値の低さではない"/>
        <outline text="制限措置には必要性と比例性が必要">
          <outline text="支援のない強制は信頼を損なう"/>
        </outline>
      </outline>
      <outline text="研究倫理">
        <outline text="妥当性、利益・リスク均衡、公平、審査"/>
        <outline text="臨床的均衡は専門家の真の不確実性"/>
        <outline text="同意では研究と治療を区別"/>
        <outline text="プラセボで重大な回避可能な害を与えない"/>
        <outline text="ゲノミクス、人工知能、バイオバンクの統治"/>
      </outline>
    </outline>
  </body>
</opml>
