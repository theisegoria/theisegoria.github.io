<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>033-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="筋骨格・リウマチ疾患の基礎">
      <outline text="概説">
        <outline text="外傷、変性、感染、結晶、免疫"/>
        <outline text="第一に緊急性の有無">
          <outline text="脅かされた肢、開放骨折、コンパートメント症候群"/>
          <outline text="化膿性関節炎、脊髄圧迫、血管炎"/>
        </outline>
        <outline text="第二に炎症性か機械的か">
          <outline text="パターンと時間経過は抗体検査に勝る"/>
        </outline>
      </outline>
      <outline text="急性軟部組織損傷">
        <outline text="出血、炎症、疼痛、腫脹"/>
        <outline text="炎症、増殖期、リモデリング">
          <outline text="リモデリングで組織が負荷方向へ整列"/>
        </outline>
        <outline text="保護と運動の均衡">
          <outline text="保護不足は損傷を反復"/>
          <outline text="長すぎる固定は拘縮と萎縮"/>
        </outline>
        <outline text="腱断裂は痛みが軽くても間隙と筋力低下"/>
        <outline text="脱臼は緊急整復を要する"/>
      </outline>
      <outline text="骨折と四肢の緊急病態">
        <outline text="脆弱性骨折は骨強度低下を示す"/>
        <outline text="病的骨折は局在性疾患を通る"/>
        <outline text="開放骨折">
          <outline text="抗菌薬、破傷風、デブリードマン、固定"/>
          <outline text="創部を繰り返し探らない"/>
        </outline>
        <outline text="早期単純画像正常でも不顕性骨折"/>
        <outline text="コンパートメント症候群">
          <outline text="閉鎖筋膜区画の圧上昇が灌流を障害"/>
          <outline text="不釣り合いな激痛、他動伸展時痛"/>
          <outline text="動脈拍動は保たれ得る"/>
          <outline text="遅延で筋壊死、腎障害、肢切断"/>
        </outline>
      </outline>
      <outline text="変形性関節症">
        <outline text="関節全体の機能不全">
          <outline text="骨棘、骨リモデリング、間欠的滑膜炎"/>
        </outline>
        <outline text="画像重症度と疼痛の相関は不完全"/>
        <outline text="活動時痛、安静後の短いこわばり"/>
        <outline text="長いこわばりや全身症状は別病態"/>
        <outline text="運動、減量、活動配分、外用療法"/>
        <outline text="重症例に人工関節置換術">
          <outline text="関節鏡はびまん性変性を逆転しない"/>
        </outline>
      </outline>
      <outline text="結晶誘発性関節炎">
        <outline text="痛風は尿酸過飽和による結晶沈着">
          <outline text="発作中も血清尿酸値正常のことがある"/>
          <outline text="針状で負の複屈折性"/>
          <outline text="結晶があっても感染は除外できない"/>
        </outline>
        <outline text="発作は非ステロイド性抗炎症薬等で早期治療"/>
        <outline text="長期尿酸降下療法">
          <outline text="低用量開始、目標まで調整、発作予防"/>
          <outline text="発作中も通常は継続"/>
        </outline>
        <outline text="ピロリン酸カルシウム沈着症">
          <outline text="菱形で弱い正の複屈折性"/>
          <outline text="結晶量を除去する治療はない"/>
        </outline>
      </outline>
      <outline text="化膿性関節炎と骨髄炎">
        <outline text="熱く腫れた関節は評価まで化膿性">
          <outline text="発熱がないこともある"/>
          <outline text="血液培養と緊急関節液採取"/>
        </outline>
        <outline text="骨髄炎は血行性、隣接組織、手術、外傷">
          <outline text="慢性は壊死骨、瘻孔、バイオフィルム"/>
          <outline text="深部組織の微生物学的診断が必要"/>
        </outline>
        <outline text="感染源制御と標的抗微生物療法"/>
      </outline>
      <outline text="炎症性関節炎">
        <outline text="関節リウマチ">
          <outline text="対称性小関節、長い朝のこわばり"/>
          <outline text="抗シトルリン化ペプチド抗体は特異的"/>
          <outline text="抗体陰性でも滑膜炎は除外できない"/>
          <outline text="寛解を目指す早期疾患修飾療法"/>
        </outline>
        <outline text="脊椎関節炎">
          <outline text="付着部炎、指趾炎、ぶどう膜炎、乾癬"/>
          <outline text="ヒト白血球抗原B27はリスク支持、診断せず"/>
          <outline text="腰背部痛は運動で改善"/>
          <outline text="磁気共鳴で仙腸関節炎が単純画像に先行"/>
        </outline>
      </outline>
      <outline text="全身性エリテマトーデスと結合組織病">
        <outline text="寛容喪失と免疫複合体"/>
        <outline text="抗核抗体は感度高く特異度低い">
          <outline text="特異抗体、補体、尿所見"/>
        </outline>
        <outline text="腎生検がループス腎炎治療を導く"/>
        <outline text="ヒドロキシクロロキン、糖質コルチコイド毒性"/>
        <outline text="全身性強皮症は血管障害と線維化"/>
        <outline text="シェーグレン病は乾燥とリンパ腫リスク"/>
      </outline>
      <outline text="血管炎と炎症性筋疾患">
        <outline text="血管壁損傷で虚血、出血"/>
        <outline text="顎跛行、紫斑、多発単神経炎"/>
        <outline text="生検または血管画像で確定"/>
        <outline text="筋疾患は亜急性の近位筋力低下">
          <outline text="クレアチンキナーゼは常に高値でない"/>
        </outline>
      </outline>
      <outline text="免疫調節療法の安全性">
        <outline text="開始前に潜伏感染を検査"/>
        <outline text="生ワクチン以外の接種を更新"/>
        <outline text="発熱は感染、再燃、またはその両方">
          <outline text="感染を除外せず強化しない"/>
        </outline>
        <outline text="血球、臓器機能、骨、服薬遵守を監視"/>
        <outline text="共同意思決定は効果発現、費用、妊孕性"/>
      </outline>
    </outline>
  </body>
</opml>
