<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>099-02 Lifespan development, cognition, and social-emotional growth</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Lifespan development and growth">
      <outline text="Principles of development">
        <outline text="Genes, maturation, experience, culture, history"/>
        <outline text="Neither rigid timetable nor unlimited plasticity"/>
        <outline text="Skills emerge in ranges by several viable paths"/>
        <outline text="Assess domains, change, opportunity, function"/>
        <outline text="One delayed milestone does not identify a cause"/>
        <outline text="Loss of an established skill is more concerning"/>
      </outline>
      <outline text="Brain development and sensitive periods">
        <outline text="Proliferation, migration, differentiation, cell death"/>
        <outline text="Synapses overproduced, refined by activity"/>
        <outline text="Myelination and specialisation continue for decades"/>
        <outline text="Sensitive periods are not absolute deadlines">
          <outline text="Recovery depends on timing, duration, system"/>
        </outline>
      </outline>
      <outline text="Attachment and temperament">
        <outline text="Infants regulate arousal through caregivers"/>
        <outline text="Attachment: secure base, not a personality label">
          <outline text="Shaped by availability, temperament, culture"/>
        </outline>
        <outline text="Atypical patterns may be adaptation"/>
        <outline text="Temperament: reactivity, attention, self-regulation"/>
        <outline text="Goodness of fit between child and environment">
          <outline text="Reactive child thrives with calm routines"/>
        </outline>
        <outline text="&quot;Difficult&quot; label treats tendency as destiny"/>
      </outline>
      <outline text="Motor and language development">
        <outline text="Motor: maturation, body, strength, practice"/>
        <outline text="Infants discover solutions to constraints"/>
        <outline text="New locomotion changes cognitive experience"/>
        <outline text="Assess vision, hearing, tone, asymmetry, pain"/>
        <outline text="Language: preparedness plus social learning"/>
        <outline text="Receptive precedes expressive"/>
        <outline text="Joint attention and gesture link focus to words"/>
        <outline text="Passive media lacks contingent feedback"/>
        <outline text="Multilingual exposure does not cause disorder"/>
      </outline>
      <outline text="Cognition and executive function">
        <outline text="Children reason well in familiar contexts">
          <outline text="Fail tasks needing language or inhibition"/>
        </outline>
        <outline text="Stage theories underestimate early competence"/>
        <outline text="Knowledge is domain-specific"/>
        <outline text="Executive: inhibition, updating, switching, planning"/>
        <outline text="Frontoparietal, subcortical, cerebellar networks"/>
        <outline text="Performance depends on sleep, stress, environment"/>
        <outline text="Externalise demands with routines and visual cues"/>
      </outline>
      <outline text="Social and moral understanding">
        <outline text="Theory of mind represents beliefs and intentions"/>
        <outline text="False-belief task is one milestone"/>
        <outline text="Real social cognition integrates ambiguous cues"/>
        <outline text="Difference does not mean absent empathy"/>
        <outline text="Morality: emotion, learning, reasoning, institutions"/>
        <outline text="Moral harms distinguished from conventions"/>
        <outline text="Reasoning expands from punishment to principles"/>
        <outline text="Moral language does not guarantee behaviour"/>
      </outline>
      <outline text="Adolescence and identity">
        <outline text="Puberty plus expanding social and legal roles"/>
        <outline text="Reward systems respond before regulation matures">
          <outline text="Especially in emotional peer contexts"/>
        </outline>
        <outline text="Not uniformly irrational"/>
        <outline text="Risk harmful with intense reward, low supervision"/>
        <outline text="Identity integrates values, roles, body, culture"/>
        <outline text="Exploration and commitment can be phases"/>
        <outline text="Distress not automatically due to identity"/>
      </outline>
      <outline text="Adulthood and ageing">
        <outline text="Intimacy, work, caregiving, generativity"/>
        <outline text="Processing speed declines gradually"/>
        <outline text="Knowledge, vocabulary, expertise stable or grow"/>
        <outline text="Cross-sectional cohort and longitudinal survival bias"/>
        <outline text="Normal ageing slows retrieval, not dementia"/>
        <outline text="Sensory loss masquerades as cognitive impairment"/>
        <outline text="Acute decline: delirium, illness, medication"/>
        <outline text="Narrowing future time changes priorities"/>
        <outline text="Grief varies, no mandatory stages"/>
      </outline>
      <outline text="Context, categories, and formulation">
        <outline text="Nested systems shape daily inputs"/>
        <outline text="Adversity alters stress physiology, not destiny"/>
        <outline text="Protective relationships and services buffer risk"/>
        <outline text="Resilience must not shift responsibility"/>
        <outline text="Diagnostic thresholds divide continuous traits"/>
        <outline text="Masking conceals difficulty at a cost"/>
        <outline text="Formulate profile, context, goals, accommodations"/>
        <outline text="Compare with own trajectory, not only population"/>
      </outline>
    </outline>
  </body>
</opml>
