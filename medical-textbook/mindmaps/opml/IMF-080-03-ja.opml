<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>080-03 脳神経、動静脈経路、自律神経節、リンパ系</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="脳神経、動静脈、自律神経節、リンパ系">
      <outline text="嗅覚路と視覚路">
        <outline text="嗅糸は篩板を通る">
          <outline text="剪断で嗅覚脱失と髄液漏"/>
        </outline>
        <outline text="必須の視床中継がない">
          <outline text="嗅覚は記憶・情動と結び付く"/>
        </outline>
        <outline text="視神経は髄膜に囲まれた中枢神経路">
          <outline text="圧が神経鞘へ伝わり乳頭浮腫"/>
        </outline>
        <outline text="視交叉で鼻側線維が交叉"/>
        <outline text="交叉は下垂体上方、血管の近傍"/>
      </outline>
      <outline text="眼球運動神経と海綿静脈洞">
        <outline text="動眼神経は後大脳・上小脳動脈間"/>
        <outline text="動眼神経は挙筋、三直筋、下斜筋"/>
        <outline text="滑車神経は長い走行で外傷に弱い"/>
        <outline text="外転神経はドレロ管を通る">
          <outline text="洞内で内頸動脈に接する"/>
        </outline>
        <outline text="外側壁は動眼、滑車、眼、上顎神経"/>
        <outline text="眼静脈・顔面静脈が感染を伝える"/>
        <outline text="副交感は毛様体神経節から括約筋へ"/>
        <outline text="交感は上頸神経節から散大筋へ"/>
      </outline>
      <outline text="三叉神経三枝">
        <outline text="メッケル腔の三叉神経節"/>
        <outline text="眼神経は涙腺、前頭、鼻毛様体神経">
          <outline text="額、角膜、上眼瞼、鼻背"/>
        </outline>
        <outline text="上顎神経は正円孔から翼口蓋窩へ">
          <outline text="中顔面、上歯、口蓋、上顎洞"/>
        </outline>
        <outline text="下顎神経は運動根と卵円孔から出る">
          <outline text="運動枝は咀嚼筋、顎舌骨筋、張筋"/>
        </outline>
        <outline text="舌神経に鼓索神経が合流"/>
        <outline text="損傷高位で欠損の型が決まる"/>
      </outline>
      <outline text="顔面神経">
        <outline text="内耳道、顔面神経管、膝神経節、茎乳突孔"/>
        <outline text="管内の枝">
          <outline text="大錐体神経は翼口蓋神経節へ"/>
          <outline text="アブミ骨筋神経"/>
          <outline text="鼓索神経は味覚と唾液分泌線維"/>
        </outline>
        <outline text="耳下腺内神経叢と五終枝">
          <outline text="耳下腺分泌は支配しない"/>
        </outline>
        <outline text="頭蓋内病変は味覚、流涙、アブミ骨筋"/>
        <outline text="上位運動ニューロン病変は額を温存">
          <outline text="両側性皮質入力"/>
        </outline>
      </outline>
      <outline text="下位脳神経">
        <outline text="舌咽神経は茎突咽頭筋と舌後方">
          <outline text="頸動脈洞・小体の求心路"/>
          <outline text="小錐体神経・耳神経節経由で耳下腺"/>
        </outline>
        <outline text="迷走神経は頸動脈鞘内を下行">
          <outline text="上喉頭神経は感覚性内枝と運動性外枝"/>
        </outline>
        <outline text="副神経は後頸三角で表在性">
          <outline text="肩の挙上と頭部回旋が弱くなる"/>
        </outline>
        <outline text="舌下神経は舌骨舌筋表面を回る">
          <outline text="顎下部・頸動脈手術で損傷し得る"/>
        </outline>
      </outline>
      <outline text="自律神経節">
        <outline text="三叉神経枝と結び付く四副交感神経節">
          <outline text="毛様体神経節は動眼神経から眼へ"/>
          <outline text="翼口蓋神経節は大錐体路から腺へ"/>
          <outline text="顎下神経節は鼓索から二腺へ"/>
          <outline text="耳神経節は舌咽神経から耳下腺へ"/>
        </outline>
        <outline text="節後線維は三叉神経枝に便乗"/>
        <outline text="交感線維はシナプスせず通過">
          <outline text="共同経路で複合障害"/>
        </outline>
        <outline text="ホルネル症候群">
          <outline text="眼瞼下垂、縮瞳、見かけ上の眼球陥凹"/>
          <outline text="無汗分布で節前・節後を局在"/>
        </outline>
      </outline>
      <outline text="動脈供給">
        <outline text="内頸動脈は錐体部・海綿部から眼窩と脳"/>
        <outline text="外頸動脈は顔面、頭皮、硬膜、頸部"/>
        <outline text="顎動脈は二つの窩を進む">
          <outline text="中硬膜動脈は棘孔へ"/>
          <outline text="蝶口蓋動脈は鼻出血で重要"/>
        </outline>
        <outline text="椎骨動脈は第六頸椎横突孔から環椎へ"/>
        <outline text="頸動脈系吻合は側副路か塞栓路"/>
      </outline>
      <outline text="静脈還流">
        <outline text="硬膜静脈洞は弁のない流路"/>
        <outline text="上矢状洞は横・S状洞から内頸静脈へ"/>
        <outline text="直静脈洞は大大脳静脈を受ける"/>
        <outline text="左右の海綿静脈洞は交通する"/>
        <outline text="翼突筋静脈叢は顔面と海綿静脈洞を結ぶ"/>
        <outline text="導出静脈は弁なく頭蓋孔を通る">
          <outline text="圧を均等化し感染・腫瘍を伝える"/>
        </outline>
      </outline>
      <outline text="リンパ系">
        <outline text="表在輪は深頸リンパ節鎖へ流れる"/>
        <outline text="深頸節は内頸静脈に沿う"/>
        <outline text="臨床的レベルは癌手術に用いる"/>
        <outline text="ワルダイエル輪は咽頭入口を囲む">
          <outline text="口蓋扁桃は舌咽神経に近接">
            <outline text="関連耳痛と手術時出血"/>
          </outline>
        </outline>
        <outline text="ウィルヒョウ節は胸管経由で腫大"/>
        <outline text="右リンパ本幹は右上半身を排出"/>
      </outline>
      <outline text="経路としての局在">
        <outline text="脳幹出口からリンパ領域まで欠損を追う"/>
        <outline text="孤立した名称でなく連結した経路"/>
      </outline>
    </outline>
  </body>
</opml>
