<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>065-02 集団測定、スクリーニングのトレードオフ、ワクチン戦略、および公平な予防</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="集団測定、スクリーニング、ワクチン、公平性">
      <outline text="集団の視点">
        <outline text="注意単位は分布へ広がる"/>
        <outline text="空気、労働、住宅、所得が患者数を決める"/>
        <outline text="誰が利用し、誰が負担するか"/>
      </outline>
      <outline text="発生の測定">
        <outline text="累積罹患は一定期間の確率"/>
        <outline text="罹患率は事象数を人時間で割る"/>
        <outline text="有病割合は発生増加か期間延長で上昇">
          <outline text="治療で生存延長し有病割合増加"/>
        </outline>
        <outline text="致命割合は軽症診断で変わる"/>
        <outline text="粗率は年齢・性構成で変わる"/>
        <outline text="直接標準化は共通基準集団へ適用"/>
        <outline text="間接法は観察事象と期待事象を比較">
          <outline text="実際の地域負担ではない"/>
        </outline>
      </outline>
      <outline text="因果と効果の大きさ">
        <outline text="関連は因果を示さない"/>
        <outline text="交絡因子は曝露と転帰の双方に関連"/>
        <outline text="無作為化は既知・未知交絡を平均化">
          <outline text="脱落や交差は残る"/>
        </outline>
        <outline text="観察研究の調整後も未測定交絡"/>
        <outline text="相対危険は稀な事象で大きく見える"/>
        <outline text="治療必要数は期間などを引き継ぐ">
          <outline text="基礎危険で変わる"/>
        </outline>
      </outline>
      <outline text="検診の正当化と偏り">
        <outline text="無症状者の患者重要転帰改善のため"/>
        <outline text="早く見つかるだけでは正当化されない"/>
        <outline text="追跡が乏しい測定法は検診制度でない"/>
        <outline text="リードタイム偏りは死亡時点不変"/>
        <outline text="期間偏りは遅い病変を見つける"/>
        <outline text="過剰診断は無害な真の病変">
          <outline text="確定精度向上では解消しない"/>
          <outline text="治療すれば過剰治療"/>
        </outline>
        <outline text="病期や生存より無作為化での害減少"/>
      </outline>
      <outline text="検診の閾値と意思決定">
        <outline text="低有病率は偽陽性を増幅">
          <outline text="画像、生検、不安、病名付与"/>
        </outline>
        <outline text="閾値上昇で特異度改善、見逃し増加">
          <outline text="遅延診断と不要追跡を比較"/>
        </outline>
        <outline text="全転帰を同じ期間・分母で示す"/>
        <outline text="症状がある人の検査は検診でない"/>
        <outline text="受けない選択も正当で再検討可能"/>
        <outline text="医療が届く人ほど受検しやすい">
          <outline text="アウトリーチ、通訳、ナビゲーション"/>
        </outline>
        <outline text="確定と転帰を集団群別に追う"/>
      </outline>
      <outline text="ワクチン製剤と実効性">
        <outline text="弱毒生ワクチンは広い反応">
          <outline text="細胞性免疫不全と妊娠で危険"/>
        </outline>
        <outline text="非生製剤は複製で感染を起こさない"/>
        <outline text="結合型は幼児に記憶を可能にする"/>
        <outline text="有効率は試験、実効性は現実"/>
        <outline text="感染より重症化への防御が強い"/>
        <outline text="集団免疫閾値が正確なことは稀"/>
      </outline>
      <outline text="接種の実施と安全性">
        <outline text="適切な製剤、人、間隔"/>
        <outline text="冷蔵逸脱は見た目で判定しない"/>
        <outline text="時間的関連は原因とは限らない">
          <outline text="報告刺激が見かけの集積を作る"/>
          <outline text="観察率と期待率を比べる"/>
        </outline>
        <outline text="禁忌は俗説より狭い"/>
        <outline text="免疫抑制前に非生ワクチン"/>
        <outline text="追いつき接種はやり直さず続ける"/>
      </outline>
      <outline text="心血管予防">
        <outline text="絶対危険に基づく">
          <outline text="同じ脂質低下で高危険者ほど防ぐ"/>
        </outline>
        <outline text="長期診断前に血圧を確認"/>
        <outline text="危険計算器は真の個人確率でない">
          <outline text="構造的不利益を捉えない"/>
        </outline>
        <outline text="生活介入は薬物開始の前提でない"/>
        <outline text="目標は心筋梗塞、脳卒中、腎不全の減少"/>
        <outline text="利益発現前に余命が尽きれば過剰治療">
          <outline text="虚弱、転倒、多剤、出血"/>
        </outline>
        <outline text="暦年齢で止めず自動継続もしない"/>
      </outline>
      <outline text="がん、感染、依存">
        <outline text="検診は臓器と危険で異なる">
          <outline text="卵巣マーカー、甲状腺超音波は過剰診断"/>
        </outline>
        <outline text="実際の伝播経路を遮断"/>
        <outline text="薬剤耐性予防は感染数の削減から"/>
        <outline text="ニコチン代替は燃焼から分離"/>
        <outline text="再発は次の治療試行へつなぐ"/>
        <outline text="オピオイド害低減も断薬目標を保つ"/>
      </outline>
      <outline text="公平性と実装">
        <outline text="社会カテゴリーは固定生物学でない"/>
        <outline text="公平は比較可能な利益へ資源を変える"/>
        <outline text="集団平均は少数群の悪化を隠す"/>
        <outline text="招待、参加、脱落、害を分けて評価">
          <outline text="絶対格差と相対格差は異なり得る"/>
        </outline>
        <outline text="文化でなく制度機序を調べる"/>
        <outline text="過程指標は転帰と結び付く時に意味"/>
        <outline text="移行計画で継続診療とデータ責任"/>
      </outline>
    </outline>
  </body>
</opml>
