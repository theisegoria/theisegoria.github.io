<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>021-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="消化、吸収、肝機能、栄養">
      <outline text="構造と調節">
        <outline text="粘膜、粘膜下層、筋層、漿膜"/>
        <outline text="ひだ、絨毛、微絨毛が表面積を増大"/>
        <outline text="密着結合と選択的輸送体"/>
        <outline text="上皮の速い更新が傷害を修復">
          <outline text="代謝拮抗薬、放射線、虚血に脆弱"/>
        </outline>
        <outline text="腸管神経系が局所機能を調整"/>
        <outline text="副交感神経は消化を促進"/>
        <outline text="交感神経は抑制し血管を収縮"/>
        <outline text="カハール介在細胞が緩徐波を生成"/>
        <outline text="消化管ホルモンが局所反応を調整">
          <outline text="ガストリンは胃酸と粘膜成長"/>
          <outline text="セクレチンは酸に応じ重炭酸分泌"/>
          <outline text="コレシストキニン：膵酵素、胆嚢、排出遅延"/>
          <outline text="インクレチンとモチリン"/>
        </outline>
      </outline>
      <outline text="口腔から結腸までの運動">
        <outline text="嚥下反射が気道を保護"/>
        <outline text="括約筋弛緩障害でアカラシア"/>
        <outline text="不適切な逆流が扁平上皮を酸曝露"/>
        <outline text="近位部は受容、遠位部は粉砕"/>
        <outline text="十二指腸信号が胃排出を遅延"/>
        <outline text="嘔吐で塩化物、カリウム、体液喪失"/>
        <outline text="分節運動は混合、蠕動は前進"/>
        <outline text="空腹期伝播性収縮が残留物除去"/>
        <outline text="膨起収縮は吸水、大蠕動は移送"/>
        <outline text="排便は反射と随意制御の組合せ"/>
      </outline>
      <outline text="分泌と消化">
        <outline text="唾液は潤滑、緩衝、消化開始"/>
        <outline text="壁細胞は塩酸と内因子">
          <outline text="ヒスタミン、アセチルコリン、ガストリン"/>
          <outline text="ソマトスタチンとプロスタグランジンが抑制"/>
        </outline>
        <outline text="粘膜防御が自己消化を防ぐ"/>
        <outline text="膵は重炭酸と消化酵素">
          <outline text="不活性前駆体で自己消化を抑制"/>
          <outline text="外分泌不全で脂肪便"/>
        </outline>
        <outline text="胆汁酸は乳化しミセル形成">
          <outline text="終末回腸で回収"/>
          <outline text="循環中断で下痢、脂肪吸収不良"/>
        </outline>
      </outline>
      <outline text="吸収">
        <outline text="糖はブドウ糖、ガラクトース、果糖"/>
        <outline text="ナトリウム共役輸送が経口補水の根拠"/>
        <outline text="長鎖脂肪はカイロミクロンでリンパへ"/>
        <outline text="短鎖脂肪酸は門脈血へ"/>
        <outline text="ビタミンB12は内因子と終末回腸"/>
        <outline text="鉄は近位小腸、ヘプシジンで調節"/>
        <outline text="結腸は水とナトリウムを回収"/>
        <outline text="下痢の機序">
          <outline text="絶食は浸透圧性のみ改善"/>
          <outline text="大量便で循環血液量減少、腎傷害"/>
        </outline>
      </outline>
      <outline text="バリア、微生物叢、内臓循環">
        <outline text="粘液、上皮、抗菌分子、免疫細胞、常在微生物"/>
        <outline text="微生物叢は発酵し胆汁酸を修飾"/>
        <outline text="関連は因果を証明しない"/>
        <outline text="対向流循環で絨毛先端が低酸素"/>
        <outline text="低血圧、動脈閉塞、静脈血栓で虚血">
          <outline text="診察所見に不釣り合いな疼痛"/>
          <outline text="梗塞進行で腹膜刺激と虚脱"/>
        </outline>
      </outline>
      <outline text="肝構造と機能領域">
        <outline text="門脈血と肝動脈血の流入"/>
        <outline text="類洞から中心静脈へ"/>
        <outline text="胆汁は逆方向に胆管へ"/>
        <outline text="肝細胞は経口薬剤に先に曝露"/>
        <outline text="門脈周囲は酸素、酸化、尿素"/>
        <outline text="中心静脈周囲は低酸素、薬物代謝">
          <outline text="低酸素と特定の毒物に弱い"/>
        </outline>
        <outline text="星細胞活性化が線維化を促す"/>
      </outline>
      <outline text="代謝、合成、解毒機能">
        <outline text="グリコーゲンと糖新生で血糖緩衝"/>
        <outline text="アルブミン、凝固因子、補体を合成">
          <outline text="膠質浸透圧を支え薬剤を結合"/>
        </outline>
        <outline text="第一相で官能基、第二相で抱合">
          <outline text="不活化、プロドラッグ活性化、毒性"/>
        </outline>
        <outline text="誘導、遺伝、シャントで曝露変化"/>
        <outline text="ビリルビンはヘム分解から">
          <outline text="非抱合型は過剰産生か抱合障害"/>
          <outline text="抱合型は排泄障害か閉塞"/>
        </outline>
      </outline>
      <outline text="栄養と臨床評価">
        <outline text="エネルギー平衡は摂取から喪失まで"/>
        <outline text="低栄養で筋量、免疫、予備能低下"/>
        <outline text="肥満も微量栄養素欠乏を伴い得る"/>
        <outline text="体重推移と機能を統合評価">
          <outline text="アルブミンは単独の栄養指標でない"/>
        </outline>
        <outline text="長期低栄養後の再栄養">
          <outline text="リン酸、カリウム、マグネシウムが細胞内へ"/>
          <outline text="チアミン補充、慎重開始、緊密監視"/>
        </outline>
        <outline text="経腸栄養は粘膜機能を保つ"/>
        <outline text="静脈栄養は救命的だが感染リスク"/>
      </outline>
    </outline>
  </body>
</opml>
