<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>099-03 ストレス、動機、習慣、行動変容</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="ストレス、動機、行動変容">
      <outline text="ストレスとその生理">
        <outline text="ストレッサーは事象、ストレスは反応"/>
        <outline text="脅威、挑戦、喪失、無関係"/>
        <outline text="急性ストレスは注意とエネルギーを優先"/>
        <outline text="極端、遷延、回復不足で害となる"/>
        <outline text="迅速な交感神経・副腎髄質反応">
          <outline text="ノルアドレナリンは覚醒と血管緊張"/>
          <outline text="アドレナリンは心拍出、換気、糖利用"/>
        </outline>
        <outline text="より遅い視床下部下垂体副腎系">
          <outline text="コルチゾールは基質動員、免疫変化"/>
          <outline text="脳と下垂体へフィードバック"/>
        </outline>
        <outline text="一回測定には時刻と文脈が必要"/>
      </outline>
      <outline text="アロスタシスと認知的評価">
        <outline text="アロスタシスは変化による安定"/>
        <outline text="アロスタティック負荷は累積生理費用">
          <outline text="普遍的標準臨床検査ではない"/>
        </outline>
        <outline text="貧困、差別、介護が持続要求を作る">
          <outline text="個人の態度へ還元しない"/>
        </outline>
        <outline text="一次評価は何が危機にあるか"/>
        <outline text="二次評価は選択肢と対処資源"/>
      </outline>
      <outline text="対処、制御、支援">
        <outline text="問題焦点型、情動焦点型、意味焦点型"/>
        <outline text="制御可能なら直接行動、不能なら受容"/>
        <outline text="回避は短期安堵でも恐怖を維持"/>
        <outline text="知覚制御は幻想や責任追及で有害"/>
        <outline text="予測可能性は準備を許す"/>
        <outline text="接触数より支援の質が重要"/>
        <outline text="自律を無視する助言は新たな要求"/>
      </outline>
      <outline text="動機と期待">
        <outline text="動因、誘因、目標"/>
        <outline text="ドパミンは報酬予測の学習、快楽でない"/>
        <outline text="欲求、快楽、努力、学習は分離する">
          <outline text="快楽なき手掛かりの牽引と依存"/>
        </outline>
        <outline text="期待価値は成功期待、価値、費用"/>
        <outline text="危険情報は一要素しか変えない"/>
        <outline text="どの即時費用が優位かを問う"/>
      </outline>
      <outline text="自己効力感と自律性">
        <outline text="自己効力感は特定行動への確信">
          <outline text="成功練習、モデル、励まし、生理状態"/>
        </outline>
        <outline text="一般的自尊心とは異なる"/>
        <outline text="達成可能な具体的目標とフィードバック"/>
        <outline text="広い目標を観察可能な段階へ分ける"/>
        <outline text="自律的動機と統制的動機"/>
        <outline text="有能感、自律性、関係性"/>
        <outline text="統制的な報酬は内発的関心を弱める"/>
        <outline text="情報に基づく選択は放置でない"/>
      </outline>
      <outline text="習慣と計画">
        <outline text="安定文脈での反復による手掛かり結合"/>
        <outline text="結果価値が低下しても続く"/>
        <outline text="知識変更だけの効果は限られる"/>
        <outline text="手掛かり、摩擦、順序、即時強化を変える"/>
        <outline text="実行意図は手掛かりと行動を連結"/>
        <outline text="行動計画は場所、時、方法"/>
        <outline text="対処計画は障壁時の対応"/>
        <outline text="計画は柔軟であるべき"/>
      </outline>
      <outline text="行動モデルと対話">
        <outline text="能力、機会、動機"/>
        <outline text="構造障壁を視野に保つ"/>
        <outline text="訓練、リマインダー、再設計を不足に合わせる"/>
        <outline text="段階モデルは準備性に支援を合わせる">
          <outline text="常に順序通りには進まない"/>
        </outline>
        <outline text="動機づけ面接は混合動機を探索">
          <outline text="本人の理由を引き出し議論を避ける"/>
        </outline>
      </outline>
      <outline text="危険知覚と行動経済学">
        <outline text="即時性、鮮明さ、恐怖、信頼が影響"/>
        <outline text="基礎リスクなしの相対危険は誤解を招く"/>
        <outline text="同じ分母の絶対頻度"/>
        <outline text="本人の言葉で理解を確認"/>
        <outline text="デフォルト、現在偏重、損失回避、規範"/>
        <outline text="倫理的デフォルトは透明で拒否が容易"/>
        <outline text="資源が乏しいと誘因は強制的になる"/>
      </outline>
      <outline text="再発、評価、統合">
        <outline text="再発は道徳的失敗でなく情報"/>
        <outline text="逸脱には見直し、思いやり、再開"/>
        <outline text="ストレスは注意を狭め習慣反応を強化"/>
        <outline text="生活行動で構造的逆境は除けない"/>
        <outline text="機序と結果を明示する"/>
        <outline text="関与自体は利益でない"/>
        <outline text="スティグマと格差拡大を監視"/>
        <outline text="機序に合う最小介入を選び修正"/>
      </outline>
    </outline>
  </body>
</opml>
