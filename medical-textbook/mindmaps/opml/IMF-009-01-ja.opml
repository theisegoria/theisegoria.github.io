<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>009-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="虚血、心不全、弁膜症、不整脈">
      <outline text="概説">
        <outline text="供給、ポンプ、弁、調律、血管制御"/>
        <outline text="各カテゴリーは互いに重なり合う"/>
        <outline text="単一所見では診断できない"/>
      </outline>
      <outline text="アテローム性動脈硬化">
        <outline text="内皮機能障害から始まる動脈内膜の疾患"/>
        <outline text="アポリポタンパク質B含有リポタンパク質の侵入"/>
        <outline text="単球、マクロファージ、泡沫細胞"/>
        <outline text="平滑筋遊走、細胞外マトリックス、炎症、石灰化"/>
        <outline text="線維性被膜と脂質に富む壊死性中心"/>
      </outline>
      <outline text="冠症候群">
        <outline text="プラーク量の増加が労作時血流を制限する"/>
        <outline text="破裂またはびらん、血小板活性化、血栓形成"/>
        <outline text="破綻する病変が最高度狭窄とは限らない"/>
        <outline text="虚血に至る他の経路">
          <outline text="冠攣縮、塞栓、解離"/>
          <outline text="微小血管疾患"/>
          <outline text="著しい酸素需給不均衡"/>
        </outline>
        <outline text="安定狭心症：労作で出現し安静で軽快"/>
        <outline text="急性冠症候群：安静時、持続長く、自律神経症状を伴う"/>
      </outline>
      <outline text="心筋梗塞とトロポニン">
        <outline text="急性虚血の証拠を伴う心筋傷害"/>
        <outline text="トロポニンは傷害を示すが原因は示さない">
          <outline text="心筋炎、頻脈性不整脈、心不全"/>
          <outline text="肺塞栓症、重症疾患、腎疾患"/>
        </outline>
        <outline text="上昇と下降を症状と臨床状況で読む"/>
        <outline text="第5次心筋梗塞国際定義">
          <outline text="一次性：急性の冠動脈病変"/>
          <outline text="二次性：別の急性疾患による需給不均衡"/>
          <outline text="手技関連：心臓手技から30日以内"/>
        </outline>
        <outline text="傷害、虚血、原因を分けて問う"/>
      </outline>
      <outline text="初期対応">
        <outline text="早期認識、心電図、モニタリング"/>
        <outline text="抗血小板療法と抗血栓療法の判断"/>
        <outline text="冠動脈閉塞が疑われれば迅速な再灌流"/>
        <outline text="酸素は低酸素血症に対して使う"/>
        <outline text="出血リスク、腎機能、代替診断"/>
      </outline>
      <outline text="心不全">
        <outline text="拍出量不足、充満圧上昇、またはその両方"/>
        <outline text="駆出率は低下、軽度低下、保持"/>
        <outline text="駆出率が保持されても正常機能ではない"/>
        <outline text="前方拍出低下：疲労、四肢冷感、腎機能障害"/>
        <outline text="左心系うっ血">
          <outline text="起座呼吸と発作性夜間呼吸困難"/>
          <outline text="肺水腫"/>
        </outline>
        <outline text="右心系うっ血">
          <outline text="頸静脈圧上昇と肝うっ血"/>
          <outline text="腹水と末梢浮腫"/>
        </outline>
        <outline text="短期に助け長期に害する代償">
          <outline text="交感神経とレニン・アンジオテンシン・アルドステロン系"/>
          <outline text="後負荷、酸素需要、線維化、不整脈の増悪"/>
        </outline>
        <outline text="ナトリウム利尿ペプチド値の変動要因"/>
        <outline text="急性期の利尿と慢性期の疾患修飾"/>
      </outline>
      <outline text="弁膜症">
        <outline text="狭窄：前方血流の障害と圧負荷"/>
        <outline text="逆流：後方流の許容と容量負荷"/>
        <outline text="大動脈弁狭窄症：左室圧負荷と求心性肥大"/>
        <outline text="低拍出では雑音の強さが重症度を誤らせる"/>
        <outline text="慢性大動脈弁逆流症は脈圧を拡大する"/>
        <outline text="急性逆流には適応の時間がない"/>
        <outline text="僧帽弁狭窄症：左房拡大と心房細動"/>
      </outline>
      <outline text="不整脈">
        <outline text="心房細動は無症状にも高度症状にもなる"/>
        <outline text="レート、リズム、誘因、血栓塞栓リスク"/>
        <outline text="規則正しい狭いQRS頻拍は上室性リエントリー"/>
        <outline text="幅の広いQRS頻拍は心室頻拍として扱う"/>
        <outline text="循環動態不安定：同期カルディオバージョン"/>
        <outline text="無脈性：除細動と蘇生"/>
        <outline text="徐脈：薬剤、洞結節疾患、伝導障害、虚血"/>
      </outline>
      <outline text="心膜と心筋の炎症">
        <outline text="前屈で軽快する鋭い胸膜性疼痛"/>
        <outline text="心膜摩擦音は特異的だが一過性"/>
        <outline text="心タンポナーデ：閉塞性血行動態と奇脈"/>
        <outline text="急速貯留は少量でもタンポナーデを起こす"/>
        <outline text="心筋炎は無症候性傷害からショックまで"/>
        <outline text="活動性炎症中の激しい運動は避ける"/>
      </outline>
      <outline text="予防と経過観察">
        <outline text="絶対リスクが介入強度を決める"/>
        <outline text="確立した動脈硬化性疾患の二次予防"/>
        <outline text="体重、体液量、調律、腎機能、電解質を追う"/>
        <outline text="リハビリテーション：活動、教育、心理的回復"/>
      </outline>
    </outline>
  </body>
</opml>
