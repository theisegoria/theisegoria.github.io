<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>100-01 社会的認知、同一性、影響、集団</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="社会的認知、同一性、影響、集団">
      <outline text="医療における社会心理学">
        <outline text="現実、想像、暗黙の他者が行動を形作る"/>
        <outline text="家族、チーム、制度が判断を形作る"/>
        <outline text="診療を調整し所属を与える">
          <outline text="偏見や異論抑制も生む"/>
        </outline>
        <outline text="社会的情報は非合理でなく証拠"/>
      </outline>
      <outline text="知覚と帰属">
        <outline text="迅速な分類が注意を導く">
          <outline text="認知負荷を減らすが群内変異を隠す"/>
        </outline>
        <outline text="ステレオタイプ、偏見、差別">
          <outline text="別々に起こり得る"/>
        </outline>
        <outline text="観察者は特性を過大、状況を過小評価">
          <outline text="受診欠席と交通、費用、育児"/>
        </outline>
        <outline text="個人と環境の両説明を検証"/>
        <outline text="後知恵バイアスは予測可能性を誇張"/>
        <outline text="公正世界傾向は疾患を行動のせいにする"/>
        <outline text="自己奉仕的帰属">
          <outline text="抑うつ、恥、周縁化で逆転"/>
        </outline>
      </outline>
      <outline text="態度と説得">
        <outline text="認知的信念、情動評価、行動傾向"/>
        <outline text="具体的、利用可能、安定で予測力大"/>
        <outline text="矛盾行動後の認知的不協和">
          <outline text="信念変更、正当化、情報回避"/>
          <outline text="強制的公開関与は抵抗を固定"/>
        </outline>
        <outline text="慎重処理と手掛かり処理"/>
        <outline text="信頼性には能力と誠実性が必要"/>
        <outline text="実行可能な反応なき恐怖">
          <outline text="有効感が低いと防御的回避"/>
        </outline>
      </outline>
      <outline text="規範、同調、応諾">
        <outline text="記述的規範と命令的規範"/>
        <outline text="不正の広報は正常化し得る">
          <outline text="価値ある基準を併記"/>
        </outline>
        <outline text="社会全体より信頼する仲間"/>
        <outline text="情報的影響と規範的影響"/>
        <outline text="不確実性、全会一致、公開回答で強まる">
          <outline text="一人の異論者が全会一致を壊す"/>
        </outline>
        <outline text="議論前に独立評価"/>
        <outline text="初期関与、返報性、希少性の技法">
          <outline text="社会圧力の肯定は同意でない"/>
        </outline>
      </outline>
      <outline text="権威と発言">
        <outline text="専門性と責任を調整"/>
        <outline text="責任が上へ移ると有害行動が容易">
          <outline text="作業断片化、異論が不忠に見える"/>
        </outline>
        <outline text="専門職も免れない"/>
        <outline text="エスカレーション、段階的主張、閉ループ"/>
        <outline text="懸念提起へ感謝する指導者"/>
        <outline text="形式的許可と社会的処罰は失敗"/>
      </outline>
      <outline text="同一性と集団行動">
        <outline text="任意区分でも内集団を優遇"/>
        <outline text="脅威、競争、不平等な地位が境界を強める"/>
        <outline text="協力と平等のある接触が有効">
          <outline text="敵対条件の近接は強化し得る"/>
        </outline>
        <outline text="交差する同一性は予測を限る"/>
        <outline text="没個性化は顕著な局所規範へ寄る"/>
        <outline text="傍観者の責任分散">
          <outline text="名指しで連絡を依頼"/>
        </outline>
      </outline>
      <outline text="集団判断とチームワーク">
        <outline text="初期傾向への集団極性化"/>
        <outline text="指示的、隔離、同質集団の集団思考">
          <outline text="構造化異論と独立審査"/>
        </outline>
        <outline text="集団知性は情報共有と心理的安全性"/>
        <outline text="共有情報バイアスが固有情報を隠す">
          <outline text="何が計画を変えるかを問う"/>
        </outline>
        <outline text="社会的手抜きと協調損失"/>
        <outline text="競争は学習と率直さを抑える"/>
        <outline text="重複が回復力を保つ"/>
      </outline>
      <outline text="権力、向社会的行動、葛藤">
        <outline text="専門性、地位、報酬、情報統制から権力"/>
        <outline text="低権力者は監視し対立リスクを負う">
          <outline text="患者の合意は依存を反映し得る"/>
          <outline text="質問の私的機会と安全な拒否"/>
        </outline>
        <outline text="共感的関心と自己焦点の苦痛"/>
        <outline text="疲労と道徳的苦悩は別機序"/>
        <outline text="強靱性の説諭より組織支援"/>
        <outline text="立場と根底の利益"/>
        <outline text="希少性は相互利益を限る">
          <outline text="公正手続き、透明性、審査"/>
        </outline>
      </outline>
      <outline text="よりよい環境の設計">
        <outline text="教育だけでバイアスは消えない"/>
        <outline text="高リスク判断を遅くし基礎率を示す"/>
        <outline text="独立見解を招き理由を記録"/>
        <outline text="集団別転帰を監査"/>
        <outline text="影響を可視化し説明可能にする"/>
      </outline>
    </outline>
  </body>
</opml>
