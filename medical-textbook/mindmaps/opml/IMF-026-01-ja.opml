<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>026-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="内分泌・生殖系の診察と検査">
      <outline text="概説と内分泌疾患の問診">
        <outline text="緩徐に進行し複数の臓器系に影響">
          <outline text="腺の疾患を薬剤、全身疾患、妊娠と区別"/>
          <outline text="結合蛋白と測定干渉"/>
        </outline>
        <outline text="生殖評価はプライバシー、同意、トラウマ配慮"/>
        <outline text="まず時間経過と機能への影響">
          <outline text="体重変化は脂肪、体液、筋肉、摂取、異化"/>
          <outline text="色素沈着、塩分渇望、腎結石、指輪のサイズ"/>
        </outline>
        <outline text="単独で弱い症状も症候群なら意味を持つ"/>
        <outline text="あらゆる経路の薬剤と補完療法を記録">
          <outline text="糖質コルチコイド、アミオダロン、ビオチン"/>
          <outline text="内分泌症候群を生じさせ、覆い隠す"/>
        </outline>
      </outline>
      <outline text="内分泌系の一般診察">
        <outline text="体格、脂肪と筋肉の分布、声"/>
        <outline text="適応があれば臥位・立位血圧"/>
        <outline text="皮膚線条、皮下出血、色素沈着、多毛"/>
        <outline text="近位筋力低下は起立と腕の挙上で評価"/>
        <outline text="振戦、反射の弛緩相、視野、歩行"/>
        <outline text="単独の所見で診断は確定しない">
          <outline text="丸い顔、肥満、毛髪減少はよくみられる"/>
          <outline text="識別力の高い組み合わせを重視"/>
        </outline>
      </outline>
      <outline text="甲状腺と下垂体の診察">
        <outline text="安静時と嚥下時に頸部を視診"/>
        <outline text="大きさ、硬さ、結節、リンパ節を触診">
          <outline text="血流増加の疑いがあれば血管雑音を聴取"/>
          <outline text="胸骨後方進展は小さくても圧迫症状"/>
        </outline>
        <outline text="頸部以外の甲状腺機能の影響"/>
        <outline text="グレーブス眼症は視力、視野、色覚、角膜">
          <outline text="視神経障害は緊急評価"/>
        </outline>
        <outline text="下垂体は対座法視野、瞳孔、脳神経"/>
        <outline text="下垂体卒中は頭痛と突然の視覚変化">
          <outline text="嘔吐、低血圧、意識変容"/>
        </outline>
        <outline text="先端巨大症は四肢末端、顔貌、睡眠時無呼吸"/>
      </outline>
      <outline text="糖尿病と足の評価">
        <outline text="血糖の推移、低血糖、ケトーシスの危険"/>
        <outline text="足の視診は胼胝、変形、潰瘍、履物"/>
        <outline text="動脈拍動、皮膚温、毛細血管再充満、虚血"/>
        <outline text="校正済みモノフィラメントで防御知覚"/>
        <outline text="リスク分類は対応につなげる">
          <outline text="教育、履物、足病診療、血管評価"/>
        </outline>
      </outline>
      <outline text="生殖および性に関する問診">
        <outline text="中立的な言葉と患者自身の表現"/>
        <outline text="アイデンティティから身体構造を推測しない"/>
        <outline text="月経、出血、帯下、避妊、安全"/>
        <outline text="産科歴はすべての妊娠と転帰"/>
        <outline text="妊娠中は出血、頭痛、胎動を確認"/>
        <outline text="男性は精巣、捻転、アンドロゲン使用">
          <outline text="精液所見は変動し、異常なら再検査"/>
        </outline>
      </outline>
      <outline text="内診および性器診察">
        <outline text="適応、明示的同意、プライバシー、立会人">
          <outline text="患者はいつでも一時停止・中止できる"/>
        </outline>
        <outline text="腟鏡診で腟と子宮頸部を観察し検体採取"/>
        <outline text="双合診は多くの疾患に感度が限定的"/>
        <outline text="硬い精巣内腫瘤は緊急超音波検査"/>
        <outline text="高位精巣を伴う突然の激痛は精巣捻転">
          <outline text="低価値の検査で遅らせず直ちに外科評価"/>
        </outline>
      </outline>
      <outline text="臨床検査の考え方">
        <outline text="まず疑われるホルモン軸を定める"/>
        <outline text="標的ホルモンと調節ホルモンを組み合わせる">
          <outline text="遊離サイロキシンと甲状腺刺激ホルモン"/>
          <outline text="カルシウムと副甲状腺ホルモン"/>
          <outline text="基準範囲内の調節ホルモンも不適切なことがある"/>
        </outline>
        <outline text="予想外の異常値は確認する">
          <outline text="採血時刻、絶食、月経周期、妊娠、結合蛋白"/>
          <outline text="ビオチン、異好抗体、フック効果"/>
          <outline text="臨床像と不一致なら検査室に相談"/>
        </outline>
        <outline text="負荷試験は予備能または抑制可能性を評価">
          <outline text="検査前確率と検証された判定閾値が必要"/>
        </outline>
      </outline>
      <outline text="生殖および妊娠に関する検査">
        <outline text="妊娠検査は絨毛性ゴナドトロピンを検出">
          <outline text="妊娠週数なしに一つの数値を解釈しない"/>
          <outline text="疼痛、不安定、腹膜刺激は異所性妊娠を緊急評価"/>
        </outline>
        <outline text="無月経はまず妊娠を除外"/>
        <outline text="超音波は構造、子宮鏡は別の問い"/>
        <outline text="不妊症は排卵、精液、卵管を並行評価">
          <outline text="卵巣予備能検査は刺激への反応を推定"/>
        </outline>
        <outline text="スクリーニングはリスク推定、診断は確定"/>
      </outline>
      <outline text="画像診断と組織診断">
        <outline text="病態仮説を立ててから画像検査"/>
        <outline text="超音波、磁気共鳴、断層撮影、核医学の役割">
          <outline text="妊娠中の放射線被曝と核医学の制限"/>
        </outline>
        <outline text="偶発病変は症状と無関係なことがある">
          <outline text="分泌、圧迫、悪性所見、増大を判断"/>
        </outline>
        <outline text="下垂体・副腎腫瘤は専門的検討なく生検しない"/>
      </outline>
      <outline text="緊急病態の認識">
        <outline text="副腎クリーゼ、甲状腺クリーゼ、ケトアシドーシス"/>
        <outline text="下垂体卒中、精巣捻転、異所性妊娠破裂、出血"/>
        <outline text="確定前に安定化処置と経験的治療">
          <outline text="遅延なく治療前に重要な検体を採取"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
