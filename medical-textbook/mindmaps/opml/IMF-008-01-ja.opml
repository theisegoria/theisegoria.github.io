<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>008-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="血行動態、血管調節、血圧">
      <outline text="循環が担う仕事">
        <outline text="酸素と栄養素を運び老廃物を除去する"/>
        <outline text="必要に応じた血流分配と十分な灌流圧"/>
        <outline text="動脈は拍動を緩衝し細動脈は抵抗を調節"/>
        <outline text="毛細血管は交換、静脈は貯留と還流"/>
        <outline text="リンパ管は液体と高分子を回収"/>
      </outline>
      <outline text="圧、流量、抵抗">
        <outline text="流量＝圧勾配÷抵抗"/>
        <outline text="抵抗は長さと粘性に正比例"/>
        <outline text="抵抗は半径の4乗に反比例"/>
        <outline text="直列は加算、並列は総抵抗を低下"/>
        <outline text="流速＝流量÷総断面積"/>
        <outline text="巨大な毛細血管断面積が通過を遅くする"/>
        <outline text="乱流は高流速、大径、急な狭窄で生じる"/>
        <outline text="雑音がなくても疾患は否定できない"/>
      </outline>
      <outline text="動脈圧と拍動">
        <outline text="脈圧＝収縮期血圧−拡張期血圧"/>
        <outline text="平均動脈圧≒拡張期血圧＋脈圧の3分の1"/>
        <outline text="平均圧は心拍出量と全身血管抵抗で決まる"/>
        <outline text="心拍出量＝心拍数×一回拍出量"/>
        <outline text="脈圧は一回拍出量とコンプライアンスに依存"/>
        <outline text="動脈硬化は脈波伝播速度と脈圧を上げる"/>
        <outline text="弾性反跳が駆出を連続的な血流へ平滑化"/>
      </outline>
      <outline text="細動脈と局所調節">
        <outline text="カルシウムがミオシン軽鎖キナーゼを活性化"/>
        <outline text="弛緩はカルシウム減少かホスファターゼ増加"/>
        <outline text="alpha one は収縮、beta two は骨格筋で拡張"/>
        <outline text="代謝性の血管拡張因子">
          <outline text="酸素低下、二酸化炭素と水素イオンの増加"/>
          <outline text="カリウム、アデノシンなどの代謝産物"/>
        </outline>
        <outline text="伸展に応じる筋原性自動調節が血流を安定化"/>
        <outline text="反応性充血は閉塞解除の後に起こる"/>
        <outline text="活動性充血は代謝の増加に伴う"/>
      </outline>
      <outline text="内皮のシグナル伝達">
        <outline text="ずり応力、ホルモン、炎症を感知する"/>
        <outline text="一酸化窒素が環状グアノシン一リン酸を増やす"/>
        <outline text="プロスタサイクリンは拡張と血小板抑制"/>
        <outline text="エンドセリンは収縮を起こす"/>
        <outline text="内皮機能障害で拡張と抗血栓の働きが低下"/>
      </outline>
      <outline text="毛細血管交換とリンパ">
        <outline text="拡散が溶質交換の大部分を担う">
          <outline text="脂溶性は膜を、水溶性は細胞間隙を通る"/>
          <outline text="速度は表面積と勾配に比例し距離に反比例"/>
        </outline>
        <outline text="静水圧は濾過、膠質浸透圧は吸収"/>
        <outline text="グリコカリックスと限定的な静脈端再吸収"/>
        <outline text="濾過がリンパ還流を上回ると浮腫">
          <outline text="静脈圧または毛細血管圧の上昇"/>
          <outline text="低アルブミンまたは透過性亢進"/>
          <outline text="リンパ管閉塞またはナトリウム貯留"/>
        </outline>
        <outline text="弁、筋運動、呼吸がリンパを推進"/>
      </outline>
      <outline text="静脈と静脈還流">
        <outline text="容量血管が血液量の多くを保持"/>
        <outline text="静脈緊張の小変化が血液を中枢へ移す"/>
        <outline text="還流は右心房への圧勾配に従う"/>
        <outline text="静脈収縮、筋ポンプ、呼吸、静脈弁が支える"/>
        <outline text="立位では心臓より下に血液が貯留"/>
        <outline text="不動は静脈うっ滞と血栓症を促す"/>
      </outline>
      <outline text="うっ血を臓器までさかのぼる">
        <outline text="臓器は受け取るだけでなく送り出す"/>
        <outline text="静脈圧の上昇は臓器の圧較差を狭める"/>
        <outline text="うっ血は間質への水分蓄積を促す"/>
        <outline text="高い中心静脈圧は腎機能悪化と関連する"/>
        <outline text="関連は単一の原因の証明ではない"/>
        <outline text="入れないのか、出られないのか、両方か"/>
      </outline>
      <outline text="急速および長期の圧調節">
        <outline text="頸動脈洞と大動脈弓の圧受容体"/>
        <outline text="昇圧時は副交感優位、交感神経は抑制"/>
        <outline text="再設定のため長期調節は担えない"/>
        <outline text="化学受容体は低酸素と酸性化に反応"/>
        <outline text="長期調節はナトリウムと腎機能に依存"/>
        <outline text="レニン分泌：低灌流、交感活性化、緻密斑"/>
        <outline text="アンジオテンシン two は収縮とナトリウム保持"/>
        <outline text="アルドステロン：ナトリウム保持とカリウム分泌"/>
        <outline text="抗利尿ホルモンは水を保持し血管を収縮"/>
        <outline text="ナトリウム利尿ペプチドは排泄と拡張を促す"/>
      </outline>
      <outline text="高血圧、低血圧、測定">
        <outline text="高血圧は多因子性で多くは無症状"/>
        <outline text="脳、腎、網膜、心臓を障害する"/>
        <outline text="二次性を疑う：若年、急な発症、抵抗性"/>
        <outline text="低血圧は臓器灌流が不十分なときに問題"/>
        <outline text="原因：容量、ポンプ、拡張、閉塞、自律神経"/>
        <outline text="カフサイズ、支持、安静、体位、反復測定"/>
        <outline text="家庭血圧と24時間測定で仮面高血圧を捉える"/>
      </outline>
    </outline>
  </body>
</opml>
