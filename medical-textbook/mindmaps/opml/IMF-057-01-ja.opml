<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>057-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="口腔・歯科疾患の基礎">
      <outline text="概説">
        <outline text="栄養、意思疎通、感染、慢性疾患に影響"/>
        <outline text="深頸部感染、敗血症、気道障害へ進行"/>
        <outline text="口腔病変は全身疾患を示す"/>
        <outline text="疼痛、不安、障害、文化に配慮"/>
      </outline>
      <outline text="口腔構造、唾液、微生物叢">
        <outline text="歯髄を囲む象牙質とエナメル質"/>
        <outline text="歯根膜が歯根を歯槽骨へ固定"/>
        <outline text="唾液腺は水、粘液、重炭酸、ミネラルを分泌"/>
        <outline text="副交感神経：大量の水様性唾液"/>
        <outline text="交感神経：蛋白質組成の変化"/>
        <outline text="唾液は緩衝、再石灰化、除去、微生物抑制">
          <outline text="分泌低下でう蝕、カンジダ症、歯周病"/>
          <outline text="抗コリン薬、オピオイド、放射線、多剤併用"/>
        </outline>
        <outline text="プラークは組織化されたバイオフィルム">
          <outline text="頻回の発酵性炭水化物で脱灰"/>
          <outline text="低pHの反復で空洞形成"/>
          <outline text="フッ化物は再石灰化を促す"/>
        </outline>
      </outline>
      <outline text="病歴と診察">
        <outline text="部位、誘発因子、夜間痛、腫脹、排液"/>
        <outline text="気道、流涎、声、頸部、全身毒性を直ちに確認"/>
        <outline text="顔面視診、顎関節・リンパ節・唾液腺触診"/>
        <outline text="開口量を測る"/>
        <outline text="咽頭後壁まで全粘膜を観察"/>
        <outline text="硬結、固定、動揺、波動、膿を記録"/>
      </outline>
      <outline text="う蝕、歯髄炎、歯性膿瘍">
        <outline text="初期う蝕は無痛のことがある"/>
        <outline text="可逆性歯髄炎：刺激で短時間の疼痛"/>
        <outline text="不可逆性歯髄炎：自発痛・持続痛">
          <outline text="根管治療または抜歯"/>
        </outline>
        <outline text="歯髄壊死で根尖感染が可能に">
          <outline text="根尖周囲膿瘍は瘻孔から排膿"/>
        </outline>
        <outline text="感染源処置が中心、抗菌薬は限定">
          <outline text="反復投与は治癒遅延と耐性選択"/>
        </outline>
        <outline text="非ステロイド性抗炎症薬とパラセタモール"/>
        <outline text="下顎大臼歯感染からルートヴィヒアンギーナ">
          <outline text="両側性の顎下・舌下蜂窩織炎"/>
          <outline text="口腔底腫脹、舌挙上、流涎"/>
          <outline text="仰臥位画像より先に気道計画"/>
        </outline>
      </outline>
      <outline text="歯周病">
        <outline text="歯肉炎：表在性、付着喪失なし、可逆的"/>
        <outline text="歯周炎：ポケット、付着喪失、骨破壊">
          <outline text="喫煙、糖尿病、免疫障害、遺伝"/>
          <outline text="歯肉退縮、動揺、歯の喪失"/>
        </outline>
        <outline text="プラーク除去、デブリードマン、危険因子管理"/>
        <outline text="血糖管理と歯周の健康は相互作用"/>
        <outline text="歯磨き時出血は炎症の徴候">
          <outline text="不釣り合いな出血は血小板・凝固・肝・骨髄"/>
        </outline>
      </outline>
      <outline text="口腔粘膜疾患">
        <outline text="アフタ：小水疱なしの反復性浅い潰瘍">
          <outline text="重症例は欠乏症、セリアック病、腸疾患"/>
        </outline>
        <outline text="再発性ヘルペスは角化粘膜に"/>
        <outline text="カンジダ症：除去できる白苔、紅斑、口角炎">
          <outline text="素因も治療する"/>
        </outline>
        <outline text="赤色病変は異形成リスクが高い"/>
        <outline text="持続病変は緊急評価と生検"/>
        <outline text="がん：タバコ、アルコール、ヒトパピローマウイルス"/>
        <outline text="全身症状を伴う広範な水疱は緊急"/>
        <outline text="新たな局所性色素沈着は評価"/>
      </outline>
      <outline text="唾液腺疾患">
        <outline text="細菌性唾液腺炎：有痛性腫脹、発熱、排膿">
          <outline text="水分、刺激、マッサージ、抗菌薬、排液"/>
        </outline>
        <outline text="結石は顎下腺管に最多">
          <outline text="食事に伴う疼痛と腫脹"/>
        </outline>
        <outline text="両側性持続性腫大は全身性原因"/>
        <outline text="シェーグレン：乾燥、う蝕、リンパ腫"/>
        <outline text="耳下腺腫瘍の多くは良性">
          <outline text="疼痛、固定、顔面筋力低下は悪性示唆"/>
          <outline text="専門的組織採取で手術計画を保つ"/>
        </outline>
      </outline>
      <outline text="歯の外傷と出血">
        <outline text="気道、頸椎、出血、視覚から評価"/>
        <outline text="脱落永久歯：歯冠を持ち再植">
          <outline text="乳歯は再植しない"/>
        </outline>
        <outline text="不正咬合、下口唇しびれ、複視は骨折">
          <outline text="盲目的な経鼻器具挿入を避ける"/>
        </outline>
        <outline text="抜歯後出血：圧迫、止血材、縫合">
          <outline text="中和前に抗血栓療法の適応を確認"/>
        </outline>
        <outline text="ドライソケット：血餅喪失、感染拡大なし"/>
      </outline>
      <outline text="顎関節および顔面痛">
        <outline text="関節・筋の疼痛、クリック音、開口制限"/>
        <outline text="説明、理学療法、非オピオイド鎮痛"/>
        <outline text="ロッキング、外傷、左右差で画像検査"/>
        <outline text="三叉神経痛：短い電撃痛発作"/>
        <outline text="視覚症状を伴う顎跛行は動脈炎"/>
      </outline>
      <outline text="予防と医学的に複雑な患者">
        <outline text="フッ化物、歯間清掃、遊離糖の頻度低減"/>
        <outline text="放射線や骨吸収抑制薬の前に口腔疾患治療"/>
        <outline text="顎骨壊死：がん用量と抜歯でリスク上昇"/>
        <outline text="心内膜炎予防は高リスク心疾患に限る"/>
        <outline text="複雑性はケアを怠る理由にならない"/>
      </outline>
    </outline>
  </body>
</opml>
