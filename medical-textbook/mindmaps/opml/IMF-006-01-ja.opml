<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>006-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="臨床推論、病歴、診察">
      <outline text="まず安全性と文脈">
        <outline text="患者は不安定か">
          <outline text="気道、呼吸仕事量、酸素化"/>
          <outline text="循環、精神状態、体温"/>
          <outline text="強い痛み、活動性出血"/>
        </outline>
        <outline text="一次評価は蘇生と並行する"/>
        <outline text="安定化と診断は同時に進める"/>
        <outline text="文脈が確率を変える">
          <outline text="年齢、妊娠、免疫状態"/>
          <outline text="最近の手術、渡航、職業"/>
          <outline text="薬剤、留置デバイス、既往疾患"/>
        </outline>
      </outline>
      <outline text="現病歴">
        <outline text="まず開かれた質問、次に焦点を絞った質問"/>
        <outline text="発症、部位、性状、重症度、放散"/>
        <outline text="時間経過、進行、増悪因子、軽快因子"/>
        <outline text="時系列はしばしば診断的">
          <outline text="突然の最大強度：血管イベント、破裂、閉塞、不整脈、けいれん、気胸"/>
          <outline text="発作性：間欠的閉塞、片頭痛、メディエーター放出、曝露"/>
          <outline text="進行性：構造的疾患、神経変性、悪性腫瘍、臓器不全"/>
        </outline>
        <outline text="患者の考え、恐れ、望む転帰"/>
        <outline text="睡眠、仕事、移動、セルフケアへの影響"/>
      </outline>
      <outline text="背景歴と薬剤歴">
        <outline text="病名ではなく重症度、合併症、コントロール"/>
        <outline text="家族歴：遺伝性疾患、若年性血管イベント"/>
        <outline text="社会歴：支援体制、職業、物質使用、曝露"/>
        <outline text="薬剤歴">
          <outline text="用量、経路、投与時刻、適応"/>
          <outline text="服薬遵守、有益性、有害作用、最近の変更"/>
          <outline text="市販薬と補完製品"/>
        </outline>
        <outline text="アレルギーは反応内容を確認する"/>
        <outline text="系統的問診は鑑別の検証に用いる"/>
      </outline>
      <outline text="仮説検証としての診察">
        <outline text="同意、尊厳、付き添い、感染対策"/>
        <outline text="触れる前に観察する"/>
        <outline text="バイタルサインは単独値でなくパターンで読む"/>
        <outline text="各徴候を解剖と機序に結びつける">
          <outline text="頸静脈圧上昇は手技に依存する"/>
          <outline text="捻髪音は一疾患に特異的でない"/>
          <outline text="筋力低下を痛み、努力、疲労と区別する"/>
        </outline>
        <outline text="信頼性は一様でなく、徴候は確率を変える"/>
      </outline>
      <outline text="問題表現">
        <outline text="患者背景、時間経過、主要症候群"/>
        <outline text="主な危険因子と識別に有用な所見"/>
        <outline text="不都合な所見を捨てない圧縮"/>
      </outline>
      <outline text="機序と解剖による鑑別">
        <outline text="血管性、感染性、炎症性、腫瘍性"/>
        <outline text="変性、中毒性、代謝性、内分泌性"/>
        <outline text="外傷性、閉塞性、医原性、先天性、機能性"/>
        <outline text="優先順位の問い">
          <outline text="最も可能性が高いもの"/>
          <outline text="見逃すと最も危険なもの"/>
          <outline text="最も治療可能または時間依存性のもの"/>
        </outline>
      </outline>
      <outline text="確率と診断検査">
        <outline text="検査前確率は有病率、臨床の場、危険因子、所見から"/>
        <outline text="感度：疾患を有する人のうち陽性となる割合"/>
        <outline text="特異度：疾患を有しない人のうち陰性となる割合"/>
        <outline text="尤度比はオッズを動かす"/>
        <outline text="予測値は有病率に依存する">
          <outline text="まれな疾患では偽陽性が上回る"/>
          <outline text="確率が高ければ陰性でも除外できない"/>
        </outline>
        <outline text="意思決定閾値の付近で最も情報価値が高い"/>
        <outline text="基準範囲は分布であり境界ではない"/>
      </outline>
      <outline text="認知エラーとキャリブレーション">
        <outline text="アンカリングと早期閉鎖"/>
        <outline text="確証バイアスと検索満足"/>
        <outline text="ベースレート無視とフレーミング効果"/>
        <outline text="診断のための立ち止まり">
          <outline text="ほかに何がありうるか"/>
          <outline text="どの所見が合わないか"/>
          <outline text="どの証拠が計画を変えるか"/>
        </outline>
        <outline text="キャリブレーション：除外ではなく残余確率を述べる"/>
        <outline text="フォローアップは診断の道具"/>
      </outline>
      <outline text="記録とコミュニケーション">
        <outline text="情報の出所と信頼性"/>
        <outline text="関連する陽性所見と陰性所見、不確実性、計画"/>
        <outline text="申し送り：状況、背景、危険、推奨"/>
        <outline text="重要な指示には閉ループ通信"/>
        <outline text="共同意思決定と決定ごとの意思能力"/>
      </outline>
    </outline>
  </body>
</opml>
