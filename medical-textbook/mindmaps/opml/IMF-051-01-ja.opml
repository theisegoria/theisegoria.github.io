<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>051-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="尿路疾患の基礎">
      <outline text="概説">
        <outline text="腎集合系から尿管を経て低圧の膀胱へ"/>
        <outline text="膀胱収縮と出口弛緩の協調で排出"/>
        <outline text="流出、蓄尿、排尿、尿禁制の障害"/>
        <outline text="直ちに対応すべき病態">
          <outline text="感染を伴う閉塞、急性尿閉、無尿"/>
          <outline text="重度の出血、精巣の緊急疾患"/>
          <outline text="急速に悪化する腎機能"/>
        </outline>
      </outline>
      <outline text="病歴と病変部位の推定">
        <outline text="尿管疝痛">
          <outline text="閉塞に逆らう蠕動"/>
          <outline text="変動の強い側腹部痛、鼠径部へ放散"/>
          <outline text="体を動かし、腹膜炎症は動かない"/>
        </outline>
        <outline text="発熱と持続性側腹部痛は上部尿路感染">
          <outline text="高齢者や免疫抑制では典型所見を欠く"/>
        </outline>
        <outline text="下部尿路症状の分類">
          <outline text="蓄尿症状は頻尿、尿意切迫、夜間頻尿"/>
          <outline text="排尿症状は排尿開始困難、尿勢低下"/>
          <outline text="排尿後症状は残尿感、排尿後尿滴下"/>
          <outline text="前立腺疾患と決めつけず定量化"/>
        </outline>
        <outline text="血尿の病歴">
          <outline text="抗凝固療法は顕在化させるが唯一の原因でない"/>
          <outline text="無痛性肉眼的血尿は悪性腫瘍を評価"/>
        </outline>
        <outline text="薬剤と尿閉">
          <outline text="抗コリン薬、オピオイド、交感神経刺激薬"/>
          <outline text="利尿薬と鎮静薬は尿失禁を悪化"/>
        </outline>
        <outline text="基礎の腎機能と単腎の確認"/>
      </outline>
      <outline text="診察">
        <outline text="バイタルサイン、水分状態、灌流、敗血症"/>
        <outline text="腹部の腫瘤、ヘルニア、膀胱膨隆"/>
        <outline text="肋骨脊柱角叩打痛は支持的だが非特異的"/>
        <outline text="同意、プライバシー、同席者で外性器診察"/>
        <outline text="精巣痛">
          <outline text="位置、腫脹、精巣挙筋反射"/>
          <outline text="精巣捻転では外科診察を遅らせない"/>
        </outline>
        <outline text="直腸指診">
          <outline text="大きさと閉塞の相関は弱い"/>
          <outline text="正常所見でもがんは除外できない"/>
          <outline text="急性前立腺炎で激しいマッサージを避ける"/>
        </outline>
        <outline text="脊髄・馬尾障害を疑えば神経診察"/>
      </outline>
      <outline text="尿検査と微生物学的検査">
        <outline text="試験紙は臨床状況と併せて解釈">
          <outline text="ヘムは赤血球、ヘモグロビン、ミオグロビン"/>
          <outline text="亜硝酸塩は硝酸塩還元と滞留時間が必要"/>
          <outline text="膿尿は炎症を示し原因は多様"/>
        </outline>
        <outline text="中間尿か採取ポート、バッグは不可"/>
        <outline text="妊娠、再発、複雑例で尿培養"/>
        <outline text="無症候性細菌尿は通常治療しない">
          <outline text="定着菌治療は有害作用と耐性を招く"/>
        </outline>
      </outline>
      <outline text="尿路感染症">
        <outline text="単純性膀胱炎は全身症状を伴わない">
          <outline text="腟症状は別の診断を示唆"/>
        </outline>
        <outline text="腎盂腎炎は発熱、側腹部痛、菌血症"/>
        <outline text="症候群、重症度、培養で抗菌薬選択"/>
        <outline text="治療失敗は閉塞、膿瘍、耐性、服薬"/>
        <outline text="カテーテルは防御を迂回しバイオフィルム">
          <outline text="混濁尿でなく症状で診断"/>
          <outline text="予防は回避、無菌、閉鎖系、抜去"/>
        </outline>
      </outline>
      <outline text="閉塞と尿閉">
        <outline text="上流の圧力上昇">
          <outline text="濾過低下と濃縮障害"/>
          <outline text="感染と最終的な腎萎縮"/>
        </outline>
        <outline text="両側性や単腎では無痛の無尿"/>
        <outline text="慢性尿閉は無痛のことがある">
          <outline text="超音波で排尿後残尿量を測定"/>
        </outline>
        <outline text="困難な挿入は経験ある支援を求める">
          <outline text="盲目的な反復は偽尿道を形成"/>
        </outline>
        <outline text="閉塞解除後利尿">
          <outline text="塩分と水の排泄、または濃縮障害"/>
          <outline text="適切な割合を補充"/>
        </outline>
      </outline>
      <outline text="尿路結石">
        <outline text="過飽和を尿量、pH、阻害物質が修飾"/>
        <outline text="画像検査">
          <outline text="非造影コンピュータ断層撮影は感度が高い"/>
          <outline text="超音波は妊娠中の被曝を避ける"/>
        </outline>
        <outline text="鎮痛薬、制吐薬、欠乏の補正">
          <outline text="過剰な水分で結石は押し流せない"/>
        </outline>
        <outline text="感染を伴う閉塞は緊急事態">
          <outline text="抗菌薬とステントまたは腎瘻"/>
          <outline text="根治的治療は状態安定後"/>
        </outline>
        <outline text="尿量と原因に応じた予防">
          <outline text="食事中カルシウムは排除しない"/>
        </outline>
      </outline>
      <outline text="血尿と泌尿器がん">
        <outline text="真の血尿を確認し糸球体性所見を評価"/>
        <outline text="血塊は非糸球体性出血を示唆">
          <outline text="血塊は尿流出路を閉塞し得る"/>
        </outline>
        <outline text="年齢とリスクで画像と膀胱鏡"/>
        <outline text="膀胱がんは喫煙と職業性曝露に関連"/>
        <outline text="前立腺特異抗原は臓器特異的"/>
      </outline>
      <outline text="尿失禁と神経因性膀胱">
        <outline text="機序">
          <outline text="腹圧性は腹圧が尿道閉鎖圧を上回る"/>
          <outline text="切迫性、溢流性、機能性、混在が多い"/>
        </outline>
        <outline text="排尿日誌、残尿量、選択的尿流動態検査"/>
        <outline text="まず可逆的な要因を治療"/>
        <outline text="骨盤底筋訓練は腹圧性の第一選択"/>
        <outline text="抗ムスカリン薬は口腔乾燥、意識混乱、尿閉"/>
        <outline text="神経因性は低圧蓄尿で腎機能を保護"/>
      </outline>
    </outline>
  </body>
</opml>
