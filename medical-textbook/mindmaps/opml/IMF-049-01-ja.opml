<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>049-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="消化器系評価の基礎">
      <outline text="概説">
        <outline text="症状を解剖学的・生理学的モデルへ変換"/>
        <outline text="同時にベッドサイドで緊急度を判断"/>
        <outline text="各症状は良性から悪性まで生じ得る"/>
        <outline text="最も安全な方法">
          <outline text="発症と経過を定義"/>
          <outline text="可能性の高い区画を局在"/>
          <outline text="水分状態と灌流を評価"/>
          <outline text="腹膜炎または閉塞を探す"/>
          <outline text="検査は明確な問いに答える"/>
        </outline>
      </outline>
      <outline text="症状の病歴">
        <outline text="疼痛：発症、部位、放散、性状、疝痛">
          <outline text="内臓痛は自律神経求心路共有で正中びまん性"/>
          <outline text="壁側腹膜炎症は鋭い局在痛と筋性防御"/>
          <outline text="疼痛移動は有用だがパターンは不完全"/>
          <outline text="突然最大の疼痛は緊急評価"/>
        </outline>
        <outline text="嘔吐：量、色、胆汁、血液、便臭">
          <outline text="反復嘔吐で塩化物と水素イオン喪失">
            <outline text="収縮性アルカローシス、カリウム欠乏、腎障害"/>
          </outline>
          <outline text="便臭性嘔吐は遠位閉塞または瘻孔"/>
          <outline text="逆流および反芻と区別"/>
        </outline>
        <outline text="嚥下障害：開始、固形物、液体、進行"/>
        <outline text="ディスペプシアは症状群で最終診断でない"/>
        <outline text="排便習慣：基準、血液、夜間、脂肪便">
          <outline text="表面の鮮血も混在血も近位病変を除外せず"/>
          <outline text="鉄とビスマスは出血なしに便を暗くする"/>
        </outline>
        <outline text="黄疸：尿、便、痒み、曝露">
          <outline text="慢性肝疾患の可能性があれば関連症状"/>
        </outline>
      </outline>
      <outline text="背景とリスク">
        <outline text="手術、ヘルニア、腸疾患、癌、妊娠"/>
        <outline text="手術歴は癒着リスクを高めるが証明せず"/>
        <outline text="薬剤は潰瘍、出血、運動異常を生じる">
          <outline text="抗炎症薬、抗血栓薬、オピオイドを確認"/>
        </outline>
        <outline text="食事は中立的かつ具体的に尋ねる"/>
        <outline text="家族歴：癌、ポリポーシス、炎症性疾患"/>
        <outline text="社会歴：衛生、渡航、住居、ストーマ管理"/>
      </outline>
      <outline text="即時の生理学的評価">
        <outline text="吐血または意識低下による気道リスク"/>
        <outline text="呼吸、脈拍、血圧、再充満、精神状態"/>
        <outline text="ショック、敗血症、出血、穿孔、閉塞を探す"/>
        <outline text="早期の正常ヘモグロビンは大量出血を除外せず">
          <outline text="血漿と赤血球が同時に失われる"/>
        </outline>
      </outline>
      <outline text="全身および腹部診察">
        <outline text="苦痛、筋萎縮、蒼白、黄疸を観察"/>
        <outline text="手：ばち指、手掌紅斑、羽ばたき振戦"/>
        <outline text="慢性肝疾患徴候は文脈を支持するのみ"/>
        <outline text="尊厳を守り下胸部から鼠径部まで露出"/>
        <outline text="腸雑音の診断精度は限られる"/>
        <outline text="疼痛部位から離れ優しく触診、顔を観察">
          <outline text="随意性筋性防御と不随意性硬直"/>
          <outline text="腹膜刺激が示されれば反跳痛は不要"/>
          <outline text="動脈瘤疑いで強い触診をしない"/>
        </outline>
        <outline text="移動性濁音は超音波より感度が低い"/>
        <outline text="直腸指診は治療を変える場合のみ"/>
        <outline text="腹腔外も診察する"/>
      </outline>
      <outline text="基本検査">
        <outline text="検査は症候群に従う"/>
        <outline text="血球数、電解質、血液ガス、肝機能検査"/>
        <outline text="推移と検査前確率で解釈">
          <outline text="乳酸正常は早期腸間膜虚血を除外せず"/>
          <outline text="軽度リパーゼ上昇は膵炎以外でも生じる"/>
          <outline text="便潜血は出血部位を示さない"/>
        </outline>
        <outline text="便検査は炎症所見、集団発生、渡航で"/>
      </outline>
      <outline text="画像診断と内視鏡">
        <outline text="腹部単純画像：適応は限られる"/>
        <outline text="立位胸部画像陰性でも穿孔あり得る"/>
        <outline text="超音波は胆石、胆道、腹水に適する"/>
        <outline text="コンピュータ断層は閉塞、穿孔を評価"/>
        <outline text="出血や虚血には緊急の血管造影"/>
        <outline text="内視鏡は観察、生検、治療を行う">
          <outline text="狭窄でカプセルが滞留し得る"/>
          <outline text="逆行性胆道膵管造影は主に治療目的"/>
        </outline>
      </outline>
      <outline text="急性疼痛と外科コンサルテーション">
        <outline text="蘇生と診断を同時に進める"/>
        <outline text="反復診察なら鎮痛で所見は隠れない"/>
        <outline text="時間依存性疾患は早期に外科へ"/>
        <outline text="直ちにエスカレーションする病態">
          <outline text="腹膜刺激徴候、遊離ガス、絞扼、虚血"/>
          <outline text="動脈瘤破裂、異所性妊娠、捻転"/>
        </outline>
        <outline text="フレイル、妊娠、免疫抑制で徴候乏しい"/>
        <outline text="治療後の再評価も診断の一部"/>
      </outline>
    </outline>
  </body>
</opml>
