<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>076-02 上肢の骨、関節、筋、血管、神経</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="上肢の解剖">
      <outline text="骨性安定性より可動性">
        <outline text="到達範囲、方向付け、操作性"/>
        <outline text="可動性肩甲骨と浅い肩関節窩"/>
        <outline text="区画、作用、経路、損傷部位から学ぶ"/>
      </outline>
      <outline text="肩帯と体軸骨格への接続">
        <outline text="鎖骨は体幹との唯一の骨性接続">
          <outline text="弯曲が肩を胸郭から離す"/>
          <outline text="骨折は血管、神経叢、肺を脅かす"/>
        </outline>
        <outline text="関節窩は浅く関節唇で深くなる"/>
        <outline text="肩甲胸郭運動は筋が作る"/>
        <outline text="烏口鎖骨靱帯が上肢を懸垂">
          <outline text="破綻で肩鎖分離と力学変化"/>
        </outline>
        <outline text="挙上は肩甲上腕と肩甲骨運動の組合せ">
          <outline text="肩甲上腕リズムは固定比ではない"/>
          <outline text="前鋸筋・僧帽筋低下が上方回旋を乱す"/>
        </outline>
      </outline>
      <outline text="肩の動的安定化">
        <outline text="関節窩に比べ大きい上腕骨頭"/>
        <outline text="静的は関節唇、関節包、靱帯、陰圧"/>
        <outline text="動的は腱板の圧着と肩甲骨筋">
          <outline text="棘上筋は外転を開始・支持"/>
          <outline text="棘下筋と小円筋は外旋"/>
          <outline text="肩甲下筋は内旋"/>
        </outline>
        <outline text="外転・外旋位で前下方脱臼">
          <outline text="外科頸付近で腋窩神経が脆弱"/>
          <outline text="反復は関節唇剥離、骨頭圧潰"/>
        </outline>
        <outline text="肩峰下の挙上時痛は原因が多様">
          <outline text="肩峰形状だけでは因果関係を示さない"/>
        </outline>
      </outline>
      <outline text="上腕と肘窩">
        <outline text="筋間中隔が屈筋・伸筋区画を分ける"/>
        <outline text="筋皮神経が上腕前方筋を支配"/>
        <outline text="橈骨神経は上腕深動脈と橈骨神経溝へ">
          <outline text="上腕骨骨幹部損傷で危険"/>
        </outline>
        <outline text="上腕動脈は橈骨・尺骨動脈へ分岐"/>
        <outline text="肘窩の内容は外側から">
          <outline text="二頭筋腱、上腕動脈、正中神経"/>
          <outline text="腱膜が静脈穿刺時に深部を保護"/>
        </outline>
        <outline text="側副靱帯が外反・内反へ抵抗">
          <outline text="輪状靱帯が橈骨頭を保持"/>
        </outline>
      </outline>
      <outline text="前腕回旋と区画">
        <outline text="回内で橈骨が尺骨を横切る"/>
        <outline text="骨間膜は荷重を伝え区画を分ける"/>
        <outline text="前方屈筋の大半は正中神経">
          <outline text="尺側手根屈筋と深指屈筋内側部は尺骨"/>
          <outline text="前骨間神経は長母指屈筋、方形回内筋"/>
        </outline>
        <outline text="後方伸筋と回外筋は橈骨神経">
          <outline text="深枝は回外筋を通り後骨間神経"/>
          <outline text="圧迫で感覚低下乏しい伸展低下"/>
        </outline>
        <outline text="掌動脈弓は変異し側副循環を評価"/>
      </outline>
      <outline text="手関節と手根管">
        <outline text="舟状骨は両列を橋渡し">
          <outline text="伸展手への転倒"/>
          <outline text="逆行性血流で近位極壊死の危険"/>
        </outline>
        <outline text="手根管は正中神経と九本の屈筋腱"/>
        <outline text="尺骨神経・動脈はギヨン管"/>
        <outline text="正中神経圧迫は外側三指半">
          <outline text="母指球筋と外側虫様筋の低下"/>
          <outline text="掌皮枝は浅層で掌感覚が保たれ得る"/>
        </outline>
      </outline>
      <outline text="手の力学と神経支配">
        <outline text="中手指節関節の側副靱帯は屈曲で緊張"/>
        <outline text="虫様筋は中手指節屈曲と指節間伸展"/>
        <outline text="背側骨間筋は外転、掌側は内転"/>
        <outline text="正中神経は精密操作を与える"/>
        <outline text="尺骨神経は大半の内在筋で強い握り"/>
        <outline text="橈骨神経は手内在筋を支配しない"/>
        <outline text="浅指屈筋は中節骨、深指屈筋は末節骨">
          <outline text="槌指、ボタン穴、ジャージー指"/>
        </outline>
      </outline>
      <outline text="腕神経叢">
        <outline text="C5からT1の前枝">
          <outline text="神経幹は前・中斜角筋間"/>
          <outline text="前後区は鎖骨後方、束は腋窩動脈周囲"/>
        </outline>
        <outline text="神経根病変は複数神経の一部へ影響"/>
        <outline text="上神経幹は肩外転・外旋、肘屈曲"/>
        <outline text="下神経幹は手内在筋、ホルネル症候群"/>
        <outline text="長胸神経は前鋸筋低下と内側翼状化"/>
      </outline>
      <outline text="外傷と圧迫">
        <outline text="外科頸骨折は腋窩神経"/>
        <outline text="上腕骨骨幹部骨折は橈骨神経"/>
        <outline text="内側上顆損傷は尺骨神経"/>
        <outline text="顆上骨折は上腕動脈と正中神経系"/>
        <outline text="前腕区画圧は手灌流を危険にする">
          <outline text="神経血管診察を反復"/>
        </outline>
        <outline text="胸郭出口は斜角筋、肋鎖間隙、小胸筋下">
          <outline text="誘発試験は非特異的"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
