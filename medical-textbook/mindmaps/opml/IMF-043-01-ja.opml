<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>043-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="加齢、フレイル、多剤併用、高齢者総合評価">
      <outline text="概説と加齢による生理変化">
        <outline text="暦年齢は予備能を規定しない">
          <outline text="疾患、不活動、栄養、環境が喪失を決める"/>
        </outline>
        <outline text="動脈硬化と心房収縮への依存">
          <outline text="アドレナリン反応と圧受容器反射の低下"/>
          <outline text="運動予備能低下、起立性低血圧増加"/>
        </outline>
        <outline text="肺は弾性収縮力、除去能、咳嗽力を失う">
          <outline text="誤嚥と感染のリスクが高まる"/>
        </outline>
        <outline text="正常クレアチニンでも濾過低下が隠れる"/>
        <outline text="総体水分量と除脂肪量減少、脂肪増加">
          <outline text="水溶性は高濃度、脂溶性は残存"/>
        </outline>
        <outline text="認知症は正常加齢ではない"/>
      </outline>
      <outline text="フレイルとサルコペニア">
        <outline text="複数臓器系のストレス脆弱性"/>
        <outline text="身体的表現型または欠損蓄積">
          <outline text="転倒、せん妄、障害、死亡を予測"/>
        </outline>
        <outline text="フレイルは動的で改善し得る">
          <outline text="尺度で機械的に治療を拒否しない"/>
        </outline>
        <outline text="サルコペニアは筋量より筋力">
          <outline text="レジスタンス運動、栄養、原因治療"/>
        </outline>
      </outline>
      <outline text="高齢者総合機能評価">
        <outline text="多領域を協調的計画にまとめる"/>
        <outline text="基本的、次に手段的日常生活動作">
          <outline text="基準状態からの低下は鋭敏な徴候"/>
        </outline>
        <outline text="移乗、歩行、履物、住環境を観察"/>
        <outline text="介護者を参加させ本人に話しかける">
          <outline text="個別面談で虐待や強要を検出"/>
        </outline>
      </outline>
      <outline text="非典型的な疾患の現れ方">
        <outline text="せん妄、転倒、不動、機能低下"/>
        <outline text="発熱や白血球増多のない感染"/>
        <outline text="息切れや混乱で現れる心筋梗塞"/>
        <outline text="新しい症状を年齢のせいにしない">
          <outline text="軽度の侵襲が重なり重度せん妄"/>
        </outline>
      </outline>
      <outline text="せん妄、認知症、うつ病">
        <outline text="せん妄は急性で変動する不注意">
          <outline text="低活動型は見逃されやすい"/>
          <outline text="素因と誘因"/>
        </outline>
        <outline text="原因治療と感覚、睡眠の保護">
          <outline text="抗精神病薬はせん妄を治癒しない"/>
        </outline>
        <outline text="認知症は自立を妨げる慢性低下"/>
        <outline text="うつ病は認知障害に類似し悪化させる"/>
        <outline text="検査は教育、文化、感覚の影響を受ける"/>
      </outline>
      <outline text="転倒と移動能力">
        <outline text="通常は多因子性"/>
        <outline text="前駆症状、意識消失、床上時間を問う"/>
        <outline text="臥位・立位血圧、歩行、足を診察"/>
        <outline text="複数の予防策を組み合わせる">
          <outline text="恐怖による不活動はリスクを高める"/>
        </outline>
        <outline text="転倒後は外傷と回復不能の理由">
          <outline text="抗凝固療法中は画像閾値を下げる"/>
        </outline>
      </outline>
      <outline text="多剤併用と減薬">
        <outline text="薬剤数より適切性"/>
        <outline text="処方カスケードは有害作用を治療する"/>
        <outline text="分布が大きく変わり腎排泄は低下"/>
        <outline text="鎮静薬、オピオイドへの感受性増加"/>
        <outline text="ケア移行時に全製品を照合"/>
        <outline text="害が利益を上回れば減薬">
          <outline text="一部の薬剤は漸減を要する"/>
          <outline text="予防薬中止はケア放棄ではない"/>
        </outline>
      </outline>
      <outline text="栄養、嚥下、排泄自制">
        <outline text="体重減少の原因は多様">
          <outline text="アルブミンは単独の栄養指標でない"/>
        </outline>
        <outline text="嚥下障害は誤嚥と栄養不良を招く">
          <outline text="食形態変更は安全と楽しみの交換"/>
        </outline>
        <outline text="一過性と慢性の失禁">
          <outline text="カテーテルは感染と外傷を生む"/>
        </outline>
      </outline>
      <outline text="意思決定能力、目標、事前ケア">
        <outline text="個別の決定と時点に特異的"/>
        <outline text="理解、保持、比較衡量、伝達"/>
        <outline text="能力判断前に伝達を支援する">
          <outline text="賢明でない選択だけでは能力欠如でない"/>
        </outline>
        <outline text="事前指示と指定された意思決定者"/>
        <outline text="目標は予後と重視する転帰を結ぶ"/>
      </outline>
      <outline text="リハビリテーションとケア移行">
        <outline text="入院は廃用を生じる"/>
        <outline text="移動、食事、感覚、睡眠を早期に回復"/>
        <outline text="課題特異的なリハビリ目標"/>
        <outline text="退院の安全性は機能に依存する">
          <outline text="再入院はサービス間の断絶から"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
