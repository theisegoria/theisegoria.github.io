<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>071-03 管理、モニタリング、予防、安全、倫理、医療システム、長期継続ケア</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="プライマリ・ケアの長期管理">
      <outline text="疾患目標より先に目標を定める">
        <outline text="過大な負担なく予防可能な害を減らす">
          <outline text="各項目に目的、再評価、中止基準"/>
        </outline>
        <outline text="本人が最も大切にすることから始める">
          <outline text="価値観を測定可能な目標へ"/>
        </outline>
        <outline text="共同意思決定でも明確に推奨する"/>
        <outline text="害が利益を上回れば目標を緩和">
          <outline text="年齢だけで有効治療を除外しない"/>
        </outline>
        <outline text="責任者を明示した一つの統合計画">
          <outline text="患者だけを情報伝達手段にしない"/>
        </outline>
      </outline>
      <outline text="変動する曝露としてのポリファーマシー">
        <outline text="実際に服用している薬を確認">
          <outline text="薬の整理方法と飲み忘れを尋ねる"/>
        </outline>
        <outline text="処方カスケード">
          <outline text="有害作用を新しい疾患と誤認し治療"/>
          <outline text="新症状を薬の変更と時間的に照合"/>
        </outline>
        <outline text="害が利益を上回れば減薬">
          <outline text="適応なし、重複、高リスク併用"/>
          <outline text="漸減、少数ずつ変更、転帰を追跡"/>
        </outline>
        <outline text="移行期は高リスク">
          <outline text="中止、開始、変更を照合し説明"/>
          <outline text="服薬支援器具は意図的不使用を解決しない"/>
        </outline>
      </outline>
      <outline text="問いに答えるモニタリング">
        <outline text="制御、毒性、服薬状況、進行"/>
        <outline text="間隔は変化速度、安定性、行動可能性">
          <outline text="頻回は偶然変動、過少は悪化を見逃す"/>
        </outline>
        <outline text="処方更新だけでない疾患別レビュー"/>
        <outline text="家庭測定：主体性と不安">
          <outline text="妥当な機器と対応経路"/>
          <outline text="ウェアラブルは偽警報を生む"/>
        </outline>
      </outline>
      <outline text="絶対利益に基づく予防">
        <outline text="生涯にわたり予防ケアを見直す">
          <outline text="まとめても主訴を押しのけない"/>
        </outline>
        <outline text="禁煙はどの年齢でも利益"/>
        <outline text="偏見を避けた体重への助言"/>
        <outline text="具体的な運動処方"/>
        <outline text="検診は余命と過剰診断を考慮">
          <outline text="中止が生命の価値を否定しない"/>
        </outline>
      </outline>
      <outline text="摩擦を減らす治療実行支援">
        <outline text="意図的、非意図的、構造的">
          <outline text="道徳的非難でなく障壁の診断"/>
        </outline>
        <outline text="服用簡素化、再処方調整、薬剤師関与"/>
        <outline text="ティーチバックと動機づけ面接"/>
        <outline text="発作性疾患の書面の行動計画">
          <outline text="平常状態、警告徴候、手順、受診時期"/>
        </outline>
      </outline>
      <outline text="紹介と移行">
        <outline text="紹介状に問い、緊急度、目標を記す"/>
        <outline text="受け入れまで紹介元が責任を持つ">
          <outline text="橋渡しケアとエスカレーション基準"/>
        </outline>
        <outline text="勧告を全人的計画と照合"/>
        <outline text="退院直後は高リスク">
          <outline text="早期連絡で症状、薬、支援を確認"/>
        </outline>
        <outline text="多職種ケアには明確な役割"/>
      </outline>
      <outline text="デジタル診療とアクセス">
        <outline text="遠隔診療は全診察を代替できない">
          <outline text="本人確認、所在地、プライバシー"/>
        </outline>
        <outline text="ポータルは一部の人を排除し得る">
          <outline text="緊急症状を非同期通信に依存させない"/>
        </outline>
        <outline text="自動化された要約は検証を要する"/>
        <outline text="予約欠席は臨床情報">
          <outline text="相応の働きかけ"/>
        </outline>
      </outline>
      <outline text="関係倫理">
        <outline text="温かさと専門的限界の両立"/>
        <outline text="家族と地域での守秘義務"/>
        <outline text="過誤と診断遅延の正直な開示">
          <outline text="不安なくセカンドオピニオンや苦情"/>
        </outline>
        <outline text="同意に基づく介護者関与">
          <outline text="介護者の健康は別に評価"/>
        </outline>
        <outline text="能力変化：法的経路と従前の価値観"/>
      </outline>
      <outline text="機能と患者経験による成功評価">
        <outline text="バイオマーカーを超えた転帰">
          <outline text="転倒するなら検査値低下は成功でない"/>
        </outline>
        <outline text="全計画の定期的見直し">
          <outline text="何を中止できるか尋ねる"/>
        </outline>
        <outline text="予測的ケアと事前ケア計画"/>
        <outline text="循環：優先、行動、測定、簡素化、改訂"/>
      </outline>
    </outline>
  </body>
</opml>
