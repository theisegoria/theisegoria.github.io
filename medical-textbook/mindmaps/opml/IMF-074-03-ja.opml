<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>074-03 管理、モニタリング、予防、安全、倫理、医療システム、長期継続ケア</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="希少性下の管理">
      <outline text="必須蘇生">
        <outline text="気道は体位、吸引、バッグ・マスクから">
          <outline text="二人のマスク換気が早期挿管より安全"/>
        </outline>
        <outline text="酸素は有限の薬">
          <outline text="濃縮器は電力を要し高地で変化"/>
          <outline text="滴定し漏れを修正し残量監視"/>
        </outline>
        <outline text="大量晶質液より止血を優先">
          <outline text="歩行供血者は事前手順を要する"/>
        </outline>
        <outline text="輸液はショックと脱水を区別">
          <outline text="腸管が機能すれば経口補水"/>
          <outline text="少量介入ごとに再評価"/>
        </outline>
      </outline>
      <outline text="感染予防と治療">
        <outline text="清潔水と衛生が抗菌薬配布に勝る"/>
        <outline text="清潔・汚染動線の分離"/>
        <outline text="経験的手順は地域耐性を反映">
          <outline text="無差別な投与は耐性を促す"/>
          <outline text="感染源制御は不可欠"/>
        </outline>
        <outline text="比例的で実行可能な隔離">
          <outline text="強制は隠蔽を招く"/>
        </outline>
      </outline>
      <outline text="避難・搬送">
        <outline text="気道、止血、固定、鎮痛で安定化"/>
        <outline text="搬送生理は低い機内圧と騒音"/>
        <outline text="搬送先は必要能力と収容力で選ぶ">
          <outline text="直接搬送か最寄り蘇生施設か"/>
        </outline>
        <outline text="電子障害後も残る搬送記録"/>
      </outline>
      <outline text="倫理的配分">
        <outline text="危機前に公開して手順策定"/>
        <outline text="社会的価値、富、人種を除外">
          <outline text="年齢を検討なしの一律除外にしない"/>
        </outline>
        <outline text="配分判断を患者擁護から分離"/>
        <outline text="差し控えと中止は同等になり得る">
          <outline text="中止は感情的に難しい"/>
        </outline>
        <outline text="障害は臨床予後で評価">
          <outline text="配分道具の構造的バイアス監査"/>
        </outline>
      </outline>
      <outline text="救助者保護と人員">
        <outline text="防護具、予防接種、休息、警備"/>
        <outline text="ケア義務にも限界">
          <outline text="組織は相互的保護を負う"/>
        </outline>
        <outline text="勤務表は睡眠と概日生理を尊重"/>
        <outline text="強制的振り返りより機密支援"/>
        <outline text="業務範囲調整でも監督は不可欠">
          <outline text="統合されないボランティアは危険"/>
        </outline>
      </outline>
      <outline text="薬、機器、供給網">
        <outline text="必須医薬品一覧">
          <outline text="消費速度、期限、低温流通を追跡"/>
          <outline text="代替手順が場当たり的換算を防ぐ"/>
        </outline>
        <outline text="機器は現地で維持可能に">
          <outline text="互換性のない寄贈は制度を圧迫"/>
        </outline>
        <outline text="事前配置は遅延減少と期限切れ"/>
        <outline text="兵站データは臨床データ"/>
      </outline>
      <outline text="慢性、母子、精神医療">
        <outline text="簡素化し急な中止を避ける">
          <outline text="ステロイド、インスリン、抗発作薬、オピオイド"/>
        </outline>
        <outline text="補充地点と紙の要約"/>
        <outline text="母子サービスと性と生殖の医療">
          <outline text="暴力と意図しない妊娠が増え得る"/>
        </outline>
        <outline text="心理的応急処置と重症疾患の継続">
          <outline text="地域支援を置き換えず強化"/>
        </outline>
      </outline>
      <outline text="復旧、強靱性、公平性">
        <outline text="復旧は建物以上を回復"/>
        <outline text="人道データは目的限定と最小限">
          <outline text="侵害は暴力や拘禁へ曝す"/>
        </outline>
        <outline text="体系的に見落とされる人を評価"/>
        <outline text="並行制度より現地調達"/>
        <outline text="資金と責任者を伴う事後レビュー"/>
        <outline text="より良く再建する">
          <outline text="復旧資金で不公平を再生産しない"/>
        </outline>
      </outline>
      <outline text="説明責任を伴う柔軟性">
        <outline text="変更基準は正式に発動し終了">
          <outline text="通常診療が不可能な理由を記録"/>
        </outline>
        <outline text="希少性は差別を正当化しない"/>
        <outline text="同意と守秘義務は続く"/>
        <outline text="準備が即興の必要を減らす"/>
      </outline>
    </outline>
  </body>
</opml>
