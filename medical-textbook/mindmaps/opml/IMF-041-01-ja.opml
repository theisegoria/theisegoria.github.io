<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>041-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="多臓器自己免疫疾患と血管炎">
      <outline text="概説と免疫寛容の喪失">
        <outline text="診断は表現型と臓器障害に基づく">
          <outline text="自己抗体は確率を変えるのみ"/>
        </outline>
        <outline text="中枢性寛容は自己反応細胞を除去・編集"/>
        <outline text="末梢性寛容は逃れた細胞を抑える">
          <outline text="アネルギー、制御性T細胞、抑制性受容体"/>
        </outline>
        <outline text="誘因は感染、紫外線、喫煙、薬剤">
          <outline text="分子模倣、エピトープ拡大、傍観者活性化"/>
        </outline>
        <outline text="遺伝的リスク、環境、偶然の相互作用"/>
        <outline text="複数の損傷機序が同時に存在し得る"/>
      </outline>
      <outline text="自己抗体の解釈">
        <outline text="検査前確率が正当化する時のみ測定"/>
        <outline text="抗核抗体は健康者にもみられる">
          <outline text="抗体価と染色パターンは診断を確立しない"/>
        </outline>
        <outline text="抗二本鎖デオキシリボ核酸抗体と補体">
          <outline text="ループス腎炎活動性に対応し得る"/>
        </outline>
        <outline text="抗Ro抗体は妊娠に重要な意味を持つ"/>
        <outline text="抗好中球細胞質抗体は類似疾患にも出現"/>
        <outline text="炎症マーカーは非特異的で正常もあり得る">
          <outline text="沈渣、補体、画像、生検が損傷を示す"/>
        </outline>
      </outline>
      <outline text="全身性エリテマトーデス">
        <outline text="免疫複合体、補体、インターフェロン信号"/>
        <outline text="皮疹、潰瘍、非びらん性関節炎、漿膜炎"/>
        <outline text="腎病変は無症候性であり得る">
          <outline text="血圧、クレアチニン、沈渣、蛋白で検出"/>
          <outline text="生検で機序と活動性を分類"/>
        </outline>
        <outline text="神経症状は感染、血栓症、薬剤を除外"/>
        <outline text="ヒドロキシクロロキンは再燃を減らす">
          <outline text="体重に基づく投与と網膜監視"/>
        </outline>
      </outline>
      <outline text="抗リン脂質抗体症候群">
        <outline text="抗体持続陽性と血栓症または妊娠合併症">
          <outline text="抗体だけでは症候群を確定しない"/>
          <outline text="抗凝固薬と急性疾患が検査に影響"/>
        </outline>
        <outline text="劇症型は急速な多臓器小血管血栓症">
          <outline text="抗凝固療法、免疫調節、誘因治療"/>
        </outline>
        <outline text="長期戦略は事象、抗体、出血リスクで決定"/>
      </outline>
      <outline text="全身性強皮症">
        <outline text="血管障害、免疫活性化、進行性線維化"/>
        <outline text="レイノー現象と手指腫脹が皮膚硬化に先行"/>
        <outline text="間質性肺疾患と肺動脈性肺高血圧が主要死因">
          <outline text="体系的スクリーニングを要する"/>
        </outline>
        <outline text="腎クリーゼは突然の高血圧と腎障害">
          <outline text="緊急のアンジオテンシン変換酵素阻害薬"/>
          <outline text="高用量糖質コルチコイドはリスクを高める"/>
        </outline>
        <outline text="線維化でなく各臓器機序を標的とする"/>
      </outline>
      <outline text="シェーグレン病">
        <outline text="眼乾燥は異物感と角膜損傷"/>
        <outline text="口腔乾燥はう蝕、カンジダ症、腺腫大"/>
        <outline text="薬剤、脱水、糖尿病、加齢も乾燥に類似"/>
        <outline text="代替物、歯科予防、全身免疫調節"/>
        <outline text="唾液腺腫大、紫斑、低補体はリンパ腫懸念"/>
      </outline>
      <outline text="炎症性ミオパチー">
        <outline text="進行性近位筋・頸部筋力低下、嚥下障害"/>
        <outline text="抗合成酵素症候群は筋炎と間質性肺疾患"/>
        <outline text="封入体筋炎は手指屈筋と大腿四頭筋">
          <outline text="従来の免疫抑制に反応しにくい"/>
        </outline>
        <outline text="酵素上昇が軽度なこともある"/>
        <outline text="免疫療法、悪性腫瘍検索、リハビリテーション"/>
      </outline>
      <outline text="血管炎の枠組み">
        <outline text="血管壁の炎症で狭窄、動脈瘤、虚血"/>
        <outline text="血管径、臓器、組織像、原因で分類"/>
        <outline text="感染、塞栓、薬剤が血管炎に類似">
          <outline text="感染除外前の免疫抑制は破局的"/>
        </outline>
        <outline text="大血管炎は巨細胞性動脈炎と高安動脈炎">
          <outline text="視力危機では生検前に糖質コルチコイド"/>
          <outline text="高安動脈炎は脈拍左右差、血管雑音、高血圧"/>
        </outline>
        <outline text="中血管炎は梗塞、動脈瘤、皮下結節">
          <outline text="原発性糸球体腎炎を伴わない"/>
        </outline>
        <outline text="小血管炎は紫斑、糸球体腎炎、肺胞出血">
          <outline text="抗好中球細胞質抗体関連と免疫複合体型"/>
        </outline>
      </outline>
      <outline text="臓器を脅かす臨床像">
        <outline text="肺腎症候群">
          <outline text="肺胞出血と急速進行性糸球体腎炎"/>
          <outline text="喀血がないこともある"/>
          <outline text="緊急の血清学、微生物学、生検"/>
        </outline>
        <outline text="多発単神経炎は神経栄養血管の虚血"/>
        <outline text="腸間膜血管炎は腹痛、出血、穿孔"/>
      </outline>
      <outline text="治療戦略と安全性">
        <outline text="寛解導入と維持療法を分ける">
          <outline text="糖質コルチコイドにシクロホスファミド等"/>
          <outline text="血漿交換は特定の適応に限る"/>
        </outline>
        <outline text="肝炎、結核、ヒト免疫不全ウイルスを評価"/>
        <outline text="日和見感染と骨量減少の予防"/>
        <outline text="疾患活動性と治療毒性を別々に監視">
          <outline text="炎症マーカー正常は寛解を証明しない"/>
        </outline>
        <outline text="発熱、血球減少は感染、毒性、再燃">
          <outline text="免疫抑制強化前に培養と標的診断"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
