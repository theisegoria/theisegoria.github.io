<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>034-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="皮膚機能、創傷、感染、腫瘍">
      <outline text="概説と皮膚構造">
        <outline text="障壁、免疫、感覚、体温調節の器官"/>
        <outline text="病名の前に形態と分布を記述"/>
        <outline text="色の所見は皮膚色で異なる"/>
        <outline text="角化細胞が角質層を形成">
          <outline text="脂質層内の角質細胞が耐水性障壁"/>
          <outline text="障壁破綻で刺激物と病原体が侵入"/>
        </outline>
        <outline text="メラニンは紫外線を吸収し損傷を抑制">
          <outline text="皮膚色差はメラノソームの活動と分布"/>
        </outline>
        <outline text="ランゲルハンス細胞は免疫、メルケル細胞は触覚"/>
        <outline text="乳頭層は表皮と接し網状層は強度"/>
        <outline text="皮下脂肪は緩衝、断熱、貯蔵"/>
      </outline>
      <outline text="体温調節、感覚、分泌">
        <outline text="血管拡張で放熱、収縮で熱を保存"/>
        <outline text="エクリン汗腺の汗は蒸発で冷却">
          <outline text="主に交感神経性コリン作動線維"/>
        </outline>
        <outline text="発汗・感覚障害で熱障害と創傷リスク"/>
        <outline text="痒みは疼痛と異なる神経経路">
          <outline text="皮膚、腎、肝、血液、薬剤、神経が原因"/>
          <outline text="掻破は障壁を損傷し悪循環を持続"/>
        </outline>
        <outline text="皮脂、アポクリン分泌、ビタミンD合成"/>
      </outline>
      <outline text="発疹の記述">
        <outline text="部位、数、配列、対称性、分布"/>
        <outline text="一次疹：斑から膨疹、嚢胞まで"/>
        <outline text="二次的変化：鱗屑、痂皮、びらん、瘢痕"/>
        <outline text="硝子圧法は圧迫退色を調べる"/>
        <outline text="ダーモスコピーで皮下の色素と血管"/>
        <outline text="正確な記述が機序を絞り込む"/>
      </outline>
      <outline text="炎症性皮膚疾患">
        <outline text="アトピー性皮膚炎：障壁、炎症、痒み">
          <outline text="保湿剤、刺激物回避、外用抗炎症療法"/>
          <outline text="根拠のない食物除去は栄養上の害"/>
        </outline>
        <outline text="接触皮膚炎：刺激性かアレルギー性">
          <outline text="パッチテストは即時型検査と異なる"/>
        </outline>
        <outline text="乾癬：境界明瞭な鱗屑性局面">
          <outline text="全身性炎症、心代謝・心理的負担"/>
        </outline>
        <outline text="蕁麻疹：肥満細胞による一過性膨疹">
          <outline text="血管性浮腫はより深部の組織"/>
          <outline text="気道障害やアナフィラキシーにアドレナリン"/>
        </outline>
      </outline>
      <outline text="皮膚感染症">
        <outline text="伝染性膿痂疹、毛包炎、膿瘍"/>
        <outline text="蜂窩織炎：通常片側性の拡大性感染">
          <outline text="両側下肢の発赤は非感染性が多い"/>
        </outline>
        <outline text="壊死性感染症：不釣り合いな疼痛">
          <outline text="直ちに外科的探索、画像で遅らせない"/>
        </outline>
        <outline text="単純ヘルペス：集簇した有痛性小水疱"/>
        <outline text="帯状疱疹は感覚神経の分布に従う">
          <outline text="高リスクでは早期抗ウイルス療法"/>
        </outline>
        <outline text="皮膚糸状菌・カンジダは検体採取"/>
        <outline text="疥癬：接触者と環境を同時に管理"/>
      </outline>
      <outline text="創傷、潰瘍、圧迫損傷">
        <outline text="止血、炎症、増殖、リモデリング">
          <outline text="瘢痕は無傷の皮膚の強度に戻らない"/>
        </outline>
        <outline text="感染、虚血、浮腫、圧迫が治癒を遅延"/>
        <outline text="ドレッシング材は銘柄でなく組織と水分"/>
        <outline text="静脈性潰瘍：動脈評価後に圧迫療法"/>
        <outline text="動脈性潰瘍：有痛性、遠位、灌流不良"/>
        <outline text="神経障害性潰瘍：感覚消失の圧迫点"/>
        <outline text="圧迫と剪断力で微小循環が障害">
          <outline text="表面破綻前に深部組織で損傷"/>
          <outline text="体位変換、圧再分配、踵の除圧"/>
          <outline text="治癒中の病変を逆方向に分類しない"/>
        </outline>
      </outline>
      <outline text="熱傷">
        <outline text="深さ、面積、部位、吸入損傷、機序"/>
        <outline text="表在性熱傷は有痛性で圧迫退色"/>
        <outline text="深い熱傷は蒼白、革状、無感覚"/>
        <outline text="全周性熱傷は循環・換気を障害"/>
        <outline text="流水で冷却、氷と低体温を避ける"/>
        <outline text="重症熱傷：輸液、体温管理、専門搬送"/>
      </outline>
      <outline text="薬疹と水疱性緊急疾患">
        <outline text="麻疹様薬疹：発症時期と全身所見"/>
        <outline text="好酸球増多・全身症状の薬物反応"/>
        <outline text="スティーブンス・ジョンソン症候群と中毒性表皮壊死症">
          <outline text="疑わしい薬剤を中止し専門的支持療法"/>
        </outline>
        <outline text="自己免疫性水疱症：接着構造への抗体">
          <outline text="生検と病変周囲の免疫蛍光法"/>
          <outline text="体液喪失、感染、体温不安定"/>
        </outline>
      </outline>
      <outline text="皮膚腫瘍">
        <outline text="基底細胞癌：局所浸潤、転移はまれ"/>
        <outline text="扁平上皮癌：転移可能性がより高い"/>
        <outline text="悪性黒色腫：転移能ゆえに危険">
          <outline text="経時変化や他と異なる病変を重視"/>
          <outline text="結節型は対称的でも急速に増大"/>
          <outline text="破壊的治療でなく全切除生検"/>
        </outline>
        <outline text="予防：日陰、衣服、日焼け止め"/>
        <outline text="外観だけで悪性は除外できない"/>
      </outline>
    </outline>
  </body>
</opml>
