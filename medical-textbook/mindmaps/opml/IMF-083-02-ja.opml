<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>083-02 結合組織、細胞外基質、血液、軟骨、骨、脂肪組織</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="結合組織、血液、軟骨、骨、脂肪">
      <outline text="結合組織の基本構成">
        <outline text="支持、結合、栄養、防御、貯蔵、力の伝達"/>
        <outline text="細胞間に豊富な細胞外基質"/>
        <outline text="線維、基質、ミネラル、細胞で性質が決まる"/>
        <outline text="胚性間葉から生じる"/>
        <outline text="線維芽細胞が基質を産生">
          <outline text="活動性細胞は好塩基性細胞質が豊富"/>
          <outline text="損傷後に筋線維芽細胞となる"/>
        </outline>
      </outline>
      <outline text="線維と基質">
        <outline text="コラーゲンは張力へ抵抗">
          <outline text="一型：真皮、腱、骨、瘢痕の太い線維"/>
          <outline text="二型：軟骨と硝子体"/>
          <outline text="三型：細胞性臓器の細網線維"/>
          <outline text="四型：基底膜のシート状網"/>
        </outline>
        <outline text="弾性線維：エラスチン芯と微細線維">
          <outline text="動脈壁の弾性板が収縮期に蓄える"/>
          <outline text="フィブリリン欠損：骨格、眼、大動脈"/>
          <outline text="エラスチン分解：肺気腫、動脈硬化"/>
        </outline>
        <outline text="基質は水和ゲル">
          <outline text="陰性荷電グリコサミノグリカンが陽イオンと水"/>
          <outline text="ヒアルロン酸は空間を占め移動を促す"/>
          <outline text="フィブロネクチンは細胞結合、ラミニンは基底膜"/>
          <outline text="通常処理で失われ空隙に見える"/>
        </outline>
      </outline>
      <outline text="結合組織の種類">
        <outline text="疎性：拡散と免疫監視">
          <outline text="浮腫を起こしやすい"/>
        </outline>
        <outline text="密性不規則は多方向応力に抵抗"/>
        <outline text="密性規則は主要力方向へコラーゲン"/>
        <outline text="腱：平行束、腱細胞、血管が少ない">
          <outline text="引張強度は高いが治癒は遅い"/>
          <outline text="反復負荷：配列異常と修復不全"/>
        </outline>
        <outline text="靱帯は骨同士を結び弾性線維を含む"/>
      </outline>
      <outline text="常在細胞と脂肪組織">
        <outline text="マクロファージは貪食、抗原提示、再構成"/>
        <outline text="肥満細胞はヒスタミン、プロテアーゼを放出"/>
        <outline text="形質細胞：車軸状核と淡明なゴルジ野"/>
        <outline text="白色脂肪：一個の大脂肪滴、印環状">
          <outline text="中性脂肪貯蔵とアディポカイン分泌"/>
          <outline text="内臓脂肪と皮下脂肪は異なる"/>
        </outline>
        <outline text="褐色脂肪：多数の脂肪滴とミトコンドリア">
          <outline text="脱共役タンパク質一がプロトンを漏出"/>
          <outline text="アデノシン三リン酸でなく熱を産生"/>
        </outline>
      </outline>
      <outline text="血液">
        <outline text="血漿が液状基質"/>
        <outline text="赤血球：無核の両凹円盤">
          <outline text="中央淡明部は直径の約三分の一"/>
          <outline text="大きさ、色、形、封入体が手掛かり"/>
        </outline>
        <outline text="好中球は急性細菌性炎症で優勢"/>
        <outline text="好酸球：寄生虫防御、アレルギー"/>
        <outline text="単球は組織でマクロファージ様細胞に"/>
        <outline text="血小板：巨核球から離れた断片">
          <outline text="接着、活性化、動員、凝固を支持"/>
          <outline text="試験管内凝集で見かけの減少"/>
        </outline>
      </outline>
      <outline text="軟骨">
        <outline text="小腔内の軟骨細胞、無血管基質">
          <outline text="軟骨膜または滑液から拡散"/>
          <outline text="成人関節軟骨は修復不良"/>
        </outline>
        <outline text="硝子軟骨：細い二型コラーゲン原線維">
          <outline text="関節軟骨は軟骨膜を欠く"/>
        </outline>
        <outline text="弾性軟骨：耳介と喉頭蓋"/>
        <outline text="線維軟骨は張力と圧縮へ抵抗"/>
      </outline>
      <outline text="骨の構造と形成">
        <outline text="石灰化支持とカルシウム・リン貯蔵"/>
        <outline text="骨芽細胞が類骨を分泌"/>
        <outline text="骨細胞は骨細管で荷重を感知"/>
        <outline text="破骨細胞は酸性密閉区画で吸収"/>
        <outline text="骨単位：中心管周囲の同心円状層板">
          <outline text="介在層板は旧骨単位の残存物"/>
        </outline>
        <outline text="海綿骨は荷重方向へ並ぶ"/>
        <outline text="線維骨は層板骨へ再構成"/>
        <outline text="膜内骨化または軟骨内骨化"/>
      </outline>
      <outline text="成長、再構成、修復">
        <outline text="成長板の帯構造">
          <outline text="柱状に分裂、肥大し、死に、置換される"/>
          <outline text="板閉鎖で長軸成長が終わる"/>
        </outline>
        <outline text="再構成は吸収と形成を連結">
          <outline text="リガンドとおとり受容体が破骨細胞を調節"/>
          <outline text="ホルモン、負荷、炎症が均衡に影響"/>
        </outline>
        <outline text="修復：止血から再構成へ">
          <outline text="肉芽組織は肉芽腫性炎症でない"/>
          <outline text="三型コラーゲン置換、強度は増す"/>
        </outline>
        <outline text="治癒は血管性、細胞性、回転に従う"/>
      </outline>
    </outline>
  </body>
</opml>
