<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>065-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="疫学、スクリーニング、予防接種、集団の健康">
      <outline text="概説">
        <outline text="疾患はなぜ不均等に生じるか"/>
        <outline text="住居、収入、教育、食品、仕事、アクセス">
          <outline text="発病と回復を左右する"/>
        </outline>
        <outline text="根拠に公平性、実行可能性、信頼、害"/>
      </outline>
      <outline text="疾病頻度の尺度">
        <outline text="罹患率はリスクのある人の新規事象"/>
        <outline text="有病率は時点または期間の既存疾患">
          <outline text="罹患率と持続期間の両方に依存"/>
          <outline text="生存可能な慢性疾患は有病率が高い"/>
        </outline>
        <outline text="致命率は診断症例中の死亡割合"/>
        <outline text="リスクは確率、率は人時間を用いる"/>
        <outline text="絶対リスク差と相対リスクの比">
          <outline text="まれな転帰は相対大でも絶対利益小"/>
        </outline>
        <outline text="治療必要数は絶対リスク減少の逆数">
          <outline text="時間範囲と基礎リスクを示す"/>
        </outline>
        <outline text="標準化は選んだ基準集団に依存"/>
        <outline text="生態学的データは個人に当てはまらない"/>
      </outline>
      <outline text="予防の水準">
        <outline text="根源的予防はリスクの出現を防ぐ"/>
        <outline text="一次予防は発症前に疾患を防ぐ"/>
        <outline text="二次予防は早期検出と迅速治療"/>
        <outline text="三次予防は合併症と障害を制限"/>
        <outline text="四次予防は不必要な医療介入から守る"/>
        <outline text="上流の介入はカウンセリングより広く届く">
          <outline text="安全な水は反復的な個人選択が不要"/>
          <outline text="課税や表示は低所得者の負担に配慮"/>
        </outline>
      </outline>
      <outline text="スクリーニングの原則">
        <outline text="目的は罹患または死亡の減少"/>
        <outline text="検出可能な前臨床期が必要">
          <outline text="有効な早期治療と明確な診療経路"/>
        </outline>
        <outline text="低有病率では偽陽性が真陽性を上回る"/>
        <outline text="害は不安、追跡検査、過剰診断"/>
        <outline text="レングスバイアスは遅い疾患を検出"/>
        <outline text="リードタイムバイアスは生存を長く見せる">
          <outline text="病期移行より無作為化試験の転帰"/>
        </outline>
        <outline text="感度重視後に特異的確認検査"/>
        <outline text="プログラムが格差を広げ得る"/>
        <outline text="追跡のない機会的検査は不可"/>
      </outline>
      <outline text="予防接種と免疫防御">
        <outline text="抗原曝露で記憶B細胞とT細胞"/>
        <outline text="結合型はT細胞支援を誘導"/>
        <outline text="アジュバントは自然免疫を強化"/>
        <outline text="有効性は宿主と病原体で変わる">
          <outline text="感染より重症疾患をよく予防"/>
        </outline>
        <outline text="集団免疫の閾値は伝播性で変わる"/>
        <outline text="接種後の事象は接種によるとは限らない">
          <outline text="背景発生率、時間関係、機序を比較"/>
        </outline>
        <outline text="生ワクチンは増殖可能">
          <outline text="重度免疫抑制と妊娠で避ける"/>
        </outline>
        <outline text="免疫抑制治療前に接種する"/>
        <outline text="未接種分はやり直さず継続"/>
      </outline>
      <outline text="心血管および代謝疾患の予防">
        <outline text="絶対心血管リスクを推定">
          <outline text="危険因子は相互に作用する"/>
        </outline>
        <outline text="正確な反復血圧測定"/>
        <outline text="脂質低下の利益は基礎リスク次第"/>
        <outline text="スタチンの症状を評価し予防を維持"/>
        <outline text="抗血小板は低リスクで出血が上回る"/>
        <outline text="肥満診療はスティグマを避ける"/>
        <outline text="フレイルと余命で目標を調整"/>
      </outline>
      <outline text="がん予防と早期発見">
        <outline text="タバコ対策は複数のがんを予防"/>
        <outline text="ヒトパピローマウイルスとB型肝炎ワクチン"/>
        <outline text="化学予防は個人リスクが正当化時のみ"/>
        <outline text="子宮頸部、乳房、大腸、肺の検診"/>
        <outline text="検査の存在だけでは検診は不適切">
          <outline text="甲状腺、卵巣、膵臓の過剰診断"/>
        </outline>
      </outline>
      <outline text="感染症予防">
        <outline text="予防策を伝播経路に合わせる"/>
        <outline text="個人用防護具は一層の対策">
          <outline text="制度、換気、人員が不十分なら機能せず"/>
        </outline>
        <outline text="抗微生物薬耐性は共有された曝露">
          <outline text="狭域治療、正しい用量と期間"/>
          <outline text="ウイルス疾患に抗菌薬を使わない"/>
        </outline>
        <outline text="ワンヘルスは共有された生態系"/>
      </outline>
      <outline text="タバコ、アルコール、物質使用の予防">
        <outline text="行動支援と薬物療法を組み合わせる"/>
        <outline text="長時間型と短時間型ニコチン併用"/>
        <outline text="再発には非難でなく新たな支援"/>
        <outline text="アルコールリスクは量とパターン次第"/>
        <outline text="ナロキソンと作動薬治療で死亡減少"/>
      </outline>
      <outline text="健康の公平性と実装">
        <outline text="平等は同じ資源を与える"/>
        <outline text="公平は障壁と必要に応じる"/>
        <outline text="アイデンティティーは生物学ではない"/>
        <outline text="地域社会との共同設計で信頼"/>
        <outline text="到達範囲、利用率、害、分布を評価"/>
        <outline text="健康的な選択を実行可能で普通に"/>
      </outline>
    </outline>
  </body>
</opml>
