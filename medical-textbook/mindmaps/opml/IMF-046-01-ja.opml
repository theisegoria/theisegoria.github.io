<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>046-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="統合的な病棟症例提示、申し送り、継続診療">
      <outline text="概説と初回接触">
        <outline text="不完全な情報を安全な行動へ変換">
          <outline text="脅威同定、表現、順位、検査、治療、修正"/>
        </outline>
        <outline text="病棟診療は人、勤務帯、施設をまたぐ連携"/>
        <outline text="申し送りは推論と今後の課題を保つ"/>
        <outline text="病歴聴取より先に生理学的脅威を治療">
          <outline text="血圧正常でもショックは除外できない"/>
        </outline>
        <outline text="本人確認、アレルギー、妊娠、意思決定支援"/>
        <outline text="治療前の状態を記録する">
          <outline text="治療反応は機序の識別に役立つ"/>
        </outline>
      </outline>
      <outline text="問題表現と問題リスト">
        <outline text="背景、時間経過、症候群、重症度を一文に"/>
        <outline text="急性、局在性、炎症性、進行性などの修飾語"/>
        <outline text="陰性所見は信頼でき識別に役立つ場合のみ"/>
        <outline text="早すぎる診断名を避けデータで更新"/>
        <outline text="症候群、確定診断、合併症、障壁を区別"/>
        <outline text="因果関係を保ち重複を統合"/>
        <outline text="脅威、可逆性、時間、患者優先で順位づけ"/>
      </outline>
      <outline text="鑑別診断">
        <outline text="解剖、機序、時間経過から作る"/>
        <outline text="高頻度、危険、患者固有の原因">
          <outline text="順位のない長いリストは安全ではない"/>
        </outline>
        <outline text="主要候補の支持と反証の根拠"/>
        <outline text="安定患者では診断の時間が治療的"/>
        <outline text="不可逆的損傷の恐れには即時の経験的治療"/>
        <outline text="治療失敗時は代替診断を再検討"/>
      </outline>
      <outline text="検査戦略">
        <outline text="各検査には明確な目的がある"/>
        <outline text="各結果が行動をどう変えるか予測">
          <outline text="行動を変えないなら検査を再考"/>
        </outline>
        <outline text="安全なら治療前に良質な検体を採取"/>
        <outline text="予想外の結果を確認する"/>
        <outline text="重大結果は閉ループで伝える">
          <outline text="受信者、意味、行動、エスカレーション"/>
        </outline>
      </outline>
      <outline text="治療計画と治療的試行">
        <outline text="目標と機序に沿って記載"/>
        <outline text="薬剤、用量、経路、間隔、見直し、中止条件">
          <outline text="他の臨床家が安全に継続できる"/>
        </outline>
        <outline text="試行には標的、時間枠、代替解釈">
          <outline text="無反応は誤診、投与不足、疾患、時間"/>
        </outline>
        <outline text="異なる時間軸で利益を均衡">
          <outline text="厳格な血糖管理より低血糖予防"/>
          <outline text="中止した予防薬は再開を見直す"/>
        </outline>
      </outline>
      <outline text="薬剤照合">
        <outline text="入院前使用と現処方、退院時処方を比較"/>
        <outline text="患者、薬局、プライマリケアなど複数の情報源"/>
        <outline text="相違は意図的か非意図的か">
          <outline text="欠落、重複、濃度の誤り"/>
          <outline text="腎機能調整の失敗、有害薬の再開"/>
        </outline>
        <outline text="高リスク：抗凝固薬、インスリン、オピオイド"/>
        <outline text="休薬には理由と再開基準を記録">
          <outline text="説明のないリストは曖昧さを渡す"/>
        </outline>
        <outline text="入手、費用、手先の機能、認知を確認"/>
      </outline>
      <outline text="回診、エスカレーション、不確実性">
        <outline text="推移、摂取、機器、結果、反応を確認"/>
        <outline text="各問題の状態、行動、監視、エスカレーション"/>
        <outline text="懸念は安心できるスコアより優先"/>
        <outline text="生理悪化や現場能力超過でエスカレーション">
          <outline text="まず緊急度、次に背景と具体的依頼"/>
          <outline text="安全でなければ上位階層へ粘り強く"/>
        </outline>
        <outline text="不確実性を段階づけ：既知、可能性、危険">
          <outline text="観察、発動閾値、追跡で安全網"/>
        </outline>
        <outline text="診断エラー：アンカリング、早期終結">
          <outline text="他に何か、何が整合しないかを問う"/>
        </outline>
      </outline>
      <outline text="申し送りと記録">
        <outline text="行動に不可欠な情報から始める"/>
        <outline text="課題：何を、なぜ、いつ、誰が、予想、異常時"/>
        <outline text="閉ループの質問と復唱"/>
        <outline text="未解決の危険は直接伝える"/>
        <outline text="適時、事実、作成者明確、有用な診療録"/>
        <outline text="観察、報告、推論を区別"/>
        <outline text="評価的判断なしに行動を記述"/>
      </outline>
      <outline text="退院計画と継続診療">
        <outline text="退院計画は入院時から始める"/>
        <outline text="安定とは現監視環境の外で安全に管理"/>
        <outline text="責任者付き保留検査と警告症状"/>
        <outline text="ティーチバックと利用しやすい書面"/>
        <outline text="原因と害を起こしやすくした条件へ対処"/>
        <outline text="多疾患併存：利益、負担、目標">
          <outline text="臓器間で専門医を調整"/>
        </outline>
        <outline text="リハビリと社会的支援は疾患治療"/>
      </outline>
      <outline text="共同意思決定、治療目標、安全">
        <outline text="選択肢、転帰、不確実性、負担、価値観"/>
        <outline text="蘇生の決定は心肺停止への対応のみ"/>
        <outline text="緩和ケアは疾患標的治療と並行">
          <outline text="放棄でなく快適性と連携を強化"/>
        </outline>
        <outline text="有害事象後：安定化、開示、証拠保存"/>
        <outline text="教育より標準化と優れた設計"/>
        <outline text="公正な文化：エラー、近道、無謀を区別"/>
      </outline>
    </outline>
  </body>
</opml>
