<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>039-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="白血球疾患と血液悪性腫瘍">
      <outline text="概説と造血">
        <outline text="血球数は産生、放出、破壊、クローン性を反映">
          <outline text="血球数だけでは診断にならない"/>
          <outline text="形態、系統、時間経過、分子所見"/>
        </outline>
        <outline text="幹細胞は自己複製と分化を均衡">
          <outline text="間質、基質、血管、サイトカインの微小環境"/>
        </outline>
        <outline text="赤血球、巨核球、顆粒球を促す増殖因子"/>
        <outline text="クローン性造血は加齢で増加">
          <outline text="血液癌と心血管疾患リスクを高める"/>
          <outline text="必ず白血病になるわけではない"/>
        </outline>
      </outline>
      <outline text="白血球数の解釈">
        <outline text="百分率でなく絶対細胞数を用いる"/>
        <outline text="好中球増多は感染、炎症、ステロイド、腫瘍">
          <outline text="左方移動は未熟顆粒球の増加"/>
          <outline text="中毒性顆粒と空胞は反応性を支持"/>
          <outline text="辺縁プールからの移動で産生なく増加"/>
        </outline>
        <outline text="リンパ球増多は反応性か単調なクローンか"/>
        <outline text="白血球減少は抑制、破壊、薬剤、脾臓">
          <outline text="推移で単一系統か骨髄全体か判断"/>
        </outline>
      </outline>
      <outline text="好中球減少症と発熱性好中球減少症">
        <outline text="リスクは減少の深さと持続期間で上昇">
          <outline text="皮膚粘膜、機器、細胞性免疫の障害"/>
        </outline>
        <outline text="膿、局在徴候、発熱なしの重症感染"/>
        <outline text="好中球減少中の発熱は緊急病態">
          <outline text="培養採取と部位の評価"/>
          <outline text="広域抗緑膿菌薬を速やかに投与"/>
          <outline text="直腸操作は避ける"/>
        </outline>
        <outline text="持続発熱は再評価の契機"/>
        <outline text="顆粒球コロニー刺激因子で減少を短縮">
          <outline text="成立した敗血症の代わりにならない"/>
        </outline>
      </outline>
      <outline text="骨髄不全">
        <outline text="再生不良性貧血は低形成性汎血球減少">
          <outline text="幹細胞の免疫性破壊が多い"/>
          <outline text="著明なリンパ節腫大や脾腫はない"/>
        </outline>
        <outline text="幹細胞移植で選択例は治癒">
          <outline text="輸血の同種免疫化が移植を複雑に"/>
        </outline>
        <outline text="免疫抑制とトロンボポエチン作動性支持"/>
        <outline text="骨髄穿刺は細胞詳細とフロー"/>
        <outline text="骨髄生検は構築、線維化、浸潤"/>
      </outline>
      <outline text="骨髄異形成腫瘍と骨髄増殖性腫瘍">
        <outline text="骨髄異形成は無効で異形成的な造血">
          <outline text="血球減少と急性骨髄性白血病リスク"/>
          <outline text="栄養、毒性、薬剤、感染の類似病態を除外"/>
        </outline>
        <outline text="骨髄増殖性は成熟骨髄系細胞の過剰">
          <outline text="真性多血症は血栓、痒み、脾腫"/>
          <outline text="本態性血小板血症は血栓か出血"/>
          <outline text="骨髄線維症は線維化と白赤芽球症"/>
        </outline>
        <outline text="ドライバー変異が増殖信号を活性化"/>
        <outline text="血球数の高さだけでリスクは決まらない"/>
      </outline>
      <outline text="急性白血病">
        <outline text="芽球が正常骨髄を抑制し組織浸潤">
          <outline text="疲労、感染、出血、骨痛"/>
        </outline>
        <outline text="系統と遺伝子型が治療と予後を決定"/>
        <outline text="急性前骨髄球性白血病は重度凝固障害">
          <outline text="疑い時点で分化誘導療法"/>
        </outline>
        <outline text="寛解導入、地固め、リスク別移植"/>
        <outline text="高白血球血症は微小血管血流を障害">
          <outline text="脳と肺の症状に緊急細胞減少療法"/>
          <outline text="赤血球輸血は粘稠度を高める"/>
        </outline>
      </outline>
      <outline text="慢性白血病">
        <outline text="慢性骨髄性は転座由来の融合キナーゼ">
          <outline text="慢性期から急性転化へ進展"/>
          <outline text="阻害薬は分子学的反応を監視"/>
        </outline>
        <outline text="慢性リンパ性は成熟B細胞のクローン">
          <outline text="低ガンマグロブリン血症、自己免疫性減少"/>
          <outline text="リンパ球数でなく臨床適応で治療"/>
        </outline>
      </outline>
      <outline text="リンパ腫">
        <outline text="ホジキンは反応性背景に悪性細胞">
          <outline text="連続的に進展することが多い"/>
        </outline>
        <outline text="非ホジキンは低・高悪性度B、T、NK"/>
        <outline text="持続リンパ節腫大、盗汗、体重減少は評価"/>
        <outline text="切除またはコア生検は構築を保つ">
          <outline text="細針吸引だけでは分類困難"/>
        </outline>
        <outline text="病期より組織亜型と分子リスク"/>
      </outline>
      <outline text="形質細胞疾患">
        <outline text="単クローン性免疫グロブリンまたは軽鎖"/>
        <outline text="意義不明の単クローン性は臓器障害なし"/>
        <outline text="骨髄腫は骨、貧血、腎、カルシウム、感染"/>
        <outline text="小さなクローンでも臓器を損傷"/>
        <outline text="蛋白検査、遊離軽鎖、骨髄、全身画像"/>
      </outline>
      <outline text="緊急病態とケアの原則">
        <outline text="腫瘍崩壊でカリウム、リン酸、核酸放出">
          <outline text="不整脈、発作、尿酸性腎障害"/>
          <outline text="予防は輸液、監視、尿酸降下療法"/>
        </outline>
        <outline text="脊髄圧迫、上大静脈閉塞、気道障害"/>
        <outline text="持続異常を推移確認なしに軽視しない"/>
        <outline text="治癒可能性、フレイル、目標で決定"/>
        <outline text="長期生存者はワクチン、二次癌、妊孕性"/>
      </outline>
    </outline>
  </body>
</opml>
