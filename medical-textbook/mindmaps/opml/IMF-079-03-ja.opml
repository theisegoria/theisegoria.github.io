<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>079-03 会陰、外性器、内生殖器、性解剖</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="会陰、外性器、内生殖器">
      <outline text="会陰の三角と隙">
        <outline text="恥骨結合から尾骨までの菱形"/>
        <outline text="坐骨結節間線が二つの三角に分ける"/>
        <outline text="会陰膜が恥骨弓をまたぐ"/>
        <outline text="浅隙は外性器根部、関連筋">
          <outline text="存在時の大前庭腺"/>
        </outline>
        <outline text="深隙は外尿道括約筋複合体">
          <outline text="男性型では尿道球腺"/>
        </outline>
        <outline text="坐骨肛門窩の脂肪が肛門拡張を許す">
          <outline text="内閉鎖筋膜の陰部神経管"/>
          <outline text="感染は肛門管後方で左右を渡る"/>
        </outline>
      </outline>
      <outline text="会陰筋膜と疾患拡大">
        <outline text="膜性表在筋膜はScarpa・肉様膜へ続く">
          <outline text="鼠径靱帯下の付着で大腿へ続かない"/>
        </outline>
        <outline text="海綿体尿道破裂">
          <outline text="尿は陰嚢、陰茎周囲、腹壁へ"/>
          <outline text="大腿や肛門三角へ自由に入らない"/>
        </outline>
        <outline text="膜様尿道・膀胱損傷は深部の面"/>
        <outline text="壊死性感染は筋膜面に沿い進む"/>
      </outline>
      <outline text="勃起組織と制御">
        <outline text="白膜内の血管腔"/>
        <outline text="陰茎海綿体は坐骨恥骨枝に脚"/>
        <outline text="尿道海綿体は海綿体尿道を囲む"/>
        <outline text="陰核海綿体と前庭球"/>
        <outline text="坐骨海綿体筋は静脈流出を減らす"/>
        <outline text="球海綿体筋は射精・腟収縮を助ける"/>
        <outline text="副交感性海綿体神経">
          <outline text="一酸化窒素で動脈拡張、勃起"/>
        </outline>
        <outline text="交感は射出と弛緩"/>
        <outline text="背神経は体性、自律神経は深部"/>
      </outline>
      <outline text="精巣、精索、精路">
        <outline text="鼠径管を通り下降">
          <outline text="被膜は腹壁の層に由来"/>
          <outline text="精巣鞘膜は腹膜鞘状突起から"/>
        </outline>
        <outline text="精細管から精巣網、精巣上体、精管へ"/>
        <outline text="精索の内容">
          <outline text="腸骨鼠径神経は被膜外"/>
        </outline>
        <outline text="精巣動脈は腹大動脈から">
          <outline text="左静脈は左腎静脈へ"/>
          <outline text="リンパは傍大動脈節へ"/>
        </outline>
        <outline text="精管は尿管を横切り精嚢管と合流"/>
      </outline>
      <outline text="前立腺と付属腺">
        <outline text="膀胱下で近位尿道を囲む"/>
        <outline text="辺縁、中心、移行、前方域">
          <outline text="がんの多くは辺縁域"/>
          <outline text="良性肥大は移行域"/>
        </outline>
        <outline text="射精管は精丘付近に開く"/>
        <outline text="静脈叢は椎骨静脈叢と交通"/>
        <outline text="精嚢は果糖を加え精子を貯蔵しない"/>
      </outline>
      <outline text="卵巣、卵管、子宮、腟">
        <outline text="卵巣窩の卵巣、位置は変わる">
          <outline text="卵巣提索が卵巣血管を運ぶ"/>
          <outline text="血管とリンパは大動脈へ"/>
        </outline>
        <outline text="卵管は采、膨大部、峡部">
          <outline text="受精は膨大部に多い"/>
          <outline text="輸送障害は異所性妊娠へ"/>
        </outline>
        <outline text="子宮は通常前傾・前屈"/>
        <outline text="広間膜は主要支持でない">
          <outline text="基靱帯、仙骨子宮靱帯、骨盤底"/>
        </outline>
        <outline text="子宮動脈は尿管上を横切る"/>
        <outline text="後円蓋が最深"/>
        <outline text="腟下部は体性、上部は自律"/>
      </outline>
      <outline text="外性器と腺">
        <outline text="外陰は陰唇、陰核、前庭、腺">
          <outline text="大きさと色素は広く変異"/>
        </outline>
        <outline text="陰茎は左右海綿体と腹側尿道海綿体">
          <outline text="深背静脈は前立腺静脈叢へ"/>
        </outline>
        <outline text="精巣挙筋は陰部大腿運動線維で挙上"/>
        <outline text="温度は皮膚、肉様膜、蔓状叢熱交換"/>
      </outline>
      <outline text="出産、手術、疼痛">
        <outline text="分娩で骨盤底・会陰体が伸張">
          <outline text="神経、挙筋、括約筋が断裂し得る"/>
          <outline text="修復で括約筋・直腸壁損傷を同定"/>
        </outline>
        <outline text="子宮摘出は尿管を脅かす"/>
        <outline text="前立腺・直腸手術は海綿体神経"/>
        <outline text="リンパ節郭清は閉鎖神経"/>
        <outline text="会陰痛の起源は多様">
          <outline text="ジェンダーでなく臓器で局在"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
