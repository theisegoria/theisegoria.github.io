<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>029-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="高次機能、睡眠、意識、自律神経制御">
      <outline text="大脳皮質の構成">
        <outline text="連合野は感覚様式と時間を統合する"/>
        <outline text="機能は局所組織と同じほど結合性に依存">
          <outline text="戦略的病変は回路を切断し重い障害"/>
        </outline>
        <outline text="左右半球は特殊化しつつ協働する">
          <outline text="大多数で言語は左半球優位"/>
          <outline text="右は空間的注意、韻律、全体的文脈"/>
          <outline text="優位性は確率的、推測せず診察する"/>
        </outline>
      </outline>
      <outline text="注意と実行制御">
        <outline text="前頭頭頂回路と視床、脳幹覚醒系"/>
        <outline text="注意障害は全認知検査を低下させる">
          <outline text="想起不良は保存でなく符号化の失敗"/>
        </outline>
        <outline text="前頭前野は作業記憶、抑制、規則切替"/>
        <outline text="眼窩前頭部損傷は脱抑制と判断力低下"/>
        <outline text="内側前頭部損傷は無気力と自発性低下"/>
        <outline text="背外側部損傷は計画と柔軟性の障害"/>
        <outline text="半側空間無視は片側への注意障害">
          <outline text="通常は右半球損傷で左側に生じる"/>
          <outline text="一次感覚障害では説明できない"/>
          <outline text="両側同時刺激で消去現象"/>
        </outline>
      </outline>
      <outline text="言語と記号機能">
        <outline text="非流暢性は努力性発話、理解は比較的保持"/>
        <outline text="流暢性受容性は空疎な発話と理解障害"/>
        <outline text="伝導性失語は復唱が不釣り合いに障害"/>
        <outline text="構音障害は運動遂行障害、言語は保持"/>
        <outline text="発語失行は構音運動の計画障害"/>
        <outline text="行為失行は筋力・感覚で説明できない"/>
        <outline text="失認は一次感覚保持でも認識できない"/>
      </outline>
      <outline text="記憶系">
        <outline text="作業、エピソード、意味、手続き記憶"/>
        <outline text="海馬回路は新しい陳述記憶を固定する">
          <outline text="すべての詳細の永久的倉庫ではない"/>
        </outline>
        <outline text="想起は再構成であり記憶は誤り得る">
          <outline text="反復想起は強化と更新をもたらす"/>
        </outline>
        <outline text="前向性健忘と逆向性健忘"/>
        <outline text="前頭葉は記憶方略と情報源の監視"/>
        <outline text="作話は意図的な欺きではない"/>
      </outline>
      <outline text="感情、動機、ストレス">
        <outline text="扁桃体は重要性を検出し脅威を学習"/>
        <outline text="ドパミンは予測と結果の差を符号化"/>
        <outline text="精神症状の原因は多様である">
          <outline text="脳と心は競合する説明ではない"/>
        </outline>
      </outline>
      <outline text="睡眠構築">
        <outline text="概日リズムと恒常性睡眠圧"/>
        <outline text="視交叉上核は網膜入力で光に同調"/>
        <outline text="メラトニンは夜の信号でスイッチでない"/>
        <outline text="徐波睡眠と交感神経活動の低下"/>
        <outline text="急速眼球運動睡眠は夢、皮質活性化、無緊張">
          <outline text="横隔膜と一部の筋は除かれる"/>
        </outline>
        <outline text="前半に徐波睡眠、後半に急速眼球運動睡眠"/>
        <outline text="睡眠不足は覚醒度、判断、血糖調節を低下">
          <outline text="主観的な慣れが客観的回復を上回る"/>
        </outline>
      </outline>
      <outline text="睡眠障害">
        <outline text="不眠症は機会があっても日中の支障">
          <outline text="条件づけられた覚醒が誘因後も残る"/>
          <outline text="認知行動療法は覚醒と時刻を標的"/>
          <outline text="鎮静薬は依存、転倒、呼吸悪化"/>
        </outline>
        <outline text="閉塞性無呼吸は上気道の反復虚脱">
          <outline text="眠気がなくても除外できない"/>
          <outline text="持続陽圧、体重管理、装置、手術"/>
        </outline>
        <outline text="ナルコレプシーは急速眼球運動睡眠侵入、脱力発作"/>
        <outline text="睡眠時随伴症は不完全な状態移行"/>
        <outline text="むずむず脚は動かしたい衝動、鉄、薬剤"/>
      </outline>
      <outline text="意識と覚醒">
        <outline text="覚醒は脳幹、視床下部、視床に依存"/>
        <outline text="昏睡は両側障害か覚醒系損傷で生じる"/>
        <outline text="まず気道、血糖、毒物、発作、感染"/>
        <outline text="構造性は局在性、代謝性は対称性"/>
        <outline text="せん妄は急性変動性の注意障害">
          <outline text="低活動型せん妄は見逃されやすい"/>
        </outline>
        <outline text="認知症は慢性低下、せん妄と併存し得る"/>
        <outline text="最小意識状態と無反応覚醒症候群"/>
        <outline text="閉じ込め症候群は意識保持、運動喪失"/>
      </outline>
      <outline text="自律神経系の構成">
        <outline text="節前ニューロンはアセチルコリン"/>
        <outline text="交感神経節後は大部分ノルアドレナリン">
          <outline text="汗腺線維は例外"/>
        </outline>
        <outline text="交感と副交感は単純な拮抗ではない"/>
        <outline text="圧受容器が交感・迷走神経出力を調節"/>
        <outline text="立位で血管収縮、心拍増加、筋ポンプ"/>
        <outline text="起立性低血圧は血液量、薬剤、神経障害"/>
      </outline>
      <outline text="自律神経不全と緊急病態">
        <outline text="臥位と立位の血圧と脈拍"/>
        <outline text="高位脊髄損傷後の自律神経過反射">
          <outline text="膀胱または腸管の拡張が誘因"/>
          <outline text="重度高血圧、頭痛、徐脈"/>
          <outline text="起座位、誘因除去、血圧監視"/>
          <outline text="見逃すと脳卒中、発作、心障害"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
