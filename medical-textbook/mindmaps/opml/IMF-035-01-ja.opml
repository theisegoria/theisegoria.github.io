<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>035-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="細菌、ウイルス、真菌、寄生虫、微生物遺伝学">
      <outline text="概説">
        <outline text="細胞構成、複製、代謝、宿主依存性">
          <outline text="診断、伝播、免疫反応、治療を決める"/>
        </outline>
        <outline text="細菌は原核、真菌と寄生虫は真核"/>
        <outline text="正常微生物叢は定着抵抗性を支える"/>
        <outline text="検出は必ずしも原因を示さない"/>
      </outline>
      <outline text="細菌の細胞構造">
        <outline text="核なし、核様体の染色体、プラスミド"/>
        <outline text="ペプチドグリカン壁は浸透圧破裂を防ぐ">
          <outline text="染色性と抗菌薬感受性を決める"/>
        </outline>
        <outline text="グラム陽性菌は厚く露出した壁とタイコ酸"/>
        <outline text="グラム陰性菌は内膜と外膜の間の薄い壁">
          <outline text="外膜はリポ多糖とポリンを含む"/>
          <outline text="リピドAは強力な炎症を誘発"/>
        </outline>
        <outline text="抗酸菌は脂質に富む抗酸性外被"/>
        <outline text="マイコプラズマは細胞壁なく壁作用薬に耐性"/>
        <outline text="莢膜は貪食を妨げ付着を助ける"/>
        <outline text="線毛は結合とデオキシリボ核酸移送、鞭毛は運動"/>
        <outline text="芽胞は熱、乾燥、化学物質に抵抗"/>
        <outline text="バイオフィルムは増殖、免疫、薬剤浸透を変える"/>
      </outline>
      <outline text="細菌の増殖と代謝">
        <outline text="二分裂はクローン性、遺伝子交換で多様化"/>
        <outline text="誘導期、対数増殖期、定常期、死滅期"/>
        <outline text="生体内増殖は栄養と酸素で形づくられる">
          <outline text="遅い、休眠、バイオフィルム集団は反応が異なる"/>
        </outline>
        <outline text="好気性、嫌気性、通性嫌気性、微好気性"/>
        <outline text="呼吸は電子伝達系と最終電子受容体"/>
        <outline text="発酵は受容体なしで補酵素を再生"/>
      </outline>
      <outline text="細菌分類と臨床パターン">
        <outline text="球菌、桿菌、湾曲菌、らせん菌、分枝状"/>
        <outline text="染色、酵素、質量分析、核酸配列で精密化"/>
        <outline text="分類は変化し名称だけに依存しない"/>
        <outline text="細胞外化膿菌は好中球、膿、膿瘍"/>
        <outline text="細胞内細菌には強い細胞性免疫が必要"/>
        <outline text="毒素介在性疾患は侵入が少なくても生じる"/>
        <outline text="偏性細胞内寄生菌は通常培地で増殖不能"/>
      </outline>
      <outline text="ウイルス">
        <outline text="カプシドに包まれた核酸、時にエンベロープ">
          <outline text="リボソームと代謝なく宿主装置を使う"/>
        </outline>
        <outline text="ゲノムの性質が複製と変異を決める"/>
        <outline text="受容体への付着が指向性に影響"/>
        <outline text="エンベロープは脆弱、非エンベロープは残存"/>
        <outline text="持続は潜伏、組み込み、長寿命細胞">
          <outline text="免疫変化やストレスで再活性化"/>
        </outline>
        <outline text="発癌は慢性炎症、細胞周期、組み込み"/>
        <outline text="リボ核酸ポリメラーゼは校正機能を欠く">
          <outline text="分節型は重複感染中に再集合する"/>
        </outline>
        <outline text="進化は病原性の方向を定めない"/>
      </outline>
      <outline text="真菌">
        <outline text="真核生物、キチン壁、エルゴステロール膜"/>
        <outline text="酵母は出芽、糸状菌は菌糸、二形性は切替"/>
        <outline text="表在性、皮下、全身性風土病真菌"/>
        <outline text="日和見真菌は好中球減少やT細胞障害を利用">
          <outline text="カンジダは定着し脆弱宿主で侵入"/>
          <outline text="アスペルギルスはアレルギー、空洞、血管侵襲"/>
        </outline>
        <outline text="真核細胞の共有で選択性が難しい">
          <outline text="標的はエルゴステロール、壁、核酸、有糸分裂"/>
        </outline>
      </outline>
      <outline text="原虫、蠕虫、プリオン">
        <outline text="原虫は多様な生活環の単細胞">
          <outline text="シスト型は宿主外で生存"/>
        </outline>
        <outline text="マラリアは蚊、肝臓、赤血球を循環"/>
        <outline text="蠕虫は線虫、条虫、吸虫">
          <outline text="多くは増殖せず寄生虫量は曝露を反映"/>
          <outline text="糞線虫は自家感染し免疫抑制で致死的"/>
        </outline>
        <outline text="組織内移行は好酸球性炎症を生じる"/>
        <outline text="間欠的排出で一回の陰性は不十分"/>
        <outline text="プリオンは異常折りたたみを鋳型化">
          <outline text="不活化に抵抗し潜伏期間が長い"/>
        </outline>
      </outline>
      <outline text="微生物ゲノム、変異、遺伝子調節">
        <outline text="複製エラー、損傷、可動性因子で変異"/>
        <outline text="抗菌薬は耐性を作らず選択する"/>
        <outline text="水平遺伝子伝播は適応を加速">
          <outline text="形質転換は遊離デオキシリボ核酸を取り込む"/>
          <outline text="形質導入はバクテリオファージ経由"/>
          <outline text="接合は細胞接触で移す"/>
          <outline text="トランスポゾンとインテグロンが集積"/>
        </outline>
        <outline text="クオラムセンシングは病原性を調節"/>
        <outline text="溶原化変換は毒素遺伝子を追加"/>
      </outline>
      <outline text="微生物叢と培養検査・同定">
        <outline text="常在微生物は病原体と競合する"/>
        <outline text="抗菌薬は定着抵抗性を低下させる"/>
        <outline text="ディスバイオーシスは変化の記述で機序でない"/>
        <outline text="検体の質が技術に先立つ">
          <outline text="安全なら抗微生物薬投与前に感染部位で採取"/>
          <outline text="表在性スワブは深部感染を反映しない"/>
        </outline>
        <outline text="培養は生菌回収、治療後病原体を見逃す"/>
        <outline text="核酸増幅は死滅後の残存物も検出"/>
        <outline text="配列解析だけで因果関係は確立しない"/>
      </outline>
    </outline>
  </body>
</opml>
