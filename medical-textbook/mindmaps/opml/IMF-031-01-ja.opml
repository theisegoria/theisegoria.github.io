<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>031-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="神経学的問診、診察、局在診断">
      <outline text="概説と時間経過">
        <outline text="病変部位、次に病的過程"/>
        <outline text="整合する局在診断が検査を導く">
          <outline text="偶発的画像所見は解剖に代わらない"/>
        </outline>
        <outline text="最後に正常であった時刻を特定"/>
        <outline text="発症時最大は塞栓、出血、発作、片頭痛"/>
        <outline text="数時間から数日は炎症、感染、圧迫"/>
        <outline text="数週から数か月は腫瘍、免疫、変性"/>
        <outline text="反復定型的はてんかん、片頭痛、チャネル病"/>
      </outline>
      <outline text="症状の定義と背景">
        <outline text="名称でなく失われた機能を問う">
          <outline text="めまいは回転性、前失神、平衡障害"/>
          <outline text="脱力は筋力、疼痛、疲労、協調障害"/>
        </outline>
        <outline text="発作性事象は目撃者から聴取"/>
        <outline text="血管危険因子、腫瘍、免疫、毒物、家族歴"/>
        <outline text="抗凝固薬、鎮静薬、ドパミン遮断薬を確認"/>
        <outline text="発症前の移動、認知、利き手、希望"/>
        <outline text="危険徴候は雷鳴頭痛、髄膜刺激、括約筋障害">
          <outline text="完全診察より安定化を優先"/>
        </outline>
      </outline>
      <outline text="精神状態">
        <outline text="まず覚醒度と注意">
          <outline text="障害されると以降の検査は無効"/>
        </outline>
        <outline text="記憶、言語、視空間、実行を問いに応じて"/>
        <outline text="得点は教育、言語、文化の影響を受ける"/>
        <outline text="急性変動と不注意はせん妄を示唆"/>
        <outline text="失語と構音障害、難聴、覚醒低下の区別"/>
        <outline text="意思決定能力は個別の決定ごとに評価"/>
      </outline>
      <outline text="脳神経">
        <outline text="視力、視野、瞳孔、眼底、眼球運動"/>
        <outline text="相対的求心性瞳孔障害は非対称な視神経障害"/>
        <outline text="乳頭浮腫は即時でも普遍でもない"/>
        <outline text="上位運動ニューロン性は額を温存">
          <outline text="下位運動ニューロン性は同側顔面全体"/>
        </outline>
        <outline text="口蓋、声、咳、嚥下の安全性">
          <outline text="下位脳神経障害は気道と栄養を脅かす"/>
        </outline>
      </outline>
      <outline text="運動系診察">
        <outline text="筋量、線維束性収縮、不随意運動"/>
        <outline text="異なる速度で筋緊張を評価">
          <outline text="痙縮は速度依存性、固縮は均一"/>
          <outline text="パラトニアは協力や前頭葉で変動"/>
        </outline>
        <outline text="真の筋力低下と疼痛、疲労、脱力を区別"/>
        <outline text="錐体路性は上肢伸筋と下肢屈筋優位"/>
        <outline text="ニューロパチー遠位、ミオパチー近位"/>
        <outline text="接合部性筋力低下は変動し易疲労"/>
        <outline text="反射亢進、クローヌス、伸展性足底反応"/>
        <outline text="反射低下は正常変異もある"/>
      </outline>
      <outline text="感覚系診察">
        <outline text="分布を図示、閉眼、リズムと誘導を避ける"/>
        <outline text="皮質性感覚検査は一次感覚と注意が前提"/>
        <outline text="感覚レベルは脊髄"/>
        <outline text="鞍部感覚低下は馬尾または円錐"/>
        <outline text="皮節は神経根、固有神経、靴下型"/>
        <outline text="顔面と身体の交叉性障害は脳幹"/>
        <outline text="機能性は除外より積極的徴候"/>
      </outline>
      <outline text="協調運動、立位、歩行">
        <outline text="指鼻、踵膝、反復拮抗運動"/>
        <outline text="測定障害は筋力低下や感覚低下でも生じる"/>
        <outline text="ロンベルグ試験は視覚なしの立位">
          <outline text="閉眼時転倒は固有感覚か前庭の障害"/>
        </outline>
        <outline text="異常でなく歩行パターンを記述"/>
        <outline text="安全でない患者は介助下で検査"/>
      </outline>
      <outline text="局在診断の枠組み">
        <outline text="大脳半球は対側障害と皮質徴候"/>
        <outline text="脳幹は脳神経徴候と対側身体徴候"/>
        <outline text="小脳は同側協調障害、筋力低下なし"/>
        <outline text="脊髄は病変以下の両側性徴候">
          <outline text="高位で下位、以下で上位運動ニューロン"/>
          <outline text="半側損傷は対側の痛覚温度覚障害"/>
        </outline>
        <outline text="馬尾は非対称な下位徴候、鞍部、括約筋"/>
        <outline text="神経根は放散痛、筋節、皮節、反射"/>
        <outline text="接合部とミオパチーは感覚障害なし"/>
      </outline>
      <outline text="検査">
        <outline text="CTは血液、占拠効果、水頭症、骨折"/>
        <outline text="MRIは梗塞、脱髄、後頭蓋窩、脊髄"/>
        <outline text="緊急度は臨床的リスクで決定"/>
        <outline text="偶発所見は多く診察と対応させる"/>
        <outline text="腰椎穿刺は初圧、細胞、蛋白、糖">
          <outline text="ヘルニアリスクがあれば先に画像"/>
          <outline text="抗微生物療法を遅らせない"/>
        </outline>
        <outline text="短時間の正常脳波はてんかんを除外しない"/>
        <outline text="神経伝導検査は軸索性と脱髄性を識別"/>
      </outline>
      <outline text="統合とコミュニケーション">
        <outline text="一文で症候群、局在、機序、経過"/>
        <outline text="不確実性を明示し診察を反復"/>
        <outline text="運転、水辺の安全、転倒、嚥下"/>
        <outline text="機能性神経症状症は積極的徴候で診断"/>
        <outline text="リハビリは診断と並行して開始"/>
      </outline>
    </outline>
  </body>
</opml>
