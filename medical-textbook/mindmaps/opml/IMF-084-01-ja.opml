<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>084-01 血管壁から肺胞障壁までの心血管・呼吸組織学</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="心血管・呼吸組織学">
      <outline text="構成原理">
        <outline text="機能へ適応した壁上の連続内皮"/>
        <outline text="伝導系からガス交換系へ"/>
        <outline text="経路に沿い構造が規則的に変化"/>
      </outline>
      <outline text="心臓壁">
        <outline text="血管内膜へ続く心内膜">
          <outline text="心内膜下層に小血管、神経、プルキンエ線維"/>
        </outline>
        <outline text="分枝心筋細胞からなる心筋">
          <outline text="心房は薄く一部にナトリウム利尿ペプチド顆粒"/>
          <outline text="全身圧が高く左心室壁が最厚"/>
          <outline text="豊富なミトコンドリアと高毛細血管密度">
            <outline text="虚血は速やかに収縮を障害"/>
          </outline>
        </outline>
        <outline text="心外膜は臓側漿膜性心膜"/>
      </outline>
      <outline text="線維性骨格、弁、伝導系">
        <outline text="弁口周囲の密性結合組織">
          <outline text="弁尖を固定し過剰拡張を防ぐ"/>
          <outline text="心房筋を心室筋から絶縁"/>
        </outline>
        <outline text="弁尖はコラーゲン、プロテオグリカン、弾性"/>
        <outline text="結節は筋原線維の少ない小型細胞"/>
        <outline text="プルキンエ線維はグリコーゲン豊富な淡明細胞">
          <outline text="心内膜下を高速伝導"/>
        </outline>
        <outline text="線維化や虚血で伝導ブロック、リエントリー"/>
      </outline>
      <outline text="動脈壁">
        <outline text="内膜、中膜、外膜">
          <outline text="大血管外壁は栄養血管を要する"/>
        </outline>
        <outline text="弾性動脈は拍動性心拍出を緩衝">
          <outline text="収縮期の拡張でエネルギーを蓄積">
            <outline text="反跳が拡張期流を維持"/>
          </outline>
          <outline text="内弾性板は目立ちにくい"/>
        </outline>
        <outline text="筋性動脈は血液を臓器へ分配">
          <outline text="波状で明瞭な内弾性板"/>
          <outline text="動脈硬化症は主に内膜に生じる"/>
        </outline>
        <outline text="細動脈は抵抗血管で毛細血管圧を決定">
          <outline text="硝子様：高血圧と糖尿病"/>
          <outline text="増殖性：重症高血圧">
            <outline text="慢性虚血で下流組織を傷害"/>
          </outline>
        </outline>
      </outline>
      <outline text="毛細血管、細静脈、静脈、リンパ管">
        <outline text="連続型：筋、肺、神経組織"/>
        <outline text="有窓型：内分泌器官、腸粘膜、腎"/>
        <outline text="洞様型：肝、脾、骨髄"/>
        <outline text="周皮細胞は血管安定化と流量調節"/>
        <outline text="後毛細血管細静脈は白血球退出部位"/>
        <outline text="静脈は薄い中膜と厚い外膜">
          <outline text="高コンプライアンスで血液貯蔵"/>
        </outline>
        <outline text="形でなく壁対内腔比で判断"/>
        <outline text="リンパ毛細管は重なる内皮、赤血球なし"/>
      </outline>
      <outline text="上気道と気管">
        <outline text="偽重層線毛円柱上皮の呼吸粘膜">
          <outline text="血管性固有層が空気を温める"/>
          <outline text="漿粘液腺が加湿し粒子を捕捉"/>
        </outline>
        <outline text="嗅粘膜は双極性感覚ニューロンを含む"/>
        <outline text="真声帯は重層扁平上皮で腺が乏しい"/>
        <outline text="仮声帯は呼吸上皮と腺を保つ"/>
        <outline text="気管のC字形硝子軟骨輪">
          <outline text="気管平滑筋が開放端を結ぶ"/>
          <outline text="慢性刺激で重層扁平上皮化生"/>
        </outline>
      </outline>
      <outline text="気管支と細気管支">
        <outline text="軟骨は不連続板となる"/>
        <outline text="平滑筋が相対的に目立つ"/>
        <outline text="肺動脈は気管支に伴走、肺静脈は隔壁内"/>
        <outline text="細気管支は軟骨と粘膜下腺を欠く">
          <outline text="終末細気管支は最後の純伝導気道"/>
          <outline text="クラブ細胞は分泌、解毒、上皮更新"/>
        </outline>
      </outline>
      <outline text="ガス交換領域">
        <outline text="呼吸細気管支の壁を肺胞が中断"/>
        <outline text="弾性反跳が受動呼気を駆動">
          <outline text="弾性枠破壊で肺気腫と呼気虚脱"/>
        </outline>
        <outline text="一型細胞が表面積の大部分を覆う"/>
        <outline text="二型細胞がサーファクタントを分泌">
          <outline text="損傷後に両上皮型を補充"/>
        </outline>
        <outline text="サーファクタントは表面張力を低下">
          <outline text="不足・不活化で虚脱"/>
        </outline>
        <outline text="関門はサーファクタント、上皮、基底板、内皮">
          <outline text="浮腫と線維化は関門を厚くする"/>
          <outline text="肺気腫は表面積を減らす"/>
        </outline>
      </outline>
      <outline text="防御、胸膜、解釈">
        <outline text="肺胞マクロファージが粒子を取り込む"/>
        <outline text="肺胞孔は感染も広げる"/>
        <outline text="胸膜リンパ管は壁側ストーマから除去"/>
        <outline text="空気や過剰液が胸膜を離す"/>
        <outline text="異常区画はどこかを問う"/>
      </outline>
    </outline>
  </body>
</opml>
