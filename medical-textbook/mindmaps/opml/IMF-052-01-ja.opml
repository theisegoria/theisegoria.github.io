<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>052-01 基礎</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="男性の生殖および性の健康">
      <outline text="概説">
        <outline text="羞恥心とスティグマが受診を遅らせる">
          <outline text="包摂的な言葉、守秘義務、許可"/>
        </outline>
        <outline text="時間的猶予なし：捻転、フルニエ、持続勃起"/>
      </outline>
      <outline text="ホルモン調節と性腺機能低下症">
        <outline text="拍動性の放出ホルモンが性腺刺激ホルモンを刺激">
          <outline text="黄体形成ホルモンはライディッヒ細胞に作用"/>
          <outline text="卵胞刺激ホルモンはセルトリ細胞に作用"/>
        </outline>
        <outline text="テストステロンとインヒビンの負のフィードバック"/>
        <outline text="原発性：精巣不全、性腺刺激ホルモン高値">
          <outline text="染色体異常、精巣炎、捻転、化学療法、放射線"/>
        </outline>
        <outline text="続発性：視床下部または下垂体">
          <outline text="腫瘍、プロラクチン、オピオイド、ステロイド"/>
        </outline>
        <outline text="日内変動と急性疾患での低下">
          <outline text="適切な時間帯に反復測定し文脈で解釈"/>
        </outline>
        <outline text="補充は欠乏が証明された場合のみ">
          <outline text="精子形成抑制、赤血球増加症"/>
          <outline text="疲労や加齢の治療ではない"/>
        </outline>
      </outline>
      <outline text="性歴聴取と診察">
        <outline text="懸念、パートナー、性行為、機能、生殖の希望"/>
        <outline text="パートナーや身体構造から推測しない"/>
        <outline text="発症時期、一貫性、朝立ち、状況差"/>
        <outline text="精巣、次に精巣上体と精索を触診">
          <outline text="正常精巣は平滑で硬すぎない"/>
        </outline>
        <outline text="透光試験より超音波検査が信頼できる"/>
      </outline>
      <outline text="勃起障害と射精障害">
        <outline text="一酸化窒素、流入、弛緩、静脈閉鎖"/>
        <outline text="血管、神経、内分泌、薬剤、心因、混在"/>
        <outline text="細い陰茎動脈：心血管疾患の早期徴候">
          <outline text="血圧、糖尿病、脂質、喫煙、心機能"/>
        </outline>
        <outline text="ホスホジエステラーゼ五型阻害薬が増強">
          <outline text="性的刺激が必要"/>
          <outline text="硝酸薬と併用禁止：著明な低血圧"/>
        </outline>
        <outline text="陰圧式、尿道内、海綿体内、人工陰茎"/>
        <outline text="早漏：苦痛と制御困難"/>
        <outline text="射精遅延：セロトニン作動薬、神経障害"/>
        <outline text="逆行性：膀胱出口が閉鎖しない"/>
      </outline>
      <outline text="持続勃起症と陰茎疾患">
        <outline text="持続勃起症：四時間を超える勃起"/>
        <outline text="虚血性：有痛性、硬いコンパートメント症候群">
          <outline text="血液疾患、注射薬、向精神薬"/>
          <outline text="緊急吸引と交感神経刺激薬"/>
        </outline>
        <outline text="非虚血性：動脈外傷、疼痛が弱い"/>
        <outline text="嵌頓包茎：浮腫が血流を障害">
          <outline text="緊急整復"/>
        </outline>
        <outline text="亀頭包皮炎とペイロニー病のプラーク"/>
        <outline text="陰茎がん：持続病変は生検">
          <outline text="喫煙、包茎、発がん性ヒトパピローマウイルス"/>
        </outline>
      </outline>
      <outline text="急性陰嚢痛">
        <outline text="捻転は静脈、次に動脈を遮断">
          <outline text="徴候だけで安全に除外できない"/>
          <outline text="画像を待たず手術と両側固定"/>
        </outline>
        <outline text="精巣上体炎：緩徐、後方の圧痛">
          <outline text="尿と性感染症を検査、パートナー対応"/>
        </outline>
        <outline text="フルニエ壊疽：会陰壊死の急速進行">
          <outline text="目に見える範囲を超える疼痛"/>
          <outline text="蘇生、広域抗菌薬、即時デブリードマン"/>
        </outline>
        <outline text="陰嚢水腫と左側の精索静脈瘤">
          <outline text="右側や還納しない病変：二次性閉塞"/>
        </outline>
        <outline text="精巣内充実性腫瘤は悪性とみなす">
          <outline text="緊急超音波、経陰嚢的生検は禁忌"/>
        </outline>
      </outline>
      <outline text="精巣がん">
        <outline text="若年成人、無痛性のしこりや重い感じ"/>
        <outline text="停留精巣と精巣腫瘍の既往"/>
        <outline text="マーカーは分類に役立つが正常もある"/>
        <outline text="高位精巣摘除術"/>
        <outline text="病期に応じた治療で治癒率が高い"/>
        <outline text="治療前に精子保存を話し合う"/>
      </outline>
      <outline text="前立腺疾患">
        <outline text="前立腺肥大：アンドロゲン依存の移行領域肥大">
          <outline text="症状は大きさでなく緊張と膀胱で決まる"/>
          <outline text="アルファ一遮断薬は速やかに弛緩"/>
          <outline text="五アルファ還元酵素阻害薬は数か月で縮小"/>
          <outline text="尿閉、反復感染、腎障害：手術"/>
        </outline>
        <outline text="急性前立腺炎：培養と移行性抗菌薬"/>
        <outline text="慢性骨盤痛：抗菌薬を反復しない"/>
        <outline text="前立腺特異抗原は良性要因でも上昇"/>
        <outline text="スクリーニングは価値観で決める">
          <outline text="死亡予防と過剰診断・害の比較"/>
        </outline>
        <outline text="磁気共鳴画像とリスクに応じた生検"/>
      </outline>
      <outline text="男性不妊">
        <outline text="双方のパートナーを評価"/>
        <outline text="産生、閉塞、射精、内分泌の障害"/>
        <outline text="変動があるため精液検査を反復"/>
        <outline text="可逆的要因を治療">
          <outline text="外因性テストステロンを中止"/>
        </outline>
        <outline text="人工授精から体外受精、顕微授精まで"/>
      </outline>
    </outline>
  </body>
</opml>
