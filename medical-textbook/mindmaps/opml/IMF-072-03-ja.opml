<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>072-03 管理、モニタリング、予防、安全、倫理、医療システム、長期継続ケア</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="リハビリテーション管理と長期継続ケア">
      <outline text="管理の原則">
        <outline text="課題練習、体力調整、機器、環境変更"/>
        <outline text="強度は多いほど良いわけではない">
          <outline text="用量は治癒、予備能、疲労に適合"/>
        </outline>
        <outline text="目標が構成し、反復測定で判定"/>
      </outline>
      <outline text="運動処方">
        <outline text="頻度、強度、時間、種類、進行"/>
        <outline text="禁忌は年齢でなく強度と病態"/>
        <outline text="有酸素運動強度">
          <outline text="心拍数、酸素摂取量、自覚的運動強度"/>
          <outline text="ベータ遮断では心拍目標が不確か"/>
          <outline text="ウォームアップとクールダウン"/>
        </outline>
        <outline text="抵抗運動">
          <outline text="疼痛やフォーム崩れなく進める"/>
          <outline text="パワー訓練は高齢者に有益"/>
          <outline text="長い息こらえを避ける"/>
        </outline>
        <outline text="平衡訓練は安全に課題を与える"/>
        <outline text="ストレッチは神経性筋力低下を治さない"/>
      </outline>
      <outline text="診断別の運動リハビリテーション">
        <outline text="脳卒中">
          <outline text="反復する課題特異的練習"/>
          <outline text="痙縮が消えるまで待たない"/>
          <outline text="肩の疼痛と学習性不使用を予防"/>
        </outline>
        <outline text="痙縮">
          <outline text="疼痛、感染、便秘などの誘因対応"/>
          <outline text="装具、ボツリヌス毒素、髄腔内、手術"/>
          <outline text="緊張低下で移乗が悪化し得る"/>
        </outline>
        <outline text="パーキンソン病">
          <outline text="大振幅、外的手掛かり、すくみ対策"/>
          <outline text="薬の時刻が遂行に影響"/>
        </outline>
        <outline text="脊髄損傷">
          <outline text="除圧、移乗、車椅子技能"/>
          <outline text="過反射：上体挙上、誘因探索、監視"/>
        </outline>
      </outline>
      <outline text="支援技術">
        <outline text="装具">
          <outline text="関節安定、クリアランス、変形予防"/>
          <outline text="皮膚損傷や不使用の危険"/>
        </outline>
        <outline text="義肢">
          <outline text="切断高位、断端、認知、能力、目標"/>
          <outline text="幻肢痛：教育、鏡像法、脱感作"/>
        </outline>
        <outline text="車椅子：手動、電動、パワーアシスト"/>
        <outline text="保守、充電、予備手段、資金計画"/>
      </outline>
      <outline text="二次合併症の予防">
        <outline text="圧迫：除圧、支持面、皮膚確認"/>
        <outline text="静脈血栓予防は移動能力とリスク"/>
        <outline text="拘縮：肢位、能動運動、装具"/>
        <outline text="不動後の骨粗鬆症"/>
        <outline text="呼吸ケア">
          <outline text="球麻痺は誤嚥リスクを増す"/>
          <outline text="正常な酸素飽和度でもリスク"/>
        </outline>
        <outline text="転倒予防は多因子を統合">
          <outline text="活動制限は将来の転倒を増やす"/>
        </outline>
      </outline>
      <outline text="疲労、ペーシング、役割復帰">
        <outline text="省エネルギー法と選択的委任"/>
        <outline text="ペーシングは過活動と虚脱を避ける">
          <outline text="労作後症候群はエネルギー範囲内"/>
        </outline>
        <outline text="復職は課題分析から始める">
          <outline text="段階的時間、業務変更、遠隔勤務"/>
          <outline text="開示は本人が決める"/>
        </outline>
        <outline text="運転">
          <outline text="路上評価で統合能力を検証"/>
          <outline text="地域の報告義務を知る"/>
        </outline>
        <outline text="適応スポーツはアイデンティティを支える">
          <outline text="クラス分けは重症度尺度でない"/>
        </outline>
      </outline>
      <outline text="学際的ケア">
        <outline text="各職種の異なる専門性"/>
        <outline text="学際的ケアは共通目標へ統合">
          <outline text="多職種の並列は断片化し得る"/>
        </outline>
        <outline text="チーム会議：障壁、責任ある行動"/>
        <outline text="患者と支援者もチームの一員"/>
        <outline text="早期からの退院計画">
          <outline text="安定しても住居に入れず危険"/>
        </outline>
      </outline>
      <outline text="障害を理解した倫理">
        <outline text="臨床家は生活の質を過小評価"/>
        <outline text="障害を悲劇だけとして語らない"/>
        <outline text="支援された意思疎通、最小制限">
          <outline text="理解した上でリスクを選べる"/>
        </outline>
        <outline text="施設の都合は拘束の理由でない"/>
        <outline text="アクセスの不平等">
          <outline text="急速な改善予測は重度障害者を排除"/>
          <outline text="必要性と公平性で配分"/>
        </outline>
      </outline>
      <outline text="転帰測定と機能維持">
        <outline text="参加と介護者負担を追跡"/>
        <outline text="進歩がなければ再評価">
          <outline text="診断、用量、気分、機器、目標"/>
        </outline>
        <outline text="維持">
          <outline text="地域での運動、自己管理"/>
          <outline text="加齢、妊娠、介護者変更で不安定化"/>
        </outline>
        <outline text="成功は技能、支援、環境"/>
      </outline>
    </outline>
  </body>
</opml>
