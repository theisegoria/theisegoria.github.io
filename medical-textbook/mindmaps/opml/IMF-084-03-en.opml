<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>084-03 Reproductive, skin, sensory, and lymphoid histology with structure–function recognition</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Reproductive, skin, sensory, and lymphoid histology">
      <outline text="Spatial organisation">
        <outline text="Reproductive tissue varies with age and cycle"/>
        <outline text="Sensory epithelia transduce stimuli"/>
        <outline text="Lymphoid compartments organise immune cells"/>
      </outline>
      <outline text="Testis">
        <outline text="Tunica albuginea, lobules, seminiferous tubules"/>
        <outline text="Germ cells mature from base to lumen">
          <outline text="Mitosis, meiosis, differentiation"/>
        </outline>
        <outline text="Sertoli cells span basement membrane to lumen">
          <outline text="Tight junctions form blood–testis barrier"/>
          <outline text="Inhibin and androgen-binding protein"/>
        </outline>
        <outline text="Leydig cells secrete testosterone"/>
      </outline>
      <outline text="Male ducts and glands">
        <outline text="Efferent ductules: scalloped lumen"/>
        <outline text="Epididymis: stereocilia, sperm maturation"/>
        <outline text="Ductus deferens: thick three-layered muscle"/>
        <outline text="Seminal vesicle stores no sperm"/>
        <outline text="Prostate: corpora amylacea increase with age"/>
        <outline text="Erectile tissue: endothelial vascular spaces"/>
      </outline>
      <outline text="Ovary">
        <outline text="Cortex follicles, vascular medulla"/>
        <outline text="Primordial: one layer of flattened cells"/>
        <outline text="Primary: cuboidal granulosa, zona pellucida"/>
        <outline text="Antral: fluid cavity, theca layers"/>
        <outline text="Corpus luteum makes progesterone">
          <outline text="Without support becomes corpus albicans"/>
        </outline>
        <outline text="Atresia far exceeds ovulation"/>
      </outline>
      <outline text="Tube, uterus, cervix, vagina, breast">
        <outline text="Tube: ciliated and peg cells, ampulla folds">
          <outline text="Obstruction: infertility, ectopic implantation"/>
        </outline>
        <outline text="Basalis regenerates functionalis"/>
        <outline text="Proliferative: straight mitotic glands"/>
        <outline text="Secretory: vacuoles, tortuous glands"/>
        <outline text="Endocervix columnar, ectocervix squamous">
          <outline text="Junction vulnerable to papillomavirus"/>
        </outline>
        <outline text="Vagina: glycogen-rich, no glands"/>
        <outline text="Breast proliferates in pregnancy">
          <outline text="Myoepithelial cells aid milk ejection"/>
        </outline>
      </outline>
      <outline text="Skin">
        <outline text="Strata from basale to corneum">
          <outline text="Corneocytes form the barrier"/>
        </outline>
        <outline text="Melanin shields nuclei from ultraviolet">
          <outline text="Colour reflects melanosomes, not cell number"/>
        </outline>
        <outline text="Langerhans cells present antigen"/>
        <outline text="Papillary loose, reticular dense dermis"/>
        <outline text="Thick skin lacks hair and sebaceous glands"/>
        <outline text="Sebaceous glands are holocrine"/>
        <outline text="Eccrine ducts reabsorb salt"/>
      </outline>
      <outline text="Eye and ear">
        <outline text="Cornea transparent from orderly collagen">
          <outline text="Endothelium pumps fluid from stroma">
            <outline text="Cell loss causes oedema, opacity"/>
          </outline>
        </outline>
        <outline text="Photoreceptors to bipolar to ganglion cells"/>
        <outline text="Fovea maximises cone resolution"/>
        <outline text="Optic disc lacks photoreceptors"/>
        <outline text="Retinal vessels inner, choroid outer"/>
        <outline text="Inner hair cells transduce sound"/>
        <outline text="Outer hair cells amplify vibration"/>
        <outline text="Maculae linear, cristae angular acceleration"/>
      </outline>
      <outline text="Taste and smell">
        <outline text="Taste receptor cells extend microvilli to pore"/>
        <outline text="Olfactory axons cross cribriform plate"/>
        <outline text="Olfactory receptor cells are replaced"/>
      </outline>
      <outline text="Lymphoid organs">
        <outline text="Lymph node filters lymph">
          <outline text="Cortex: B-cell follicles, germinal centres"/>
          <outline text="Paracortex: T cells, high endothelial venules"/>
          <outline text="Medullary cords hold plasma cells"/>
        </outline>
        <outline text="Spleen filters blood">
          <outline text="White pulp around central arterioles"/>
          <outline text="Red pulp retains rigid erythrocytes"/>
        </outline>
        <outline text="Thymus supports T-cell development">
          <outline text="Epithelial reticular cells, Hassall corpuscles"/>
          <outline text="No follicles or afferent lymphatics"/>
        </outline>
        <outline text="Tonsils and Peyer patches sample antigen">
          <outline text="Microfold cells transport luminal material"/>
        </outline>
      </outline>
      <outline text="Recognition by boundaries and routes">
        <outline text="Arrangement shows what is processed"/>
      </outline>
    </outline>
  </body>
</opml>
