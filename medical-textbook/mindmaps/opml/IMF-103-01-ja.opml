<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>103-01 社会的決定要因、格差、不公正、集団健康</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="社会的決定要因と集団健康">
      <outline text="決定要因と定義">
        <outline text="生物学と生活条件の相互作用"/>
        <outline text="所得、教育、住宅、雇用、食料、交通"/>
        <outline text="環境、つながり、法、差別、政治力"/>
        <outline text="曝露、ストレス、発見、治療、回復を形作る"/>
        <outline text="臨床は個人身体、集団健康は分布"/>
        <outline text="健康格差：測定可能な差"/>
        <outline text="健康不公正：回避可能で不正な差">
          <outline text="明示すべき規範主張を加える"/>
        </outline>
        <outline text="平等：同じ資源"/>
        <outline text="公平：必要と障壁に応じ配分"/>
      </outline>
      <outline text="社会的勾配">
        <outline text="各階層段階で健康が改善"/>
        <outline text="物質資源：栄養、住居、治療接近"/>
        <outline text="相対的位置：自律、地位、慢性ストレス"/>
        <outline text="生活習慣への還元は機序を誤る">
          <outline text="環境が高価にする行動を要求"/>
        </outline>
      </outline>
      <outline text="教育と雇用">
        <outline text="教育は識字、所得、制度利用へ影響"/>
        <outline text="健康も教育へ影響：双方向性"/>
        <outline text="就学年数は質を同じに測らない"/>
        <outline text="教育達成は複数経路を表し得る"/>
        <outline text="雇用は所得、同一性、生活構造"/>
        <outline text="不安定、危険、低裁量労働は有害"/>
        <outline text="危険労働から離れると改善も"/>
        <outline text="職名でなく作業、時刻、裁量"/>
      </outline>
      <outline text="住宅、地域、食料、交通">
        <outline text="住宅：湿気、黴、過密、睡眠"/>
        <outline text="不安定住宅は薬物保存と追跡を乱す"/>
        <outline text="ホームレス状態は一様でない"/>
        <outline text="助言前に居所を尋ねる">
          <outline text="正しくても不可能な計画になる"/>
        </outline>
        <outline text="地域は曝露とサービスを配分"/>
        <outline text="居住分離が有利不利を集中"/>
        <outline text="個人調整が経路の一部を除く"/>
        <outline text="食料不安定：制限と入手期の交互"/>
        <outline text="設備を仮定する助言は恥を増す"/>
        <outline text="教育以外の構造的食料介入"/>
        <outline text="交通障壁が受診欠席を作る"/>
        <outline text="改善が低所得住民を追い出し得る">
          <outline text="平均利益と分配結果を評価"/>
        </outline>
      </outline>
      <outline text="つながりと差別">
        <outline text="孤立：客観的接触不足"/>
        <outline text="孤独：望む関係と実際の不一致"/>
        <outline text="疾患は孤立の原因にも結果にも"/>
        <outline text="介入は障壁に合わせる"/>
        <outline text="差別：対人、制度、構造"/>
        <outline text="接近とストレス生理を変える"/>
        <outline text="人種差別は集団の生物学的性質でない">
          <outline text="不均等処遇と曝露で生物学的結果"/>
        </outline>
        <outline text="人種分類は遺伝型や経験の代用不可"/>
        <outline text="交差性：足すのでなく組み合わさる"/>
        <outline text="集団平均は個人の運命でない"/>
      </outline>
      <outline text="ライフコースと商業的決定要因">
        <outline text="曝露の蓄積、集積、感受性期"/>
        <outline text="累積不利は予備能を減らす"/>
        <outline text="リスク連鎖と保護経験による中断"/>
        <outline text="確率を変えるが必然にはしない"/>
        <outline text="企業製品、実践、政治活動"/>
        <outline text="個人選択は設計された環境内"/>
        <outline text="規制は規定値を大規模に変える">
          <outline text="代替、違法市場、業界適応を予測"/>
        </outline>
      </outline>
      <outline text="医療アクセスと逆ケア">
        <outline text="利用可能性、地理、費用、受容性、品質"/>
        <outline text="形式的権利は適時診療を保証しない"/>
        <outline text="言語、開業時間、デジタル排除、恐怖"/>
        <outline text="継続性なき量増加は転帰を改善しない"/>
        <outline text="未充足需要は数えられない人を含む"/>
        <outline text="逆ケア：必要最大の所ほど医療が少ない"/>
        <outline text="同じ診察時間は不公正になり得る"/>
        <outline text="比例的普遍主義は不利に比例"/>
      </outline>
      <outline text="集団戦略とデータ">
        <outline text="高リスク戦略：少数へ大きな利益">
          <outline text="発見と継続関与へ依存"/>
        </outline>
        <outline text="集団戦略：分布全体を移動">
          <outline text="有利な人が先に利用し格差拡大"/>
        </outline>
        <outline text="普遍的変化と対象支援の組合せ"/>
        <outline text="絶対差と相対差は逆に動き得る"/>
        <outline text="欠測は無作為でないことが多い"/>
        <outline text="平均は少数群の悪化を隠す"/>
      </outline>
      <outline text="決定要因への行動">
        <outline text="因果候補であり悲観の言い訳でない"/>
        <outline text="臨床家：障壁、適応、接続、要求"/>
        <outline text="公共政策は上流介入"/>
        <outline text="両水準は置換不能"/>
      </outline>
    </outline>
  </body>
</opml>
