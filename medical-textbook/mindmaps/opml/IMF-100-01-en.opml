<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>100-01 Social cognition, identity, influence, and groups</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="Social cognition, identity, influence, and groups">
      <outline text="Social psychology in medicine">
        <outline text="Behaviour shaped by actual, imagined, implied others"/>
        <outline text="Families, teams, institutions shape decisions"/>
        <outline text="Coordinates care and provides belonging">
          <outline text="Can also create bias and silence disagreement"/>
        </outline>
        <outline text="Social information is evidence, not irrationality"/>
      </outline>
      <outline text="Perception and attribution">
        <outline text="Rapid categorisation guides attention">
          <outline text="Reduces load but hides within-group variation"/>
        </outline>
        <outline text="Stereotype, prejudice, discrimination">
          <outline text="Can occur separately"/>
        </outline>
        <outline text="Observers overweight traits, underweight situations">
          <outline text="Missed appointments: transport, cost, childcare"/>
        </outline>
        <outline text="Test person and environment explanations"/>
        <outline text="Hindsight bias exaggerates predictability"/>
        <outline text="Just-world tendency blames illness on behaviour"/>
        <outline text="Self-serving attributions">
          <outline text="Reversed by depression, shame, marginalisation"/>
        </outline>
      </outline>
      <outline text="Attitudes and persuasion">
        <outline text="Beliefs, emotions, action tendencies"/>
        <outline text="Predict best when specific, accessible, stable"/>
        <outline text="Cognitive dissonance after inconsistent action">
          <outline text="Change beliefs, justify, or avoid information"/>
          <outline text="Coercive commitment entrenches resistance"/>
        </outline>
        <outline text="Careful versus heuristic processing"/>
        <outline text="Credibility needs competence and trustworthiness"/>
        <outline text="Fear without a feasible response">
          <outline text="Defensive avoidance when efficacy is low"/>
        </outline>
      </outline>
      <outline text="Norms, conformity, and compliance">
        <outline text="Descriptive versus injunctive norms"/>
        <outline text="Advertised misconduct can normalise it">
          <outline text="Pair with a clear valued standard"/>
        </outline>
        <outline text="Trusted peers outweigh society"/>
        <outline text="Informational versus normative influence"/>
        <outline text="Uncertainty, unanimity, public response strengthen">
          <outline text="One dissenter breaks unanimity"/>
        </outline>
        <outline text="Independent assessments before discussion"/>
        <outline text="Commitment, reciprocity, scarcity techniques">
          <outline text="Consent needs more than a pressured yes"/>
        </outline>
      </outline>
      <outline text="Authority and speaking up">
        <outline text="Coordinates expertise and accountability"/>
        <outline text="Harm easier when responsibility shifts upward">
          <outline text="Fragmented tasks, dissent seen as disloyal"/>
        </outline>
        <outline text="Professional status gives no immunity"/>
        <outline text="Escalation, graded assertiveness, closed loop"/>
        <outline text="Leaders thank people for concerns"/>
        <outline text="Formal permission with social punishment fails"/>
      </outline>
      <outline text="Identity and group behaviour">
        <outline text="In-group favouritism even when arbitrary"/>
        <outline text="Threat, competition, unequal status harden boundaries"/>
        <outline text="Contact helps with cooperation and equality">
          <outline text="Hostile proximity reinforces stereotypes"/>
        </outline>
        <outline text="Intersecting identities limit prediction"/>
        <outline text="Deindividuation follows salient local norms"/>
        <outline text="Diffusion of responsibility among bystanders">
          <outline text="Name a person to call for help"/>
        </outline>
      </outline>
      <outline text="Group decisions and teamwork">
        <outline text="Polarisation toward the initial tendency"/>
        <outline text="Groupthink from directive, insulated, homogeneous groups">
          <outline text="Structured dissent and independent review"/>
        </outline>
        <outline text="Collective intelligence from sharing and safety"/>
        <outline text="Shared-information bias hides unique facts">
          <outline text="Ask what evidence would change the plan"/>
        </outline>
        <outline text="Social loafing versus coordination loss"/>
        <outline text="Competition suppresses learning and candour"/>
        <outline text="Redundancy preserves resilience"/>
      </outline>
      <outline text="Power, prosocial behaviour, and conflict">
        <outline text="Power from expertise, position, rewards, information"/>
        <outline text="Low-power people monitor and bear conflict risk">
          <outline text="Patient agreement may reflect dependence"/>
          <outline text="Private questions and safe refusal"/>
        </outline>
        <outline text="Empathic concern versus self-focused distress"/>
        <outline text="Exhaustion and moral distress are distinct"/>
        <outline text="Organisational support over resilience exhortation"/>
        <outline text="Positions versus underlying interests"/>
        <outline text="Scarcity limits win-win solutions">
          <outline text="Fair procedure, transparency, review"/>
        </outline>
      </outline>
      <outline text="Designing better environments">
        <outline text="Education rarely abolishes bias"/>
        <outline text="Slow high-risk decisions, expose base rates"/>
        <outline text="Invite independent views, document reasons"/>
        <outline text="Audit outcomes across groups"/>
        <outline text="Make influence visible and accountable"/>
      </outline>
    </outline>
  </body>
</opml>
