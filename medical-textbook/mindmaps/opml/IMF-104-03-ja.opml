<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>104-03 暑熱、寒冷、高地、潜水、微小重力</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="暑熱、寒冷、高地、潜水、微小重力">
      <outline text="環境ストレスの原則">
        <outline text="熱、気体、水分、機械負荷の交換"/>
        <outline text="強さ、持続、装備に依存"/>
        <outline text="運動は代謝熱と酸素需要を上げる"/>
        <outline text="適応は範囲を広げるが限界は消さない"/>
      </outline>
      <outline text="熱交換と暑熱順化">
        <outline text="深部体温は産生と熱交換の均衡">
          <outline text="放射、対流、伝導、蒸発"/>
        </outline>
        <outline text="周囲が高温なら放射と対流は熱を加える"/>
        <outline text="蒸発冷却には蒸気圧が必要">
          <outline text="高湿度、非透過衣服、滴る汗"/>
        </outline>
        <outline text="皮膚と深部の受容器から視床下部・脳幹"/>
        <outline text="皮膚血流は活動筋、中心血液量と競う">
          <outline text="血漿量減少で心拍上昇"/>
        </outline>
        <outline text="強制飲水は希釈性低ナトリウム血症"/>
        <outline text="反復曝露による暑熱順化">
          <outline text="血漿量が増える"/>
          <outline text="早く薄い汗、アルドステロン性"/>
          <outline text="数日で開始、一から二週、減衰"/>
        </outline>
      </outline>
      <outline text="熱中症">
        <outline text="熱疲労は継続不能、重篤中枢障害なし"/>
        <outline text="熱射病は高体温と中枢神経障害">
          <outline text="肝、腎、筋、凝固の傷害"/>
          <outline text="持続発汗で除外できない"/>
        </outline>
        <outline text="労作性は活動者、古典型は脆弱者"/>
        <outline text="薬剤が発汗や判断を損なう"/>
        <outline text="搬送を遅らせず急速冷却"/>
        <outline text="設定温度が上がらず解熱薬無効"/>
      </outline>
      <outline text="寒冷曝露と傷害">
        <outline text="皮膚血管収縮と行動で熱保存"/>
        <outline text="震えと非震え熱産生"/>
        <outline text="水は静止空気より速く熱を奪う"/>
        <outline text="アルコールは熱損失を加速"/>
        <outline text="低体温は代謝と心伝導を遅らせる">
          <outline text="混乱から不整脈、心停止へ"/>
          <outline text="心筋は刺激されやすく移動に注意"/>
        </outline>
        <outline text="受動、能動的外部、内部加温"/>
        <outline text="凍傷は氷形成、内皮傷害、血栓">
          <outline text="融解後再凍結で著しく悪化"/>
          <outline text="擦ると機械傷害を加える"/>
        </outline>
        <outline text="湿冷による非凍結性寒冷傷害"/>
      </outline>
      <outline text="高地の生理">
        <outline text="気圧低下、酸素分率はほぼ同じ"/>
        <outline text="即時低酸素換気反応">
          <outline text="呼吸性アルカローシスが換気を抑える"/>
          <outline text="腎の重炭酸排泄が過換気を許す"/>
        </outline>
        <outline text="最大有酸素能力が低下"/>
        <outline text="エリスロポエチンで数週に赤血球増加">
          <outline text="血漿量収縮が先に濃度を上げる"/>
          <outline text="過剰粘度は流れを妨げる"/>
        </outline>
        <outline text="生涯内順化と進化適応は別"/>
      </outline>
      <outline text="高地疾患">
        <outline text="急性高山病は登高後の頭痛">
          <outline text="登高速、睡眠高度、個人感受性"/>
        </outline>
        <outline text="高地脳浮腫は運動失調、精神変化"/>
        <outline text="高地肺水腫は息切れ、低酸素">
          <outline text="広範な低酸素性肺血管収縮"/>
          <outline text="不均一収縮と高流量"/>
        </outline>
        <outline text="下降と酸素が中心"/>
        <outline text="アセタゾラミドは順化を助ける"/>
        <outline text="糖質コルチコイドは脳症状のみ軽減"/>
      </outline>
      <outline text="潜水と浸水">
        <outline text="海水約十メートルごとに約一気圧"/>
        <outline text="Boyle則で気体は縮み膨張する">
          <outline text="耳、洞、マスク空間、肺の圧平衡不能"/>
          <outline text="息止め上昇で圧外傷とガス塞栓"/>
        </outline>
        <outline text="Henry則で深所ほど気体が溶ける">
          <outline text="急な上昇で気泡と減圧症"/>
          <outline text="高濃度酸素と緊急再圧評価"/>
        </outline>
        <outline text="窒素酔いは認知を損なう"/>
        <outline text="酸素毒性は痙攣と肺毒性"/>
        <outline text="二酸化炭素蓄積が両者を悪化"/>
        <outline text="浸水は血液を中心へ移し利尿"/>
        <outline text="冷水浸水は低体温前にあえぎ"/>
        <outline text="事前過換気は水中意識消失を招く"/>
      </outline>
      <outline text="微小重力">
        <outline text="体液が胸と頭へ移動">
          <outline text="利尿で血漿量減少"/>
        </outline>
        <outline text="循環脱調節、骨喪失、筋萎縮"/>
        <outline text="帰還時の起立不耐"/>
        <outline text="尿中カルシウム増加で結石危険"/>
        <outline text="前庭の再解釈と動揺病"/>
        <outline text="放射線危険は線量と期間で増す"/>
        <outline text="対策は適応を減らすが消さない"/>
      </outline>
      <outline text="統合的予防">
        <outline text="支配する物理曝露を同定"/>
        <outline text="仕事と装備を予備能へ合わせる"/>
        <outline text="段階適応を許す"/>
        <outline text="不可逆傷害前に早期破綻を認識"/>
      </outline>
    </outline>
  </body>
</opml>
