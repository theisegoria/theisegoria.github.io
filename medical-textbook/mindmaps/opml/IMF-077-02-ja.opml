<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>077-02 縦隔、心膜、心臓、冠循環、大血管</title>
    <ownerName>Integrated Medical Foundations</ownerName>
  </head>
  <body>
    <outline text="縦隔、心臓、大血管">
      <outline text="縦隔の区画">
        <outline text="左右胸膜腔間の中央区画">
          <outline text="一病変が複数系を圧迫し得る"/>
        </outline>
        <outline text="胸骨角からT4・T5椎間板の面">
          <outline text="上縦隔と下縦隔を分ける"/>
        </outline>
        <outline text="下部は心膜で三分される"/>
        <outline text="上縦隔は静脈、動脈、気道、食道の順"/>
        <outline text="前縦隔は疎性組織、リンパ節、胸腺"/>
        <outline text="中縦隔は心膜、心臓、横隔神経"/>
        <outline text="後縦隔は大動脈、食道、胸管、奇静脈"/>
        <outline text="腫瘤位置は傾向で絶対でない"/>
      </outline>
      <outline text="心膜">
        <outline text="腱、血管、胸骨へ付く線維性袋"/>
        <outline text="漿膜性心膜の壁側層と臓側層"/>
        <outline text="横洞は動脈流出路の後方">
          <outline text="大動脈・肺動脈幹周囲へ通過"/>
        </outline>
        <outline text="斜洞は左心房後方の盲嚢"/>
        <outline text="横隔神経は肺根前方、迷走神経は後方"/>
        <outline text="タンポナーデの生理">
          <outline text="急速貯留は内圧上昇で充満障害"/>
          <outline text="緩徐貯留では袋が伸びる"/>
          <outline text="右心腔は拡張期に脆弱"/>
        </outline>
      </outline>
      <outline text="心臓外表面">
        <outline text="心尖は主に左心室"/>
        <outline text="心底は主に左心房で後方を向く"/>
        <outline text="心縁">
          <outline text="右縁は右心房"/>
          <outline text="左縁は左心室と左心耳"/>
        </outline>
        <outline text="胸肋面は主に右心室"/>
        <outline text="横隔面は主に左心室"/>
      </outline>
      <outline text="心腔と弁">
        <outline text="右心房は大静脈と冠状静脈洞を受ける">
          <outline text="分界稜が壁を分ける"/>
          <outline text="卵円窩は胎児卵円孔を示す"/>
        </outline>
        <outline text="調節帯を持つ右心室">
          <outline text="動脈円錐から肺動脈弁へ"/>
        </outline>
        <outline text="左心房は肺静脈を受ける"/>
        <outline text="僧帽弁と二群の乳頭筋"/>
        <outline text="体循環駆出のため左心室壁が厚い"/>
        <outline text="冠動脈は右・左大動脈洞から"/>
        <outline text="弁閉鎖は圧逆転と尖の接合">
          <outline text="乳頭筋は逸脱を防ぐのみ"/>
        </outline>
        <outline text="線維骨格が心房を絶縁する"/>
      </outline>
      <outline text="冠動脈支配領域">
        <outline text="右冠動脈は右房室溝を走る">
          <outline text="結節枝と後室間枝を出す"/>
        </outline>
        <outline text="左冠動脈は二分する">
          <outline text="前室間枝は中隔前方を供給"/>
          <outline text="回旋枝は左房室溝に沿う"/>
        </outline>
        <outline text="優位性は後室間動脈の起始">
          <outline text="下壁と房室結節血流に影響"/>
        </outline>
        <outline text="機能的終動脈">
          <outline text="急性閉塞は梗塞を起こす"/>
          <outline text="緩徐な狭窄は側副路を拡大"/>
        </outline>
        <outline text="心内膜下は主に拡張期に灌流"/>
        <outline text="静脈は冠状静脈洞へ流れる"/>
      </outline>
      <outline text="伝導と自律神経支配">
        <outline text="洞房結節は上大静脈流入口付近"/>
        <outline text="房室結節は冠状静脈洞付近"/>
        <outline text="房室束は線維骨格を横切り二分">
          <outline text="右脚は調節帯を通る"/>
          <outline text="左脚は中隔上で扇状に広がる"/>
        </outline>
        <outline text="結節血流は優位性で変わる"/>
        <outline text="中隔や弁付近の損傷で伝導障害"/>
        <outline text="交感神経は心拍と収縮力を増す"/>
        <outline text="迷走神経は結節機能を遅くする"/>
        <outline text="内臓痛求心線維は交感神経と走る">
          <outline text="胸部・上腕内側関連痛"/>
        </outline>
      </outline>
      <outline text="大血管の位置関係">
        <outline text="上行大動脈は冠動脈を出す"/>
        <outline text="弓部は左主気管支上でT4へ"/>
        <outline text="肺動脈幹は大動脈前方">
          <outline text="右肺動脈は大動脈・大静脈後方"/>
        </outline>
        <outline text="動脈管索は左反回喉頭神経に近い"/>
        <outline text="左腕頭静脈は前方を横断"/>
        <outline text="奇静脈は右肺根上を弓状に通る"/>
        <outline text="胸管は左静脈合流部へ入る">
          <outline text="損傷で乳び胸"/>
        </outline>
      </outline>
      <outline text="縦隔病態">
        <outline text="解離は分枝や弁へ伸展">
          <outline text="心膜破裂でタンポナーデ"/>
          <outline text="胸膜破裂で血胸"/>
        </outline>
        <outline text="動脈瘤は神経、気道、静脈を圧迫"/>
        <outline text="左心房拡大は食道に影響"/>
        <outline text="上大静脈閉塞は側副路と浮腫"/>
        <outline text="縦隔気腫は筋膜面に沿う"/>
        <outline text="聴診部位は音の伝わる場所">
          <outline text="心エコーが実際の弁を示す"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
